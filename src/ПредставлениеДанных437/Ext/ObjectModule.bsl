// #Область ОписаниеПеременных

Перем Возможности; // Структура, Неопределено - метаданные и API, внедряемые оркестратором.

// #КонецОбласти

// #Область СлужебныйПрограммныйИнтерфейс

// #Область ШаблоныТаблиц

// Создает пустую схему таблицы для выбранного раздела и возможностей платформы.
//
// Параметры:
//  ДанныеТаблицы - Структура - описание раздела, его ресурсов и схемы колонок.
//
// Возвращаемое значение:
//  ТаблицаЗначений - типизированные колонки интерфейса без строк данных.
Функция ШаблонТаблицыПоДанным(ДанныеТаблицы) Экспорт
	
	Таблица = Новый ТаблицаЗначений;
	
	Для Каждого Колонка Из ДанныеТаблицы.Колонки Цикл
		Если Колонка.Доступна Тогда
			Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Подготавливает навигацию и загрузку разделов из общей схемы.
//
// Параметры:
//  СхемаТаблиц - Массив - готовая схема разделов.
//
// Возвращаемое значение:
//  Массив - имена разделов и реквизитов, действие выбора и фиксированные метаданные навигации.
//   * ИмяТаблицы - Строка - раздел общей схемы.
//   * ИмяРеквизита - Строка - источник данных таблицы формы.
//   * ВыборСтроки - Строка - действие выбора строки.
//   * ОтдельныеСведения - Булево - раздел показывается отдельным полем сведений.
//   * КоллекцияОбъектовМетаданных - Строка - фиксированный вид метаданных; пустое имя берется из строки.
//   * ОбъектМетаданных - Строка - фиксированное имя объекта; пустое имя берется из строки.
Функция ОписанияРазделовФормы(СхемаТаблиц) Экспорт
	
	Описания = Новый Массив;
	
	Для Каждого Раздел Из СхемаТаблиц Цикл
		Описание = Новый Структура;
		Описание.Вставить("ИмяТаблицы", Раздел.ИмяТаблицы);
		Описание.Вставить("ИмяРеквизита", Раздел.ИмяРеквизита);
		Описание.Вставить("ВыборСтроки", Раздел.ВыборСтроки);
		Описание.Вставить("ОтдельныеСведения", Раздел.ОтдельныеСведения);
		Описание.Вставить("КоллекцияОбъектовМетаданных", Раздел.КоллекцияМетаданных);
		Описание.Вставить("ОбъектМетаданных", ?(Раздел.УсловиеДоступности = "Справочник",
			Раздел.МетаданныеДоступности, ""));
		Описания.Добавить(Описание);
	КонецЦикла;
	
	Возврат Описания;
	
КонецФункции

// Проверяет наличие метаданных раздела по переданным возможностям.
//
// Параметры:
//  ДанныеТаблицы - Структура - описание раздела, его ресурсов и схемы колонок.
//
// Возвращаемое значение:
//  Булево - Истина, если страницу следует показывать.
Функция ЕстьМетаданныеСтраницы(ДанныеТаблицы) Экспорт
	
	Возврат Возможности.МетаданныеСтраниц[ДанныеТаблицы.ИмяТаблицы] = Истина;
	
КонецФункции

// #КонецОбласти

// #Область СовместимостьТипов

// Определяет файловый режим по явной строке соединения либо по переданному контексту.
//
// Параметры:
//  СтрокаСоединенияИнформационнойБазы - Строка - проверяемая строка; если пуста, используется признак из контекста.
//
// Возвращаемое значение:
//  Булево - файловый режим по указанной строке или контексту представления.
Функция ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "") Экспорт
	
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		Возврат Возможности.Файловая;
	КонецЕсли;
	
	Возврат Найти(ВРег(СтрокаСоединенияИнформационнойБазы), "FILE=") = 1;
	
КонецФункции

// Подставляет П1–П10 вместо %1–%10; значения приводятся к строке, пропущенные равны пустой строке.
// Совместим с платформой 8.2.
//
// Параметры:
//  Строка - Строка - шаблон с маркерами %1–%10.
//  П1 - Произвольный
//  П2 - Произвольный
//  П3 - Произвольный
//  П4 - Произвольный
//  П5 - Произвольный
//  П6 - Произвольный
//  П7 - Произвольный
//  П8 - Произвольный
//  П9 - Произвольный
//  П10 - Произвольный
//
// Возвращаемое значение:
//  Строка - однократная подстановка маркеров; знаки % внутри значений повторно не обрабатываются.
Функция СтрШаблонАдапт(Строка, П1 = "", П2 = "", П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "", П9 = "",
	П10 = "") Экспорт
	
	ЗначенияПодстановки = Новый Массив;
	ЗначенияПодстановки.Добавить(П1);
	ЗначенияПодстановки.Добавить(П2);
	ЗначенияПодстановки.Добавить(П3);
	ЗначенияПодстановки.Добавить(П4);
	ЗначенияПодстановки.Добавить(П5);
	ЗначенияПодстановки.Добавить(П6);
	ЗначенияПодстановки.Добавить(П7);
	ЗначенияПодстановки.Добавить(П8);
	ЗначенияПодстановки.Добавить(П9);
	ЗначенияПодстановки.Добавить(П10);
	
	Результат = "";
	Позиция = 1;
	
	Пока Позиция <= СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Номер = 0;
		ДлинаФрагмента = 1;
		
		Если Символ = "%" Тогда
			Если Сред(Строка, Позиция + 1, 2) = "10" Тогда
				Номер = 10;
				ДлинаФрагмента = 3;
			Иначе
				Цифра = Сред(Строка, Позиция + 1, 1);
				
				Если Цифра <> "" Тогда
					Номер = Найти("123456789", Цифра);
					
					Если Номер > 0 Тогда
						ДлинаФрагмента = 2;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Номер > 0 Тогда
			ЗначениеПараметра = ЗначенияПодстановки[Номер - 1];
			Результат = Результат + Строка(ЗначениеПараметра);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
		
		Позиция = Позиция + ДлинаФрагмента;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область Форматы

// Разрешает только именованные форматы схемы; строки BSL из макета не исполняются.
//
// Параметры:
//  ВидФормата - Строка - код из схемы: Количество или Дата; остальные значения дают пустой формат.
//
// Возвращаемое значение:
//  Строка - платформенный формат количества или даты; для остальных кодов пустая строка.
Функция ФорматКолонкиСхемы(ВидФормата) Экспорт
	
	Если ВидФормата = "Количество" Тогда
		Возврат ФорматКоличестваТаблиц();
	ИначеЕсли ВидФормата = "Дата" Тогда
		Возврат "ДФ=dd.MM.yyyy";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Формат целого числа с апострофом между триадами.
//
// Возвращаемое значение:
//  Строка
Функция ФорматКоличества() Экспорт
	
	Возврат "ЧГ=3,0;ЧРГ=""'"";ЧДЦ=0;ЧН=0";
	
КонецФункции

// Формирует надпись текущего отбора с общим признаком необходимости повторного сканирования.
//
// Параметры:
//  Состояние - Структура - ПредставлениеОтбора, ОсновныеУстарели, ДополнительныеУстарели.
//
// Возвращаемое значение:
//  Строка - надпись для нижней части основной формы.
Функция ТекстОтборов(Состояние) Экспорт
	
	Текст = ?(ПустаяСтрока(Состояние.ПредставлениеОтбора), "Отборы не установлены",
		"Отбор: " + Состояние.ПредставлениеОтбора);
	
	Если Состояние.ОсновныеУстарели Или Состояние.ДополнительныеУстарели Тогда
		Текст = Текст + " (необходимо повторное сканирование)";
		
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Добавляет количество строк к заголовку без повторения исходного названия.
//
// Параметры:
//  Заголовок - Строка - исходное название приложения или страницы без счетчика.
//  Количество - Число - число строк, добавляемое к заголовку страницы.
//  ПоказыватьНоль - Булево - показывать счетчик 0 вместо исходного заголовка.
//
// Возвращаемое значение:
//  Строка - заголовок страницы с заданным правилом показа нуля.
Функция ЗаголовокСтраницыТаблицы(Заголовок, Количество, ПоказыватьНоль = Ложь) Экспорт
	
	Возврат Заголовок + ?(Количество = 0 И Не ПоказыватьНоль, "",
		" (" + Формат(Количество, ФорматКоличестваТаблиц()) + ")");
	
КонецФункции

// #КонецОбласти

// #Область ОформлениеСистемныхДанных

// Подготавливает панель ресурсов из сохраненного системного снимка, без повторного сбора.
//
// Параметры:
//  Сведения - Структура - снимок приложения и компьютеров; см. ДанныеСистемногоСкана.
//
// Возвращаемое значение:
//  Структура - готовые подписи, показатели и подробности для страницы «Системные».
//   * Заголовок - Строка - заголовок приложения.
//   * Конфигурация - Строка - конфигурация и версия.
//   * Платформа - Строка - версия, тип платформы и клиент.
//   * Расположение - Строка - строка подключения.
//   * РежимРаботы - Строка - режим и доступный размер файловой базы.
//   * Отклик - Строка - доступный пинг клиент-сервер.
//   * Компьютеры - Массив из Структура - роли, имена, CPU, память, диски и подробности.
Функция ПанельСистемныхСведений(Сведения) Экспорт
	
	Приложение = Сведения.Приложение;
	ПанельРесурсов = Новый Структура;
	ПанельРесурсов.Вставить("Заголовок", Приложение.Заголовок);
	ПанельРесурсов.Вставить("Конфигурация", Приложение.Конфигурация + " (" + Приложение.ВерсияКонфигурации + ")");
	ПанельРесурсов.Вставить("Платформа", Приложение.Платформа + " · " + Строка(Приложение.ТипПлатформы)
		+ " · " + Приложение.Клиент);
	ПанельРесурсов.Вставить("Расположение", Приложение.Расположение);
	ПанельРесурсов.Вставить("РежимРаботы", "");
	ПанельРесурсов.Вставить("Отклик", "");
	ПанельРесурсов.Вставить("Компьютеры", Новый Массив);
	Если Сведения.Компьютеры = Неопределено Тогда
		Возврат ПанельРесурсов;
	КонецЕсли;
	
	ПанельРесурсов.РежимРаботы = СтрокаРежимаРаботы(Сведения.РежимРаботы);
	Компьютеры = Сведения.Компьютеры;
	ПанельРесурсов.Отклик = "Пинг: " + ?(Компьютеры.ОткликМс = Неопределено, "n/a",
		Формат(Компьютеры.ОткликМс, "ЧГ=;ЧДЦ=0;ЧН=0") + " мс");
	Совпадают = КомпьютерыСовпадают(Компьютеры.Сервер, Компьютеры.Клиент, Сведения.РежимРаботы.Файловая);
	Сервер = ?(Совпадают, СведенияСовпавшихКомпьютеров(Компьютеры.Сервер, Компьютеры.Клиент), Компьютеры.Сервер);
	ПанельРесурсов.Компьютеры.Добавить(ПанельКомпьютера(Сервер,
		?(Совпадают, "Клиент и сервер — один ПК", "Сервер")));
	Если Не Совпадают Тогда
		ПанельРесурсов.Компьютеры.Добавить(ПанельКомпьютера(Компьютеры.Клиент, "Клиент"));
	КонецЕсли;
	
	Возврат ПанельРесурсов;
	
КонецФункции

// Подготавливает начальные сведения приложения; конфигурация и платформа выделены полужирным.
//
// Параметры:
//  Сведения - Структура - готовые сведения приложения и компьютеров.
//
// Возвращаемое значение:
//  Массив из Структура - краткие строки приложения и конфигурации.
//   * Текст - Строка - готовая строка представления с начальным маркером.
//   * Группа - Строка - раздел системных сведений.
//   * ЭтоЗаголовок - Булево - строка выделяется как заголовок.
Функция НачальныеСистемныеСтроки(Сведения) Экспорт
	
	Строки = Новый Массив;
	Приложение = Сведения.Приложение;
	ДобавитьСистемнуюСтроку(Строки, "Заголовок приложения: " + Приложение.Заголовок, "СистемнаяИнформация");
	ДобавитьСистемнуюСтроку(Строки, "Конфигурация: " + Приложение.Конфигурация + " ("
		+ Приложение.ВерсияКонфигурации + ")", "СистемнаяИнформация", Истина);
	ДобавитьСистемнуюСтроку(Строки, "Платформа: " + Приложение.Платформа + " (" + Строка(Приложение.ТипПлатформы)
		+ ")", "СистемнаяИнформация", Истина);
	ДобавитьСистемнуюСтроку(Строки, "Приложение: " + Приложение.Клиент, "СистемнаяИнформация");
	ДобавитьСистемнуюСтроку(Строки, "Расположение: " + Приложение.Расположение, "СистемнаяИнформация");
	
	Возврат Строки;
	
КонецФункции

// Объединяет начальные и дополнительные строки в порядке печати.
//
// Параметры:
//  Сведения - Структура - готовые сведения приложения и компьютеров.
//
// Возвращаемое значение:
//  Массив из Структура - начальные и дополнительные строки в порядке печати; состав строки описан в
//   НачальныеСистемныеСтроки.
Функция СистемныеСтроки(Сведения) Экспорт
	
	Строки = НачальныеСистемныеСтроки(Сведения);
	
	Для Каждого СтрокаСведений Из ДополнительныеСистемныеСтроки(Сведения) Цикл
		Строки.Добавить(СтрокаСведений);
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

// #КонецОбласти

// #Область ПодготовкаПечати

// Возвращает готовые заголовки и текст отдельных сведений в порядке печати из общей схемы.
//
// Параметры:
//  Описания - Массив из Структура - разделы и колонки подготовленной схемы.
//  Сведения - Структура, Неопределено - дополнительные сведения; при отсутствии возвращается пустой массив.
//
// Возвращаемое значение:
//  Массив из Структура - готовые заголовки и тексты нетабличных дополнительных разделов.
//   * Заголовок - Строка - подпись раздела в печатном документе.
//   * Текст - Строка - готовое представление сведений.
//   * ИмяРаздела - Строка - ключ раздела общей схемы.
//   * ВидСтрокиПечати - Строка - вид оформления строки общей схемы.
Функция РазделыСведенийДляПечати(Описания, Сведения) Экспорт
	
	Разделы = Новый Массив;
	
	Если Сведения = Неопределено Тогда
		Возврат Разделы;
	КонецЕсли;
	
	Для Каждого Описание Из ОписанияВПорядкеПечати(Описания) Цикл
		Если Не Описание.ОтдельныеСведения Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = Неопределено;
		
		Если Сведения.Свойство(Описание.ИмяТаблицы, Данные) И Данные <> Неопределено Тогда
			Текст = ТекстРазделаСведений(Описание, Данные);
			Разделы.Добавить(НовыйРазделСведенийДляПечати(Описание, Текст));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Разделы;
	
КонецФункции

// Возвращает строки для табличного макета печати; порядок, подпись раздела и форматы взяты из схемы.
//
// Параметры:
//  Описания - Массив из Структура - разделы и колонки подготовленной схемы.
//  Данные - Соответствие - имя раздела и таблица из ДанныеТаблицДляПечати.
//
// Возвращаемое значение:
//  Массив из Структура - строки дополнительных таблиц в порядке общей схемы печати.
//   * КоллекцияОбъектовМетаданныхСиноним - Строка - заголовок раздела общей схемы.
//   * ИмяРаздела - Строка - ключ раздела общей схемы.
//   * ВидСтрокиПечати - Строка - вид оформления строки; остальные свойства взяты из колонок таблицы.
Функция ДополнительныеСтрокиДляПечати(Описания, Данные) Экспорт
	
	Строки = Новый Массив;
	
	Для Каждого Описание Из ОписанияВПорядкеПечати(Описания) Цикл
		Если Не Описание.ЭтоДополнительнаяТаблица Или Описание.ОтдельныеСведения Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица = Данные[Описание.ИмяТаблицы];
		
		Для Каждого СтрокаДанных Из Таблица Цикл
			Строки.Добавить(СтрокаДополнительнойТаблицыДляПечати(Описание, Таблица, СтрокаДанных));
		КонецЦикла;
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

// Возвращает таблицы по именам разделов; незаполненные разделы содержат пустые таблицы общей схемы.
//
// Параметры:
//  Описания - Массив из Структура - разделы и колонки подготовленной схемы.
//  Скан - Структура, Неопределено - основной снимок; см. МодульСнимкиСканирования.ОсновнойСнимокПубликации.
//  Сведения - Структура, Неопределено - опубликованные дополнительные разделы.
//  Кэш - Структура - кэш диагностики; см. ДанныеИнформационнойБазыИСистемы.ДанныеКэшаДиагностики.
//
// Возвращаемое значение:
//  Соответствие - ключ — ИмяТаблицы, значение — ТаблицаЗначений; незаполненным разделам соответствует пустая
//   таблица.
Функция ДанныеТаблицДляПечати(Описания, Скан, Сведения, Кэш) Экспорт
	
	Данные = Новый Соответствие;
	
	Для Каждого Описание Из Описания Цикл
		Таблица = ШаблонТаблицыПоДанным(Описание);
		
		Если Описание.ЭтоДополнительнаяТаблица И Сведения <> Неопределено Тогда
			ТаблицаРаздела = Неопределено;
			
			Если Сведения.Свойство(Описание.ИмяТаблицы, ТаблицаРаздела) И ТаблицаРаздела <> Неопределено Тогда
				Таблица = ТаблицаРаздела;
			КонецЕсли;
		КонецЕсли;
		
		Данные.Вставить(Описание.ИмяТаблицы, Таблица);
	КонецЦикла;
	
	Если Скан <> Неопределено И Скан.Свойство("ОсновныеДанные") Тогда
		Данные.Вставить("Сводная", ОсновныеДанныеДляПечати(Скан.ОсновныеДанные, Кэш));
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Возвращает режим работы базы и строки компьютеров; до сбора возвращает пустой массив.
//
// Параметры:
//  Сведения - Структура - готовые сведения приложения и компьютеров.
//
// Возвращаемое значение:
//  Массив из Структура - режим базы и строки компьютеров; состав строки описан в НачальныеСистемныеСтроки.
Функция ДополнительныеСистемныеСтроки(Сведения) Экспорт
	
	Строки = Новый Массив;
	
	Если Сведения.Компьютеры = Неопределено Тогда
		Возврат Строки;
	КонецЕсли;
	
	ДобавитьСистемнуюСтроку(Строки, СтрокаРежимаРаботы(Сведения.РежимРаботы), "СистемнаяИнформация");
	
	Для Каждого СтрокаСведений Из СтрокиСведенийКомпьютеров(Сведения.Компьютеры,
		Сведения.РежимРаботы.Каталог, Сведения.РежимРаботы.Файловая) Цикл
		Строки.Добавить(СтрокаСведений);
	КонецЦикла;
	
	Возврат Строки;
	
КонецФункции

// #КонецОбласти

// #Область ИдентификацияСборки

// Идентификатор совместимости основной обработки и исполнителей.
//
// Возвращаемое значение:
//  Строка - версия и отпечаток исходников для проверки совместимости исполнителей.
Функция ИдентификаторСборки() Экспорт
	
	Возврат "4.137_e9277ced5053957b345f";
	
КонецФункции

// #КонецОбласти

// #Область КонтекстПредставления

// Принимает возможности платформы и метаданных; самостоятельно их не читает.
//
// Параметры:
//  ДанныеВозможностей - Структура - доступность платформенных API и метаданных из ДоступКДанным.
Процедура Инициализировать(ДанныеВозможностей) Экспорт
	
	Возможности = ДанныеВозможностей;
	
КонецПроцедуры

// #КонецОбласти

// #Область ЗаголовкиПечати

// Формирует заголовок по дате печати и фактическому идентификатору базы.
//
// Параметры:
//  ДатаПечати - Дата - дата формирования документа.
//  ИдентификаторБазы - Строка - идентификатор, предоставленный конфигурацией, либо диагностика недоступности.
//
// Возвращаемое значение:
//  Строка - название, дата и идентификатор без фиксированного UUID.
Функция ЗаголовокПечатногоДокумента(ДатаПечати, ИдентификаторБазы) Экспорт
	
	Возврат "Данные ИБ и системы " + Формат(ДатаПечати, "ДФ=dd.MM.yyyy HH:mm:ss") + " " + ИдентификаторБазы;
	
КонецФункции

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область ПредставленияСистемныхСведений

Функция ПанельКомпьютера(Сведения, Роль)
	
	Компьютер = Новый Структура;
	Компьютер.Вставить("Роль", Роль);
	Компьютер.Вставить("Имя", ?(ПустаяСтрока(Сведения.Имя), "n/a", Сведения.Имя));
	Компьютер.Вставить("Виртуализация", ПредставлениеВиртуализацииКомпьютера(Сведения));
	Компьютер.Вставить("ВремяРаботы", ПредставлениеВремениРаботыКомпьютера(Сведения.ЧасовРаботыОС));
	Компьютер.Вставить("CPU", ПоказателиCPU(Сведения));
	Компьютер.Вставить("Память", ПоказательПамяти(Сведения));
	Компьютер.Вставить("Диски", ДискиПанелиРесурсов(Сведения));
	Компьютер.Вставить("ФизическиеДиски", ФизическиеДискиПанелиРесурсов(Сведения));
	Компьютер.Вставить("Подробности", ПодробностиПанелиРесурсов(Сведения));
	
	Возврат Компьютер;
	
КонецФункции

Функция ПредставлениеВиртуализацииКомпьютера(Сведения)
	
	Виртуализация = "";
	
	Если Не Сведения.Свойство("Виртуализация", Виртуализация) Или ПустаяСтрока(Виртуализация) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "Виртуальная машина · " + Виртуализация;
	
КонецФункции

Функция ПредставлениеВремениРаботыКомпьютера(Часы)
	
	Если Часы = Неопределено Или Часы = Null Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат "Работает " + Формат(?(Часы < 72, Часы, Часы / 24), "ЧГ=;ЧДЦ=1;ЧН=0")
		+ ?(Часы < 72, " ч", " дня");
	
КонецФункции

Функция ОбъемДискаПанели(Байты)
	
	Если Байты = Неопределено Или Байты = Null Тогда
		Возврат "n/a";
	КонецЕсли;
	
	Возврат Формат(Байты / 1073741824, ФорматСистемногоОбъема());
	
КонецФункции

Функция ФизическиеДискиПанелиРесурсов(Сведения)
	
	Диски = Новый ТаблицаЗначений;
	Диски.Колонки.Добавить("Модель");
	Диски.Колонки.Добавить("Объем");
	Для Каждого Диск Из Сведения.ФизическиеДиски Цикл
		Если ПустаяСтрока(Диск.Модель) И Диск.РазмерБайт = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДиска = Диски.Добавить();
		СтрокаДиска.Модель = ?(ПустаяСтрока(Диск.Модель), "n/a", Диск.Модель);
		СтрокаДиска.Объем = ОбъемДискаПанели(Диск.РазмерБайт);
	КонецЦикла;
	Диски.Сортировать("Модель Возр");
	
	Возврат Диски;
	
КонецФункции

Процедура ДобавитьПроцессорыПанелиРесурсов(Строки, Сведения)
	
	Номер = 0;
	ЕстьОписание = Ложь;
	Для Каждого Процессор Из Сведения.Процессоры Цикл
		Если Не ПустаяСтрока(Процессор.Модель) Тогда
			ЕстьОписание = Истина;
			Подпись = "Процессор" + ?(Сведения.Процессоры.Количество() > 1, Строка(Номер), "");
			ДобавитьСистемнуюСтроку(Строки, Подпись + ": " + Процессор.Модель
				+ "; ядер: " + Строка(Процессор.Ядер) + "; потоков: " + Строка(Процессор.Потоков), "");
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;
	Если Не ЕстьОписание И Не ПустаяСтрока(Сведения.Процессор) Тогда
		ДобавитьСистемнуюСтроку(Строки, "Процессор: " + Сведения.Процессор, "");
	КонецЕсли;
	
КонецПроцедуры

Функция ПоказателиCPU(Сведения)
	
	Показатели = Новый Массив;
	Для Каждого Процессор Из Сведения.Процессоры Цикл
		Процент = ПроцентПоказателя(Процессор.Загрузка);
		Показатели.Добавить(Новый Структура("Имя,Процент,Текст", Процессор.Имя, Процент,
			?(Процент = Неопределено, "n/a", Формат(Процент, "ЧГ=;ЧДЦ=0;ЧН=0") + "%")));
	КонецЦикла;
	Если Показатели.Количество() = 0 Тогда
		Показатели.Добавить(Новый Структура("Имя,Процент,Текст", "CPU", Неопределено, "n/a"));
	КонецЕсли;
	
	Возврат Показатели;
	
КонецФункции

Функция ПроцентПоказателя(Значение)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Макс(0, Мин(100, Значение));
	
КонецФункции

Функция ПоказательПамяти(Сведения)
	
	Показатель = Новый Структура("Процент,Текст,Подпись", Неопределено, "n/a", "");
	Всего = Сведения.ВсегоПамятиМБ;
	Свободно = Сведения.СвободноПамятиМБ;
	Если Всего <= 0 Или Свободно = Неопределено Тогда
		Показатель.Подпись = ?(Всего > 0, "Всего " + ОбъемМБВГБ(Всего),
			?(Свободно = Неопределено, "Объем памяти: n/a", "Свободно " + ОбъемМБВГБ(Свободно)));
		
		Возврат Показатель;
	КонецЕсли;
	
	Занято = Макс(0, Мин(Всего, Всего - Свободно));
	Показатель.Процент = Занято / Всего * 100;
	Показатель.Текст = Формат(Показатель.Процент, "ЧГ=;ЧДЦ=0;ЧН=0") + "%";
	Показатель.Подпись = Формат(Занято / 1024, ФорматСистемногоОбъема()) + " / "
		+ Формат(Всего / 1024, ФорматСистемногоОбъема()) + " Гб";
	
	Возврат Показатель;
	
КонецФункции

Функция ДискиПанелиРесурсов(Сведения)
	
	Диски = Новый Массив;
	Для Каждого Диск Из Сведения.ЛогическиеДиски Цикл
		Если ПустаяСтрока(Диск.Имя) И Диск.РазмерБайт = Неопределено И Диск.СвободноБайт = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Процент = Неопределено;
		Если Диск.РазмерБайт <> Неопределено И Диск.СвободноБайт <> Неопределено Тогда
			Если Диск.РазмерБайт > 0 Тогда
				Процент = ПроцентПоказателя((1 - Диск.СвободноБайт / Диск.РазмерБайт) * 100);
			КонецЕсли;
		КонецЕсли;
		
		Описание = Новый Структура;
		Описание.Вставить("Имя", ИмяЛокальногоДиска(Диск));
		Описание.Вставить("Процент", Процент);
		Описание.Вставить("Объем", ОбъемДискаПанели(Диск.СвободноБайт) + " / "
			+ ОбъемДискаПанели(Диск.РазмерБайт) + " Гб");
		Описание.Вставить("МалоСвободногоМеста", Процент <> Неопределено И Процент > 90);
		Описание.Вставить("Свободно", ?(Процент = Неопределено, "Свободное место: сведения неполные",
			"Свободно " + Формат(100 - Процент, "ЧГ=;ЧДЦ=1;ЧН=0") + "%"));
		Диски.Добавить(Описание);
	КонецЦикла;
	
	Возврат Диски;
	
КонецФункции

Функция ИмяЛокальногоДиска(Диск)
	
	Устройство = Неопределено;
	Если Не Диск.Свойство("Устройство", Устройство) Или ТипЗнч(Устройство) <> Тип("Строка") Тогда
		Возврат Диск.Имя;
	КонецЕсли;
	Если ПустаяСтрока(Устройство) Тогда
		Возврат Диск.Имя;
	КонецЕсли;
	Если Лев(Устройство, 5) = "/dev/" Тогда
		Устройство = Сред(Устройство, 6);
	КонецЕсли;
	
	Возврат Устройство;
	
КонецФункции

Функция ПодробностиПанелиРесурсов(Сведения)
	
	Строки = Новый Массив;
	Если Не ПустаяСтрока(Сведения.ОС) Тогда
		ДобавитьСистемнуюСтроку(Строки, Сведения.ОС, "", Истина);
	КонецЕсли;
	Если Сведения.ДатаЗапускаОС <> Неопределено Тогда
		ДобавитьСистемнуюСтроку(Строки, "ОС работает с "
			+ Формат(Сведения.ДатаЗапускаОС, "ДФ=dd.MM.yyyy HH:mm"), "");
	КонецЕсли;
	
	ДобавитьПроцессорыПанелиРесурсов(Строки, Сведения);
	ДобавитьСтрокиОборудования(Строки, Сведения, "", Ложь);
	Если Не ПустаяСтрока(Сведения.Диагностика) Тогда
		ДобавитьСистемнуюСтроку(Строки, Сведения.Диагностика, "");
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

Функция СтрокиСведенийКомпьютеров(Сведения, КаталогБазы = "", ФайловыйКонтекст = Ложь)
	
	Строки = Новый Массив;
	Пинг = ?(Сведения.ОткликМс = Неопределено, "n/a", Формат(Сведения.ОткликМс, "ЧДЦ=0;ЧГ=") + "мс");
	ДобавитьСистемнуюСтроку(Строки, "Пинг клиент-сервер: " + Пинг, "СистемнаяИнформация");
	Совпадают = КомпьютерыСовпадают(Сведения.Сервер, Сведения.Клиент, ФайловыйКонтекст);
	СведенияСервера = ?(Совпадают, СведенияСовпавшихКомпьютеров(Сведения.Сервер, Сведения.Клиент),
		Сведения.Сервер);
	ДобавитьСтрокиКомпьютера(Строки, СведенияСервера, ?(Совпадают, "Клиент и сервер — один ПК", "Сервер"),
		"СведенияСервера", КаталогБазы);
	Если Не Совпадают Тогда
		ДобавитьСтрокиКомпьютера(Строки, Сведения.Клиент, "Клиент", "СведенияКлиента");
	КонецЕсли;
	
	Возврат Строки;
	
КонецФункции

Функция КомпьютерыСовпадают(Сервер, Клиент, ФайловыйКонтекст = Ложь)
	
	Если ПустаяСтрока(Сервер.Имя) Или ПустаяСтрока(Клиент.Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ВРег(Сервер.Имя) <> ВРег(Клиент.Имя) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Сервер.Идентификатор) И Не ПустаяСтрока(Клиент.Идентификатор) Тогда
		Возврат ВРег(Сервер.Идентификатор) = ВРег(Клиент.Идентификатор);
	КонецЕсли;
	
	Возврат ФайловыйКонтекст;
	
КонецФункции

Функция СведенияСовпавшихКомпьютеров(Сервер, Клиент)
	
	Сведения = КопияСистемнойСтруктуры(Сервер);
	Если ПустаяСтрока(Сведения.ОС) Тогда
		Сведения.ОС = Клиент.ОС;
	КонецЕсли;
	
	Если ПустаяСтрока(Сведения.Платформа) Тогда
		Сведения.Платформа = Клиент.Платформа;
	КонецЕсли;
	
	Если ПустаяСтрока(Сведения.Процессор) Тогда
		Сведения.Процессор = Клиент.Процессор;
	КонецЕсли;
	
	Если Сведения.ДатаЗапускаОС = Неопределено Или Сведения.ДатаЗапускаОС = Null Тогда
		Сведения.ДатаЗапускаОС = Клиент.ДатаЗапускаОС;
	КонецЕсли;
	
	Если Сведения.ЧасовРаботыОС = Неопределено Или Сведения.ЧасовРаботыОС = Null Тогда
		Сведения.ЧасовРаботыОС = Клиент.ЧасовРаботыОС;
	КонецЕсли;
	
	Виртуализация = "";
	Сервер.Свойство("Виртуализация", Виртуализация);
	
	Если ПустаяСтрока(Виртуализация) Тогда
		Клиент.Свойство("Виртуализация", Виртуализация);
	КонецЕсли;
	
	Сведения.Вставить("Виртуализация", Виртуализация);
	ДополнитьПамятьСовпавшихКомпьютеров(Сведения, Клиент);
	Сведения.Процессоры = ДополненныеСведенияПроцессоров(Сервер.Процессоры, Клиент.Процессоры);
	Сведения.ЛогическиеДиски = ДополненныеСведенияОбъемов(Сервер.ЛогическиеДиски,
		Клиент.ЛогическиеДиски, "РазмерБайт", "СвободноБайт");
	Сведения.ФайлыПодкачки = ДополненныеСведенияОбъемов(Сервер.ФайлыПодкачки,
		Клиент.ФайлыПодкачки, "ВсегоМБ", "ЗанятоМБ");
	Если Сервер.ФизическиеДиски.Количество() = 0 Тогда
		Сведения.ФизическиеДиски = Клиент.ФизическиеДиски;
	КонецЕсли;
	
	Если Сервер.МатеринскиеПлаты.Количество() = 0 Тогда
		Сведения.МатеринскиеПлаты = Клиент.МатеринскиеПлаты;
	КонецЕсли;
	
	Сведения.Диагностика = ДиагностикаСовпавшихКомпьютеров(Сервер.Диагностика, Клиент.Диагностика);
	
	Возврат Сведения;
	
КонецФункции

Процедура ДополнитьПамятьСовпавшихКомпьютеров(Сведения, Клиент)
	
	Если Сведения.СвободноПамятиМБ = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если (Сведения.ВсегоПамятиМБ <= 0 Или Сведения.СвободноПамятиМБ = Неопределено)
		И Клиент.ВсегоПамятиМБ > 0 И Клиент.СвободноПамятиМБ <> Неопределено Тогда
		Сведения.ВсегоПамятиМБ = Клиент.ВсегоПамятиМБ;
		Сведения.СвободноПамятиМБ = Клиент.СвободноПамятиМБ;
	КонецЕсли;
	
КонецПроцедуры

Функция КопияСистемнойСтруктуры(Исходная)
	
	Копия = Новый Структура;
	Для Каждого Поле Из Исходная Цикл
		Копия.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	
	Возврат Копия;
	
КонецФункции

Функция СистемнаяСтрокаПоИмени(Строки, Имя)
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого СтрокаДанных Из Строки Цикл
		Если ВРег(СтрокаДанных.Имя) = ВРег(Имя) Тогда
			Возврат СтрокаДанных;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция КопияСистемныхСтрок(Исходные)
	
	Копия = Новый Массив;
	Для Каждого СтрокаДанных Из Исходные Цикл
		Копия.Добавить(КопияСистемнойСтруктуры(СтрокаДанных));
	КонецЦикла;
	
	Возврат Копия;
	
КонецФункции

Функция ДополненныеСведенияПроцессоров(Основные, Дополнительные)
	
	Результат = КопияСистемныхСтрок(Основные);
	Для Каждого Процессор Из Дополнительные Цикл
		Основной = СистемнаяСтрокаПоИмени(Результат, Процессор.Имя);
		Если Основной = Неопределено Тогда
			Результат.Добавить(КопияСистемнойСтруктуры(Процессор));
		Иначе
			Если Основной.Загрузка = Неопределено Тогда
				Основной.Загрузка = Процессор.Загрузка;
			КонецЕсли;
			
			Если ПустаяСтрока(Основной.Модель) Тогда
				Основной.Модель = Процессор.Модель;
			КонецЕсли;
			
			Если Основной.Ядер = Неопределено И Основной.Потоков = Неопределено Тогда
				Основной.Ядер = Процессор.Ядер;
				Основной.Потоков = Процессор.Потоков;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДополненныеСведенияОбъемов(Основные, Дополнительные, ИмяВсего, ИмяИзмерения)
	
	Результат = КопияСистемныхСтрок(Основные);
	Для Каждого Дополнительная Из Дополнительные Цикл
		Основная = СистемнаяСтрокаПоИмени(Результат, Дополнительная.Имя);
		Если Основная = Неопределено Тогда
			Результат.Добавить(КопияСистемнойСтруктуры(Дополнительная));
		ИначеЕсли Основная[ИмяИзмерения] <> 0
			И (Основная[ИмяВсего] = Неопределено Или Основная[ИмяИзмерения] = Неопределено)
			И Дополнительная[ИмяВсего] <> Неопределено И Дополнительная[ИмяИзмерения] <> Неопределено Тогда
			Основная[ИмяВсего] = Дополнительная[ИмяВсего];
			Основная[ИмяИзмерения] = Дополнительная[ИмяИзмерения];
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДиагностикаСовпавшихКомпьютеров(Сервер, Клиент)
	
	Если ПустаяСтрока(Сервер) Тогда
		Возврат Клиент;
	КонецЕсли;
	
	Если ПустаяСтрока(Клиент) Или Сервер = Клиент Тогда
		Возврат Сервер;
	КонецЕсли;
	
	Возврат "Сервер: " + Сервер + "; Клиент: " + Клиент;
	
КонецФункции

Процедура ДобавитьСтрокиКомпьютера(Строки, Сведения, РольКомпьютера, Группа, КаталогБазы = "")
	
	СтрокиКомпонентов = СтрокиКомпонентовКомпьютера(Сведения, Группа, КаталогБазы);
	Если ПустаяСтрока(Сведения.Имя) И СтрокиКомпонентов.Количество() = 0
		И ПустаяСтрока(Сведения.Диагностика) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСистемнуюСтроку(Строки, РольКомпьютера + ": " + ?(ПустаяСтрока(Сведения.Имя), "имя недоступно",
		Сведения.Имя), Группа, Истина);
	Для Каждого СтрокаКомпонента Из СтрокиКомпонентов Цикл
		Строки.Добавить(СтрокаКомпонента);
	КонецЦикла;
	
	Если Не ПустаяСтрока(Сведения.Диагностика) Тогда
		ДобавитьСистемнуюСтроку(Строки, Сведения.Диагностика, Группа);
	КонецЕсли;
	
КонецПроцедуры

Функция СтрокиКомпонентовКомпьютера(Сведения, Группа, КаталогБазы)
	
	Строки = Новый Массив;
	Виртуализация = ПредставлениеВиртуализацииКомпьютера(Сведения);
	
	Если Не ПустаяСтрока(Виртуализация) Тогда
		ДобавитьСистемнуюСтроку(Строки, Виртуализация, Группа);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Сведения.ОС) Тогда
		ДобавитьСистемнуюСтроку(Строки, "ОС: " + Сведения.ОС, Группа);
	КонецЕсли;
	
	Если Сведения.ДатаЗапускаОС <> Неопределено Тогда
		Текст = "ОС работает с " + Формат(Сведения.ДатаЗапускаОС, "ДФ=dd.MM.yyyy HH:mm");
		Если Сведения.ЧасовРаботыОС <> Неопределено Тогда
			Текст = Текст + " (около " + Формат(Сведения.ЧасовРаботыОС, "ЧДЦ=1") + " ч)";
		КонецЕсли;
		
		ДобавитьСистемнуюСтроку(Строки, Текст, Группа);
	КонецЕсли;
	
	ДобавитьСтрокиПроцессоров(Строки, Сведения, Группа);
	Память = СтрокаОперативнойПамяти(Сведения);
	Если Не ПустаяСтрока(Память) Тогда
		ДобавитьСистемнуюСтроку(Строки, Память, Группа);
	КонецЕсли;
	
	ДобавитьСтрокиДисков(Строки, Сведения, Группа, КаталогБазы);
	ДобавитьСтрокиОборудования(Строки, Сведения, Группа);
	
	Возврат Строки;
	
КонецФункции

Функция СтрокаОперативнойПамяти(Сведения)
	
	Всего = Сведения.ВсегоПамятиМБ;
	Свободно = Сведения.СвободноПамятиМБ;
	Если Всего <= 0 Тогда
		Если Свободно = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Возврат "Оперативная память: свободно " + ОбъемМБВГБ(Свободно) + "; общий объем недоступен";
	КонецЕсли;
	
	Если Свободно = Неопределено Тогда
		Возврат "Оперативная память: недоступно/" + Формат(Всего / 1024, ФорматСистемногоОбъема()) + " Гб";
	КонецЕсли;
	
	Занято = Макс(0, Мин(Всего, Всего - Свободно));
	
	Возврат "Оперативная память: " + Формат(Занято / 1024, ФорматСистемногоОбъема()) + "/"
	+ Формат(Всего / 1024, ФорматСистемногоОбъема()) + " Гб (" + Формат(Занято / Всего * 100, "ЧДЦ=0") + "%)";
	
КонецФункции

// #КонецОбласти

// #Область Форматы

Функция ФорматКоличестваТаблиц()
	
	Возврат "ЧГ=3,0;ЧРГ="" "";ЧДЦ=0;ЧН=0";
	
КонецФункции

Функция ФорматСистемногоОбъема()
	
	Возврат "ЧГ=;ЧДЦ=1;ЧН=0";
	
КонецФункции

// #КонецОбласти

// #Область ПредставленияПечати

Функция ОписанияВПорядкеПечати(Описания)
	
	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Порядок");
	Порядок.Колонки.Добавить("Описание");
	
	Для Каждого Описание Из Описания Цикл
		СтрокаПорядка = Порядок.Добавить();
		СтрокаПорядка.Порядок = Описание.ПорядокПечати;
		СтрокаПорядка.Описание = Описание;
	КонецЦикла;
	
	Порядок.Сортировать("Порядок");
	
	Возврат Порядок.ВыгрузитьКолонку("Описание");
	
КонецФункции

Функция ТекстРазделаСведений(Описание, Данные)
	
	Текст = "";
	Номер = 0;
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Номер = Номер + 1;
		СтрокаТекста = Формат(Номер, "ЧГ=;ЧН=0") + ") " + ТекстСтрокиСведений(Описание, СтрокаДанных);
		Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС) + СтрокаТекста;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ТекстСтрокиСведений(Описание, СтрокаДанных)
	
	Если Описание.ВидСтрокиПечати = "Библиотека" Тогда
		
		Возврат ТекстЗначенияКолонки(СтрокаДанных.Имя, "") + " "
			+ ТекстЗначенияКолонки(СтрокаДанных.Версия, "");
	ИначеЕсли Описание.ВидСтрокиПечати = "Расширение" Тогда
		Возврат ТекстРасширенияДляПечати(СтрокаДанных);
	ИначеЕсли Описание.ВидСтрокиПечати = "Организация" Тогда
		Возврат ТекстОрганизацииДляПечати(СтрокаДанных);
	КонецЕсли;
	
	Разделитель = ", ";
	
	Возврат ТекстПолейСведений(Описание, СтрокаДанных, Разделитель);
	
КонецФункции

Функция ТекстПолейСведений(Описание, СтрокаДанных, Разделитель)
	
	Текст = "";
	
	Для Каждого Колонка Из Описание.Колонки Цикл
		Если Не Колонка.Доступна Или Не Колонка.Видимость Тогда
			Продолжить;
		КонецЕсли;
		
		Значение = ТекстЗначенияКолонки(СтрокаДанных[Колонка.Имя], Колонка.Формат);
		
		Если Не ПустаяСтрока(Значение) Тогда
			Текст = Текст + ?(ПустаяСтрока(Текст), "", Разделитель) + Колонка.Заголовок + ": " + Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

Функция ТекстРасширенияДляПечати(СтрокаДанных)
	
	Активно = ТекстЗначенияКолонки(СтрокаДанных.Активно, "");
	Состояние = ?(Активно = "Да", "Активно", ?(Активно = "Нет", "Не активно", "Активность не определена"));
	Имя = ТекстЗначенияКолонки(СтрокаДанных.Имя, "");
	Версия = ТекстЗначенияКолонки(СтрокаДанных.Версия, "");
	Наименование = ТекстЗначенияКолонки(СтрокаДанных.Синоним, "");
	Текст = Состояние + ", " + Имя + ?(ПустаяСтрока(Версия), "", " " + Версия);
	
	Если Не ПустаяСтрока(Наименование) Тогда
		Текст = Текст + " (" + Наименование + ")";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ТекстОрганизацииДляПечати(СтрокаДанных)
	
	Наименование = ТекстЗначенияКолонки(СтрокаДанных.СокращенноеНаименование, "");
	
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = ТекстЗначенияКолонки(СтрокаДанных.Наименование, "");
	КонецЕсли;
	
	ИНН = ТекстЗначенияКолонки(СтрокаДанных.ИНН, "");
	КПП = ТекстЗначенияКолонки(СтрокаДанных.КПП, "");
	Реквизиты = ИНН + ?(ПустаяСтрока(КПП), "", ?(ПустаяСтрока(ИНН), "", "/") + КПП);
	Текст = Наименование + ?(ПустаяСтрока(Реквизиты), "", " " + Реквизиты);
	Вид = ТекстЗначенияКолонки(СтрокаДанных.ВидОрганизации, "");
	
	Если Не ПустаяСтрока(Вид) Тогда
		Текст = Текст + ", " + Вид;
	КонецЕсли;
	
	Префикс = ТекстЗначенияКолонки(СтрокаДанных.Префикс, "");
	
	Если Не ПустаяСтрока(Префикс) Тогда
		Текст = Текст + "; Префикс: " + Префикс;
	КонецЕсли;
	
	Возврат Текст + "; Документов: " + ТекстЗначенияКолонки(СтрокаДанных.КоличествоДокументов, "Количество");
	
КонецФункции

Функция НовыйРазделСведенийДляПечати(Описание, Текст)
	
	Раздел = Новый Структура;
	Раздел.Вставить("Заголовок", Описание.ЗаголовокПечати);
	Раздел.Вставить("Текст", Текст);
	Раздел.Вставить("ИмяРаздела", Описание.ИмяТаблицы);
	Раздел.Вставить("ВидСтрокиПечати", Описание.ВидСтрокиПечати);
	
	Возврат Раздел;
	
КонецФункции

Функция СтрокаДополнительнойТаблицыДляПечати(Описание, Таблица, СтрокаДанных)
	
	Результат = Новый Структура;
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Результат.Вставить(Колонка.Имя, СтрокаДанных[Колонка.Имя]);
	КонецЦикла;
	
	Результат.Вставить("КоллекцияОбъектовМетаданныхСиноним", Описание.ЗаголовокПечати);
	Результат.Вставить("ИмяРаздела", Описание.ИмяТаблицы);
	Результат.Вставить("ВидСтрокиПечати", Описание.ВидСтрокиПечати);
	
	Для Каждого Колонка Из Описание.Колонки Цикл
		Если Не ПустаяСтрока(Колонка.Формат)
			И (Колонка.Имя = "ОсновнойРесурс" Или Колонка.Формат = "Дата") Тогда
			Результат.Вставить(Колонка.Имя, ТекстЗначенияКолонки(СтрокаДанных[Колонка.Имя], Колонка.Формат));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗначенияКолонки(Значение, ВидФормата)
	
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат "";
	КонецЕсли;
	
	ФорматЗначения = ФорматКолонкиСхемы(ВидФормата);
	Текст = ?(ПустаяСтрока(ФорматЗначения), Строка(Значение), Формат(Значение, ФорматЗначения));
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ПС, " ");
	Текст = СтрЗаменить(Текст, Символы.ВК, " ");
	
	Возврат СокрЛП(Текст);
	
КонецФункции

Функция ОсновныеДанныеДляПечати(Данные, Кэш)
	
	Результат = Данные.Скопировать();
	Результат.Колонки.Добавить("ТаблицаСУБД");
	Результат.Колонки.Добавить("КоллекцияОбъектовМетаданныхСиноним");
	
	Для Каждого СтрокаДанных Из Результат Цикл
		Ключ = СтрокаДанных.КоллекцияОбъектовМетаданныхИмя + "." + СтрокаДанных.МетаданныеИмя;
		
		Если Кэш.Свойство("ИменаТаблиц") И Кэш.ИменаТаблиц <> Неопределено Тогда
			ИмяТаблицы = Кэш.ИменаТаблиц.Получить(Ключ);
			СтрокаДанных.ТаблицаСУБД = ?(ИмяТаблицы = Неопределено, "", ИмяТаблицы);
		КонецЕсли;
		
		СтрокаДанных.КоллекцияОбъектовМетаданныхСиноним = СтрокаДанных.КоллекцияМетаданныхСиноним;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область ОформлениеСистемныхДанных

Процедура ДобавитьСистемнуюСтроку(Строки, Текст, Группа, ЭтоЗаголовок = Ложь)
	
	Строки.Добавить(Новый Структура("Текст,Группа,ЭтоЗаголовок", "- " + Текст, Группа, ЭтоЗаголовок));
	
КонецПроцедуры

Процедура ДобавитьСтрокиПроцессоров(Строки, Сведения, Группа, ВыводитьЗагрузку = Истина)
	
	Модель = "";
	
	Для Каждого Процессор Из Сведения.Процессоры Цикл
		Если Не ПустаяСтрока(Процессор.Модель) Тогда
			Если Не ПустаяСтрока(Модель) Тогда
				Модель = Модель + "; ";
			КонецЕсли;
			
			Модель = Модель + Процессор.Модель + "; ядер: " + Строка(Процессор.Ядер) + "; потоков: "
			+ Строка(Процессор.Потоков);
		КонецЕсли;
	КонецЦикла;
	
	Модель = ?(ПустаяСтрока(Модель), Сведения.Процессор, Модель);
	Если Не ПустаяСтрока(Модель) Тогда
		ДобавитьСистемнуюСтроку(Строки, "Процессор: " + Модель, Группа);
	КонецЕсли;
	
	Если Не ВыводитьЗагрузку Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Процессор Из Сведения.Процессоры Цикл
		Если Процессор.Загрузка <> Неопределено Тогда
			ДобавитьСистемнуюСтроку(Строки, "Загрузка " + Процессор.Имя + ": " + Формат(Процессор.Загрузка,
				"ЧГ=;ЧДЦ=0;ЧН=0") + "%", Группа);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокиДисков(Строки, Сведения, Группа, КаталогБазы)
	
	Каталог = ВРег(СтрЗаменить(КаталогБазы, "/", "\"));
	Монтирование = ТочкаМонтированияБазыLinux(Сведения, КаталогБазы);
	
	Для Каждого Диск Из Сведения.ЛогическиеДиски Цикл
		Если ПустаяСтрока(Диск.Имя) И Диск.РазмерБайт = Неопределено И Диск.СвободноБайт = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Текст = "Диск " + Диск.Имя + " " + ПолосаЗанятостиДиска(Диск.РазмерБайт, Диск.СвободноБайт)
		+ " свободно " + ОбъемДискаГБ(Диск.СвободноБайт) + " из " + ОбъемДискаГБ(Диск.РазмерБайт);
		
		Если Диск.РазмерБайт <> Неопределено И Диск.СвободноБайт <> Неопределено Тогда
			Если Диск.РазмерБайт > 0 Тогда
				Текст = Текст + " (" + Формат(Диск.СвободноБайт / Диск.РазмерБайт * 100, "ЧДЦ=1") + "%)";
			КонецЕсли;
		КонецЕсли;
		
		Если (Сред(Каталог, 2, 2) = ":\" И Лев(Каталог, 2) = ВРег(Диск.Имя))
			Или (Не ПустаяСтрока(Монтирование) И Диск.Имя = Монтирование) Тогда
			Текст = Текст + " — база здесь";
		КонецЕсли;
		
		ДобавитьСистемнуюСтроку(Строки, Текст, Группа);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокиОборудования(Строки, Сведения, Группа, ВыводитьФизическиеДиски = Истина)
	
	Для Каждого Подкачка Из Сведения.ФайлыПодкачки Цикл
		Если ПустаяСтрока(Подкачка.Имя) И Подкачка.ЗанятоМБ = Неопределено И Подкачка.ВсегоМБ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСистемнуюСтроку(Строки, "Подкачка " + Подкачка.Имя + ": занято " + ОбъемМБВГБ(Подкачка.ЗанятоМБ)
			+ " из " + ОбъемМБВГБ(Подкачка.ВсегоМБ), Группа);
	КонецЦикла;
	
	Для Каждого Плата Из Сведения.МатеринскиеПлаты Цикл
		Модель = СокрЛП(Плата.Производитель + " " + Плата.Модель);
		Если Не ПустаяСтрока(Модель) Тогда
			ДобавитьСистемнуюСтроку(Строки, "Материнская плата: " + Модель, Группа);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ВыводитьФизическиеДиски Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Диск Из Сведения.ФизическиеДиски Цикл
		Если ПустаяСтрока(Диск.Модель) И Диск.РазмерБайт = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьСистемнуюСтроку(Строки, "Физический диск: " + Диск.Модель + " (" + ОбъемДискаГБ(Диск.РазмерБайт)
			+ ")", Группа);
	КонецЦикла;
	
КонецПроцедуры

Функция ОбъемМБВГБ(МБ)
	
	Возврат ?(МБ = Неопределено, "n/a", Формат(МБ / 1024, ФорматСистемногоОбъема()) + " Гб");
	
КонецФункции

Функция СтрокаРежимаРаботы(Сведения)
	
	Если Не Сведения.Файловая Тогда
		Возврат "Режим работы: клиент-серверный";
	КонецЕсли;
	
	Возврат "Режим работы: файловый; размер 1Cv8.1CD: "
	+ ?(Сведения.РазмерБайт = Неопределено, "n/a", Формат(Сведения.РазмерБайт / 1048576, "ЧДЦ=2") + " МБ");
	
КонецФункции

Функция ПолосаЗанятостиДиска(Размер, Свободно)
	
	Если Размер = Неопределено Или Свободно = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если Число(Размер) <= 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ДоляЗанятого = Макс(0, Мин(1, 1 - Число(Свободно) / Число(Размер)));
	Заполнено = Окр(ДоляЗанятого * 10, 0);
	Полоса = "";
	
	Для Номер = 1 По 10 Цикл
		Полоса = Полоса + ?(Номер <= Заполнено, "■", "□");
	КонецЦикла;
	
	Возврат Полоса;
	
КонецФункции

Функция ОбъемДискаГБ(Байты)
	
	Если Байты = Null Или Байты = Неопределено Тогда
		Возврат "n/a";
	КонецЕсли;
	
	Возврат Формат(Число(Байты) / 1073741824, ФорматСистемногоОбъема()) + " Гб";
	
КонецФункции

// #КонецОбласти

// #Область ФайловаяБазаНаLinux

Функция ТочкаМонтированияБазыLinux(Сведения, КаталогБазы)
	
	Точка = "";
	
	Если Лев(КаталогБазы, 1) = "/" Тогда
		Сведения.Свойство("ТочкаМонтированияБазы", Точка);
	КонецЕсли;
	
	Возврат Точка;
	
КонецФункции

