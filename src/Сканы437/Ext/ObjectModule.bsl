// Создает независимый пустой снимок основного сканирования.
//
// Возвращаемое значение:
//  Структура - дата, конфигурация, версия, база, описания отборов и пустая таблица строк снимка.
Функция НовыйСканОсновныхТаблиц()
	
	Скан = Новый Структура;
	Скан.Вставить("Дата", ТекущаяДата());
	Скан.Вставить("Конфигурация", Метаданные.Имя);
	Скан.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Скан.Вставить("База", СтрокаСоединенияИнформационнойБазы());
	Скан.Вставить("Отбор", "");
	Скан.Вставить("ОтборПечати", "");
	Скан.Вставить("Строки", НоваяТаблицаСтрокСкана());
	
	Возврат Скан;
	
КонецФункции

// Фиксирует параметры отбора вместе со снимком.
//
// Параметры:
//  Период - Структура, Неопределено - границы отбора; отсутствие означает весь период.
//  Организация - ЛюбаяСсылка, Неопределено - организация отбора; пустая ссылка отключает отбор.
//
// Возвращаемое значение:
//  Строка - отпечаток периода и организации для сопоставления сканов.
Функция ОписаниеОтборовСкана(Период, Организация)
	
	Результат = "Период: без отбора";
	
	Период = НормализованныйПериодОтбора(Период);
	Если ЗначениеЗаполнено(Период) Тогда
		Результат = "Период: " + Формат(Период.ДатаНачала, "ДФ=yyyyMMddHHmmss")
		+ " — " + Формат(Период.ДатаОкончания, "ДФ=yyyyMMddHHmmss");
	КонецЕсли;
	
	Результат = Результат + "; Организация: ";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Результат = Результат + Строка(Организация.УникальныйИдентификатор());
	Иначе
		Результат = Результат + "без отбора";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СоответствияПадежейИменКоллекцийМетаданных()
	
	Соответствия = Новый Соответствие;
	
	Соответствия.Вставить("ПланОбмена", "ПланыОбмена");
	Соответствия.Вставить("Справочник", "Справочники");
	Соответствия.Вставить("Документ", "Документы");
	Соответствия.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");
	Соответствия.Вставить("БизнесПроцесс", "БизнесПроцессы");
	Соответствия.Вставить("Задача", "Задачи");
	Соответствия.Вставить("РегистрСведений", "РегистрыСведений");
	Соответствия.Вставить("РегистрНакопления", "РегистрыНакопления");
	Соответствия.Вставить("РегистрБухгалтерии", "РегистрыБухгалтерии");
	Соответствия.Вставить("РегистрРасчета", "РегистрыРасчета");
	
	Соответствия.Вставить("ПланСчетов", "ПланыСчетов");
	Соответствия.Вставить("ПланВидовРасчета", "ПланыВидовРасчета");
	
	Возврат Соответствия;
	
КонецФункции

Функция ОписаниеТиповСтрока255()
	
	Возврат Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(255));
	
КонецФункции

// #КонецОбласти

// #Область СериализацияСканов

Процедура ЗаписатьСтрокуСканаВДокумент(Документ, НомерСтроки, Коллекция, Имя, Синоним, Количество)
	
	Документ.Область(НомерСтроки, 1).Текст = Коллекция;
	Документ.Область(НомерСтроки, 2).Текст = Имя;
	Документ.Область(НомерСтроки, 3).Текст = Синоним;
	Документ.Область(НомерСтроки, 4).Текст = Количество;
	
КонецПроцедуры

Процедура ПрочитатьСтрокиСкана(Документ, Начало, КоличествоСтрок, Строки)
	
	Ключи = Новый Соответствие;
	Коллекции = СоответствияПадежейИменКоллекцийМетаданных();
	
	Для Индекс = Начало По Начало + КоличествоСтрок - 1 Цикл
		СтрокаСкана = Строки.Добавить();
		СтрокаСкана.КоллекцияОбъектовМетаданныхИмя = Документ.Область(Индекс, 1).Текст;
		СтрокаСкана.МетаданныеИмя = Документ.Область(Индекс, 2).Текст;
		СтрокаСкана.МетаданныеСиноним = Документ.Область(Индекс, 3).Текст;
		СтрокаСкана.ОсновнойРесурс = НеотрицательноеЦелоеИзЯчейки(Документ.Область(Индекс, 4).Текст);
		
		Если Коллекции.Получить(СтрокаСкана.КоллекцияОбъектовМетаданныхИмя) = Неопределено
			Или ПустаяСтрока(СтрокаСкана.МетаданныеИмя) Тогда
			ВызватьИсключение НСтр("ru='Некорректный объект метаданных в строке '") + Строка(Индекс);
		КонецЕсли;
		
		Ключ = КлючСтрокиСкана(СтрокаСкана);
		
		Если Ключи.Получить(Ключ) <> Неопределено Тогда
			ВызватьИсключение НСтр("ru='Повторяющийся объект в файле скана: '") + Ключ;
		КонецЕсли;
		
		Ключи.Вставить(Ключ, Истина);
	КонецЦикла;
	
КонецПроцедуры

Функция НеотрицательноеЦелоеИзЯчейки(Текст)
	
	Если ПустаяСтрока(Текст) Или СтрДлина(Текст) > 15 Тогда
		ВызватьИсключение НСтр("ru='Некорректное число в файле скана.'");
	КонецЕсли;
	
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Найти("0123456789", Сред(Текст, Индекс, 1)) = 0 Тогда
			ВызватьИсключение НСтр("ru='Некорректное число в файле скана: '") + Текст;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Число(Текст);
	
КонецФункции

// #КонецОбласти

// #Область СлужебныеСведения

// Описывает зафиксированный отбор для заголовка печати.
//
// Параметры:
//  Период - Структура, Неопределено - границы отбора; отсутствие означает весь период.
//  Организация - ЛюбаяСсылка, Неопределено - организация отбора; пустая ссылка отключает отбор.
//
// Возвращаемое значение:
//  Строка - описание периода и организации либо пустая строка без отбора.
Функция ПредставлениеОтбораПечати(Период, Организация)
	
	Результат = "";
	
	Период = НормализованныйПериодОтбора(Период);
	Если ЗначениеЗаполнено(Период) Тогда
		Результат = "период";
		Если ЗначениеЗаполнено(Период.ДатаНачала) Тогда
			Результат = Результат + " с " + Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		Если Период.ДатаОкончания <> Дата('39991231235959') Тогда
			Результат = Результат + " по " + Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Результат = Результат + ?(ПустаяСтрока(Результат), "", "; ") + "организация: " + Строка(Организация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОтборХронологии(Скан)
	
	Период = Неопределено;
	Организация = Неопределено;
	Скан.Свойство("ПериодХронологии", Период);
	Скан.Свойство("ОрганизацияХронологии", Организация);
	
	Возврат Новый Структура("Период,Организация", Период, Организация);
	
КонецФункции

Процедура ДобавитьЗамерыСканаВДокумент(Документ, Скан)
	
	Замеры = Неопределено;
	
	Если Не Скан.Свойство("Замеры", Замеры) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДокумента = Документ.ВысотаТаблицы + 2;
	Документ.Область(СтрокаДокумента, 1).Имя = "ЗамерыСканирования_381";
	Документ.Область(СтрокаДокумента, 1).Текст = "Замеры сбора данных (мс)";
	
	Для Каждого Замер Из Замеры Цикл
		СтрокаДокумента = СтрокаДокумента + 1;
		Документ.Область(СтрокаДокумента, 1).Текст = Замер.Раздел;
		Документ.Область(СтрокаДокумента, 2).Текст = Формат(Замер.ДлительностьМс, "ЧГ=;ЧН=0");
		Документ.Область(СтрокаДокумента, 3).Текст = ?(Замер.Успех, "Успешно", "Ошибка");
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область СхемаТаблицИРесурсов

Функция ТекстЯчейкиСхемы(Макет, НомерСтроки, НомерКолонки)
	
	Адрес = "R" + Формат(НомерСтроки, "ЧГ=;ЧН=0") + "C" + Формат(НомерКолонки, "ЧГ=;ЧН=0");
	
	Возврат Макет.Область(Адрес).Текст;
	
КонецФункции

Функция ФлагЯчейкиСхемы(Макет, НомерСтроки, НомерКолонки)
	
	Значение = ТекстЯчейкиСхемы(Макет, НомерСтроки, НомерКолонки);
	
	Если Значение <> "" И Значение <> "+" Тогда
		ВызватьИсключение "Флаг схемы должен быть пустым или +: строка " + Строка(НомерСтроки)
			+ ", колонка " + Строка(НомерКолонки);
	КонецЕсли;
	
	Возврат Значение = "+";
	
КонецФункции

Функция ПорядокПечатиСхемы(Макет, НомерСтроки)
	
	Текст = ТекстЯчейкиСхемы(Макет, НомерСтроки, 15);
	
	Если ПустаяСтрока(Текст) Тогда
		ВызватьИсключение "Не задан порядок печати в строке схемы " + Строка(НомерСтроки);
	КонецЕсли;
	
	Попытка
		Порядок = Число(Текст);
	Исключение
		ВызватьИсключение "Нечисловой порядок печати в строке схемы " + Строка(НомерСтроки) + ", колонка 15";
	КонецПопытки;
	
	Возврат Порядок;
	
КонецФункции

Функция ОписаниеРазделаСхемы(Макет, НомерСтроки)
	
	Описание = Новый Структура;
	Описание.Вставить("ИмяТаблицы", ТекстЯчейкиСхемы(Макет, НомерСтроки, 2));
	Описание.Вставить("ИмяТаблицыМн", ТекстЯчейкиСхемы(Макет, НомерСтроки, 3));
	Описание.Вставить("СинонимТаблицы", ТекстЯчейкиСхемы(Макет, НомерСтроки, 4));
	Описание.Вставить("ЗаголовокСтраницы", ТекстЯчейкиСхемы(Макет, НомерСтроки, 5));
	Описание.Вставить("ЭтоДополнительнаяТаблица", ФлагЯчейкиСхемы(Макет, НомерСтроки, 6));
	Описание.Вставить("ОтдельныеСведения", ФлагЯчейкиСхемы(Макет, НомерСтроки, 7));
	Описание.Вставить("ИмяРеквизита", ТекстЯчейкиСхемы(Макет, НомерСтроки, 8));
	Описание.Вставить("УсловиеДоступности", ТекстЯчейкиСхемы(Макет, НомерСтроки, 9));
	Описание.Вставить("МетаданныеДоступности", ТекстЯчейкиСхемы(Макет, НомерСтроки, 10));
	Описание.Вставить("ВыборСтроки", ТекстЯчейкиСхемы(Макет, НомерСтроки, 11));
	Описание.Вставить("Сортировка", ТекстЯчейкиСхемы(Макет, НомерСтроки, 12));
	Описание.Вставить("Подвал", ФлагЯчейкиСхемы(Макет, НомерСтроки, 13));
	Описание.Вставить("ПоказыватьНоль", ФлагЯчейкиСхемы(Макет, НомерСтроки, 14));
	Описание.Вставить("ПорядокПечати", ПорядокПечатиСхемы(Макет, НомерСтроки));
	Описание.Вставить("ЗаголовокПечати", ТекстЯчейкиСхемы(Макет, НомерСтроки, 16));
	Описание.Вставить("ВидСтрокиПечати", ТекстЯчейкиСхемы(Макет, НомерСтроки, 17));
	Описание.Вставить("РесурсПроведен", Ложь);
	Описание.Вставить("РесурсПометкаУдаления", Ложь);
	Описание.Вставить("РесурсПредопределенный", Ложь);
	Описание.Вставить("Колонки", Новый Массив);
	Описание.Вставить("ДополнительныеРесурсы", НоваяТаблицаРесурсовСхемы());
	
	Возврат Описание;
	
КонецФункции

Функция ШиринаКолонкиСхемы(Макет, НомерСтроки)
	
	Текст = ТекстЯчейкиСхемы(Макет, НомерСтроки, 13);
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Попытка
		Ширина = Число(Текст);
	Исключение
		ВызватьИсключение "Нечисловая ширина в строке схемы " + Строка(НомерСтроки) + ", колонка 13";
	КонецПопытки;
	
	Возврат Ширина;
	
КонецФункции

Процедура ДобавитьКолонкуСхемы(Раздел, Макет, НомерСтроки)
	
	Если Раздел = Неопределено Тогда
		ВызватьИсключение "Колонка схемы указана до раздела.";
	КонецЕсли;
	
	Если Раздел.ИмяТаблицы <> ТекстЯчейкиСхемы(Макет, НомерСтроки, 2) Тогда
		ВызватьИсключение "Колонка схемы относится к другому разделу.";
	КонецЕсли;
	
	Колонка = Новый Структура;
	Колонка.Вставить("Имя", ТекстЯчейкиСхемы(Макет, НомерСтроки, 3));
	Колонка.Вставить("Заголовок", ТекстЯчейкиСхемы(Макет, НомерСтроки, 4));
	Колонка.Вставить("ВидТипа", ТекстЯчейкиСхемы(Макет, НомерСтроки, 5));
	Колонка.Вставить("УсловиеДоступности", ТекстЯчейкиСхемы(Макет, НомерСтроки, 6));
	Колонка.Вставить("Видимость", ФлагЯчейкиСхемы(Макет, НомерСтроки, 7));
	Колонка.Вставить("Формат", ТекстЯчейкиСхемы(Макет, НомерСтроки, 8));
	Колонка.Вставить("Полужирная", ФлагЯчейкиСхемы(Макет, НомерСтроки, 9));
	Колонка.Вставить("Цвет", ТекстЯчейкиСхемы(Макет, НомерСтроки, 10));
	Колонка.Вставить("Ресурс", ТекстЯчейкиСхемы(Макет, НомерСтроки, 11));
	Колонка.Вставить("Итог", ФлагЯчейкиСхемы(Макет, НомерСтроки, 12));
	Колонка.Вставить("Ширина", ШиринаКолонкиСхемы(Макет, НомерСтроки));
	Колонка.Вставить("Порядок", Раздел.Колонки.Количество());
	Раздел.Колонки.Добавить(Колонка);
	
	Если Не ПустаяСтрока(Колонка.Ресурс) Тогда
		Если Колонка.Ресурс <> "Проведен" И Колонка.Ресурс <> "ПометкаУдаления"
			И Колонка.Ресурс <> "Предопределенный" Тогда
			ВызватьИсключение "Неизвестный ресурс схемы в строке " + Строка(НомерСтроки) + ": " + Колонка.Ресурс;
		КонецЕсли;
		
		Раздел["Ресурс" + Колонка.Ресурс] = Истина;
		Ресурс = Раздел.ДополнительныеРесурсы.Добавить();
		Ресурс.Метаданные = Раздел.ИмяТаблицыМн;
		Ресурс.ИмяРесурса = Колонка.Имя;
		Ресурс.ЗначениеРесурса = Колонка.Ресурс;
	КонецЕсли;
	
КонецПроцедуры

Функция НоваяТаблицаРесурсовСхемы()
	
	Ресурсы = Новый ТаблицаЗначений;
	Ресурсы.Колонки.Добавить("Метаданные", ОписаниеТиповСтрока255());
	Ресурсы.Колонки.Добавить("ИмяРесурса", ОписаниеТиповСтрока255());
	Ресурсы.Колонки.Добавить("ЗначениеРесурса", ОписаниеТиповСтрока255());
	
	Возврат Ресурсы;
	
КонецФункции

// #КонецОбласти

// Нормализует границы отбора, не изменяя переданный период.
//
// Параметры:
//  ИсходныйПериод - СтандартныйПериод, Структура, Неопределено - границы ДатаНачала и ДатаОкончания.
//  ПроверятьГраницы - Булево - отклонить начало позже окончания.
//
// Возвращаемое значение:
//  - СтандартныйПериод - начало как задано, окончание в конце дня; пустой конец заменен верхней границей дат.
//  - Неопределено - обе даты не заданы.
Функция НормализованныйПериодОтбора(ИсходныйПериод, ПроверятьГраницы = Ложь)
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод.ДатаНачала)
		И Не ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Период = Новый СтандартныйПериод;
	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = ИсходныйПериод.ДатаНачала;
	
	Если ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Период.ДатаОкончания = КонецДня(ИсходныйПериод.ДатаОкончания);
	Иначе
		Период.ДатаОкончания = Дата('39991231235959');
	КонецЕсли;
	
	Если ПроверятьГраницы И Период.ДатаОкончания < Период.ДатаНачала Тогда
		ВызватьИсключение(
			НСтр("ru='Некорректный отбор по периоду. Дата начала не может быть больше даты окончания'"));
	КонецЕсли;
	
	Возврат Период;
	
КонецФункции

Функция СинонимКоллекцииПоСхеме(Коллекция, СхемаТаблиц)
	
	Если СхемаТаблиц <> Неопределено Тогда
		Для Каждого Раздел Из СхемаТаблиц Цикл
			Если Раздел.ИмяТаблицы = Коллекция Тогда
				Возврат Раздел.СинонимТаблицы;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Коллекция;
	
КонецФункции

// #КонецОбласти
