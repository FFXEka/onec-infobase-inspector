// Клиентский адаптер для платформы 8.3.6 и новее.

// #Область СлужебныйПрограммныйИнтерфейс

// #Область КлиентскийПрограммныйИнтерфейс

// Начинает передачу MXL пользователю; механизм завершения зависит от адаптера.
// Завершение или отмена сообщаются в СохранениеСканаЗавершено владельца.
//
// Параметры:
//  Адрес - Строка - адрес во временном хранилище; файловые адаптеры освобождают его по своему контракту.
//  ИмяФайла - Строка - предлагаемое имя сохраняемого файла MXL.
//  Владелец - УправляемаяФорма - форма, принимающая оповещение и владеющая временными данными.
&НаКлиенте
Процедура СохранитьСкан(Адрес, ИмяФайла, Владелец) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("СохранениеСканаЗавершено", Владелец, Адрес);
	Файлы = Новый Массив;
	Файлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла, Адрес));
	НачатьПолучениеФайлов(Оповещение, Файлы, , Истина);
	
КонецПроцедуры

