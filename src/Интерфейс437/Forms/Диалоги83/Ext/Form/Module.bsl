// Клиентский адаптер для платформы 8.3.3 и новее.

// #Область СлужебныеПроцедурыИФункции

// #Область КлиентскийПрограммныйИнтерфейс

// Показывает немодальное предупреждение средствами поддерживаемой платформы.
//
// Параметры:
//  Текст - Строка - сообщение, показываемое пользователю.
&НаКлиенте
Процедура Предупредить(Текст) Экспорт
	
	ПоказатьПредупреждение(Неопределено, Текст);
	
КонецПроцедуры

// Открывает форму и блокирует окно владельца через отдельный адаптер новой платформы.
//
// Параметры:
//  ПутьФормы - Строка - полное имя открываемой формы.
//  ПараметрыОкна - Структура - параметры открываемой формы.
//  Владелец - УправляемаяФорма - форма, принимающая оповещение и владеющая временными данными.
//  Уникальность - Произвольный - ключ уникальности открываемой формы.
&НаКлиенте
Процедура ОткрытьСБлокировкойВладельца(ПутьФормы, ПараметрыОкна, Владелец, Уникальность) Экспорт
	
	ОткрытьФорму(ПутьФормы, ПараметрыОкна, Владелец, Уникальность, , , ,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Открывает отдельный штатный список с уведомлением формы-инициатора о закрытии.
//
// Параметры:
//  ПутьФормы - Строка - полное имя открываемой формы.
//  Владелец - УправляемаяФорма - форма инициатора, принимающая оповещение о завершении.
//  КлючФормы - УникальныйИдентификатор - ключ отдельного списка и его временных пользовательских настроек.
//
// Возвращаемое значение:
//  УправляемаяФорма - отдельная форма списка с оповещением владельца о закрытии.
&НаКлиенте
Функция СтандартныйСписокСОповещением(ПутьФормы, Владелец, КлючФормы) Экспорт
	
	Оповещение = Новый ОписаниеОповещения("СтандартныйСписокЗакрыт", Владелец, КлючФормы);
	
	Возврат ОткрытьФорму(ПутьФормы, Новый Структура, Владелец, КлючФормы, , , Оповещение);
	
КонецФункции

// Отключает запись временного отбора и возвращает прежний режим сохранения списка.
//
// Параметры:
//  Список - ДинамическийСписок - штатный список с временным отбором.
//
// Возвращаемое значение:
//  Булево - прежний режим автоматического сохранения пользовательских настроек.
&НаКлиенте
Функция ОтключитьСохранениеНастроекСписка(Список) Экспорт
	
	РежимСохранения = Список.АвтоматическоеСохранениеПользовательскихНастроек;
	Список.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	
	Возврат РежимСохранения;
	
КонецФункции

// Возвращает режим сохранения после восстановления исходных пользовательских настроек.
//
// Параметры:
//  Список - ДинамическийСписок - штатный список после восстановления исходных пользовательских настроек.
//  РежимСохранения - Булево - исходное значение АвтоматическоеСохранениеПользовательскихНастроек.
&НаКлиенте
Процедура ВосстановитьСохранениеНастроекСписка(Список, РежимСохранения) Экспорт
	
	Список.АвтоматическоеСохранениеПользовательскихНастроек = РежимСохранения;
	
КонецПроцедуры

