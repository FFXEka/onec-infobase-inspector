// #Область ОписаниеПеременных

Перем КонтекстОтображения; // Структура, Неопределено - снимки и схемы одного вызова интерфейса.
Перем ИсполнительПредставленияДанных; // ВнешняяОбработкаОбъект, Неопределено - форматирование.
Перем ИсполнительСнимков; // ВнешняяОбработкаОбъект, Неопределено - сравнение снимков.
Перем Форма; // Форма, УправляемаяФорма, Неопределено - текущий получатель отображения.
Перем ТаблицыСканирования; // ТаблицаЗначений, Неопределено - план разделов из контекста.
Перем ТекущийСкан; // Структура, Неопределено - текущий снимок из контекста формы.
Перем СканДляСравнения; // Структура, Неопределено - эталонный снимок из контекста формы.
Перем ВерсияОбработки; // Строка - версия основной обработки для снимков и заголовков.

// #КонецОбласти

// #Область СлужебныйПрограммныйИнтерфейс

// Создает картинку из переданных двоичных данных анимации.
//
// Параметры:
//  ДанныеКартинки - ДвоичныеДанные - GIF с кадрами ожидания.
//
// Возвращаемое значение:
//  Картинка - анимация ожидания из встроенных двоичных данных.
Функция КартинкаОжидания(ДанныеКартинки) Экспорт
	
	Возврат Новый Картинка(ДанныеКартинки);
	
КонецФункции

// #Область КонтрактИОтображениеСканов

// Принимает форму, снимки и внедренные исполнители; чтение базы не выполняет.
//
// Параметры:
//  Контекст - Структура - снимок отображения; см. ДанныеИнформационнойБазыИСистемы.КонтекстИнтерфейса.
//  Представление - Форма, УправляемаяФорма - основная форма обработки.
//  ОбщиеПредставления - ВнешняяОбработкаОбъект - форматирование данных и возможности интерфейса.
//  СлужбаСканов - ВнешняяОбработкаОбъект - сопоставление снимков и заполнение сравнения.
Процедура Инициализировать(Контекст, Представление, ОбщиеПредставления, СлужбаСканов) Экспорт
	
	КонтекстОтображения = Контекст;
	Форма = Представление;
	ИсполнительПредставленияДанных = ОбщиеПредставления;
	ИсполнительСнимков = СлужбаСканов;
	ТаблицыСканирования = Контекст.Таблицы;
	ТекущийСкан = Контекст.ТекущийСкан;
	СканДляСравнения = Контекст.СканДляСравнения;
	ВерсияОбработки = Контекст.Версия;
	
КонецПроцедуры

// Передает построителю схему и создает элементы выбранного интерфейса.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - форма с элементами текущего интерфейса.
Процедура ИнициализироватьРеквизитыЭлементыКомандыФормы(ФормаПриложения) Экспорт
	
	УстановитьКонтекстФормы(ФормаПриложения);
	ДобавитьЭлементыКраткойИнформацииНаФорму();
	ДобавитьОсновныеДополнительныеТаблицыНаФорму();
	ДобавитьКомандыНаФорму();
	ДобавитьЭлементыОтбораНаФорму();
	НастроитьНадписьОтборов();
	
КонецПроцедуры

// Отображает уже собранные сведения о приложении и системе.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - форма с элементами текущего интерфейса.
Процедура ОбновитьКраткуюИнформацию(ФормаПриложения) Экспорт
	
	УстановитьКонтекстФормы(ФормаПриложения);
	
	ОбновитьСистемнуюИнформацию();
	ОбновитьНадписьОтборов();
	
КонецПроцедуры

// Обновляет только надпись текущих отборов без системных данных и схемы таблиц.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - форма с элементами текущего интерфейса.
//  Скан - Структура, Неопределено - опубликованный основной снимок; см.
//   МодульСнимкиСканирования.ОсновнойСнимокПубликации.
//  ДополнительныйСкан - Структура, Неопределено - опубликованные дополнительные сведения с отборами хронологии.
//  СлужбаСканов - ВнешняяОбработкаОбъект - исполнитель сопоставления снимков текущей сборки.
//  Представления - ВнешняяОбработкаОбъект - исполнитель формирования текста отборов текущей сборки.
Процедура ОбновитьОтборыФормы(ФормаПриложения, Скан, ДополнительныйСкан, СлужбаСканов, Представления) Экспорт
	
	Форма = ФормаПриложения;
	Состояние = СлужбаСканов.СостояниеОтборов(ПериодОтбораФормы(ФормаПриложения),
		ОрганизацияОтбораФормы(), Скан, ДополнительныйСкан);
	УстановитьЗначениеНадписиФормы("НадписьОтборов", Представления.ТекстОтборов(Состояние));
	
КонецПроцедуры

// Устанавливает заголовок формы с версией обработки.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - форма с элементами текущего интерфейса.
Процедура УстановитьЗаголовокФормы(ФормаПриложения) Экспорт
	
	ФормаПриложения.Заголовок = ИсполнительПредставленияДанных.СтрШаблонАдапт(НСтр("ru='%1 (v.%2)'"),
		КонтекстОтображения.Заголовок,
		ВерсияОбработки);
	
КонецПроцедуры

// #КонецОбласти

// #Область АдаптерыЭлементовФормы

// Собирает параметры открытия штатного списка по известным именам полей отбора.
//
// Параметры:
//  ОтборСписка - Структура - поля и значения периода и организации, подготовленные службой данных.
//
// Возвращаемое значение:
//  Структура - параметры открытия штатного списка по описанию полей отбора.
Функция ПараметрыСтандартногоСписка(ОтборСписка) Экспорт
	
	Отбор = Новый Структура;
	
	Если Не ПустаяСтрока(ОтборСписка.ПолеОрганизации)
		И ЗначениеЗаполнено(ОтборСписка.Организация) Тогда
		Отбор.Вставить(ОтборСписка.ПолеОрганизации, ОтборСписка.Организация);
	КонецЕсли;
	
	Параметры = Новый Структура;
	Параметры.Вставить("Отбор", Отбор);
	
	Если ОтборСписка.Период <> Неопределено Тогда
		Параметры.Вставить("Период", ОтборСписка.Период);
		Параметры.Вставить("ДатаНачала", ОтборСписка.Период.ДатаНачала);
		Параметры.Вставить("ДатаОкончания", ОтборСписка.Период.ДатаОкончания);
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Читает период из элементов формы и нормализует границы обычного интерфейса.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - форма с элементами текущего интерфейса.
//  ПроверятьГраницы - Булево - отклонять период, начало которого позже окончания.
//
// Возвращаемое значение:
//  - СтандартныйПериод - период из элементов формы; для обычного интерфейса границы приведены к началу и концу дня.
//  - Неопределено - значение отсутствует.
Функция ПериодОтбораФормы(ФормаПриложения, ПроверятьГраницы = Ложь) Экспорт
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Период = Новый Структура("ДатаНачала,ДатаОкончания",
		ФормаПриложения.ЭлементыФормы.ОтборПоПериодуДатаНачала.Значение,
		ФормаПриложения.ЭлементыФормы.ОтборПоПериодуДатаОкончания.Значение);
	
#Иначе
	
	Период = ФормаПриложения["ОтборПоПериоду"];
	
#КонецЕсли
	
	Возврат НормализованныйПериодОтбора(Период, ПроверятьГраницы);
	
КонецФункции

// Добавляет описание совместимости отборов для обычной формы универсального списка.
//
// Параметры:
//  ДанныеСписка - Структура - готовое описание списка и его отборов.
Процедура ПодготовитьОтборыУниверсальногоСписка(ДанныеСписка) Экспорт
	
	ДанныеСписка.ОтборСписка.Вставить("ТекстОграниченияОбычногоСписка",
		ТекстОграниченияОтбораОбычногоСписка(ДанныеСписка.ОтборСписка));
	
КонецПроцедуры

// Устанавливает отбор штатного списка обычного интерфейса по нейтральному описанию полей.
//
// Параметры:
//  Список - СправочникСписок, ДокументСписок, РегистрСведенийСписок, РегистрНакопленияСписок,
//   РегистрБухгалтерииСписок, РегистрРасчетаСписок, ПланВидовХарактеристикСписок, ПланСчетовСписок,
//   ПланВидовРасчетаСписок, ПланОбменаСписок, БизнесПроцессСписок, ЗадачаСписок, ЖурналДокументовСписок - источник
//   обычного списка с коллекцией Отбор.
//  ОтборСписка - Структура - поля и значения периода и организации, подготовленные службой данных.
Процедура УстановитьОтборОбычногоСписка(Список, ОтборСписка) Экспорт
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	СброситьПериод = Ложь;
	
	Если Не ПустаяСтрока(ОтборСписка.ПолеПериода) И ОтборСписка.Период <> Неопределено Тогда
		ЭлементОтбора = Список.Отбор[ОтборСписка.ПолеПериода];
		ЭлементОтбора.Использование = Истина;
		ЭлементОтбора.ВидСравнения = ВидСравнения.Интервал;
		ЭлементОтбора.ЗначениеС = ОтборСписка.Период.ДатаНачала;
		ЭлементОтбора.ЗначениеПо = ОтборСписка.Период.ДатаОкончания;
	ИначеЕсли Не ПустаяСтрока(ОтборСписка.ПолеПериода)
		И ОтборСписка.Свойство("СброситьПериод", СброситьПериод) И СброситьПериод Тогда
		ЭлементОтбора = Список.Отбор[ОтборСписка.ПолеПериода];
		ЭлементОтбора.Использование = Ложь;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстОграниченияОтбораОбычногоСписка(ОтборСписка)) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ПолеОрганизации Из ПоляОрганизацииОтбораСписка(ОтборСписка) Цикл
		ЭлементОтбора = Список.Отбор[ПолеОрганизации];
		
		Если ЗначениеЗаполнено(ОтборСписка.Организация) Тогда
			ЭлементОтбора.Установить(ОтборСписка.Организация);
		Иначе
			ЭлементОтбора.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;
	
#КонецЕсли
	
КонецПроцедуры

// Возвращает пользовательские настройки с видимыми отборами организации и периода регистра.
//
// Параметры:
//  ПользовательскиеНастройки - ПользовательскиеНастройкиКомпоновкиДанных - текущие настройки штатного списка.
//  ИдентификаторОтбора - Строка - путь доступного пользовательского отбора списка.
//  ОтборСписка - Структура - поля и значения периода и организации, подготовленные службой данных.
//
// Возвращаемое значение:
//  Структура - пользовательские настройки с временным отбором и исходными значениями для восстановления.
//   * Настройки - ПользовательскиеНастройкиКомпоновкиДанных - настройки с примененным временным отбором.
//   * ОтборУстановлен - Булево - установлен ли доступный пользовательский отбор.
//   * ИсходныеНастройки - ПользовательскиеНастройкиКомпоновкиДанных - копия для восстановления при закрытии.
Функция ПользовательскиеНастройкиСОтборомСписка(ПользовательскиеНастройки, ИдентификаторОтбора,
	ОтборСписка) Экспорт
	
	ХранилищеНастроек = Новый ХранилищеЗначения(ПользовательскиеНастройки);
	ИсходныеНастройки = ХранилищеНастроек.Получить();
	Результат = Новый Структура("Настройки,ОтборУстановлен", ПользовательскиеНастройки, Ложь);
	Результат.Вставить("ИсходныеНастройки", ИсходныеНастройки);
	
	Если ПустаяСтрока(ИдентификаторОтбора) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Отбор = ПользовательскиеНастройки.Элементы.Найти(ИдентификаторОтбора);
	Если Отбор = Неопределено Или ТипЗнч(Отбор) <> Тип("ОтборКомпоновкиДанных") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПоляОрганизации = ПоляОрганизацииОтбораСписка(ОтборСписка);
	Если ПоляОрганизации.Количество() > 0 И ЗначениеЗаполнено(ОтборСписка.Организация) Тогда
		Для Каждого ИмяПоля Из ПоляОрганизации Цикл
			УдалитьУсловияПользовательскогоОтбора(Отбор.Элементы, ИмяПоля);
		КонецЦикла;
		
		ОтборОрганизации = Отбор;
		Если ПоляОрганизации.Количество() > 1 Тогда
			ОтборОрганизации = Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ОтборОрганизации.Использование = Истина;
			ОтборОрганизации.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
			ОтборОрганизации.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		КонецЕсли;
		
		Для Каждого ИмяПоля Из ПоляОрганизации Цикл
			ДобавитьУсловиеПользовательскогоОтбора(ОтборОрганизации, ИмяПоля,
				ВидСравненияКомпоновкиДанных.Равно, ОтборСписка.Организация);
		КонецЦикла;
		Результат.ОтборУстановлен = Истина;
	КонецЕсли;
	
	Если (ОтборСписка.ПолеПериода = "Период" Или ОтборСписка.ПолеПериода = "ПериодРегистрации")
		И ОтборСписка.Период <> Неопределено Тогда
		УдалитьУсловияПользовательскогоОтбора(Отбор.Элементы, ОтборСписка.ПолеПериода);
		ДобавитьУсловиеПользовательскогоОтбора(Отбор, ОтборСписка.ПолеПериода,
			ВидСравненияКомпоновкиДанных.БольшеИлиРавно, ОтборСписка.Период.ДатаНачала);
		ДобавитьУсловиеПользовательскогоОтбора(Отбор, ОтборСписка.ПолеПериода,
			ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, ОтборСписка.Период.ДатаОкончания);
		Результат.ОтборУстановлен = Истина;
	КонецЕсли;
	
	Если Результат.ОтборУстановлен Тогда
		Отбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Отображает сопоставление текущего снимка с эталоном; эталон не перезаписывает.
Процедура ОбновитьСравнениеСканов() Экспорт
	
	Было = СканДляСравнения;
	Стало = ТекущийСкан;
	
	Если Было = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Сопоставимы = Стало <> Неопределено;
	
	ИндексБыло = ИсполнительСнимков.СтрокиСканаПоКлючам(Было);
	
	Для Каждого ОписаниеТаблицы Из ТаблицыСканирования Цикл
		Если ОписаниеТаблицы.Дополнительная Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = ТаблицаФормыДляИзменения(ОписаниеТаблицы.Имя);
		ИсполнительСнимков.УдалитьСтрокиТолькоДляСравнения(Данные);
		ИсполнительСнимков.ЗаполнитьСравнениеТаблицы(Данные, ИндексБыло, Сопоставимы);
		ИсполнительСнимков.ДобавитьОтсутствующиеСтрокиСкана(Данные, Было, ОписаниеТаблицы, Сопоставимы,
			КонтекстОтображения.ОписанияТаблиц);
		ЗагрузитьТаблицуДополнительногоСкана(ОписаниеТаблицы.Имя, Данные);
		ПоказатьКолонкиСравнения(ОписаниеТаблицы.Имя, Данные);
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область СистемныеСведенияИПросмотрДанных

// Отображает готовые начальные и дополнительные системные строки из контекста; сбор не запускает.
//
// Параметры:
//  ФормаПриложения - Форма - форма, в которой отображаются сведения.
Процедура ОбновитьСведенияКомпьютеров(ФормаПриложения) Экспорт
	
	УстановитьКонтекстФормы(ФормаПриложения);
	ОбновитьСистемнуюИнформацию();
	
КонецПроцедуры

// Обновляет строку константы после записи без повторного сканирования остальных таблиц.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - форма с элементами текущего интерфейса.
//  ИмяКонстанты - Строка - имя существующей константы в метаданных конфигурации.
//  Данные - Структура - Доступно и Значение; при недоступности строка не изменяется.
Процедура ОбновитьСтрокуКонстанты(ФормаПриложения, ИмяКонстанты, Данные) Экспорт
	
	УстановитьКонтекстФормы(ФормаПриложения);
	Строки = ТаблицаРаздела("Константы", Истина).НайтиСтроки(Новый Структура("МетаданныеИмя", ИмяКонстанты));
	
	Если Данные.Доступно Тогда
		Для Каждого СтрокаКонстанты Из Строки Цикл
			СтрокаКонстанты.ОсновнойРесурс = Строка(Данные.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

// Передает готовые данные построителю подробной формы выбранного интерфейса.
//
// Параметры:
//  ФормаПросмотра - Форма, УправляемаяФорма - форма подробного просмотра выбранного объекта.
//  Данные - Структура - описание объекта и его страниц; см. МодульАнализМетаданных.ДанныеОбъекта.
Процедура ПостроитьПодробныйПросмотр(ФормаПросмотра, Данные) Экспорт
	
	ПостроитьПросмотрОбъекта(ФормаПросмотра, Данные);
	
КонецПроцедуры

// #КонецОбласти

// #Область ДополнительныеСведенияИПубликация

// Заменяет основные таблицы готовым этапом, сохраняя дополнительные таблицы.
//
// Параметры:
//  Данные - ТаблицаЗначений - завершенные строки основного этапа; при ошибке отображения прежние строки
//   восстанавливаются.
Процедура ПрименитьОсновнойРезультат(Данные) Экспорт
	
	ПредыдущееСостояние = СостояниеОсновногоСкана();
	
	Попытка
		ЗагрузитьОсновныеСтрокиСкана(Данные);
		ОбновитьТекстыПодваловТаблиц();
		ОтсортироватьОсновныеТаблицы();
		ОбновитьСравнениеСканов();
		ЗаполнитьИменаТаблицСУБД();
	Исключение
		ВосстановитьОсновнойСкан(ПредыдущееСостояние);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Применяет успешные разделы и отмечает неудачные, сохраняя их прежние строки.
//
// Параметры:
//  Данные - Структура - результат дополнительных разделов; см.
//   МодульСканированиеТаблиц.ДополнительныйРезультатСеанса.
Процедура ПрименитьДополнительныйРезультат(Данные) Экспорт
	
	Резерв = Новый Соответствие;
	
	Для Каждого Описание Из КонтекстОтображения.ОписанияТаблиц Цикл
		Если Описание.ЭтоДополнительнаяТаблица И Не Описание.ОтдельныеСведения Тогда
			Резерв.Вставить(Описание.ИмяТаблицы, ТаблицаФормыДляИзменения(Описание.ИмяТаблицы));
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		ЗагрузитьДополнительныеСтрокиСкана(Данные);
		ПометитьНеобновленныеРазделы(Данные.ОшибкиРазделов, Данные.Сведения);
	Исключение
		Для Каждого Таблица Из Резерв Цикл
			ЗагрузитьТаблицуДополнительногоСкана(Таблица.Ключ, Таблица.Значение);
		КонецЦикла;
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область ИдентификацияСборки

// Идентификатор совместимости основной обработки и исполнителей.
//
// Возвращаемое значение:
//  Строка - версия и отпечаток исходников для проверки совместимости исполнителей.
Функция ИдентификаторСборки() Экспорт
	
	Возврат "4.137_e9277ced5053957b345f";
	
КонецФункции

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область КонтрактИОтображениеСканов

Функция СостояниеОсновногоСкана()
	
	СостоянияТаблиц = Новый Соответствие;
	
	Для Каждого Таблица Из ТаблицыСканирования Цикл
		Если Не Таблица.Дополнительная Тогда
			СостоянияТаблиц.Вставить(Таблица.Имя, СостояниеТаблицыСкана(Таблица.Имя));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("Таблицы, Снимок", СостоянияТаблиц, ТекущийСкан);
	
КонецФункции

Функция СостояниеТаблицыСкана(ИмяТаблицы)
	
	Данные = ТаблицаРаздела(ИмяТаблицы, Истина);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	КопияДанных = Данные.Скопировать();
	Счетчик = РеквизитФормы("Количество" + ИмяТаблицы).Значение;
#Иначе
	КопияДанных = Данные.Выгрузить();
	Счетчик = Форма["Количество" + ИмяТаблицы];
#КонецЕсли
	Колонки = СостояниеКолонокСкана(ИмяТаблицы, КопияДанных);
	
	Возврат Новый Структура("Данные, Счетчик, Колонки", КопияДанных, Счетчик, Колонки);
	
КонецФункции

Функция СостояниеКолонокСкана(ИмяТаблицы, Данные)
	
	Состояние = Новый Соответствие;
	
	Для Каждого ОписаниеКолонки Из Данные.Колонки Цикл
		Колонка = КолонкаФормы(ИмяТаблицы, ОписаниеКолонки.Имя);
		Состояние.Вставить(ОписаниеКолонки.Имя,
			Новый Структура("Видимость, ТекстПодвала", Колонка.Видимость, Колонка.ТекстПодвала));
	КонецЦикла;
	
	Возврат Состояние;
	
КонецФункции

Процедура ВосстановитьОсновнойСкан(Состояние)
	
	Для Каждого Таблица Из Состояние.Таблицы Цикл
		ВосстановитьТаблицуСкана(Таблица.Ключ, Таблица.Значение);
	КонецЦикла;
	
	ТекущийСкан = Состояние.Снимок;
	
КонецПроцедуры

Процедура ВосстановитьТаблицуСкана(ИмяТаблицы, Состояние)
	
	Данные = ТаблицаРаздела(ИмяТаблицы, Истина);
	Данные.Очистить();
	
	Для Каждого СтрокаДанных Из Состояние.Данные Цикл
		ЗаполнитьЗначенияСвойств(Данные.Добавить(), СтрокаДанных);
	КонецЦикла;
	
	УстановитьЗначениеСчетчикаТаблицы(ИмяТаблицы, Состояние.Счетчик);
	
	Для Каждого Настройка Из Состояние.Колонки Цикл
		Колонка = КолонкаФормы(ИмяТаблицы, Настройка.Ключ);
		Колонка.Видимость = Настройка.Значение.Видимость;
		Колонка.ТекстПодвала = Настройка.Значение.ТекстПодвала;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьОсновныеТаблицы()
	
	Для Каждого Таблица Из ТаблицыСканирования Цикл
		Если Таблица.Дополнительная Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаздела(Таблица.Имя, Истина).Очистить();
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьТекстыПодваловТаблиц()
	
	Для Каждого Описание Из КонтекстОтображения.ОписанияТаблиц Цикл
		Если Не Описание.Подвал Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = ТаблицаРаздела(Описание.ИмяТаблицы, Истина);
		
		Для Каждого Колонка Из Описание.Колонки Цикл
			Если Колонка.Доступна И Колонка.Итог Тогда
				ЭлементКолонки = КолонкаФормы(Описание.ИмяТаблицы, Колонка.Имя);
				ЭлементКолонки.ТекстПодвала = Данные.Итог(Колонка.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтсортироватьОсновныеТаблицы()
	
	Для Каждого Описание Из КонтекстОтображения.ОписанияТаблиц Цикл
		Если Описание.ЭтоДополнительнаяТаблица Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Описание.Сортировка) Тогда
			ТаблицаРаздела(Описание.ИмяТаблицы, Истина).Сортировать(Описание.Сортировка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтрокуТаблицы(Таблица, ДанныеЗаполнения, Ресурсы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	НоваяСтрока = Таблица.Значение.Добавить();
#Иначе
	
	НоваяСтрока = Таблица.Добавить();
#КонецЕсли
	
	НоваяСтрока.МетаданныеИмя = ДанныеЗаполнения.МетаданныеИмя;
	НоваяСтрока.МетаданныеСиноним = ДанныеЗаполнения.МетаданныеСиноним;
	НоваяСтрока.КоллекцияОбъектовМетаданныхИмя = ДанныеЗаполнения.КоллекцияМетаданныхИмя;
	
	Если Ресурсы = Неопределено Тогда
		
		НоваяСтрока.ОсновнойРесурс = ДанныеЗаполнения.ОсновнойРесурс;
		
	Иначе
		
		НоваяСтрока.ОсновнойРесурс = Ресурсы.Основной;
		
		Если Ресурсы.Доп1 > 0 Тогда
			НоваяСтрока.Ресурс1 = Ресурсы.Доп1;
		КонецЕсли;
		
		Если Ресурсы.Доп2 > 0 Тогда
			НоваяСтрока.Ресурс2 = Ресурсы.Доп2;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуСводнойТаблицы(Строка, Ресурсы)
	
	НоваяСтрока = ТаблицаРаздела("Сводная", Истина).Добавить();
	НоваяСтрока.КоллекцияОбъектовМетаданныхИмя = Строка.КоллекцияМетаданныхИмя;
	НоваяСтрока.КоллекцияОбъектовМетаданныхСиноним = Строка.КоллекцияМетаданныхСиноним;
	НоваяСтрока.МетаданныеИмя = Строка.МетаданныеИмя;
	НоваяСтрока.МетаданныеСиноним = Строка.МетаданныеСиноним;
	НоваяСтрока.ОсновнойРесурс = Ресурсы.Основной;
	
КонецПроцедуры

Процедура УстановитьЗначениеСчетчикаТаблицы(ИмяТаблицы, Значение)
	
	Описание = ОписаниеРазделаПоИмени(ИмяТаблицы);
	Заголовок = ИсполнительПредставленияДанных.ЗаголовокСтраницыТаблицы(
		Описание.ЗаголовокСтраницы, Значение, Описание.ПоказыватьНоль);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	РеквизитФормы("Количество" + ИмяТаблицы).Значение = Значение;
	ПанельСтраниц = ?(Описание.ЭтоДополнительнаяТаблица,
		Форма.ЭлементыФормы.СтраницыДополнительнойИнформации,
		Форма.ЭлементыФормы.СтраницыИнформации);
	ПанельСтраниц.Страницы[ИмяТаблицы].Заголовок = Заголовок;
#Иначе
	
	Форма["Количество" + ИмяТаблицы] = Значение;
	Форма.Элементы["Стр" + ИмяТаблицы].Заголовок = Заголовок;
#КонецЕсли
	
КонецПроцедуры

Процедура ОбновитьСистемнуюИнформацию()
	
	ДокументСведений = СистемныйДокументФормы();
	ДанныеПанели = КонтекстОтображения.ПанельСистемныхСведений;
	ШиринаПанели = ?(ДанныеПанели.Компьютеры.Количество() > 1, 100, 48);
	НастроитьДокументПанелиРесурсов(ДокументСведений, ШиринаПанели);
	ОтобразитьПриложениеПанелиРесурсов(ДокументСведений, ДанныеПанели, ШиринаПанели);
	Полосы = Новый Массив;
	ОтобразитьКомпьютерыПанелиРесурсов(ДокументСведений, ДанныеПанели.Компьютеры, Полосы, ШиринаПанели);
	ОтобразитьПолосыПанелиРесурсов(ДокументСведений, Полосы);
	
КонецПроцедуры

Процедура НастроитьДокументПанелиРесурсов(ДокументСведений, ШиринаПанели)
	
	ДокументСведений.Очистить();
	ДокументСведений.ТолькоПросмотр = Истина;
	ДокументСведений.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ДокументСведений.Защита = Ложь;
	ДокументСведений.ОтображатьСетку = Ложь;
	ДокументСведений.ОтображатьЗаголовки = Ложь;
	ДокументСведений.ОтображатьГруппировки = Ложь;
	ДокументСведений.Область(1, 1).ШиринаКолонки = 0.65;
	Область = ДокументСведений.Область(1, 2, 1, ШиринаПанели + 1);
	Область.ШиринаКолонки = 1.15;
	Область.Шрифт = Новый Шрифт("Segoe UI", 9);
	Область.ЦветТекста = Новый Цвет(48, 58, 70);
	Область.Защита = Истина;
	
КонецПроцедуры

Процедура ОтобразитьПриложениеПанелиРесурсов(Документ, Данные, ШиринаПанели)
	
	ПоследняяКолонка = ШиринаПанели + 1;
	НачалоОтклика = ШиринаПанели - Цел(ШиринаПанели * 0.18) + 2;
	НачалоРежима = ШиринаПанели - Цел(ШиринаПанели * 0.28) + 2;
	КонецРасположения = НачалоРежима - 3;
	СтрокаРежима = 4;
	Режим = СтрЗаменить(Данные.РежимРаботы, "Режим работы: ", "");
	Если ШиринаПанели = 48 И Найти(Режим, ";") > 0 Тогда
		НачалоРежима = 2;
		КонецРасположения = ПоследняяКолонка;
		СтрокаРежима = 5;
	КонецЕсли;
	
	ЗаписатьТекстПанелиРесурсов(Документ, 1, 2, ПоследняяКолонка, Данные.Заголовок, 10);
	ЗаписатьТекстПанелиРесурсов(Документ, 2, 2, НачалоОтклика - 3, Данные.Конфигурация, 8);
	ЗаписатьТекстПанелиРесурсов(Документ, 2, НачалоОтклика, ПоследняяКолонка, Данные.Отклик, 8);
	Документ.Область(2, НачалоОтклика).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ЗаписатьТекстПанелиРесурсов(Документ, 3, 2, ПоследняяКолонка, Данные.Платформа, 8);
	ЗаписатьТекстПанелиРесурсов(Документ, 4, 2, КонецРасположения, Данные.Расположение, 8);
	ЗаписатьТекстПанелиРесурсов(Документ, СтрокаРежима, НачалоРежима, ПоследняяКолонка, Режим, 8);
	Документ.Область(СтрокаРежима, НачалоРежима).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ОтобразитьРазделительПанелиРесурсов(Документ, 6, ШиринаПанели);
	
КонецПроцедуры

Процедура ОтобразитьКомпьютерыПанелиРесурсов(Документ, Компьютеры, Полосы, ШиринаПанели)
	
	ПерваяСтрока = 9;
	Разделы = Новый Массив;
	Разделы.Добавить("Показатели");
	Разделы.Добавить("ЛокальныеДиски");
	Разделы.Добавить("ФизическиеДиски");
	Разделы.Добавить("Оборудование");
	Для Каждого Раздел Из Разделы Цикл
		СледующаяСтрока = ПерваяСтрока;
		Для Индекс = 0 По Компьютеры.Количество() - 1 Цикл
			Слева = ?(Индекс = 0, 2, 54);
			Справа = Слева + 47;
			СтрокаКомпьютера = СтрокаДокументаПослеРазделаКомпьютера(
				Документ, Компьютеры[Индекс], Раздел, ПерваяСтрока, Слева, Справа, Полосы);
			СледующаяСтрока = Макс(СледующаяСтрока, СтрокаКомпьютера);
		КонецЦикла;
		ПерваяСтрока = СледующаяСтрока + 4;
	КонецЦикла;
	Если Компьютеры.Количество() > 0 Тогда
		Область = Документ.Область(7, 2, СледующаяСтрока, ШиринаПанели + 1);
		Область.АвтоВысотаСтроки = Ложь;
		Область.ВысотаСтроки = 3;
	КонецЕсли;
	
КонецПроцедуры

Функция СтрокаДокументаПослеРазделаКомпьютера(Документ, Компьютер, Раздел,
	Знач ПерваяСтрока, Слева, Справа, Полосы)
	
	Если Раздел = "Показатели" Тогда
		Возврат СтрокаДокументаПослеПоказателей(Документ, Компьютер, ПерваяСтрока, Слева, Справа, Полосы);
	ИначеЕсли Раздел = "ЛокальныеДиски" Тогда
		Возврат СтрокаДокументаПослеДисков(Документ, Компьютер, ПерваяСтрока, Слева, Справа, Полосы);
	ИначеЕсли Раздел = "ФизическиеДиски" Тогда
		Возврат СтрокаДокументаПослеФизическихДисков(Документ, Компьютер, ПерваяСтрока, Слева, Справа);
	КонецЕсли;
	
	Возврат СтрокаДокументаПослеПодробностей(Документ, Компьютер, ПерваяСтрока, Слева, Справа);
	
КонецФункции

Функция СтрокаДокументаПослеПоказателей(Документ, Компьютер, Знач СтрокаДокумента, Слева, Справа, Полосы)
	
	СтрокаДокумента = СтрокаПослеШапкиКомпьютераПанели(Документ, Компьютер, СтрокаДокумента, Слева, Справа);
	Середина = Слева + Цел((Справа - Слева + 1) / 2);
	СтрокаЦП = СтрокаПослеПроцессоровПанели(Документ, Компьютер.CPU,
		СтрокаДокумента, Слева, Середина - 2, Полосы);
	СтрокаПамяти = СтрокаПослеПамятиПанели(Документ, Компьютер.Память,
		СтрокаДокумента, Середина + 2, Справа, Полосы);
	
	Возврат Макс(СтрокаЦП, СтрокаПамяти);
	
КонецФункции

Функция СтрокаДокументаПослеДисков(Документ, Компьютер, Знач СтрокаДокумента, Слева, Справа, Полосы)
	
	ПерваяСтрока = СтрокаДокумента;
	СтрокаДокумента = СтрокаСеткиПослеТекстаПанелиРесурсов(
		Документ, СтрокаДокумента, Слева, Слева + 18, "Локальные диски") + 2;
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(Документ, ПерваяСтрока, СтрокаДокумента - 3,
		Слева + 20, Справа, "Свободно / всего · % свободно", 8);
	Документ.Область(ПерваяСтрока, Слева + 20).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ОформитьГраницуСтрокиПанели(Документ, СтрокаДокумента - 2, Слева, Справа);
	Для Каждого Диск Из Компьютер.Диски Цикл
		СтрокаДокумента = СтрокаДокументаПослеДиска(Документ, Диск, СтрокаДокумента, Слева, Справа, Полосы);
	КонецЦикла;
	Если Компьютер.Диски.Количество() = 0 Тогда
		СтрокаДокумента = СтрокаСеткиПослеТекстаПанелиРесурсов(
			Документ, СтрокаДокумента, Слева, Справа, "Сведения о локальных дисках не получены", 8);
	КонецЕсли;
	
	Возврат СтрокаДокумента;
	
КонецФункции

Функция СтрокаДокументаПослеДиска(Документ, Диск, Знач ПерваяСтрока, Слева, Справа, Полосы)
	
	ИмяДиска = Диск.Имя;
	ШиринаИмениДиска = Макс(4, Мин(16, СтрДлина(ИмяДиска) * 2));
	СлеваОтПолосы = Слева + ШиринаИмениДиска;
	Если СтрДлина(ИмяДиска) > 12 Тогда
		ПерваяСтрока = СтрокаСеткиПослеТекстаПанелиРесурсов(
			Документ, ПерваяСтрока, Слева, Справа, ИмяДиска);
		СлеваОтПолосы = Слева + 4;
	Иначе
		ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(
			Документ, ПерваяСтрока, ПерваяСтрока + 5, Слева, СлеваОтПолосы - 1, ИмяДиска);
	КонецЕсли;
	Подпись = СтрЗаменить(Диск.Свободно, "Свободно ", "");
	ВысотаПодписи = КоличествоСтрокСеткиПанелиРесурсов(Подпись, 8, 8);
	ПоследняяСтрока = ПерваяСтрока + Макс(6, ВысотаПодписи) - 1;
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(Документ, ПерваяСтрока, ПерваяСтрока + 3,
		СлеваОтПолосы, Справа - 8, Диск.Объем);
	Документ.Область(ПерваяСтрока, СлеваОтПолосы).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ДобавитьПолосуПанелиРесурсов(Документ, Полосы, ПерваяСтрока + 4, СлеваОтПолосы,
		Справа - 8, Диск.Процент, Диск.МалоСвободногоМеста);
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(
		Документ, ПерваяСтрока, ПоследняяСтрока, Справа - 7, Справа, Подпись, 8);
	ОбластьПодписи = Документ.Область(ПерваяСтрока, Справа - 7);
	ОбластьПодписи.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Если Диск.МалоСвободногоМеста Тогда
		ОбластьПодписи.ЦветТекста = Новый Цвет(205, 67, 72);
	КонецЕсли;
	ОформитьГраницуСтрокиПанели(Документ, ПоследняяСтрока + 1, Слева, Справа);
	
	Возврат ПоследняяСтрока + 3;
	
КонецФункции

Функция СтрокаДокументаПослеФизическихДисков(Документ, Компьютер, Знач СтрокаДокумента, Слева, Справа)
	
	СтрокаДокумента = СтрокаПослеЗаголовкаПанелиРесурсов(
		Документ, СтрокаДокумента, Слева, Справа, "Физические диски");
	Середина = Справа - 9;
	СтрокаДокумента = СтрокаПослеМоделиФизическогоДиска(Документ,
		СтрокаДокумента, Слева, Середина, Справа, "Модель", "Объём, Гб", Истина);
	Для Каждого Диск Из Компьютер.ФизическиеДиски Цикл
		СтрокаДокумента = СтрокаПослеМоделиФизическогоДиска(Документ,
			СтрокаДокумента, Слева, Середина, Справа, Диск.Модель, Диск.Объем);
	КонецЦикла;
	Если Компьютер.ФизическиеДиски.Количество() = 0 Тогда
		СтрокаДокумента = СтрокаСеткиПослеТекстаПанелиРесурсов(
			Документ, СтрокаДокумента, Слева, Справа, "Сведения о физических дисках не получены", 8);
	КонецЕсли;
	
	Возврат СтрокаДокумента;
	
КонецФункции

Функция СтрокаДокументаПослеПодробностей(Документ, Компьютер, Знач СтрокаДокумента, Слева, Справа)
	
	СтрокаДокумента = СтрокаПослеЗаголовкаПанелиРесурсов(
		Документ, СтрокаДокумента, Слева, Справа, "Оборудование и система");
	Для Каждого Подробность Из Компьютер.Подробности Цикл
		Текст = ТекстСистемнойСтрокиБезМаркера(Подробность.Текст);
		Если Подробность.ЭтоЗаголовок Тогда
			Текст = "ОС: " + Текст;
		КонецЕсли;
		СтрокаДокумента = СтрокаПослеОписанияОборудованияПанели(
			Документ, СтрокаДокумента, Слева, Справа, Текст) + 1;
	КонецЦикла;
	
	Возврат СтрокаДокумента;
	
КонецФункции

Функция СтрокаПослеЗаголовкаПанелиРесурсов(Документ, ПерваяСтрока, Слева, Справа, Текст)
	
	СледующаяСтрока = СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, ПерваяСтрока, Слева, Справа, Текст);
	ОформитьГраницуСтрокиПанели(Документ, СледующаяСтрока, Слева, Справа);
	
	Возврат СледующаяСтрока + 2;
	
КонецФункции

Функция СтрокаПослеШапкиКомпьютераПанели(Документ, Компьютер, Знач ПерваяСтрока, Слева, Справа)
	
	СледующаяСтрока = СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, ПерваяСтрока + 1,
		Слева + 1, Справа - 1, Компьютер.Роль + " " + Компьютер.Имя);
	СледующаяСтрока = СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, СледующаяСтрока,
		Слева + 1, Справа - 1, Компьютер.ВремяРаботы, 8);
	Виртуализация = "";
	Компьютер.Свойство("Виртуализация", Виртуализация);
	
	Если Не ПустаяСтрока(Виртуализация) Тогда
		СледующаяСтрока = СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, СледующаяСтрока,
			Слева + 1, Справа - 1, Виртуализация, 8);
	КонецЕсли;
	
	Область = Документ.Область(ПерваяСтрока, Слева, СледующаяСтрока, Справа);
	Область.ЦветФона = Новый Цвет(243, 246, 248);
	Документ.Область(ПерваяСтрока, Слева, ПерваяСтрока, Справа).ГраницаСверху =
		Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Область.ЦветРамки = Новый Цвет(77, 130, 172);
	
	Возврат СледующаяСтрока + 4;
	
КонецФункции

Функция СтрокаПослеПроцессоровПанели(Документ, Процессоры, Знач ПерваяСтрока, Слева, Справа, Полосы)
	
	ПерваяСтрока = СтрокаСеткиПослеТекстаПанелиРесурсов(
		Документ, ПерваяСтрока, Слева, Справа, "Загрузка процессоров", 8);
	Для Каждого Показатель Из Процессоры Цикл
		ПерваяСтрока = СтрокаПослеЗагрузкиПроцессораПанели(
			Документ, Показатель, ПерваяСтрока, Слева, Справа, Полосы);
	КонецЦикла;
	
	Возврат ПерваяСтрока;
	
КонецФункции

Функция СтрокаПослеЗагрузкиПроцессораПанели(Документ, Показатель, ПерваяСтрока, Слева, Справа, Полосы)
	
	ПоследняяСтрока = ПерваяСтрока + Макс(КоличествоСтрокСеткиПанелиРесурсов(Показатель.Имя, 6),
		КоличествоСтрокСеткиПанелиРесурсов(Показатель.Текст, Справа - Слева - 5)) - 1;
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(
		Документ, ПерваяСтрока, ПоследняяСтрока, Слева, Слева + 5, Показатель.Имя);
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(
		Документ, ПерваяСтрока, ПоследняяСтрока, Слева + 6, Справа, Показатель.Текст);
	Документ.Область(ПерваяСтрока, Слева + 6).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ДобавитьПолосуПанелиРесурсов(Документ, Полосы, ПоследняяСтрока + 1, Слева, Справа, Показатель.Процент);
	
	Возврат ПоследняяСтрока + 3;
	
КонецФункции

Функция СтрокаПослеПамятиПанели(Документ, Память, ПерваяСтрока, Слева, Справа, Полосы)
	
	СтрокаДокумента = СтрокаСеткиПослеТекстаПанелиРесурсов(
		Документ, ПерваяСтрока, Слева, Справа, "Оперативная память", 8);
	СтрокаОбъема = СтрокаДокумента;
	СтрокаДокумента = СтрокаСеткиПослеТекстаПанелиРесурсов(
		Документ, СтрокаОбъема, Слева, Справа, Память.Подпись);
	Документ.Область(СтрокаОбъема, Слева).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	ДобавитьПолосуПанелиРесурсов(Документ, Полосы, СтрокаДокумента, Слева, Справа, Память.Процент);
	Подпись = ?(Память.Процент = Неопределено, "Занято: n/a", "Занято " + Память.Текст);
	
	Возврат СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, СтрокаДокумента + 2, Слева, Справа, Подпись, 8);
	
КонецФункции

Функция СтрокаПослеМоделиФизическогоДиска(Документ, ПерваяСтрока, Слева, Середина, Справа,
	Модель, Объем, Заголовок = Ложь)
	
	Шрифт = ?(Заголовок, 8, 9);
	ПоследняяСтрока = ПерваяСтрока + Макс(КоличествоСтрокСеткиПанелиРесурсов(Модель, Середина - Слева, Шрифт),
		КоличествоСтрокСеткиПанелиРесурсов(Объем, Справа - Середина + 1, Шрифт)) - 1;
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(
		Документ, ПерваяСтрока, ПоследняяСтрока, Слева, Середина - 1, Модель, Шрифт);
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(
		Документ, ПерваяСтрока, ПоследняяСтрока, Середина, Справа, Объем, Шрифт);
	Документ.Область(ПерваяСтрока, Середина).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Право;
	Если Заголовок Тогда
		Документ.Область(ПерваяСтрока, Слева, ПоследняяСтрока + 1, Справа).ЦветФона = Новый Цвет(243, 246, 248);
	КонецЕсли;
	ОформитьГраницуСтрокиПанели(Документ, ПоследняяСтрока + 1, Слева, Справа);
	
	Возврат ПоследняяСтрока + 3;
	
КонецФункции

Функция СтрокаПослеОписанияОборудованияПанели(Документ, ПерваяСтрока, Слева, Справа, Текст)
	
	Разделитель = Найти(Текст, "; ядер:");
	Если Лев(Текст, 9) = "Процессор" И Разделитель > 0 Тогда
		СтрокаДокумента = СтрокаСеткиПослеТекстаПанелиРесурсов(
			Документ, ПерваяСтрока, Слева, Справа, Лев(Текст, Разделитель - 1));
		
		Возврат СтрокаСеткиПослеТекстаПанелиРесурсов(
			Документ, СтрокаДокумента, Слева, Справа, Сред(Текст, Разделитель + 2), 8);
	КонецЕсли;
	РазмерШрифта = ?(Лев(Текст, 14) = "ОС работает с ", 8, 9);
	Текст = СтрЗаменить(Текст, "ОС работает с ", "Запущена ");
	
	Возврат СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, ПерваяСтрока, Слева, Справа, Текст, РазмерШрифта);
	
КонецФункции

Процедура ОформитьГраницуСтрокиПанели(Документ, НомерСтроки, Слева, Справа)
	
	Область = Документ.Область(НомерСтроки, Слева, НомерСтроки, Справа);
	Область.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Область.ЦветРамки = Новый Цвет(219, 226, 233);
	
КонецПроцедуры

Функция СтрокаСеткиПослеТекстаПанелиРесурсов(Документ, ПерваяСтрока, Слева, Справа,
	Текст, РазмерШрифта = 9, Жирный = Ложь)
	
	КоличествоСтрок = КоличествоСтрокСеткиПанелиРесурсов(Текст, Справа - Слева + 1, РазмерШрифта, Жирный);
	ПоследняяСтрока = ПерваяСтрока + КоличествоСтрок - 1;
	ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(Документ, ПерваяСтрока, ПоследняяСтрока,
		Слева, Справа, Текст, РазмерШрифта, Жирный);
	
	Возврат ПоследняяСтрока + 1;
	
КонецФункции

Функция КоличествоСтрокСеткиПанелиРесурсов(Текст, Ширина, РазмерШрифта = 9, Жирный = Ложь)
	
	ДокументИзмерения = Новый ТабличныйДокумент;
	ДокументИзмерения.Область(1, 1, 1, Ширина).ШиринаКолонки = 1.15;
	ЗаписатьТекстПанелиРесурсов(ДокументИзмерения, 1, 1, Ширина, Текст, РазмерШрифта, Жирный);
	Измеритель = ДокументИзмерения.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
	Измеритель.Расположить(ДокументИзмерения.Область(1, 1, 1, Ширина));
	ВысотаВСтроках = Измеритель.Высота * 72 / 25.4 / 3;
	КоличествоСтрок = Цел(ВысотаВСтроках);
	Если КоличествоСтрок < ВысотаВСтроках Тогда
		КоличествоСтрок = КоличествоСтрок + 1;
	КонецЕсли;
	
	Возврат Макс(1, КоличествоСтрок);
	
КонецФункции

Процедура ЗаписатьТекстВСтрокиСеткиПанелиРесурсов(Документ, ПерваяСтрока, ПоследняяСтрока,
	Слева, Справа, Текст, РазмерШрифта = 9, Жирный = Ложь)
	
	Область = Документ.Область(ПерваяСтрока, Слева, ПоследняяСтрока, Справа);
	Область.Объединить();
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт("Segoe UI", РазмерШрифта, Жирный);
	Область.ЦветТекста = ?(РазмерШрифта < 9, Новый Цвет(96, 112, 128), Новый Цвет(48, 58, 70));
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
	Область.Защита = Истина;
	
КонецПроцедуры

Процедура ЗаписатьТекстПанелиРесурсов(Документ, НомерСтроки, Слева, Справа, Текст, РазмерШрифта = 9, Жирный = Ложь)
	
	Область = Документ.Область(НомерСтроки, Слева, НомерСтроки, Справа);
	Область.Объединить();
	Область.Текст = Текст;
	Область.Шрифт = Новый Шрифт("Segoe UI", РазмерШрифта, Жирный);
	Область.ЦветТекста = ?(РазмерШрифта < 9, Новый Цвет(96, 112, 128), Новый Цвет(48, 58, 70));
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.ВысотаСтроки = 0;
	Область.АвтоВысотаСтроки = Истина;
	Область.Защита = Истина;
	
КонецПроцедуры

Процедура ДобавитьПолосуПанелиРесурсов(Документ, Полосы, НомерСтроки, Слева, Справа, Процент, Предупреждение = Ложь)
	
	Область = Документ.Область(НомерСтроки, Слева, НомерСтроки, Справа);
	Область.АвтоВысотаСтроки = Ложь;
	Полоса = Новый Структура;
	Полоса.Вставить("Строка", НомерСтроки);
	Полоса.Вставить("Слева", Слева);
	Полоса.Вставить("Справа", Справа);
	Полоса.Вставить("Процент", Процент);
	Полоса.Вставить("Предупреждение", Предупреждение);
	Полосы.Добавить(Полоса);
	
КонецПроцедуры

Процедура ОтобразитьПолосыПанелиРесурсов(Документ, Полосы)
	
	Для Каждого Полоса Из Полосы Цикл
		Область = Документ.Область(Полоса.Строка, Полоса.Слева, Полоса.Строка, Полоса.Справа);
		Фон = ПрямоугольникПолосыПанелиРесурсов(Документ, Область, Новый Цвет(231, 237, 242));
		Если Полоса.Процент <> Неопределено И Полоса.Процент > 0 Тогда
			ЦветПолосы = ?(Полоса.Предупреждение, Новый Цвет(205, 67, 72), Новый Цвет(77, 130, 172));
			Заполнение = ПрямоугольникПолосыПанелиРесурсов(Документ, Область, ЦветПолосы);
			Заполнение.Ширина = Фон.Ширина * Полоса.Процент / 100;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПрямоугольникПолосыПанелиРесурсов(Документ, Область, Цвет)
	
	Прямоугольник = Документ.Рисунки.Добавить(ТипРисункаТабличногоДокумента.Прямоугольник);
	Прямоугольник.Расположить(Область);
	Прямоугольник.Высота = 1.0;
	Прямоугольник.ЦветФона = Цвет;
	Прямоугольник.ЦветЛинии = Цвет;
	Прямоугольник.Защита = Истина;
	
	Возврат Прямоугольник;
	
КонецФункции

Процедура ОтобразитьРазделительПанелиРесурсов(Документ, НомерСтроки, ШиринаПанели)
	
	Область = Документ.Область(НомерСтроки, 2, НомерСтроки, ШиринаПанели + 1);
	Область.ЦветФона = Новый Цвет(220, 226, 231);
	Область.АвтоВысотаСтроки = Ложь;
	Область.ВысотаСтроки = 1;
	
КонецПроцедуры

Функция ТекстСистемнойСтрокиБезМаркера(Текст)
	
	Если Лев(Текст, 2) = "- " Тогда
		Возврат Сред(Текст, 3);
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// #КонецОбласти

// #Область ПостроениеГлавнойФормы

Процедура ДобавитьТаблицуНаФорму(ДанныеТаблицы)
	
	ШаблонТаблицы = ИсполнительПредставленияДанных.ШаблонТаблицыПоДанным(ДанныеТаблицы);
	ДобавитьРеквизитыТаблицы(ШаблонТаблицы, ДанныеТаблицы);
	
	Если Не ДанныеТаблицы.ОтдельныеСведения Тогда
		ДобавитьРеквизитСчетчик(ДанныеТаблицы);
	КонецЕсли;
	
	СтраницаФормы = СтраницаФормыРаздела(ДанныеТаблицы);
	ТаблицаФормы = ТаблицаФормыРаздела(ДанныеТаблицы, ШаблонТаблицы);
	ДобавитьКолонкиТаблицы(ДанныеТаблицы, ТаблицаФормы);
	
	Если ДанныеТаблицы.ВыборСтроки = "Константа" Тогда
		УстановитьВыборКонстанты(ТаблицаФормы);
	ИначеЕсли Не ПустаяСтрока(ДанныеТаблицы.ВыборСтроки) Тогда
		УстановитьВыборСтроки(ТаблицаФормы);
	КонецЕсли;
	
	СтраницаФормы.Видимость = ИсполнительПредставленияДанных.ЕстьМетаданныеСтраницы(ДанныеТаблицы);
	
	Если Не РазделПоддерживается(ДанныеТаблицы.ИмяТаблицы) Тогда
		ТаблицаФормы.Видимость = Ложь;
		СтраницаФормы.Видимость = Истина;
		ПоказатьНедоступностьРаздела(ДанныеТаблицы);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРеквизитыТаблицы(ШаблонТаблицы, ДанныеТаблицы)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	
	МассивРеквизитов = Новый Массив;
	
	Для Каждого Колонка Из ШаблонТаблицы.Колонки Цикл
		МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя,
			Колонка.ТипЗначения,
			ДанныеТаблицы.ИмяРеквизита));
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(МассивРеквизитов);
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьРеквизитСчетчик(ДанныеТаблицы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	НовыйСчетчик = Форма.ЭлементыФормы["Количество" + ДанныеТаблицы.ИмяТаблицы];
	НовыйСчетчик.ТипЗначения = ИсполнительСнимков.ОписаниеТиповЧисло150();
#Иначе
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы("Количество" + ДанныеТаблицы.ИмяТаблицы,
		ИсполнительСнимков.ОписаниеТиповЧисло150());
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
#КонецЕсли
	
КонецПроцедуры

Функция РазделПоддерживается(ИмяРаздела)
	
	ВозможностиРазделов = Неопределено;
	
	Если Не КонтекстОтображения.Возможности.Свойство("ВозможностиРазделов", ВозможностиРазделов) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Поддерживается = ВозможностиРазделов.Получить(ИмяРаздела);
	
	Возврат Поддерживается <> Ложь;
	
КонецФункции

Процедура ПоказатьНедоступностьРаздела(ДанныеТаблицы)
	
	ИмяНадписи = "Недоступность" + ДанныеТаблицы.ИмяТаблицы;
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Надпись = Форма.ЭлементыФормы[ИмяНадписи];
	Надпись.Видимость = Истина;
#Иначе
	Надпись = Форма.Элементы[ИмяНадписи];
	Надпись.Видимость = Истина;
#КонецЕсли
	Надпись.Заголовок = НСтр("ru='Не поддерживается данной платформой'");
	
КонецПроцедуры

Функция СтраницаФормыРаздела(ДанныеТаблицы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Расположение = ?(ДанныеТаблицы.ЭтоДополнительнаяТаблица,
		Форма.ЭлементыФормы.СтраницыДополнительнойИнформации,
		Форма.ЭлементыФормы.СтраницыИнформации);
	СтраницаФормы = Расположение.Страницы[ДанныеТаблицы.ИмяТаблицы];
	СтраницаФормы.Заголовок = ИсполнительПредставленияДанных.ЗаголовокСтраницыТаблицы(
		ДанныеТаблицы.ЗаголовокСтраницы, 0, Ложь);
	Расположение.ТекущаяСтраница = СтраницаФормы;
#Иначе
	
	СтраницаФормы = Форма.Элементы["Стр" + ДанныеТаблицы.ИмяТаблицы];
	СтраницаФормы.Заголовок = ИсполнительПредставленияДанных.ЗаголовокСтраницыТаблицы(
		ДанныеТаблицы.ЗаголовокСтраницы, 0, Ложь);
#КонецЕсли
	
	Возврат СтраницаФормы;
	
КонецФункции

Функция ТаблицаФормыРаздела(ДанныеТаблицы, ШаблонТаблицы)
	
	ОтображатьПодвал = ДанныеТаблицы.Подвал;
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ТаблицаФормы = Форма.ЭлементыФормы[ДанныеТаблицы.ИмяРеквизита];
	ТаблицаФормы.Значение = ШаблонТаблицы;
	
	ТаблицаФормы.ИзменятьСоставСтрок = Ложь;
	ТаблицаФормы.АвтоВводНовойСтроки = Ложь;
	ТаблицаФормы.РазрешитьПеретаскивание = Ложь;
	ТаблицаФормы.РазрешитьНачалоПеретаскивания = Ложь;
#Иначе
	
	ТаблицаФормы = Форма.Элементы[ДанныеТаблицы.ИмяРеквизита];
#КонецЕсли
	ТаблицаФормы.Подвал = ОтображатьПодвал;
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	ТаблицаФормы.СоздатьКолонки();
	
	Для Каждого ОписаниеКолонки Из ДанныеТаблицы.Колонки Цикл
		Если ОписаниеКолонки.Доступна Тогда
			КолонкаФормы = ТаблицаФормы.Колонки[ОписаниеКолонки.Имя];
			КолонкаФормы.ТекстШапки = ОписаниеКолонки.Заголовок;
			ОформитьКолонкуТаблицы(ОписаниеКолонки, КолонкаФормы);
		КонецЕсли;
	КонецЦикла;
	
#КонецЕсли
	
	Возврат ТаблицаФормы;
	
КонецФункции

Процедура ДобавитьКолонкиТаблицы(ДанныеТаблицы, ТаблицаФормыРаздела)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	
	Для Каждого Колонка Из ДанныеТаблицы.Колонки Цикл
		Если Не Колонка.Доступна Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйЭлемент = Форма.Элементы.Добавить(ДанныеТаблицы.ИмяРеквизита + Колонка.Имя,
			Тип("ПолеФормы"), ТаблицаФормыРаздела);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
		НовыйЭлемент.ПутьКДанным = ДанныеТаблицы.ИмяРеквизита + "." + Колонка.Имя;
		НовыйЭлемент.Заголовок = Колонка.Заголовок;
		НовыйЭлемент.ТолькоПросмотр = Истина;
		ОформитьКолонкуТаблицы(Колонка, НовыйЭлемент);
	КонецЦикла;
	
#КонецЕсли
	
КонецПроцедуры

Процедура УдалитьУсловияПользовательскогоОтбора(ЭлементыОтбора, ИмяПоля)
	
	Удаляемые = Новый Массив;
	Для Каждого Элемент Из ЭлементыОтбора Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если Строка(Элемент.ЛевоеЗначение) = ИмяПоля Тогда
				Удаляемые.Добавить(Элемент);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			УдалитьУсловияПользовательскогоОтбора(Элемент.Элементы, ИмяПоля);
			Если Элемент.Элементы.Количество() = 0 Тогда
				Удаляемые.Добавить(Элемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из Удаляемые Цикл
		ЭлементыОтбора.Удалить(Элемент);
	КонецЦикла;
	
КонецПроцедуры

Функция ПоляОрганизацииОтбораСписка(ОтборСписка)
	
	Поля = Неопределено;
	Если ОтборСписка.Свойство("ПоляОрганизации", Поля) Тогда
		Возврат Поля;
	КонецЕсли;
	
	Поля = Новый Массив;
	Если Не ПустаяСтрока(ОтборСписка.ПолеОрганизации) Тогда
		Поля.Добавить(ОтборСписка.ПолеОрганизации);
	КонецЕсли;
	
	Возврат Поля;
	
КонецФункции

Функция ТекстОграниченияОтбораОбычногоСписка(ОтборСписка)
	
	Если ЗначениеЗаполнено(ОтборСписка.Организация)
		И ПоляОрганизацииОтбораСписка(ОтборСписка).Количество() > 1 Тогда
		
		Возврат НСтр("ru='В обычном клиенте универсальный список не поддерживает отбор по организации "
			+ "по двум сторонам проводки. Откройте список в управляемом клиенте или снимите отбор по организации.'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ДобавитьУсловиеПользовательскогоОтбора(Отбор, ИмяПоля, ВидСравнения, Значение)
	
	Элемент = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.Использование = Истина;
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Элемент.ВидСравнения = ВидСравнения;
	Элемент.ПравоеЗначение = Значение;
	Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
	
КонецПроцедуры

Процедура ДобавитьКомандыНаФорму()
	
	НастроитьКомандыФормы(Форма);
	
КонецПроцедуры

Процедура ДобавитьЭлементыКраткойИнформацииНаФорму()
	
	ОбновитьСистемнуюИнформацию();
	
КонецПроцедуры

Процедура ДобавитьОсновныеДополнительныеТаблицыНаФорму()
	
	ДанныеЗаполнения = КонтекстОтображения.ОписанияТаблиц;
	
	Для Каждого ДанныеТаблицы Из ДанныеЗаполнения Цикл
		ДобавитьТаблицуНаФорму(ДанныеТаблицы);
	КонецЦикла;
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	ВыбратьПервуюВидимуюСтраницу(Форма.ЭлементыФормы.СтраницыИнформации);
	ВыбратьПервуюВидимуюСтраницу(Форма.ЭлементыФормы.СтраницыДополнительнойИнформации);
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьЭлементыОтбораНаФорму()
	
	ЕстьСправочникОрганизации = (КонтекстОтображения.Возможности.ЕстьОрганизации);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	ДобавитьОтборыОбычнойФормы(ЕстьСправочникОрганизации);
#Иначе
	
	ДобавитьОтборыУправляемойФормы(ЕстьСправочникОрганизации);
#КонецЕсли
	
КонецПроцедуры

Процедура НастроитьНадписьОтборов()
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Надпись = Форма.ЭлементыФормы.НадписьОтборов;
	УстановитьПривязкиНадписиОтборов(Надпись, Форма.ЭлементыФормы.СтраницыВерхнийУровень);
#КонецЕсли
	
КонецПроцедуры

Процедура УстановитьПривязкиНадписиОтборов(Надпись, Страницы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	ПанельФормы = Форма.Панель;
	Надпись.УстановитьПривязку(ГраницаЭлементаУправления.Лево, ПанельФормы, ГраницаЭлементаУправления.Лево);
	Надпись.УстановитьПривязку(ГраницаЭлементаУправления.Право, ПанельФормы, ГраницаЭлементаУправления.Право);
	Надпись.УстановитьПривязку(ГраницаЭлементаУправления.Верх, ПанельФормы, ГраницаЭлементаУправления.Низ);
	Надпись.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ПанельФормы, ГраницаЭлементаУправления.Низ);
	Страницы.УстановитьПривязку(ГраницаЭлементаУправления.Низ, Надпись, ГраницаЭлементаУправления.Верх);
	
#КонецЕсли
	
КонецПроцедуры

Процедура ОбновитьНадписьОтборов()
	
	ОбновитьОтборыФормы(Форма, КонтекстОтображения.ТекущийСкан, КонтекстОтображения.Сведения,
		ИсполнительСнимков, ИсполнительПредставленияДанных);
	
КонецПроцедуры

Функция ОрганизацияОтбораФормы()
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Элемент = Форма.ЭлементыФормы.Найти("ОтборПоОрганизации");
	Значение = ?(Элемент = Неопределено, Неопределено, Элемент.Значение);
	
#Иначе
	
	Значение = Неопределено;
	
	Элемент = Форма.Элементы.Найти("ОтборПоОрганизации");
	Если Элемент <> Неопределено И Элемент.Видимость Тогда
		Значение = Форма["ОтборПоОрганизации"];
	КонецЕсли;
	
#КонецЕсли
	
	Возврат ?(ЗначениеЗаполнено(Значение), Значение, Неопределено);
	
КонецФункции

Процедура ДобавитьОтборыУправляемойФормы(ЕстьСправочникОрганизации)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Если Не ЕстьСправочникОрганизации Тогда
		Возврат;
	КонецЕсли;
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Новый РеквизитФормы("ОтборПоОрганизации",
		Новый ОписаниеТипов("СправочникСсылка.Организации")));
	Форма.ИзменитьРеквизиты(Реквизиты);
	
	ПолеОрганизации = Форма.Элементы.Добавить("ОтборПоОрганизации", Тип("ПолеФормы"), Форма.Элементы.Отбор);
	ПолеОрганизации.Вид = ВидПоляФормы.ПолеВвода;
	ПолеОрганизации.ПутьКДанным = "ОтборПоОрганизации";
	ПолеОрганизации.Заголовок = НСтр("ru='Организация'");
	ПолеОрганизации.КнопкаОчистки = Истина;
	ПолеОрганизации.УстановитьДействие("ПриИзменении", "ОтборПриИзменении");
#КонецЕсли
	
КонецПроцедуры

Процедура ОформитьКолонкуТаблицы(Колонка, Элемент)
	
	Элемент.Видимость = Колонка.Видимость;
	Элемент.Формат = ИсполнительПредставленияДанных.ФорматКолонкиСхемы(Колонка.Формат);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Если Колонка.Формат = "Количество" Тогда
		Элемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложение.Право;
		Элемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложение.Право;
		Элемент.Ширина = 10;
	КонецЕсли;
	
	Если Колонка.Полужирная Тогда
		ПолужирныйШрифт = Новый Шрифт(, 10, Истина);
		Элемент.ШрифтПодвала = ПолужирныйШрифт;
		Элемент.ШрифтТекста = ПолужирныйШрифт;
	КонецЕсли;
	
#Иначе
	Если Колонка.Формат = "Количество" Тогда
		Элемент.ГоризонтальноеПоложениеВШапке = ГоризонтальноеПоложениеЭлемента.Право;
		Элемент.ГоризонтальноеПоложениеВПодвале = ГоризонтальноеПоложениеЭлемента.Право;
		
		Попытка
			Элемент.МаксимальнаяШирина = 10;
		Исключение
			Элемент.Ширина = 10;
		КонецПопытки;
	КонецЕсли;
	
	Если Колонка.Полужирная Тогда
		ПолужирныйШрифт = Новый Шрифт(, 10, Истина);
		Элемент.ШрифтПодвала = ПолужирныйШрифт;
		Элемент.Шрифт = ПолужирныйШрифт;
	КонецЕсли;
	
#КонецЕсли
	
	ПрименитьШиринуКолонкиСхемы(Колонка, Элемент);
	
	Если Колонка.Цвет = "Удаление" Тогда
		ЦветКолонки = ЦветаСтиля.ЦветОтрицательногоЧисла;
	ИначеЕсли Колонка.Цвет = "Проведение" Тогда
		ЦветКолонки = WebЦвета.Зеленый;
	Иначе
		Возврат;
	КонецЕсли;
	
	Элемент.ЦветТекстаПодвала = ЦветКолонки;
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Элемент.ЦветТекстаПоля = ЦветКолонки;
#Иначе
	Элемент.ЦветТекста = ЦветКолонки;
#КонецЕсли
	
КонецПроцедуры

Процедура ПрименитьШиринуКолонкиСхемы(Колонка, Элемент)
	
	Ширина = 0;
	
	Если Не Колонка.Свойство("Ширина", Ширина) Или Ширина = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Элемент.Ширина = Ширина;
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Элемент.РастягиватьПоГоризонтали = Ложь;
	Попытка
		Элемент.АвтоМаксимальнаяШирина = Ложь;
		Элемент.МаксимальнаяШирина = Ширина;
	Исключение
		// В 8.2 достаточно заданной ширины колонки.
	КонецПопытки;
#КонецЕсли
	
КонецПроцедуры

Процедура ВыбратьПервуюВидимуюСтраницу(Панель)
	
	// Страница с индексом 0 — служебная страница исходной обычной формы.
	Для Индекс = 1 По Панель.Страницы.Количество() - 1 Цикл
		Страница = Панель.Страницы[Индекс];
		
		Если Страница.Видимость Тогда
			Панель.ТекущаяСтраница = Страница;
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область АдаптерыЭлементовФормы

Процедура УстановитьКонтекстФормы(ФормаПриложения)
	
	Форма = ФормаПриложения;
	
КонецПроцедуры

Функция ОписаниеРазделаПоИмени(ИмяРаздела)
	
	Для Каждого Описание Из КонтекстОтображения.ОписанияТаблиц Цикл
		Если Описание.ИмяТаблицы = ИмяРаздела Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение "Раздел формы отсутствует в схеме: " + ИмяРаздела;
	
КонецФункции

Функция ТаблицаРаздела(ИмяРаздела, ЭтоТабличноеПоле = Ложь)
	
	Описание = ОписаниеРазделаПоИмени(ИмяРаздела);
	
	Возврат РеквизитФормы(Описание.ИмяРеквизита, ЭтоТабличноеПоле);
	
КонецФункции

Функция РеквизитФормы(ИмяРеквизита, ЭтоТабличноеПоле = Ложь)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Возврат ?(ЭтоТабличноеПоле,
		Форма.ЭлементыФормы[ИмяРеквизита].Значение,
		Форма.ЭлементыФормы[ИмяРеквизита]);
#Иначе
	
	Возврат Форма[ИмяРеквизита];
#КонецЕсли
	
КонецФункции

Процедура УстановитьЗначениеНадписиФормы(ИмяЭлемента, Значение)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Форма.ЭлементыФормы[ИмяЭлемента].Значение = Значение;
#Иначе
	
	Форма.Элементы[ИмяЭлемента].Заголовок = Значение;
#КонецЕсли
	
КонецПроцедуры

Процедура ПоказатьКолонкиСравнения(ИмяТаблицы, Данные)
	
	КолонкаБыло = КолонкаФормы(ИмяТаблицы, "ДляСравнения");
	КолонкаРазница = КолонкаФормы(ИмяТаблицы, "Разница");
	КолонкаБыло.Видимость = Истина;
	КолонкаРазница.Видимость = Истина;
	КолонкаБыло.ТекстПодвала = Строка(Данные.Итог("ДляСравнения"));
	КолонкаРазница.ТекстПодвала = Строка(Данные.Итог("Разница"));
	
КонецПроцедуры

Функция КолонкаФормы(ИмяТаблицы, ИмяКолонки)
	
	Описание = ОписаниеРазделаПоИмени(ИмяТаблицы);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Возврат Форма.ЭлементыФормы[Описание.ИмяРеквизита].Колонки[ИмяКолонки];
#Иначе
	
	Возврат Форма.Элементы[Описание.ИмяРеквизита + ИмяКолонки];
#КонецЕсли
	
КонецФункции

// #КонецОбласти

// #Область СистемныеСведенияИПросмотрДанных

Функция СистемныйДокументФормы()
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Возврат Форма.ЭлементыФормы.СистемныеСведенияДокумент;
#Иначе
	Возврат Форма.СистемныеСведенияДокумент;
#КонецЕсли
	
КонецФункции

Процедура ЗаполнитьИменаТаблицСУБД()
	
	Если ИсполнительПредставленияДанных.ИнформационнаяБазаФайловая() Тогда
		Возврат;
	КонецЕсли;
	
	Имена = КонтекстОтображения.ИменаТаблиц;
	
	Для Каждого ОписаниеТаблицы Из ТаблицыСканирования Цикл
		Если ОписаниеТаблицы.Дополнительная Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из ТаблицаРаздела(ОписаниеТаблицы.Имя, Истина) Цикл
			Имя = Имена.Получить(ИсполнительСнимков.КлючСтрокиСкана(СтрокаТаблицы));
			СтрокаТаблицы.ТаблицаСУБД = ?(Имя = Неопределено, "", Имя);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьВыборКонстанты(ТаблицаФормы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Параметры = Новый Массив;
	Параметры.Добавить("КонстантыВыбор");
	ТаблицаФормы.УстановитьДействие("Выбор", Новый(Тип("Действие"), Параметры));
#Иначе
	
	ТаблицаФормы.УстановитьДействие("Выбор", "КонстантыВыбор");
#КонецЕсли
	
КонецПроцедуры

Процедура ЗагрузитьОсновныеСтрокиСкана(Данные)
	
	ОчиститьОсновныеТаблицы();
	ДобавитьОсновныеСтрокиСкана(Данные);
	
	Для Каждого Описание Из ТаблицыСканирования Цикл
		Если Не Описание.Дополнительная Тогда
			УстановитьЗначениеСчетчикаТаблицы(Описание.Имя, ТаблицаРаздела(Описание.Имя, Истина).Количество());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОсновныеСтрокиСкана(Данные)
	
	Для Каждого СтрокаДанных Из Данные Цикл
		Поля = Новый Структура;
		Поля.Вставить("МетаданныеИмя", СтрокаДанных.МетаданныеИмя);
		Поля.Вставить("МетаданныеСиноним", СтрокаДанных.МетаданныеСиноним);
		Поля.Вставить("КоллекцияОбъектовМетаданныхИмя", СтрокаДанных.КоллекцияОбъектовМетаданныхИмя);
		Поля.Вставить("КоллекцияМетаданныхИмя", СтрокаДанных.КоллекцияОбъектовМетаданныхИмя);
		Поля.Вставить("КоллекцияМетаданныхСиноним", СтрокаДанных.КоллекцияМетаданныхСиноним);
		Ресурсы = Новый Структура("Основной,Доп1,Доп2", СтрокаДанных.ОсновнойРесурс, СтрокаДанных.Ресурс1,
			СтрокаДанных.Ресурс2);
		ДобавитьСтрокуТаблицы(ТаблицаРаздела(СтрокаДанных.КоллекцияОбъектовМетаданныхИмя), Поля, Ресурсы);
		ДобавитьСтрокуСводнойТаблицы(Поля, Ресурсы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДополнительныеСтрокиСкана(Данные)
	
	Для Каждого Описание Из КонтекстОтображения.ОписанияТаблиц Цикл
		Если Не Описание.ЭтоДополнительнаяТаблица Или Описание.ОтдельныеСведения Тогда
			Продолжить;
		КонецЕсли;
		
		Если Данные[Описание.ИмяТаблицы] <> Неопределено Тогда
			ЗагрузитьТаблицуДополнительногоСкана(Описание.ИмяТаблицы, Данные[Описание.ИмяТаблицы]);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьТаблицуДополнительногоСкана(ИмяРаздела, Данные)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ТаблицаРаздела(ИмяРаздела).Значение = Данные.Скопировать();
#Иначе
	ТаблицаРаздела(ИмяРаздела, Истина).Загрузить(Данные);
#КонецЕсли
	УстановитьЗначениеСчетчикаТаблицы(ИмяРаздела, Данные.Количество());
	
КонецПроцедуры

// #КонецОбласти

// #Область КомандыФормы

Процедура НастроитьКомандыФормы(ФормаПриложения)
	
	Форма = ФормаПриложения;
#Если ТолстыйКлиентОбычноеПриложение Тогда
	НастроитьКомандыОбычнойФормы();
#Иначе
	НастроитьКомандыУправляемойФормы();
#КонецЕсли
	
КонецПроцедуры

Процедура НастроитьКомандыУправляемойФормы()
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	КартинкаОткрытия = КартинкаОткрытияСписка();
	Если КартинкаОткрытия <> Неопределено Тогда
		Форма.Элементы.ОткрытьОсновнуюФормуСписка.Картинка = КартинкаОткрытия;
		Форма.Элементы.ОткрытьУниверсальнуюФормуСписка.Картинка = КартинкаОткрытия;
	КонецЕсли;
	
	КартинкаСправки = КартинкаСправкиФормы();
	Если КартинкаСправки <> Неопределено Тогда
		Форма.Элементы.ПоказатьСправку.Картинка = КартинкаСправки;
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

// #КонецОбласти

// #Область ПостроениеПодробногоПросмотра

Процедура ПостроитьПросмотрОбъекта(ФормаПриложения, Данные)
	
	Форма = ФормаПриложения;
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПостроитьОбычныйПросмотр(Данные);
	Форма.АвтоЗаголовок = Ложь;
	Форма.Заголовок = НСтр("ru='Объект подробно: '") + Данные.ПолноеИмя;
#Иначе
#Если Сервер Или ТолстыйКлиентУправляемоеПриложение Тогда
	ПостроитьУправляемыйПросмотр(Данные);
#КонецЕсли
	Форма.АвтоЗаголовок = Ложь;
	Форма.Заголовок = НСтр("ru='Объект подробно: '") + Данные.ПолноеИмя;
#КонецЕсли
	
КонецПроцедуры

Процедура ПостроитьУправляемыйПросмотр(Данные)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	// Каждая перестройка реквизитов повторно подготавливает весь состав управляемой формы.
	Форма.ИзменитьРеквизиты(РеквизитыУправляемогоПросмотра(Данные));
	Страницы = Форма.Элементы.СтраницыПросмотра;
	Страницы.Видимость = Истина;
	Группы = Новый Соответствие;
	
	Для Каждого Описание Из Данные.Страницы Цикл
		Родитель = РодительУправляемойСтраницы(Описание.Группа, Страницы, Группы);
		Страница = НоваяГруппаПросмотра("Страница" + Описание.Ключ, Описание.Заголовок, Родитель,
			ВидГруппыФормы.Страница);
		ДобавитьПоказателиУправляемогоПросмотра(Описание, Страница);
		ДобавитьТаблицуУправляемогоПросмотра("Поля" + Описание.Ключ, Описание.Поля, Страница);
	КонецЦикла;
	
	ДобавитьДополнительнуюУправляемуюСтраницу("ЗависимыеОбъекты", "Зависимые объекты", Данные.ЗависимыеОбъекты,
		Страницы);
	Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаОсновная;
	Форма.Элементы.СостояниеЗагрузки.Заголовок = Данные.Предупреждение;
	Форма.Элементы.СостояниеЗагрузки.Видимость = Не ПустаяСтрока(Данные.Предупреждение);
#КонецЕсли
	
КонецПроцедуры

Функция РеквизитыУправляемогоПросмотра(Данные)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Реквизиты = Новый Массив;
	
	Для Каждого Описание Из Данные.Страницы Цикл
		ДобавитьРеквизитыПоказателейПросмотра(Реквизиты, Описание);
		ДобавитьРеквизитыТаблицыПросмотра(Реквизиты, "Поля" + Описание.Ключ, Описание.Поля);
	КонецЦикла;
	
	Если Данные.ЗависимыеОбъекты.Количество() > 0 Тогда
		ДобавитьРеквизитыТаблицыПросмотра(Реквизиты, "ЗависимыеОбъекты", Данные.ЗависимыеОбъекты);
	КонецЕсли;
	
	Возврат Реквизиты;
#КонецЕсли
	
КонецФункции

Процедура ДобавитьРеквизитыПоказателейПросмотра(Реквизиты, Описание)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Реквизиты.Добавить(Новый РеквизитФормы("ТаблицаСУБД" + Описание.Ключ, Новый ОписаниеТипов("Строка")));
	
	Если Описание.ЧислоЗаписей <> Неопределено Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("ЧислоЗаписей" + Описание.Ключ, ТипКоличестваЗаписей()));
	КонецЕсли;
	
	Если Описание.Группа = "Движения" И Описание.ЧислоЗаписейВсего <> Неопределено Тогда
		Реквизиты.Добавить(Новый РеквизитФормы("ВсегоЗаписей" + Описание.Ключ, ТипКоличестваЗаписей()));
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьРеквизитыТаблицыПросмотра(Реквизиты, Имя, ДанныеТаблицы)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Если Форма.Элементы.Найти(Имя) = Неопределено Тогда
		Реквизиты.Добавить(Новый РеквизитФормы(Имя, Новый ОписаниеТипов("ТаблицаЗначений")));
	КонецЕсли;
	
	Для Каждого Колонка Из ДанныеТаблицы.Колонки Цикл
		Реквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, Имя));
	КонецЦикла;
#КонецЕсли
	
КонецПроцедуры

Функция НоваяГруппаПросмотра(Имя, Заголовок, Родитель, Вид)
	
	Группа = Форма.Элементы.Найти(Имя);
	
	Если Группа = Неопределено Тогда
		Группа = Форма.Элементы.Добавить(Имя, Тип("ГруппаФормы"), Родитель);
		Группа.Вид = Вид;
	КонецЕсли;
	
	Группа.Видимость = Истина;
	Группа.Заголовок = Заголовок;
	
	Возврат Группа;
	
КонецФункции

Функция РодительУправляемойСтраницы(ИмяГруппы, Страницы, Группы)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Если ПустаяСтрока(ИмяГруппы) Тогда
		Возврат Страницы;
	КонецЕсли;
	
	Если ИмяГруппы = "Табличные части" Тогда
		Форма.Элементы.СтраницаТабличныеЧасти.Видимость = Истина;
		
		Возврат Форма.Элементы.СтраницыТабличныхЧастей;
	ИначеЕсли ИмяГруппы = "Движения" Тогда
		Форма.Элементы.СтраницаДвижения.Видимость = Истина;
		
		Возврат Форма.Элементы.СтраницыДвижения;
	КонецЕсли;
	
	Родитель = Группы.Получить(ИмяГруппы);
	
	Если Родитель = Неопределено Тогда
		Имя = "Группа" + Формат(Группы.Количество(), "ЧГ=;ЧН=0");
		СтраницаГруппы = НоваяГруппаПросмотра(Имя, ИмяГруппы, Страницы, ВидГруппыФормы.Страница);
		Родитель = НоваяГруппаПросмотра(Имя + "Страницы", "", СтраницаГруппы, ВидГруппыФормы.Страницы);
		Группы.Вставить(ИмяГруппы, Родитель);
	КонецЕсли;
	
	Возврат Родитель;
#КонецЕсли
	
КонецФункции

Процедура ДобавитьПоказателиУправляемогоПросмотра(Описание, Родитель)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	ГруппаПоказателей = НоваяГруппаПросмотра("Показатели" + Описание.Ключ, "", Родитель,
		ВидГруппыФормы.ОбычнаяГруппа);
	ГруппаПоказателей.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Группа = НоваяГруппаПросмотра("ЗначенияПоказателей" + Описание.Ключ, "", ГруппаПоказателей,
		ВидГруппыФормы.ОбычнаяГруппа);
	Группа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	Группа.ОтображатьЗаголовок = Ложь;
	Если Не ПустаяСтрока(Описание.ТаблицаСУБД) Тогда
		ДобавитьПолеПоказателяУправляемойФормы("ТаблицаСУБД" + Описание.Ключ, "Таблица СУБД",
			Новый ОписаниеТипов("Строка"), Описание.ТаблицаСУБД, Группа, 28);
	КонецЕсли;
	
	Если Описание.ЧислоЗаписей <> Неопределено Тогда
		Заголовок = ?(Описание.Группа = "Движения", "По документу", "Количество записей");
		ДобавитьПолеПоказателяУправляемойФормы("ЧислоЗаписей" + Описание.Ключ, Заголовок,
			ТипКоличестваЗаписей(), Описание.ЧислоЗаписей, Группа, 15);
	КонецЕсли;
	
	Если Описание.Группа = "Движения" И Описание.ЧислоЗаписейВсего <> Неопределено Тогда
		ДобавитьПолеПоказателяУправляемойФормы("ВсегоЗаписей" + Описание.Ключ, "Всего записей",
			ТипКоличестваЗаписей(), Описание.ЧислоЗаписейВсего, Группа, 15);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Описание.ОшибкаКоличество) Тогда
		ДобавитьНадписьПросмотра("ОшибкаКоличество" + Описание.Ключ,
			"Количество записей недоступно: " + Описание.ОшибкаКоличество, ГруппаПоказателей);
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьПолеПоказателяУправляемойФормы(Имя, Заголовок, ТипЗначения, Значение, Родитель, Ширина)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Форма[Имя] = Значение;
	Поле = Форма.Элементы.Добавить(Имя, Тип("ПолеФормы"), Родитель);
	Поле.Вид = ВидПоляФормы.ПолеВвода;
	Поле.ПутьКДанным = Имя;
	Поле.Заголовок = Заголовок;
	Поле.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	Поле.Доступность = Истина;
	Поле.ТолькоПросмотр = Истина;
	Поле.Ширина = Ширина;
	Поле.РастягиватьПоГоризонтали = Ложь;
	
	Если ТипЗначения.СодержитТип(Тип("Число")) Тогда
		Поле.Формат = ИсполнительПредставленияДанных.ФорматКолонкиСхемы("Количество");
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

Функция ТипКоличестваЗаписей()
	
	Возврат Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 0));
	
КонецФункции

Процедура ДобавитьНадписьПросмотра(Имя, Текст, Родитель)
	
	Надпись = Форма.Элементы.Найти(Имя);
	Если Надпись = Неопределено Тогда
		Надпись = Форма.Элементы.Добавить(Имя, Тип("ДекорацияФормы"), Родитель);
		Надпись.Вид = ВидДекорацииФормы.Надпись;
	КонецЕсли;
	Надпись.Видимость = Истина;
	Надпись.Заголовок = Текст;
	РастянутьНадписьУправляемойФормы(Надпись, СтрЧислоСтрок(Текст));
	
КонецПроцедуры

Процедура РастянутьНадписьУправляемойФормы(Надпись, КоличествоСтрок = 1)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Надпись.Ширина = 1;
	Надпись.Высота = КоличествоСтрок;
	Надпись.ВысотаЗаголовка = КоличествоСтрок;
	Надпись.РастягиватьПоГоризонтали = Истина;
	Надпись.РастягиватьПоВертикали = Ложь;
	
	Попытка
		Надпись.АвтоМаксимальнаяШирина = Ложь;
		Надпись.МаксимальнаяШирина = 0;
	Исключение
		// В 8.2 надпись растягивается без свойств максимальной ширины.
	КонецПопытки;
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьДополнительнуюУправляемуюСтраницу(Имя, Заголовок, ДанныеТаблицы, Страницы)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Если ДанныеТаблицы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Страница = НоваяГруппаПросмотра("Страница" + Имя, Заголовок, Страницы, ВидГруппыФормы.Страница);
	ДобавитьТаблицуУправляемогоПросмотра(Имя, ДанныеТаблицы, Страница);
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьТаблицуУправляемогоПросмотра(Имя, ДанныеТаблицы, Родитель)
	
#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Форма.ЗначениеВРеквизитФормы(ДанныеТаблицы, Имя);
	Таблица = Форма.Элементы.Найти(Имя);
	
	Если Таблица = Неопределено Тогда
		Таблица = Форма.Элементы.Добавить(Имя, Тип("ТаблицаФормы"), Родитель);
		Таблица.ПутьКДанным = Имя;
	КонецЕсли;
	Таблица.Отображение = ОтображениеТаблицы.Список;
	Таблица.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиЭлементаФормы.Нет;
	Таблица.ИзменятьСоставСтрок = Ложь;
	Таблица.Высота = 20;
	
	Для Каждого Колонка Из ДанныеТаблицы.Колонки Цикл
		Если Колонка.Имя = "ЭтоРаздел" Или Колонка.Имя = "Ссылка" Тогда
			Продолжить;
		КонецЕсли;
		
		Поле = Форма.Элементы.Добавить(Имя + Колонка.Имя, Тип("ПолеФормы"), Таблица);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = Имя + "." + Колонка.Имя;
		Поле.Заголовок = Колонка.Заголовок;
		Поле.ТолькоПросмотр = Истина;
		
		Если Колонка.Имя = "КоличествоДокументов" Тогда
			Поле.Формат = ИсполнительПредставленияДанных.ФорматКоличества();
		КонецЕсли;
		
		Если Колонка.Имя = "ПолеСУБД" Тогда
			Поле.Подсказка = ПодсказкаПолейСУБД();
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеТаблицы.Колонки.Найти("ЭтоРаздел") <> Неопределено Тогда
		ВыделитьРазделыРеквизитов(Имя, ДанныеТаблицы);
	КонецЕсли;
	
#КонецЕсли
	
КонецПроцедуры

Процедура ВыделитьРазделыРеквизитов(ИмяТаблицы, ДанныеТаблицы)
	
	Оформление = Форма.УсловноеОформление.Элементы.Добавить();
	Оформление.Использование = Истина;
	Условие = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".ЭтоРаздел");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	Условие.Использование = Истина;
	
	Для Каждого Колонка Из ДанныеТаблицы.Колонки Цикл
		Если Колонка.Имя <> "ЭтоРаздел" Тогда
			Поле = Оформление.Поля.Элементы.Добавить();
			Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ШрифтРаздела = Новый Шрифт(Форма.Элементы[ИмяТаблицы].Шрифт, , , Истина);
	Оформление.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтРаздела);
	
КонецПроцедуры

Функция НоваяПанельПросмотра(Имя, Родитель)
	
	Страницы = Форма.ЭлементыФормы.Найти(Имя);
	Если Страницы <> Неопределено Тогда
		Возврат Страницы;
	КонецЕсли;
	Страницы = Форма.ЭлементыФормы.Добавить(Тип("Панель"), Имя, Истина, Родитель);
	Если Страницы.Страницы.Количество() > 0 Тогда
		Страницы.Страницы[0].Видимость = Ложь;
	КонецЕсли;
	
	Страницы.Лево = 5;
	Страницы.Верх = ?(Родитель = Неопределено, 5, 25);
	Страницы.Ширина = ?(Родитель = Неопределено, Форма.Ширина, Родитель.Ширина) - 10;
	УстановитьГоризонтальныеПривязкиПросмотра(Страницы, Родитель);
	Страницы.Высота = ?(Родитель = Неопределено, 660, 620);
	
	Возврат Страницы;
	
КонецФункции

Процедура УстановитьГоризонтальныеПривязкиПросмотра(Элемент, Родитель)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ПанельРодитель = ?(Родитель = Неопределено, Форма.Панель, Родитель);
	Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево, ПанельРодитель, ГраницаЭлементаУправления.Лево);
	Элемент.УстановитьПривязку(ГраницаЭлементаУправления.Право, ПанельРодитель, ГраницаЭлементаУправления.Право);
#КонецЕсли
	
КонецПроцедуры

Функция КартинкаОткрытияСписка()
	
	Попытка
		Картинка = Неопределено;
		Выполнить("Картинка = БиблиотекаКартинок.ПоказатьВСписке;");
		
		Возврат Картинка;
	Исключение
		// Картинка «Показать в списке» доступна с 8.3.6.
		
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция КартинкаСправкиФормы()
	
	Попытка
		Картинка = Неопределено;
		Выполнить("Картинка = БиблиотекаКартинок.СправкаФормы;");
		
		Возврат Картинка;
	Исключение
		// СправкаФормы появилась только в 8.3.17.
		
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПодсказкаПолейСУБД()
	
	Возврат "Один реквизит составного типа может храниться в нескольких полях: "
	+ "_TYPE - признак типа, _RTRef - вид ссылки, _RRRef - ссылка на объект. "
	+ "Для других составляющих типа платформа может создавать отдельные поля.";
	
КонецФункции

// #КонецОбласти

// #Область ДополнительныеСведенияИПубликация

Процедура ПометитьНеобновленныеРазделы(Ошибки, Сведения)
	
	Для Каждого Описание Из КонтекстОтображения.ОписанияТаблиц Цикл
		Если Не Описание.ЭтоДополнительнаяТаблица Или Не РазделПоддерживается(Описание.ИмяТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Ошибки.Получить(Описание.ИмяТаблицы) <> Неопределено Тогда
			Заголовок = ЗаголовокДополнительногоРаздела(Описание.ИмяТаблицы, Описание.ЗаголовокСтраницы);
			УстановитьЗаголовокДополнительногоРаздела(Описание.ИмяТаблицы, Заголовок, Ошибки);
			
			Продолжить;
		КонецЕсли;
		
		Количество = 0;
		
		Если Описание.ОтдельныеСведения Тогда
			Если Сведения <> Неопределено Тогда
				Количество = Сведения[Описание.ИмяТаблицы].Количество();
			КонецЕсли;
		Иначе
			Количество = ТаблицаРаздела(Описание.ИмяТаблицы, Истина).Количество();
		КонецЕсли;
		
		Заголовок = ИсполнительПредставленияДанных.ЗаголовокСтраницыТаблицы(
			Описание.ЗаголовокСтраницы, Количество, Описание.ПоказыватьНоль);
		УстановитьЗаголовокДополнительногоРаздела(Описание.ИмяТаблицы, Заголовок, Ошибки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьОтборыОбычнойФормы(ЕстьСправочникОрганизации)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Форма.ЭлементыФормы.ОтборПоПериодуДатаНачала.УстановитьДействие("ПриИзменении",
		Новый Действие("ОтборПриИзменении"));
	Форма.ЭлементыФормы.ОтборПоПериодуДатаОкончания.УстановитьДействие("ПриИзменении",
		Новый Действие("ОтборПриИзменении"));
	Форма.ЭлементыФормы.НадписьОтборПоОрганизации.Видимость = ЕстьСправочникОрганизации;
	Форма.ЭлементыФормы.ОтборПоОрганизации.Видимость = ЕстьСправочникОрганизации;
	Если ЕстьСправочникОрганизации Тогда
		ПолеОрганизации = Форма.ЭлементыФормы.ОтборПоОрганизации;
		ПолеОрганизации.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Организации");
		ПолеОрганизации.УстановитьДействие("ПриИзменении", Новый Действие("ОтборПриИзменении"));
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

Процедура НастроитьКомандыОбычнойФормы()
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	КартинкаОткрытия = КартинкаОткрытияСписка();
	Если КартинкаОткрытия <> Неопределено Тогда
		КнопкиОткрытия = Форма.ЭлементыФормы.КоманднаяПанель.Кнопки.ОткрытьФормы.Кнопки;
		КнопкиОткрытия.ОткрытьОсновнуюФормуСписка.Картинка = КартинкаОткрытия;
		КнопкиОткрытия.ОткрытьУниверсальнуюФормуСписка.Картинка = КартинкаОткрытия;
	КонецЕсли;
	
	КартинкаСправки = КартинкаСправкиФормы();
	Если КартинкаСправки <> Неопределено Тогда
		Форма.ЭлементыФормы.КоманднаяПанель.Кнопки.ПоказатьСправку.Картинка = КартинкаСправки;
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

Процедура ПостроитьОбычныйПросмотр(Данные)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Страницы = НоваяПанельПросмотра("СтраницыПросмотра", Неопределено);
	Страницы.Видимость = Истина;
	Группы = Новый Соответствие;
	Форма.ЭлементыФормы.ТаблицаСУБДОсновная.Видимость = Ложь;
	Форма.ЭлементыФормы.ЗаголовокТаблицаСУБДОсновная.Видимость = Ложь;
	Форма.ЭлементыФормы.ЧислоЗаписейОсновная.Видимость = Ложь;
	Форма.ЭлементыФормы.ЗаголовокЧислоЗаписейОсновная.Видимость = Ложь;
	
	Для Каждого Описание Из Данные.Страницы Цикл
		Родитель = РодительОбычнойСтраницы(Описание.Группа, Страницы, Группы);
		Страница = Родитель.Страницы.Найти("Страница" + Описание.Ключ);
		Если Страница = Неопределено Тогда
			Страница = Родитель.Страницы.Добавить("Страница" + Описание.Ключ, Описание.Заголовок);
		КонецЕсли;
		Страница.Видимость = Истина;
		Родитель.ТекущаяСтраница = Страница;
		ВысотаПоказателей = ДобавитьПоказателиОбычногоПросмотра(Описание, Родитель);
		ДобавитьТаблицуОбычногоПросмотра("Поля" + Описание.Ключ, Описание.Поля, Родитель,
			25 + ВысотаПоказателей);
	КонецЦикла;
	
	ДобавитьДополнительнуюОбычнуюСтраницу("ЗависимыеОбъекты", "Зависимые объекты", Данные.ЗависимыеОбъекты, Страницы);
	Для Каждого Группа Из Группы Цикл
		ВыбратьПервуюВидимуюСтраницу(Группа.Значение);
	КонецЦикла;
	
	Страницы.ТекущаяСтраница = Страницы.Страницы.СтраницаОсновная;
	
	Если Не ПустаяСтрока(Данные.Предупреждение) Тогда
		Страницы.Верх = 45;
		Страницы.Высота = Страницы.Высота - 40;
	КонецЕсли;
	
	Форма.ЭлементыФормы.СостояниеЗагрузки.Заголовок = Данные.Предупреждение;
	Форма.ЭлементыФормы.СостояниеЗагрузки.Видимость = Не ПустаяСтрока(Данные.Предупреждение);
#КонецЕсли
	
КонецПроцедуры

Функция ДобавитьПоказателиОбычногоПросмотра(Описание, Родитель)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Лево = 10;
	Если Не ПустаяСтрока(Описание.ТаблицаСУБД) Тогда
		ДобавитьПолеПоказателяОбычнойФормы("ТаблицаСУБД" + Описание.Ключ, "Таблица СУБД:",
			Новый ОписаниеТипов("Строка"), Описание.ТаблицаСУБД, Родитель, Лево, 210);
	КонецЕсли;
	
	Если Описание.ЧислоЗаписей <> Неопределено Тогда
		Заголовок = ?(Описание.Группа = "Движения", "По документу:", "Количество записей:");
		ДобавитьПолеПоказателяОбычнойФормы("ЧислоЗаписей" + Описание.Ключ, Заголовок,
			ТипКоличестваЗаписей(), Описание.ЧислоЗаписей, Родитель, Лево, 120);
	КонецЕсли;
	
	Если Описание.Группа = "Движения" И Описание.ЧислоЗаписейВсего <> Неопределено Тогда
		ДобавитьПолеПоказателяОбычнойФормы("ВсегоЗаписей" + Описание.Ключ, "Всего записей:",
			ТипКоличестваЗаписей(), Описание.ЧислоЗаписейВсего, Родитель, Лево, 120);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Описание.ОшибкаКоличество) Тогда
		Надпись = Форма.ЭлементыФормы.Найти("ОшибкаКоличество" + Описание.Ключ);
		Если Надпись = Неопределено Тогда
			Надпись = Форма.ЭлементыФормы.Добавить(Тип("Надпись"),
				"ОшибкаКоличество" + Описание.Ключ, Истина, Родитель);
			Надпись.Лево = 10;
			Надпись.Верх = 52;
			Надпись.Ширина = Родитель.Ширина - 20;
			Надпись.Высота = 20;
		КонецЕсли;
		Надпись.Видимость = Истина;
		Надпись.Заголовок = "Количество записей недоступно: " + Описание.ОшибкаКоличество;
		УстановитьГоризонтальныеПривязкиПросмотра(Надпись, Родитель);
		
		Возврат 52;
	КонецЕсли;
	
	Возврат 27;
#КонецЕсли
	
КонецФункции

Процедура ДобавитьПолеПоказателяОбычнойФормы(Имя, Заголовок, ТипЗначения, Значение, Родитель, Лево, Ширина)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Надпись = Форма.ЭлементыФормы.Найти("Заголовок" + Имя);
	Если Надпись = Неопределено Тогда
		Надпись = Форма.ЭлементыФормы.Добавить(Тип("Надпись"), "Заголовок" + Имя, Истина, Родитель);
		Надпись.Верх = 28;
		Надпись.Ширина = ?(ТипЗначения.СодержитТип(Тип("Число")), 145, 100);
		Надпись.Высота = 20;
	КонецЕсли;
	Надпись.Лево = Лево;
	Надпись.Видимость = Истина;
	Надпись.Заголовок = Заголовок;
	Лево = Лево + Надпись.Ширина;
	Поле = Форма.ЭлементыФормы.Найти(Имя);
	Если Поле = Неопределено Тогда
		Поле = Форма.ЭлементыФормы.Добавить(Тип("ПолеВвода"), Имя, Истина, Родитель);
		Поле.Верх = 25;
		Поле.Ширина = Ширина;
		Поле.Высота = 22;
	КонецЕсли;
	Поле.Лево = Лево;
	Поле.Видимость = Истина;
	Поле.ТипЗначения = ТипЗначения;
	Поле.Значение = Значение;
	Поле.Доступность = Истина;
	Поле.ТолькоПросмотр = Истина;
	Лево = Лево + Ширина + 15;
	
	Если ТипЗначения.СодержитТип(Тип("Число")) Тогда
		Поле.Формат = ИсполнительПредставленияДанных.ФорматКолонкиСхемы("Количество");
	КонецЕсли;
#КонецЕсли
	
КонецПроцедуры

Функция РодительОбычнойСтраницы(ИмяГруппы, Страницы, Группы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Если ПустаяСтрока(ИмяГруппы) Тогда
		Возврат Страницы;
	КонецЕсли;
	Родитель = Группы.Получить(ИмяГруппы);
	Если Родитель <> Неопределено Тогда
		Возврат Родитель;
	КонецЕсли;
	Если ИмяГруппы = "Табличные части" Тогда
		СтраницаГруппы = Страницы.Страницы.СтраницаТабличныеЧасти;
		Родитель = Форма.ЭлементыФормы.СтраницыТабличныхЧастей;
	ИначеЕсли ИмяГруппы = "Движения" Тогда
		СтраницаГруппы = Страницы.Страницы.СтраницаДвижения;
		Родитель = Форма.ЭлементыФормы.СтраницыДвижений;
	Иначе
		Имя = "Группа" + Формат(Группы.Количество(), "ЧГ=;ЧН=0");
		СтраницаГруппы = Страницы.Страницы.Добавить(Имя, ИмяГруппы);
		Страницы.ТекущаяСтраница = СтраницаГруппы;
		Родитель = НоваяПанельПросмотра(Имя + "Страницы", Страницы);
	КонецЕсли;
	СтраницаГруппы.Видимость = Истина;
	Страницы.ТекущаяСтраница = СтраницаГруппы;
	Группы.Вставить(ИмяГруппы, Родитель);
	
	Возврат Родитель;
#КонецЕсли
	
КонецФункции

Процедура ДобавитьДополнительнуюОбычнуюСтраницу(Имя, Заголовок, ДанныеТаблицы, Страницы)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Если ДанныеТаблицы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Страница = Страницы.Страницы.Найти("Страница" + Имя);
	Если Страница = Неопределено Тогда
		Страница = Страницы.Страницы.Добавить("Страница" + Имя, Заголовок);
	КонецЕсли;
	Страница.Видимость = Истина;
	Страницы.ТекущаяСтраница = Страница;
	ДобавитьТаблицуОбычногоПросмотра(Имя, ДанныеТаблицы, Страницы, 25);
#КонецЕсли
	
КонецПроцедуры

Процедура ДобавитьТаблицуОбычногоПросмотра(Имя, ДанныеТаблицы, Родитель, Верх)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Таблица = Форма.ЭлементыФормы.Найти(Имя);
	Если Таблица = Неопределено Тогда
		Таблица = Форма.ЭлементыФормы.Добавить(Тип("ТабличноеПоле"), Имя, Истина, Родитель);
		Таблица.Лево = 10;
		Таблица.Ширина = Родитель.Ширина - 20;
		Таблица.Высота = 480;
		УстановитьГоризонтальныеПривязкиПросмотра(Таблица, Родитель);
	КонецЕсли;
	Таблица.Верх = Верх;
	Таблица.Значение = ДанныеТаблицы;
	Таблица.ТолькоПросмотр = Истина;
	Таблица.СоздатьКолонки();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Колонка.ТекстШапки = ДанныеТаблицы.Колонки[Колонка.Имя].Заголовок;
		
		Если Колонка.Имя = "КоличествоДокументов" Тогда
			Колонка.Формат = ИсполнительПредставленияДанных.ФорматКоличества();
		КонецЕсли;
		
		Если Колонка.Имя = "ПолеСУБД" Тогда
			Таблица.Подсказка = ПодсказкаПолейСУБД();
		КонецЕсли;
		
		Если Колонка.Имя = "ЭтоРаздел" Или Колонка.Имя = "Ссылка" Тогда
			Колонка.Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ДанныеТаблицы.Колонки.Найти("ЭтоРаздел") <> Неопределено Тогда
		Таблица.УстановитьДействие("ПриВыводеСтроки", Новый Действие("РеквизитыПриВыводеСтроки"));
	КонецЕсли;
	
#КонецЕсли
	
КонецПроцедуры

Функция СтраницаДополнительногоРаздела(Имя)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	Возврат Форма.ЭлементыФормы.СтраницыДополнительнойИнформации.Страницы.Найти(Имя);
#Иначе
	
	Возврат Форма.Элементы.Найти("Стр" + Имя);
#КонецЕсли
	
КонецФункции

Функция ЗаголовокДополнительногоРаздела(Имя, ЗаголовокПоУмолчанию)
	
	Страница = СтраницаДополнительногоРаздела(Имя);
	
	Если Страница = Неопределено Тогда
		Возврат ЗаголовокПоУмолчанию;
	КонецЕсли;
	
	Возврат СтрЗаменить(Страница.Заголовок, " (не обновлено)", "");
	
КонецФункции

Процедура УстановитьЗаголовокДополнительногоРаздела(Имя, Заголовок, Ошибки)
	
	Страница = СтраницаДополнительногоРаздела(Имя);
	
	Если Страница <> Неопределено Тогда
		Страница.Заголовок = Заголовок + ?(Ошибки.Получить(Имя) = Неопределено, "", " (не обновлено)");
	КонецЕсли;
	
КонецПроцедуры

