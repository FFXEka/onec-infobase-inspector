	ИсполнительДоступаКДанным().ЗаписатьЗначениеКонстанты(ИмяКонстанты, Значение);
	
КонецПроцедуры

// Обновляет строку константы после записи без повторного сканирования остальных таблиц.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
//  ИмяКонстанты - Строка - имя существующей константы в метаданных конфигурации.
Процедура ОбновитьСтрокуКонстанты(Представление, ИмяКонстанты) Экспорт
	
	Данные = ДанныеКонстанты(ИмяКонстанты);
	
	Если Не Данные.Доступно Тогда
		Возврат;
	КонецЕсли;
	
	Отображение(Представление).ОбновитьСтрокуКонстанты(Представление, ИмяКонстанты, Данные);
	Сведения = ДанныеДополнительногоСкана();
	
	Если Сведения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СведенияДополнительногоСкана = ИсполнительСканов().ДополнительныйСканСИзмененнойКонстантой(Сведения,
		ИмяКонстанты, Данные.Значение);
	ОтметитьИзменениеСостояния("ДополнительныеСведения");
	
КонецПроцедуры

// Проверяет выбранные метаданные и определяет объект подробного просмотра.
//
// Параметры:
//  ВыбранныеМетаданные - Структура - класс и имя объекта из выбранной строки.
//
// Возвращаемое значение:
//  Строка - полное имя метаданных, например Документ.ЗаказПоставщику.
Функция ПолноеИмяПодробногоПросмотра(ВыбранныеМетаданные) Экспорт
	
	Возврат ИсполнительДоступаКДанным().ПолноеИмяПодробногоПросмотра(ВыбранныеМетаданные);
	
КонецФункции

// Двоичные данные встроенной анимации ожидания для управляемой формы.
//
// Возвращаемое значение:
//  ДвоичныеДанные - GIF макета для адреса картинки управляемой формы.
Функция ДанныеКартинкиОжиданияФормы() Экспорт
	
	Возврат ПолучитьМакет("КартинкаОжидания");
	
КонецФункции

// Встроенная анимация ожидания для обычной формы.
//
// Возвращаемое значение:
//  Картинка - встроенная анимация ожидания.
Функция КартинкаОжиданияФормы() Экспорт
	
	Исполнитель = ИсполнительИнтерфейса();
	
	Возврат Исполнитель.КартинкаОжидания(ПолучитьМакет("КартинкаОжидания"));
	
КонецФункции

// Собирает метаданные, счетчики записей выбранного объекта.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя объекта, например Документ.ЗаказПоставщику.
//
// Возвращаемое значение:
//  Структура - данные объекта; см. МодульАнализМетаданных.ДанныеОбъекта.
Функция ДанныеПодробногоПросмотра(ПолноеИмя) Экспорт
	
	ОписанияПолейРегистров = ИсполнительДоступаКДанным().ОписанияПолейБухгалтерскихРегистров(ПолноеИмя);
	Анализатор = НоваяСлужебнаяОбработкаИзМакета("МодульАнализМетаданных");
	
	Возврат Анализатор.ДанныеОбъекта(ПолноеИмя, ОписанияПолейРегистров);
	
КонецФункции

// Передает готовые данные построителю подробной формы выбранного интерфейса.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
//  Данные - Структура - описание объекта и его страниц; см. МодульАнализМетаданных.ДанныеОбъекта.
//  УправляемаяФорма - Булево - сохраненный параметр совместимости; интерфейс определяется самим построителем.
Процедура ПостроитьПодробныйПросмотр(Представление, Данные, УправляемаяФорма) Экспорт
	
	Построитель = ИсполнительИнтерфейса();
	Построитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(), ИсполнительСканов());
	Построитель.ПостроитьПодробныйПросмотр(Представление, Данные);
	
КонецПроцедуры

// Читает физические имена таблиц для объектов основного скана.
//
// Возвращаемое значение:
//  Соответствие - полное имя метаданных и имя физической таблицы.
Функция ИменаОсновныхТаблицСУБД() Экспорт
	
	Возврат ИсполнительДоступаКДанным().ИменаОсновныхТаблицСУБД(ДанныеТекущегоСкана(), ДанныеКэшаДиагностики());
	
КонецФункции

// #КонецОбласти

// #Область СозданиеИсполнителей

// Лениво создает сканер нужной сборки и передает ему службу доступа к данным.
//
// Возвращаемое значение:
//  ВнешняяОбработкаОбъект - исполнитель сканирования таблиц текущей сборки.
Функция ИсполнительСканирования() Экспорт
	
	Если ИсполнительСканированияТаблиц = Неопределено Тогда
		Исполнитель = НоваяСлужебнаяОбработкаИзМакета("МодульСканированиеТаблиц");
		
		Если Исполнитель.ВерсияКонтракта() <> 1 Тогда
			ВызватьИсключение НСтр("ru='Несовместимая версия исполнителя сканирования'");
		КонецЕсли;
		
		Исполнитель.Инициализировать(ИсполнительДоступаКДанным());
		ИсполнительСканированияТаблиц = Исполнитель;
	КонецЕсли;
	
	Возврат ИсполнительСканированияТаблиц;
	
КонецФункции

// Лениво создает построитель и адаптер элементов формы нужной сборки.
//
// Возвращаемое значение:
//  ВнешняяОбработкаОбъект - исполнитель интерфейса обработки текущей сборки.
Функция ИсполнительИнтерфейса() Экспорт
	
	Если ИсполнительИнтерфейсаОбработки = Неопределено Тогда
		ИсполнительИнтерфейсаОбработки = НоваяСлужебнаяОбработкаИзМакета("МодульИнтерфейсОбработки", Ложь);
	КонецЕсли;
	
	Возврат ИсполнительИнтерфейсаОбработки;
	
КонецФункции

// Подготавливает снимки и схемы для построителя без выполнения сканирования.
//
// Возвращаемое значение:
//  Структура - версия, заголовок, схемы таблиц, снимки, возможности и системные сведения.
//   * Версия - Строка - версия основной обработки.
//   * Заголовок - Строка - синоним обработки.
//   * Таблицы - ТаблицаЗначений - план основных разделов.
//   * ДополнительныеРесурсы - ТаблицаЗначений - числовые ресурсы схемы.
//   * ТекущийСкан - Структура, Неопределено - опубликованный основной снимок.
//   * СканДляСравнения - Структура, Неопределено - эталон сравнения.
//   * Сведения - Структура, Неопределено - опубликованные дополнительные разделы.
//   * ИменаТаблиц - Соответствие - кэш физических имен таблиц.
//   * ОписанияТаблиц - Массив из Структура - подготовленная схема разделов.
//   * Возможности - Структура - метаданные и API из МодульДоступКДанным.ВозможностиИнтерфейса.
//   * СистемныеСведения - Структура - снимок из ДанныеСистемногоСкана.
//   * ПанельСистемныхСведений - Структура - готовая панель из МодульПредставлениеДанных.ПанельСистемныхСведений.
Функция КонтекстИнтерфейса() Экспорт
	
	Контекст = Новый Структура;
	Контекст.Вставить("Версия", ВерсияОбработки);
	Контекст.Вставить("Заголовок", ЭтотОбъект.Метаданные().Синоним);
	Контекст.Вставить("Таблицы", Таблицы);
	Контекст.Вставить("ДополнительныеРесурсы", ДополнительныеРесурсы);
	Контекст.Вставить("ТекущийСкан", ДанныеТекущегоСкана());
	Контекст.Вставить("СканДляСравнения", ?(СканДляСравнения = Неопределено, Неопределено,
		СканДляСравнения.Получить()));
	Контекст.Вставить("Сведения", ДанныеДополнительногоСкана());
	Кэш = ДанныеКэшаДиагностики();
	Контекст.Вставить("ИменаТаблиц", ?(Кэш.ИменаТаблиц = Неопределено, Новый Соответствие, Кэш.ИменаТаблиц));
	Контекст.Вставить("ОписанияТаблиц", ОписанияТаблицСкана());
	Контекст.Вставить("Возможности", ВозможностиИнтерфейса());
	СистемныеДанные = ДанныеСистемногоСкана();
	Представления = ИсполнительПредставления();
	Контекст.Вставить("СистемныеСведения", СистемныеДанные);
	
	Контекст.Вставить("ПанельСистемныхСведений", Представления.ПанельСистемныхСведений(СистемныеДанные));
	
	Возврат Контекст;
	
КонецФункции

// Возвращает компактное описание разделов для загрузки и навигации форм.
//
// Возвращаемое значение:
//  Массив из Структура - описания навигации; см. МодульПредставлениеДанных.ОписанияРазделовФормы.
Функция ОписанияРазделовФормы() Экспорт
	
	Возврат ИсполнительПредставления().ОписанияРазделовФормы(ОписанияТаблицСкана());
	
КонецФункции

// #КонецОбласти

// #Область СовместимостьПлатформы

// Определяет путь лениво загружаемого адаптера указанного API платформы.
//
// Параметры:
//  Релиз - Число - код адаптера: 3, 6, 10, 13 или 15.
//
// Возвращаемое значение:
//  Строка - полное имя клиентской формы-адаптера; неизвестный релиз вызывает исключение.
Функция ИмяФормыКлиентскогоАдаптера(Релиз) Экспорт
	
	Имена = Новый Соответствие;
	Имена.Вставить(3, "Диалоги83");
	Имена.Вставить(6, "Файлы836");
	Имена.Вставить(10, "Приложение8310");
	Имена.Вставить(13, "Загрузка8313");
	Имена.Вставить(15, "Скачивание8315");
	Имя = Имена.Получить(Релиз);
	
	Если Имя = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Неизвестный клиентский адаптер.'");
	КонецЕсли;
	
	Возврат "ВнешняяОбработка." + ИсполнительИнтерфейса().Метаданные().Имя + ".Форма." + Имя;
	
КонецФункции

// #КонецОбласти

// #Область ТранспортСостояния

// Формирует только отмеченные измененные снимки для передачи в форму.
//
// Возвращаемое значение:
//  Структура - подмножество ТекущийСкан, СканДляСравнения, КэшДиагностики и системных сведений.
Функция ИзмененноеСостояние() Экспорт
	
	Данные = Новый Структура;
	
	Если ИменаИзмененныхСнимков = Неопределено Тогда
		Возврат Данные;
	КонецЕсли;
	
	Для Каждого Изменение Из ИменаИзмененныхСнимков Цикл
		Если Изменение.Ключ = "ТекущийСкан" Тогда
			Данные.Вставить(Изменение.Ключ, ДанныеТекущегоСкана());
		ИначеЕсли Изменение.Ключ = "СканДляСравнения" Тогда
			Данные.Вставить(Изменение.Ключ, СканДляСравнения.Получить());
		ИначеЕсли Изменение.Ключ = "КэшДиагностики" Тогда
			Данные.Вставить(Изменение.Ключ, ДанныеКэшаДиагностики());
		ИначеЕсли Изменение.Ключ = "ДополнительныеСведения" Тогда
			Данные.Вставить(Изменение.Ключ, ДанныеДополнительногоСкана());
		ИначеЕсли Изменение.Ключ = "СистемныеСведения" Тогда
			Данные.Вставить(Изменение.Ключ, ДанныеСистемногоСкана());
		КонецЕсли;
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

// #КонецОбласти

// #Область СистемноеСостояние

// Разворачивает сохраненный системный снимок без нового обращения к ОС.
//
// Возвращаемое значение:
//  Структура - сохраненный системный снимок; при первом обращении создаются краткие сведения приложения.
//   * Приложение - Структура - краткие сведения из МодульСистемныеСведения.СведенияПриложения.
//   * Компьютеры - Структура, Неопределено - Сервер, Клиент и ОткликМс; отсутствует до системного сбора.
//   * РежимРаботы - Структура, Неопределено - режим и размер файловой базы; отсутствует до системного сбора.
Функция ДанныеСистемногоСкана() Экспорт
	
	Если СистемныеСведения = Неопределено Тогда
		СистемныеСведения = Новый Структура("Приложение,Компьютеры,РежимРаботы",
			ИсполнительСистемныхДанных().СведенияПриложения(), Неопределено, Неопределено);
		ОтметитьИзменениеСостояния("СистемныеСведения");
	КонецЕсли;
	
	Возврат СистемныеСведения;
	
КонецФункции

// Запоминает системный снимок приложения, сервера и клиента без повторного сбора.
//
// Параметры:
//  Данные - Структура - системный снимок; состав описан в ДанныеСистемногоСкана.
Процедура УстановитьСистемныйСкан(Знач Данные) Экспорт
	
	СистемныеСведения = Данные;
	
КонецПроцедуры

// Дополняет снимок клиентским заголовком и видом приложения, затем обновляет отображение.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
//  Заголовок - Строка - исходное название приложения или страницы без счетчика.
//  Клиент - Строка - представление вида клиентского приложения.
Процедура УстановитьСведенияКлиентскогоПриложения(Представление, Заголовок, Клиент) Экспорт
	
	Сведения = ДанныеСистемногоСкана();
	Сведения.Приложение.Заголовок = Заголовок;
	Сведения.Приложение.Клиент = Клиент;
	ОтметитьИзменениеСостояния("СистемныеСведения");
	ОбновитьКраткуюИнформацию(Представление);
	
КонецПроцедуры

// #КонецОбласти

// #Область ИдентификацияСборки

// Идентификатор совместимости основной обработки и исполнителей.
//
// Возвращаемое значение:
//  Строка - версия и отпечаток исходников для проверки совместимости исполнителей.
Функция ИдентификаторСборки() Экспорт
	
	Возврат "4.137_e9277ced5053957b345f";
	
КонецФункции

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область РегистрацияИОткрытие

Функция НоваяТаблицаКоманд()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(ТаблицаКоманд, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь,
	Модификатор = "")
	
	НоваяКоманда = ТаблицаКоманд.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

// #КонецОбласти

// #Область СеансСканирования

Функция КонтекстСеансаСканирования()
	
	Контекст = Новый Структура;
	Контекст.Вставить("СхемаТаблиц", ОписанияТаблицСкана());
	Контекст.Вставить("ДополнительныеРесурсы", ДополнительныеРесурсы.Выгрузить());
	Контекст.Вставить("КэшДиагностики", ДанныеКэшаДиагностики());
	Контекст.Вставить("РазмерПорции", 64);
	Скан = ДанныеТекущегоСкана();
	Контекст.Вставить("СтрокиОсновногоСкана", ?(Скан = Неопределено, НоваяТаблицаСтрокСкана(), Скан.Строки));
	Контекст.Вставить("ПредыдущиеСведения", ДанныеДополнительногоСкана());
	
	Возврат Контекст;
	
КонецФункции

Процедура ОпубликоватьОсновныеТаблицы(Представление, Сеанс)
	
	Контекст = ПолучитьИзВременногоХранилища(Сеанс.АдресКонтекста);
	// Сеанс содержит кэш после возможного сброса при изменении конфигурации.
	УстановитьКэшДиагностики(Контекст.КэшДиагностики);
	Исполнитель = ИсполнительСканирования();
	Данные = Исполнитель.ОсновнойРезультатСеанса(Сеанс);
	ПрежнийСкан = ТекущийСкан;
	Скан = ИсполнительСканов().ОсновнойСнимокПубликации(Данные, Сеанс.Параметры,
		Сеанс.ИдентификаторПубликации, Сеанс.Замеры, ДанныеТекущегоСкана());
	
	ТекущийСкан = Новый ХранилищеЗначения(Скан);
	
	Попытка
		ИменаОсновныхТаблицСУБД();
	Исключение
		Сеанс.ОшибкиРазделов.Вставить("Имена таблиц СУБД", ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		Построитель = ИсполнительИнтерфейса();
		Построитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(),
			ИсполнительСканов());
		Построитель.ПрименитьОсновнойРезультат(Данные);
	Исключение
		ТекущийСкан = ПрежнийСкан;
		ВызватьИсключение;
	КонецПопытки;
	
	Контекст.СтрокиОсновногоСкана = Данные;
	Контекст.КэшДиагностики = ДанныеКэшаДиагностики();
	ПоместитьВоВременноеХранилище(Контекст, Сеанс.АдресКонтекста);
	ОтметитьИзменениеСостояния("ТекущийСкан");
	ОтметитьИзменениеСостояния("КэшДиагностики");
	ОбновитьОтборыФормы(Представление);
	
КонецПроцедуры

Процедура ОпубликоватьДополнительныеТаблицы(Представление, Сеанс)
	
	Исполнитель = ИсполнительСканирования();
	Данные = Исполнитель.ДополнительныйРезультатСеанса(Сеанс);
	Построитель = ИсполнительИнтерфейса();
	Построитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(), ИсполнительСканов());
	Построитель.ПрименитьДополнительныйРезультат(Данные);
	ПрежниеСведения = ДанныеДополнительногоСкана();
	
	Для Каждого Описание Из ОписанияТаблицСкана() Цикл
		Если Не Описание.ЭтоДополнительнаяТаблица Или Описание.ОтдельныеСведения Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаздела = Данные[Описание.ИмяТаблицы];
		
		Если ТаблицаРаздела = Неопределено И ПрежниеСведения <> Неопределено Тогда
			ПрежниеСведения.Свойство(Описание.ИмяТаблицы, ТаблицаРаздела);
		КонецЕсли;
		
		Если ТаблицаРаздела = Неопределено Тогда
			ТаблицаРаздела = ИсполнительДоступаКДанным().НоваяТаблицаПоСхеме(Описание.ИмяТаблицы);
		КонецЕсли;
		
		Данные.Сведения.Вставить(Описание.ИмяТаблицы, ТаблицаРаздела.Скопировать());
	КонецЦикла;
	
	СведенияДополнительногоСкана = Данные.Сведения;
	УстановитьКэшДиагностики(Данные.КэшДиагностики);
	
	ОтметитьИзменениеСостояния("ДополнительныеСведения");
	ОтметитьИзменениеСостояния("КэшДиагностики");
	ОбновитьОтборыФормы(Представление);
	
КонецПроцедуры

// #КонецОбласти

// #Область СостояниеИСравнение

Функция ДанныеТекущегоСкана()
	
	Если ТекущийСкан = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ТекущийСкан.Получить();
	
КонецФункции

Функция НоваяТаблицаСтрокСкана()
	
	Возврат ИсполнительСканов().НоваяТаблицаСтрокСкана();
	
КонецФункции

Процедура ОбновитьОтображениеСравнения(Представление)
	
	Отображение(Представление).ОбновитьСравнениеСканов();
	
КонецПроцедуры

// #КонецОбласти

// #Область СозданиеИсполнителей

Функция НоваяСлужебнаяОбработкаИзМакета(ИмяМакета, БезопасныйРежим = Истина)
	
	// Доступ к данным безопасный; интерфейс и WMI явно запрашивают свой режим.
	Сборка = ИдентификаторСборки();
	Суффикс = СтрЗаменить(Лев(Сборка, Найти(Сборка, "_") - 1), ".", "");
	Имя = ИмяМакета + Суффикс + "_b" + Сред(Сборка, Найти(Сборка, "_") + 1);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Исполнитель = ПодключитьСлужебнуюОбработку(ИмяМакета, БезопасныйРежим);
#Иначе
	Попытка
		Исполнитель = ВнешниеОбработки.Создать(Имя, БезопасныйРежим);
	Исключение
		Исполнитель = ПодключитьСлужебнуюОбработку(ИмяМакета, БезопасныйРежим);
	КонецПопытки;
	
#КонецЕсли
	ПроверитьСборкуИсполнителя(Исполнитель, ИмяМакета);
	
	Возврат Исполнитель;
	
КонецФункции

Функция ИсполнительДоступаКДанным()
	
	Если ИсполнительЧтенияДанных = Неопределено Тогда
		ИсполнительЧтенияДанных = НоваяСлужебнаяОбработкаИзМакета("МодульДоступКДанным");
		
		Если СхемаСканирования <> Неопределено Тогда
			ИсполнительЧтенияДанных.Инициализировать(СхемаСканирования);
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИсполнительЧтенияДанных;
	
КонецФункции

Функция ИсполнительПредставления()
	
	Если ИсполнительПредставленияДанных = Неопределено Тогда
		ИсполнительПредставленияДанных = НоваяСлужебнаяОбработкаИзМакета("МодульПредставлениеДанных");
		ИсполнительПредставленияДанных.Инициализировать(ВозможностиИнтерфейса());
	КонецЕсли;
	
	Возврат ИсполнительПредставленияДанных;
	
КонецФункции

Функция ИсполнительСканов()
	
	Если ИсполнительСнимков = Неопределено Тогда
		ИсполнительСнимков = НоваяСлужебнаяОбработкаИзМакета("МодульСнимкиСканирования");
	КонецЕсли;
	
	ИсполнительСнимков.Инициализировать(ВерсияОбработки);
	
	Возврат ИсполнительСнимков;
	
КонецФункции

Функция Отображение(Представление)
	
	Исполнитель = ИсполнительИнтерфейса();
	Исполнитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(), ИсполнительСканов());
	
	Возврат Исполнитель;
	
КонецФункции

Функция ПодключитьСлужебнуюОбработку(ИмяМакета, БезопасныйРежим)
	
	Адрес = АдресСлужебногоМакета(ИмяМакета);
	
	Попытка
		Защита = Неопределено;
		
		Попытка
			Выполнить("Защита = Новый ОписаниеЗащитыОтОпасныхДействий;");
		Исключение
			// Тип отсутствует на платформе 8.2.
		КонецПопытки;
		
#Если ТолстыйКлиентОбычноеПриложение Тогда
		Если Защита = Неопределено Тогда
			Исполнитель = ВнешниеОбработки.Создать(Адрес, БезопасныйРежим);
		Иначе
			Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
			Исполнитель = ВнешниеОбработки.Создать(Адрес, БезопасныйРежим, Защита);
		КонецЕсли;
		
#Иначе
		Если Защита = Неопределено Тогда
			Имя = ВнешниеОбработки.Подключить(Адрес, , БезопасныйРежим);
		Иначе
			Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
			Имя = ВнешниеОбработки.Подключить(Адрес, , БезопасныйРежим, Защита);
		КонецЕсли;
		
		Исполнитель = ВнешниеОбработки.Создать(Имя, БезопасныйРежим);
#КонецЕсли
	Исключение
		ОсвободитьСлужебныйМакетПослеОшибки(Адрес);
		ВызватьИсключение;
	КонецПопытки;
	
	ОсвободитьСлужебныйМакет(Адрес);
	
	Возврат Исполнитель;
	
КонецФункции

Функция АдресСлужебногоМакета(ИмяМакета)
	
	Макет = ПолучитьМакет(ИмяМакета);
#Если ТолстыйКлиентОбычноеПриложение Тогда
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	Попытка
		Макет.Записать(ИмяФайла);
	Исключение
		ОсвободитьСлужебныйМакетПослеОшибки(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат ИмяФайла;
#Иначе
	
	Возврат ПоместитьВоВременноеХранилище(Макет);
#КонецЕсли
	
КонецФункции

Процедура ОсвободитьСлужебныйМакет(Адрес)
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	УдалитьФайлы(Адрес);
#Иначе
	УдалитьИзВременногоХранилища(Адрес);
#КонецЕсли
	
КонецПроцедуры

Процедура ОсвободитьСлужебныйМакетПослеОшибки(Адрес)
	
	Попытка
		ОсвободитьСлужебныйМакет(Адрес);
	Исключение
		// Ошибка очистки не должна скрыть исходную ошибку записи или подключения.
		
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область ТранспортСостояния

Процедура ОтметитьИзменениеСостояния(ИмяСнимка)
	
	Если ИменаИзмененныхСнимков = Неопределено Тогда
		ИменаИзмененныхСнимков = Новый Структура;
	КонецЕсли;
	
	ИменаИзмененныхСнимков.Вставить(ИмяСнимка, Истина);
	
КонецПроцедуры

// #КонецОбласти

// #Область СхемаСканирования

Функция ОписанияТаблицСкана()
	
	Если СхемаСканирования = Неопределено Тогда
		ИсполнительДанных = ИсполнительДоступаКДанным();
		Декларация = ИсполнительСканов().ОписанияТаблицСкана(ПолучитьМакет("СхемаТаблицСканирования"));
		ГотоваяСхема = ИсполнительДанных.ПодготовленнаяСхемаТаблиц(Декларация);
		ИсполнительДанных.Инициализировать(ГотоваяСхема);
		СхемаСканирования = ГотоваяСхема;
	КонецЕсли;
	
	Возврат СхемаСканирования;
	
КонецФункции

// #КонецОбласти

// #Область СистемноеСостояние

Функция ИсполнительСистемныхДанных()
	
	Если ИсполнительСистемныхСведений = Неопределено Тогда
		ИсполнительСистемныхСведений = НоваяСлужебнаяОбработкаИзМакета("МодульСистемныеСведения", Ложь);
	КонецЕсли;
	
	Возврат ИсполнительСистемныхСведений;
	
КонецФункции

// #КонецОбласти

// #Область ИдентификацияСборки

Процедура ПроверитьСборкуСеанса(Сеанс)
	
	Сборка = "";
	
	Если Не Сеанс.Свойство("Сборка", Сборка) Или Сборка <> ИдентификаторСборки() Тогда
		ВызватьИсключение НСтр("ru='Задание принадлежит другой сборке обработки. Закройте обработку "
			+ "и откройте нужный файл заново.'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСборкуИсполнителя(Исполнитель, ИмяМакета)
	
	Если Исполнитель.ИдентификаторСборки() <> ИдентификаторСборки() Тогда
		ВызватьИсключение НСтр("ru='Несовместимая сборка исполнителя: '") + ИмяМакета;
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область ВозможностиТекущегоСеанса

Функция ВозможностиИнтерфейса()
	
	Кэш = ДанныеКэшаДиагностики();
	Возможности = Неопределено;
	
	Если Не Кэш.Свойство("ВозможностиИнтерфейса", Возможности) Тогда
		Возможности = ИсполнительДоступаКДанным().ВозможностиИнтерфейса(ОписанияТаблицСкана());
		Кэш.Вставить("ВозможностиИнтерфейса", Возможности);
		ОтметитьИзменениеСостояния("КэшДиагностики");
	КонецЕсли;
	
	Возврат Возможности;
	
КонецФункции

Процедура УчестьДинамическоеИзменениеКонфигурации()
	
	// Признак платформы остаётся истинным после динамического обновления.
	// Структура хранения не меняется динамически; повторные сканы используют кэш сеанса.
	Если Не КонфигурацияБазыДанныхИзмененаДинамически() Тогда
		Возврат;
	КонецЕсли;
	
	Кэш = ДанныеКэшаДиагностики();
	Учтено = Ложь;
	
	Если Кэш.Свойство("ДинамическоеИзменениеУчтено", Учтено) И Учтено Тогда
		Возврат;
	КонецЕсли;
	
	СброситьКэшИменТаблиц();
	Кэш.Вставить("ДинамическоеИзменениеУчтено", Истина);
	ОтметитьИзменениеСостояния("КэшДиагностики");
	
КонецПроцедуры

