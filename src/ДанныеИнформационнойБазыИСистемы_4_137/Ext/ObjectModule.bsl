// Координирует исполнителей и владеет снимками. Прикладные запросы и построение элементов выполняют исполнители.

// #Область ОписаниеПеременных

Перем ТекущийСкан Экспорт; // ХранилищеЗначения, Неопределено - опубликованный основной снимок.
Перем СканДляСравнения Экспорт; // ХранилищеЗначения, Неопределено - эталон, заменяемый только командой.
Перем ВерсияОбработки; // Строка - версия основной обработки для снимков и заголовков.
Перем ИменаИзмененныхСнимков; // Структура, Неопределено - отметки снимков для передачи в форму.
Перем СхемаСканирования; // Массив, Неопределено - схема, подготовленная один раз для объекта.
Перем СистемныеСведения; // Структура, Неопределено - новый сбор только командой пользователя.
Перем КэшДиагностики; // Структура, Неопределено - до закрытия обработки или сброса конфигурации.
Перем СведенияДополнительногоСкана; // Структура, Неопределено - основной скан этот снимок не перезаписывает.
Перем ИсполнительСканированияТаблиц; // ВнешняяОбработкаОбъект, Неопределено - ленивый сканер.
Перем ИсполнительИнтерфейсаОбработки; // ВнешняяОбработкаОбъект, Неопределено - ленивый построитель.
Перем ИсполнительЧтенияДанных; // ВнешняяОбработкаОбъект, Неопределено - ленивый доступ к данным.
Перем ИсполнительПредставленияДанных; // ВнешняяОбработкаОбъект, Неопределено - форматирование.
Перем ИсполнительСнимков; // ВнешняяОбработкаОбъект, Неопределено - сравнение снимков.
Перем ИсполнительПечати; // ВнешняяОбработкаОбъект, Неопределено - готовые данные печати.
Перем ИсполнительСистемныхСведений; // ВнешняяОбработкаОбъект, Неопределено - сбор сведений ОС.

// #КонецОбласти

// #Область ПрограммныйИнтерфейс

// #Область РегистрацияИОткрытие

// Описывает регистрацию обработки в БСП без чтения прикладных данных.
//
// Возвращаемое значение:
//  Структура - версия, назначение и таблица команд регистрации БСП.
//   * Наименование - Строка - синоним обработки, при отсутствии — имя метаданных.
//   * Информация - Строка - текст регистрации обработки.
//   * Вид - Строка - ДополнительнаяОбработка.
//   * Версия - Строка - текущая версия обработки.
//   * БезопасныйРежим - Булево - Ложь; обработка рассчитана на полные права.
//   * Команды - ТаблицаЗначений - команды регистрации БСП: Представление, Идентификатор, Использование,
//     ПоказыватьОповещение, Модификатор.
Функция СведенияОВнешнейОбработке() Экспорт
	
	ИмяОбработки = ЭтотОбъект.Метаданные().Имя;
	СинонимОбработки = ЭтотОбъект.Метаданные().Синоним;
	СинонимОбработки = ?(ЗначениеЗаполнено(СинонимОбработки), СинонимОбработки, ИмяОбработки);
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Наименование", СинонимОбработки);
	ПараметрыРегистрации.Вставить("Информация", СинонимОбработки);
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", ВерсияОбработки);
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	
	ТаблицаКоманд = НоваяТаблицаКоманд();
	
	ДобавитьКоманду(ТаблицаКоманд, СинонимОбработки, ИмяОбработки, "ОткрытиеФормы", Истина, "");
	
	ПараметрыРегистрации.Вставить("Команды", ТаблицаКоманд);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныйПрограммныйИнтерфейс

// #Область РегистрацияИОткрытие

// Передает построителю схему и создает элементы выбранного интерфейса.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
Процедура ИнициализироватьРеквизитыЭлементыКомандыФормы(Представление) Экспорт
	
	ТекущийСкан = Новый ХранилищеЗначения(Неопределено);
	СканДляСравнения = Новый ХранилищеЗначения(Неопределено);
	ИнициализироватьСхемуСканирования();
	Построитель = ИсполнительИнтерфейса();
	Построитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(), ИсполнительСканов());
	Построитель.ИнициализироватьРеквизитыЭлементыКомандыФормы(Представление);
	ОтметитьИзменениеСостояния("ТекущийСкан");
	ОтметитьИзменениеСостояния("СканДляСравнения");
	ОтметитьИзменениеСостояния("КэшДиагностики");
	ОтметитьИзменениеСостояния("ДополнительныеСведения");
	
КонецПроцедуры

// Отображает уже собранные сведения о приложении и системе.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
Процедура ОбновитьКраткуюИнформацию(Представление) Экспорт
	
	Построитель = ИсполнительИнтерфейса();
	Построитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(), ИсполнительСканов());
	Построитель.ОбновитьКраткуюИнформацию(Представление);
	
КонецПроцедуры

// Обновляет только подпись текущих отборов и актуальности опубликованных снимков.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - основная форма обработки.
Процедура ОбновитьОтборыФормы(Представление) Экспорт
	
	ИсполнительИнтерфейса().ОбновитьОтборыФормы(Представление, ДанныеТекущегоСкана(),
		ДанныеДополнительногоСкана(), ИсполнительСканов(), ИсполнительПредставления());
	
КонецПроцедуры

// Применяет переданный отбор к обычному списку.
//
// Параметры:
//  Список - СправочникСписок, ДокументСписок, РегистрСведенийСписок, РегистрНакопленияСписок,
//   РегистрБухгалтерииСписок, РегистрРасчетаСписок, ПланВидовХарактеристикСписок, ПланСчетовСписок,
//   ПланВидовРасчетаСписок, ПланОбменаСписок, БизнесПроцессСписок, ЗадачаСписок, ЖурналДокументовСписок - источник
//   обычного списка с коллекцией Отбор.
//  ОтборСписка - Структура - поля, период и организация списка.
Процедура УстановитьОтборОбычногоСписка(Список, ОтборСписка) Экспорт
	
	ИсполнительИнтерфейса().УстановитьОтборОбычногоСписка(Список, ОтборСписка);
	
КонецПроцедуры

// Возвращает период из настроек формы; в обычной форме нормализует границы дней.
//
// Параметры:
//  ФормаПриложения - Форма, УправляемаяФорма - источник настроек периода.
//  ПроверятьГраницы - Булево - отклонять период, у которого начало позже окончания.
//
// Возвращаемое значение:
//  - СтандартныйПериод - период из элементов формы; для обычного интерфейса границы приведены к началу и концу дня.
//  - Неопределено - значение отсутствует.
Функция ПериодОтбораФормы(ФормаПриложения, ПроверятьГраницы = Ложь) Экспорт
	
	Возврат ИсполнительИнтерфейса().ПериодОтбораФормы(ФормаПриложения, ПроверятьГраницы);
	
КонецФункции

// Возвращает параметры открытия стандартного списка по описаниям полей отбора.
//
// Параметры:
//  ОтборСписка - Структура - поля, период и организация, подготовленные службой данных.
//
// Возвращаемое значение:
//  Структура - параметры открытия штатного списка по описанию полей отбора.
Функция ПараметрыСтандартногоСписка(ОтборСписка) Экспорт
	
	Возврат ИсполнительИнтерфейса().ПараметрыСтандартногоСписка(ОтборСписка);
	
КонецФункции

// Возвращает пользовательские настройки списка с видимым отбором по организации и периоду регистра.
//
// Параметры:
//  Настройки - ПользовательскиеНастройкиКомпоновкиДанных - текущие пользовательские настройки штатного списка.
//  ИдентификаторОтбора - Строка - путь доступного пользовательского отбора списка.
//  ОтборСписка - Структура - поля и значения периода и организации из службы данных.
//
// Возвращаемое значение:
//  Структура - пользовательские настройки с временным отбором и исходными значениями для восстановления.
//   * Настройки - ПользовательскиеНастройкиКомпоновкиДанных - настройки с примененным временным отбором.
//   * ОтборУстановлен - Булево - установлен ли доступный пользовательский отбор.
//   * ИсходныеНастройки - ПользовательскиеНастройкиКомпоновкиДанных - копия для восстановления при закрытии.
Функция ПользовательскиеНастройкиСОтборомСписка(Настройки, ИдентификаторОтбора, ОтборСписка) Экспорт
	
	Возврат ИсполнительИнтерфейса().ПользовательскиеНастройкиСОтборомСписка(
		Настройки, ИдентификаторОтбора, ОтборСписка);
	
КонецФункции

// Устанавливает заголовок формы с версией обработки.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
Процедура УстановитьЗаголовокФормы(Представление) Экспорт
	
	Построитель = ИсполнительИнтерфейса();
	Построитель.Инициализировать(КонтекстИнтерфейса(), Представление, ИсполнительПредставления(), ИсполнительСканов());
	Построитель.УстановитьЗаголовокФормы(Представление);
	
КонецПроцедуры

// Создает описания таблиц и ресурсов до первого сканирования.
Процедура ИнициализироватьСхемуСканирования() Экспорт
	
	Таблицы.Очистить();
	ДополнительныеРесурсы.Очистить();
	
	Для Каждого Настройка Из ОписанияТаблицСкана() Цикл
		Если Настройка.ОтдельныеСведения Тогда
			Продолжить;
		КонецЕсли;
		
		Описание = Таблицы.Добавить();
		Описание.КоллекцияОбъектовМетаданных = Настройка.ИмяТаблицыМн;
		Описание.Имя = Настройка.ИмяТаблицы;
		Описание.Синоним = Настройка.СинонимТаблицы;
		Описание.ЗаголовокСтраницы = Настройка.ЗаголовокСтраницы;
		Описание.Дополнительная = Настройка.ЭтоДополнительнаяТаблица;
		
		Для Каждого Ресурс Из Настройка.ДополнительныеРесурсы Цикл
			ЗаполнитьЗначенияСвойств(ДополнительныеРесурсы.Добавить(), Ресурс);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область СеансСканирования

// Фиксирует отборы и создает сеанс; временные данные принадлежат указанному владельцу.
//
// Параметры:
//  Период - Структура, Неопределено - период отбора с ДатойНачала и ДатойОкончания; отсутствие означает весь
//   период.
//  Организация - ЛюбаяСсылка, Неопределено - организация отбора; пустая ссылка отключает отбор.
//  Основные - Булево - включить основной этап в план сеанса.
//  Дополнительные - Булево - включить дополнительные разделы в план сеанса.
//  Владелец - УникальныйИдентификатор - владелец временных данных сеанса.
//
// Возвращаемое значение:
//  Структура - сеанс из МодульСканированиеТаблиц.НовыйСеанс с дополнительным полем Сборка типа Строка.
Функция НовыйСеансСканирования(Период, Организация, Основные, Дополнительные, Владелец) Экспорт
	
	УчестьДинамическоеИзменениеКонфигурации();
	Контекст = КонтекстСеансаСканирования();
	Параметры = Новый Структура("Период,Организация", Период, Организация);
	Сеанс = ИсполнительСканирования().НовыйСеанс(Таблицы.Выгрузить(), Параметры, Контекст,
		Основные, Дополнительные, Владелец);
	Сеанс.Вставить("Сборка", ИдентификаторСборки());
	
	Возврат Сеанс;
	
КонецФункции

// Выполняет очередную пачку порций и изменяет переданный сеанс.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//
// Возвращаемое значение:
//  Структура - состояние после порций; см. МодульСканированиеТаблиц.СостояниеСеанса.
Функция СледующаяПорцияСеанса(Сеанс) Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	Если ИсполнительСканированияТаблиц = Неопределено Тогда
		ИсполнительСканирования();
	КонецЕсли;
	
	Возврат ИсполнительСканированияТаблиц.ВыполнитьСледующиеПорции(Сеанс);
	
КонецФункции

// Публикует готовый этап в форме и снимках; само подтверждение выполняется отдельным вызовом.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма, в которой сохраняется результат перед подтверждением
//   публикации.
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//  ВозвращатьИзменения - Булево - вернуть измененные снимки после публикации.
//
// Возвращаемое значение:
//  - Структура - измененные снимки либо отсутствие запрошенного результата.
//  - Неопределено - значение отсутствует.
Функция ПубликацияСеанса(Представление, Сеанс, ВозвращатьИзменения = Истина) Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	Если Сеанс.Статус = "ПубликацияОсновных" Тогда
		ОпубликоватьОсновныеТаблицы(Представление, Сеанс);
	ИначеЕсли Сеанс.Статус = "ПубликацияДополнительных" Тогда
		ОпубликоватьДополнительныеТаблицы(Представление, Сеанс);
	КонецЕсли;
	
	Если ВозвращатьИзменения Тогда
		Возврат ИзмененноеСостояние();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Подтверждает публикацию после сохранения данных формы; повторное подтверждение допустимо.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//  ИдентификаторПубликации - Строка - ключ подтверждения; повторный ключ обрабатывается без повторного продвижения.
Процедура ПодтвердитьПубликациюСканирования(Сеанс, ИдентификаторПубликации = "") Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	ИсполнительСканирования().ПодтвердитьПубликациюСеанса(Сеанс, Неопределено, ИдентификаторПубликации);
	
КонецПроцедуры

// Экспорт совместимости для контролируемых сценариев; команда отмены в интерфейсе не предоставляется.
// Отменяет сеанс между порциями; выполняющийся запрос принудительно не прерывает.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
Процедура ОтменитьСеансСканирования(Сеанс) Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	ИсполнительСканирования().ОтменитьСеанс(Сеанс);
	
КонецПроцедуры

// Экспорт совместимости для контролируемых повторов; отдельной команды повтора в интерфейсе нет.
// Возвращает ошибочную порцию к выполнению, сохраняя уже собранные данные.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
Процедура ПовторитьСеансСканирования(Сеанс) Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	ИсполнительСканирования().ПовторитьСеанс(Сеанс);
	
КонецПроцедуры

// Освобождает временные данные сеанса; повторный вызов безопасен.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
Процедура ОсвободитьСеансСканирования(Сеанс) Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	ИсполнительСканирования().ОсвободитьСеанс(Сеанс);
	
КонецПроцедуры

// Читает состояние без выполнения новых запросов.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//
// Возвращаемое значение:
//  Структура - состояние без выполнения запросов; см. МодульСканированиеТаблиц.СостояниеСеанса.
Функция СостояниеСеансаСканирования(Сеанс) Экспорт
	
	ПроверитьСборкуСеанса(Сеанс);
	
	Возврат ИсполнительСканирования().СостояниеСеанса(Сеанс);
	
КонецФункции

// #КонецОбласти

// #Область ТранспортСеанса

// Продвигает сеанс и сохраняет его по прежнему адресу временного хранилища.
//
// Параметры:
//  Адрес - Строка - адрес во временном хранилище; файловые адаптеры освобождают его по своему контракту.
//
// Возвращаемое значение:
//  Структура - состояние после порций; см. МодульСканированиеТаблиц.СостояниеСеанса.
Функция ПродолжениеСеансаИзХранилища(Адрес) Экспорт
	
	Сеанс = ПолучитьИзВременногоХранилища(Адрес);
	Состояние = СледующаяПорцияСеанса(Сеанс);
	ПоместитьВоВременноеХранилище(Сеанс, Адрес);
	
	Возврат Состояние;
	
КонецФункции

// Применяет отмену, повтор или освобождение к сеансу по его адресу.
//
// Параметры:
//  Адрес - Строка - адрес сеанса сканирования; команда Освободить удаляет сеанс и его порции.
//  ДействиеСеанса - Строка - Отменить, Повторить или Освободить.
Процедура ИзменитьСеансИзХранилища(Адрес, ДействиеСеанса) Экспорт
	
	Сеанс = ПолучитьИзВременногоХранилища(Адрес);
	
	Если Сеанс = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДействиеСеанса = "Отменить" Тогда
		ОтменитьСеансСканирования(Сеанс);
	ИначеЕсли ДействиеСеанса = "Повторить" Тогда
		ПовторитьСеансСканирования(Сеанс);
	ИначеЕсли ДействиеСеанса = "Освободить" Тогда
		ОсвободитьСеансСканирования(Сеанс);
		УдалитьИзВременногоХранилища(Адрес);
		
		Возврат;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(Сеанс, Адрес);
	
КонецПроцедуры

// Подтверждает публикацию и сохраняет измененный сеанс по прежнему адресу.
//
// Параметры:
//  Адрес - Строка - адрес во временном хранилище; файловые адаптеры освобождают его по своему контракту.
//  Идентификатор - Строка - идентификатор публикации, подтверждаемой после сохранения формы.
//
// Возвращаемое значение:
//  Структура - состояние после подтверждения; см. МодульСканированиеТаблиц.СостояниеСеанса.
Функция ПодтверждениеСеансаИзХранилища(Адрес, Идентификатор) Экспорт
	
	Сеанс = ПолучитьИзВременногоХранилища(Адрес);
	ПодтвердитьПубликациюСканирования(Сеанс, Идентификатор);
	ПоместитьВоВременноеХранилище(Сеанс, Адрес);
	
	Возврат ИсполнительСканирования().СостояниеСеанса(Сеанс);
	
КонецФункции

// #КонецОбласти

// #Область СостояниеИСравнение

// Возвращает Истина, если завершенный основной снимок доступен.
//
// Возвращаемое значение:
//  Булево - Истина, если опубликованный основной снимок доступен.
Функция ЕстьТекущийСкан() Экспорт
	
	Возврат ДанныеТекущегоСкана() <> Неопределено;
	
КонецФункции

// Разворачивает снимок дополнительных сведений для текущего вызова.
//
// Возвращаемое значение:
//  - Структура - библиотеки, расширения, организации и диагностика разделов.
//  - Неопределено - значение отсутствует.
Функция ДанныеДополнительногоСкана() Экспорт
	
	Возврат СведенияДополнительногоСкана;
	
КонецФункции

// Запоминает переданный дополнительный снимок; основной снимок и эталон не меняет.
//
// Параметры:
//  Данные - Структура, Неопределено - снимок дополнительных разделов; см.
//   МодульСканированиеТаблиц.ДополнительныйРезультатСеанса.
Процедура УстановитьДополнительныйСкан(Знач Данные) Экспорт
	
	СведенияДополнительногоСкана = Данные;
	
КонецПроцедуры

// Предоставляет кэш физических имен и описаний для текущего сеанса обработки.
//
// Возвращаемое значение:
//  Структура - имена таблиц, описания расширений, проверенные таблицы и библиотеки.
//   * ИменаТаблиц - Соответствие, Неопределено - физические имена по полным именам метаданных.
//   * Расширения - Соответствие - кэш описаний расширений.
//   * ПроверенныеТаблицы - Соответствие - отметки уже проверенных таблиц.
//   * ОписаниеБиблиотек - ТаблицаЗначений, Неопределено - библиотеки, прочитанные за жизнь обработки.
//   * ВозможностиИнтерфейса - Структура - необязательный кэш из МодульДоступКДанным.ВозможностиИнтерфейса.
//   * ДинамическоеИзменениеУчтено - Булево - необязательная отметка однократного сброса кэша.
Функция ДанныеКэшаДиагностики() Экспорт
	
	Если КэшДиагностики = Неопределено Тогда
		КэшДиагностики = Новый Структура;
		КэшДиагностики.Вставить("ИменаТаблиц", Неопределено);
		КэшДиагностики.Вставить("Расширения", Новый Соответствие);
		КэшДиагностики.Вставить("ПроверенныеТаблицы", Новый Соответствие);
		КэшДиагностики.Вставить("ОписаниеБиблиотек", Неопределено);
	КонецЕсли;
	
	Возврат КэшДиагностики;
	
КонецФункции

// Принимает кэш имен, расширений и описаний после выполнения сеанса.
//
// Параметры:
//  Данные - Структура - кэш после выполнения сеанса; состав описан в ДанныеКэшаДиагностики.
Процедура УстановитьКэшДиагностики(Знач Данные) Экспорт
	
	КэшДиагностики = Данные;
	
КонецПроцедуры

// Сбрасывает кэш физических имен таблиц после изменения конфигурации.
Процедура СброситьКэшИменТаблиц() Экспорт
	
	Кэш = ДанныеКэшаДиагностики();
	Кэш.ИменаТаблиц = Неопределено;
	Кэш.ПроверенныеТаблицы.Очистить();
	ОтметитьИзменениеСостояния("КэшДиагностики");
	
КонецПроцедуры

// Заменяет эталон копией текущего скана и включает колонки сравнения.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
Процедура ЗапомнитьТекущийСкан(Представление) Экспорт
	
	Скан = ДанныеТекущегоСкана();
	
	Если Скан = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СканДляСравнения = Новый ХранилищеЗначения(Скан);
	ОбновитьОтображениеСравнения(Представление);
	ОтметитьИзменениеСостояния("СканДляСравнения");
	
КонецПроцедуры

// Проверяет MXL и устанавливает его основную часть как эталон сравнения.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
//  Документ - ТабличныйДокумент - документ печати со служебной секцией скана.
Процедура УстановитьСканИзДокумента(Представление, Документ) Экспорт
	
	Скан = ИсполнительСканов().СканИзТабличногоДокумента(Документ);
	
	Если Скан.Конфигурация <> Метаданные.Имя Тогда
		ВызватьИсключение НСтр("ru='В файле скан другой конфигурации: '") + Скан.Конфигурация;
	КонецЕсли;
	
	СканДляСравнения = Новый ХранилищеЗначения(Скан);
	ОбновитьОтображениеСравнения(Представление);
	ОтметитьИзменениеСостояния("СканДляСравнения");
	
КонецПроцедуры

// #КонецОбласти

// #Область ПечатьИСохранение

// Формирует печатный документ и записывает его заголовок в выходной параметр.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - параметр совместимости; формированию документа не требуется.
//  ВыводитьТакжеДопТаблицы - Булево - включить дополнительные табличные разделы в печатный документ.
//  ЗаголовокДокумента - Строка - выходной параметр: заполняется названием, датой и идентификатором базы.
//
// Возвращаемое значение:
//  ТабличныйДокумент - основная информация и выбранные дополнительные таблицы.
Функция Печать(Представление, ВыводитьТакжеДопТаблицы, ЗаголовокДокумента = "") Экспорт
	
	Скан = ДанныеТекущегоСкана();
	Сведения = ДанныеДополнительногоСкана();
	Представления = ИсполнительПредставления();
	Данные = Представления.ДанныеТаблицДляПечати(ОписанияТаблицСкана(), Скан, Сведения, ДанныеКэшаДиагностики());
	Контекст = Новый Структура;
	Контекст.Вставить("Данные", Данные);
	Контекст.Вставить("Макет", ПолучитьМакет("МакетПечати"));
	Контекст.Вставить("Сведения", Сведения);
	Контекст.Вставить("ОтборПечати", ИсполнительСканов().ПредставлениеОтборовПечати(Скан, Сведения));
	Контекст.Вставить("РазделыСведений",
		Представления.РазделыСведенийДляПечати(ОписанияТаблицСкана(), Сведения));
	Контекст.Вставить("ДополнительныеСтроки",
		Представления.ДополнительныеСтрокиДляПечати(ОписанияТаблицСкана(), Данные));
	Контекст.Вставить("СистемныеСтроки", Представления.СистемныеСтроки(ДанныеСистемногоСкана()));
	ЗаголовокДокумента = Представления.ЗаголовокПечатногоДокумента(ТекущаяДата(), ПредставлениеИдентификатораБазы());
	Контекст.Вставить("ЗаголовокДокумента", ЗаголовокДокумента);
	
	Если ИсполнительПечати = Неопределено Тогда
		ИсполнительПечати = НоваяСлужебнаяОбработкаИзМакета("МодульПечатьРезультатов");
	КонецЕсли;
	
	ИсполнительПечати.Инициализировать(Контекст);
	
	Возврат ИсполнительПечати.ПечатнаяФормаИнформацииОБазеДанных(ВыводитьТакжеДопТаблицы);
	
КонецФункции

// Формирует единый документ печати и сериализованного скана для сохранения.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
//
// Возвращаемое значение:
//  - ТабличныйДокумент - документ с данными скана либо отсутствие основного снимка.
//  - Неопределено - значение отсутствует.
Функция ДокументТекущегоСкана(Представление) Экспорт
	
	Скан = ДанныеТекущегоСкана();
	
	Если Скан = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Документ = Печать(Представление, Истина);
	ИсполнительСканов().ДобавитьСканВТабличныйДокумент(Документ, Скан);
	
	Возврат Документ;
	
КонецФункции

// Читает идентификатор, предоставляемый конфигурацией; недоступность не заменяется вымышленным UUID.
//
// Возвращаемое значение:
//  Строка - идентификатор базы либо пояснение его недоступности.
Функция ПредставлениеИдентификатораБазы() Экспорт
	
	Возврат ИсполнительДоступаКДанным().ПредставлениеИдентификатораБазы();
	
КонецФункции

