// Подготавливает данные и ограничения интерфейса универсального списка выбранных метаданных.
//
// Параметры:
//  ПараметрыОткрытия - Структура - КоллекцияОбъектовМетаданных и ОбъектМетаданных выбранного списка.
//
// Возвращаемое значение:
//  Структура - описание списка; см. МодульДоступКДанным.ДанныеУниверсальногоСписка.
Функция ДанныеУниверсальногоСписка(ПараметрыОткрытия) Экспорт
	
	ОписанияТаблицСкана();
	
	ДанныеСписка = ИсполнительДоступаКДанным().ДанныеУниверсальногоСписка(ПараметрыОткрытия);
	ИсполнительИнтерфейса().ПодготовитьОтборыУниверсальногоСписка(ДанныеСписка);
	
	Возврат ДанныеСписка;
	
КонецФункции

// Проверяет, допускает ли тип константы редактирование в универсальном окне.
//
// Параметры:
//  ИмяКонстанты - Строка - имя существующей константы в метаданных конфигурации.
//
// Возвращаемое значение:
//  Булево - Ложь для ХранилищаЗначения, Истина для поддерживаемых типов.
Функция КонстантаРедактируемаВУниверсальномОкне(ИмяКонстанты) Экспорт
	
	Возврат ИсполнительДоступаКДанным().КонстантаРедактируемаВУниверсальномОкне(ИмяКонстанты);
	
