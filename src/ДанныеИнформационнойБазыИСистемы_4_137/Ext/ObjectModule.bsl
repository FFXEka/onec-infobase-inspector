// Собирает локальные сведения обычного приложения с учетом ОС и предохранителя.
//
// Параметры:
//  Подробно - Булево - запрашивать подробные сведения ОС; может требовать штатного разрешения.
//  Повторить - Булево - разрешение повторить сбор этой стороны после срабатывания предохранителя.
//
// Возвращаемое значение:
//  Структура - клиентские сведения; см. МодульСистемныеСведения.СведенияКомпьютераПоОС.
Функция СведенияОбычногоКлиента(Подробно, Повторить = Ложь) Экспорт
	
	Область = СтрокаСоединенияИнформационнойБазы() + ИмяПользователя();
	
	Возврат ИсполнительСистемныхДанных().СведенияКомпьютераПоОС(Подробно, Область, "Клиент", Повторить);
	
КонецФункции

// Создает описание недоступности отдельного сервера для обычного приложения.
//
// Возвращаемое значение:
//  Структура - сведения с причиной недоступности; см. МодульСистемныеСведения.НедоступныеСведенияСервера.
Функция НедоступныеСведенияСервера() Экспорт
	
	Возврат ИсполнительСистемныхДанных().НедоступныеСведенияСервера();
	
КонецФункции

// Сохраняет или отображает переданные сведения компьютеров; повторный сбор не запускает.
//
// Параметры:
//  Представление - Форма, УправляемаяФорма - форма обработки, в которой отображаются готовые данные.
//  Сведения - Структура, Неопределено - готовые сведения; см. МодульСистемныеСведения.СведенияКомпьютеров.
Процедура ОбновитьСведенияКомпьютеров(Представление, Сведения) Экспорт
	
	СистемныеДанные = ДанныеСистемногоСкана();
	СистемныеДанные.Компьютеры = Сведения;
	СистемныеДанные.РежимРаботы = ИсполнительДоступаКДанным().СведенияФайловойБазы();
	ОтметитьИзменениеСостояния("СистемныеСведения");
	Отображение(Представление).ОбновитьСведенияКомпьютеров(Представление);
	
КонецПроцедуры

// Подключает системный исполнитель и определяет путь его служебной формы.
//
// Возвращаемое значение:
//  Строка - полное имя формы для управляемых серверных вызовов.
Функция ИмяФормыСистемнойДиагностики() Экспорт
	
	Возврат "ВнешняяОбработка." + ИсполнительСистемныхДанных().Метаданные().Имя + ".Форма.СведенияОКомпьютерах";
	
КонецФункции

