// #Область ОбработчикиСобытийФормы

// #Область ВспомогательныеМетоды

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ПараметрыОткрытия = Параметры.ПараметрыОткрытия;
	ПараметрыОткрытия.Вставить("КоличествоСтрокТабличныхЧастей", КоличествоСтрокТабличныхЧастей);
	ДанныеСписка = ОбработкаОбъект.ДанныеУниверсальногоСписка(ПараметрыОткрытия);
	КоллекцияСписка = Параметры.ПараметрыОткрытия.КоллекцияОбъектовМетаданных;
	ИмяОбъектаСписка = Параметры.ПараметрыОткрытия.ОбъектМетаданных;
	Заголовок = "Универсальный список: " + ДанныеСписка.СинонимКоллекции
		+ " " + ДанныеСписка.СинонимОбъекта;
	Список.ОсновнаяТаблица = ДанныеСписка.ОсновнаяТаблица;
	Список.ДинамическоеСчитываниеДанных = ДанныеСписка.ДинамическоеСчитываниеДанных;
	УстановитьТекстЗапросаСписка(ДанныеСписка);
	Элементы.КоличествоСтрокТабличныхЧастей.Видимость = ДанныеСписка.ИменаПолейТабличныхЧастей.Количество() > 0;
	СоздатьОтборыСписка(ДанныеСписка);
	ДобавитьЭлементыНаФорму(ДанныеСписка.Поля, ДанныеСписка.ИменаПолейТабличныхЧастей);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СброситьШтатныйПериодСписка();
	Элементы.Список.Обновить();
	
КонецПроцедуры

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область ВспомогательныеМетоды

&НаСервере
Процедура УстановитьТекстЗапросаСписка(ДанныеСписка)
	
	Список.ТекстЗапроса = ДанныеСписка.ТекстЗапроса;
	
	Для Каждого Параметр Из ДанныеСписка.ПараметрыЗапроса Цикл
		Список.Параметры.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыНаФорму(МассивПолей, ИменаПолейТабличныхЧастей)
	
	ОшибкиКолонок = "";
	
	Для Каждого Поле Из МассивПолей Цикл
		ДобавитьКолонкуСписка(Поле, ОшибкиКолонок, ИменаПолейТабличныхЧастей);
	КонецЦикла;
	
	Если Не ПустаяСтрока(ОшибкиКолонок) Тогда
		Сообщить(НСтр("ru='Не удалось отобразить некоторые колонки универсального списка. '")
			+ "Остальные колонки доступны." + Символы.ПС + ОшибкиКолонок);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуСписка(Знач Поле, ОшибкиКолонок, ИменаПолейТабличныхЧастей = Неопределено)
	
	ИмяПоля = Поле;
	Если Лев(Поле, 5) = "$ТЧ$_" Тогда
		ИмяПоля = ИменаПолейТабличныхЧастей.Получить(Сред(Поле, 6));
	КонецЕсли;
	НовыйЭлемент = Неопределено;
	
	Попытка
		НовыйЭлемент = Элементы.Добавить(ИмяЭлементаКолонкиСписка(ИмяПоля), Тип("ПолеФормы"), Элементы.Список);
		НовыйЭлемент.ПутьКДанным = "Список." + ИмяПоля;
		НовыйЭлемент.Заголовок = ?(Лев(Поле, 5) = "$ТЧ$_", Сред(Поле, 6) + " (строк)", Поле);
	Исключение
		ОшибкиКолонок = ОшибкиКолонок + ИмяПоля + ": " + ОписаниеОшибки() + Символы.ПС;
		
		Если НовыйЭлемент <> Неопределено Тогда
			НовыйЭлемент.Видимость = Ложь;
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область ОтборыСписка

&НаСервере
Процедура УдалитьНастройкиСчетчиковСписка(ИменаПолей)
	
	КУдалению = Новый Массив;
	Для Каждого Элемент Из Список.Порядок.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементПорядкаКомпоновкиДанных") Тогда
			Если ЭтоПолеСчетчикаСписка(Элемент.Поле, ИменаПолей) Тогда
				КУдалению.Добавить(Элемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из КУдалению Цикл
		Список.Порядок.Элементы.Удалить(Элемент);
	КонецЦикла;
	УдалитьОтборыСчетчиковСписка(Список.Отбор.Элементы, ИменаПолей);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьОтборыСчетчиковСписка(ЭлементыОтбора, ИменаПолей)
	
	КУдалению = Новый Массив;
	Для Каждого Элемент Из ЭлементыОтбора Цикл
		Если ТипЗнч(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			КоличествоДоУдаления = Элемент.Элементы.Количество();
			УдалитьОтборыСчетчиковСписка(Элемент.Элементы, ИменаПолей);
			Если КоличествоДоУдаления > 0 И Элемент.Элементы.Количество() = 0 Тогда
				КУдалению.Добавить(Элемент);
			КонецЕсли;
		ИначеЕсли ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если ЭтоПолеСчетчикаСписка(Элемент.ЛевоеЗначение, ИменаПолей)
				Или ЭтоПолеСчетчикаСписка(Элемент.ПравоеЗначение, ИменаПолей) Тогда
				КУдалению.Добавить(Элемент);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Элемент Из КУдалению Цикл
		ЭлементыОтбора.Удалить(Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЭтоПолеСчетчикаСписка(Значение, ИменаПолей)
	
	Если ТипЗнч(Значение) <> Тип("ПолеКомпоновкиДанных") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Поле Из ИменаПолей Цикл
		Если Строка(Значение) = Поле.Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура УдалитьКолонкиТабличныхЧастей(ИменаПолей)
	
	Для Каждого Поле Из ИменаПолей Цикл
		Колонка = Элементы.Найти("ПолеСписка" + Поле.Значение);
		Если Колонка <> Неопределено Тогда
			Элементы.Удалить(Колонка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкиТабличныхЧастей(ИменаПолей)
	
	ОшибкиКолонок = "";
	Для Каждого Поле Из ИменаПолей Цикл
		Если Элементы.Найти("ПолеСписка" + Поле.Значение) = Неопределено Тогда
			ДобавитьКолонкуСписка("$ТЧ$_" + Поле.Ключ, ОшибкиКолонок, ИменаПолей);
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПустаяСтрока(ОшибкиКолонок) Тогда
		Сообщить(ОшибкиКолонок);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ИмяЭлементаКолонкиСписка(ИмяПоля)
	
	ОсноваИмени = "ПолеСписка" + ИмяПоля;
	ИмяЭлемента = ОсноваИмени;
	Номер = 0;
	
	Пока Элементы.Найти(ИмяЭлемента) <> Неопределено Цикл
		Номер = Номер + 1;
		ИмяЭлемента = ОсноваИмени + Формат(Номер, "ЧГ=;ЧН=0");
	КонецЦикла;
	
	Возврат ИмяЭлемента;
	
КонецФункции

&НаКлиенте
Процедура ОтборСпискаПриИзменении(Элемент)
	
	Попытка
		СброситьШтатныйПериодСписка();
		ПрименитьОтборыНаСервере();
		Элементы.Список.Обновить();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборыНаСервере()
	
	ПараметрыСписка = ПараметрыИзОтборовСписка();
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДанныеСписка = ОбработкаОбъект.ДанныеУниверсальногоСписка(ПараметрыСписка);
	Если Не КоличествоСтрокТабличныхЧастей Тогда
		УдалитьНастройкиСчетчиковСписка(ДанныеСписка.ИменаПолейТабличныхЧастей);
		УдалитьКолонкиТабличныхЧастей(ДанныеСписка.ИменаПолейТабличныхЧастей);
	КонецЕсли;
	
	УстановитьТекстЗапросаСписка(ДанныеСписка);
	Если КоличествоСтрокТабличныхЧастей Тогда
		ДобавитьКолонкиТабличныхЧастей(ДанныеСписка.ИменаПолейТабличныхЧастей);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыИзОтборовСписка()
	
	ПараметрыСписка = Новый Структура;
	
	ПараметрыСписка.Вставить("КоллекцияОбъектовМетаданных", КоллекцияСписка);
	ПараметрыСписка.Вставить("ОбъектМетаданных", ИмяОбъектаСписка);
	
	Период = Неопределено;
	Организация = Неопределено;
	
	Если Не ПустаяСтрока(ПолеПериодаСписка) Тогда
		Период = НормализованныйПериодСписка(ЭтаФорма["ПериодСписка"]);
	КонецЕсли;
	
	Если Не ПустаяСтрока(ПолеОрганизацииСписка) Тогда
		ЗначениеОтбора = ЭтаФорма["ОрганизацияСписка"];
		Организация = ?(ЗначениеЗаполнено(ЗначениеОтбора), ЗначениеОтбора, Неопределено);
	КонецЕсли;
	
	ПараметрыСписка.Вставить("Период", Период);
	ПараметрыСписка.Вставить("Организация", Организация);
	ПараметрыСписка.Вставить("КоличествоСтрокТабличныхЧастей", КоличествоСтрокТабличныхЧастей);
	
	Возврат ПараметрыСписка;
	
КонецФункции

&НаСервере
Процедура СоздатьОтборыСписка(ДанныеСписка)
	
	Настройки = ДанныеСписка.НастройкиОтборов;
	ПолеПериодаСписка = Настройки.ПолеПериода;
	ПолеОрганизацииСписка = Настройки.ПолеОрганизации;
	Элементы.ПериодСписка.Видимость = Не ПустаяСтрока(ПолеПериодаСписка);
	ЕстьОтборОрганизации = Не ПустаяСтрока(ПолеОрганизацииСписка);
	Элементы.ОтборыСписка.Видимость = Элементы.ПериодСписка.Видимость Или ЕстьОтборОрганизации;
	
	Если ЕстьОтборОрганизации Тогда
		Реквизиты = Новый Массив;
		Реквизиты.Добавить(Новый РеквизитФормы("ОрганизацияСписка", Настройки.ТипОрганизации));
		ИзменитьРеквизиты(Реквизиты);
		
		ПолеОрганизации = Элементы.Добавить("ОрганизацияСписка", Тип("ПолеФормы"), Элементы.ОтборыСписка);
		ПолеОрганизации.Вид = ВидПоляФормы.ПолеВвода;
		ПолеОрганизации.ПутьКДанным = "ОрганизацияСписка";
		ПолеОрганизации.Заголовок = НСтр("ru='Организация'");
		ПолеОрганизации.КнопкаОчистки = Истина;
		ПолеОрганизации.УстановитьДействие("ПриИзменении", "ОтборСпискаПриИзменении");
	КонецЕсли;
	
	СоздатьПоляОтборов(ДанныеСписка.ОтборСписка, Настройки.ТипОрганизации);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьПоляОтборов(ОтборСписка, ТипОрганизации)
	
	Если Не ПустаяСтрока(ПолеПериодаСписка) Тогда
		ПериодДляПоля = Новый СтандартныйПериод;
		Если ОтборСписка.Период <> Неопределено Тогда
			ПериодДляПоля.ДатаНачала = ОтборСписка.Период.ДатаНачала;
			Если ОтборСписка.Период.ДатаОкончания <> Дата('39991231235959') Тогда
				ПериодДляПоля.ДатаОкончания = ОтборСписка.Период.ДатаОкончания;
			КонецЕсли;
		КонецЕсли;
		ЭтаФорма["ПериодСписка"] = ПериодДляПоля;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ПолеОрганизацииСписка) Тогда
		Элементы.ОрганизацияСписка.Заголовок = ?(ПолеОрганизацииСписка = "Фирма", "Фирма", "Организация");
		
		Если ЗначениеЗаполнено(ОтборСписка.Организация)
			И ТипОрганизации.СодержитТип(ТипЗнч(ОтборСписка.Организация)) Тогда
			ЭтаФорма["ОрганизацияСписка"] = ОтборСписка.Организация;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьШтатныйПериодСписка()
	
	Если КоллекцияСписка <> "Документ" Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Список.Период = Новый СтандартныйПериод;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НормализованныйПериодСписка(ИсходныйПериод)
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Период = Новый СтандартныйПериод;
	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = ИсходныйПериод.ДатаНачала;
	
	Если ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Период.ДатаОкончания = КонецДня(ИсходныйПериод.ДатаОкончания);
	Иначе
		Период.ДатаОкончания = Дата('39991231235959');
	КонецЕсли;
	
	Если Период.ДатаОкончания < Период.ДатаНачала Тогда
		ВызватьИсключение("Дата начала периода не может быть больше даты окончания.");
	КонецЕсли;
	
	Возврат Период;
	
КонецФункции

// #КонецОбласти

// #КонецОбласти
