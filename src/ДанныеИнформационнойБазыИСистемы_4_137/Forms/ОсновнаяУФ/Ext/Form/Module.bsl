// #Область ОписаниеПеременных

&НаКлиенте
Перем НавигацияРазделов; // Массив, Неопределено - описания разделов на время жизни формы.

&НаКлиенте
Перем ПовторитьСистемныйСбор; // Булево, Структура - разрешения повторить сбор клиента и сервера.
&НаКлиенте
Перем КлиентскиеАдаптеры; // Соответствие, Неопределено - поддерживаемые API, загружаемые лениво.
&НаКлиенте
Перем ДлительнаяОперацияВыполняется; // Булево - блокировка повторного входа таймера и второй команды.
&НаКлиенте
Перем ВременныеНастройкиСтандартныхСписков; // Соответствие, Неопределено - настройки до закрытия списка.
&НаКлиенте
Перем НачалоЗамераВремени; // Дата, Неопределено - начало текущего замера операции.
&НаКлиенте
Перем ФормаОжидания; // УправляемаяФорма, Неопределено - окно прогресса до завершения операции.
&НаКлиенте
Перем АдресСеансаСканирования; // Строка - адрес текущего сеанса; очищается при завершении.
&НаКлиенте
Перем ИмяОркестратораСканирования; // Строка - имя исполнителя сеанса; очищается при завершении.

// #КонецОбласти

// #Область ОбработчикиСобытийФормы

// #Область ВспомогательныеМетоды

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработкаОбъект = ОбъектОбработкиНаСервере();
	ИдентификаторСборкиФормы = ОбработкаОбъект.ИдентификаторСборки();
	ИмяОркестратораФормы = ОбработкаОбъект.Метаданные().Имя;
	
	ОбработкаОбъект.УстановитьЗаголовокФормы(ЭтаФорма);
	
	ОбработкаОбъект.ИнициализироватьРеквизитыЭлементыКомандыФормы(ЭтаФорма);
	ОбработкаОбъект.ОбновитьКраткуюИнформацию(ЭтаФорма);
	
	СохранитьОбъектОбработкиНаСервере(ОбработкаОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НавигацияРазделов = ОбновитьСведенияКлиентскогоПриложенияНаСервере(
		ЗаголовокКлиентскогоПриложения(), ТипКлиентскогоПриложения());
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "КонстантаИзменена" Тогда
		ОбновитьКонстантуНаСервере(Параметр);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	
	ОбновитьНадписьОтборовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	ВосстановитьНастройкиОткрытыхСписков();
	ОтключитьОбработчикОжидания("ПродолжитьСканирование");
	ДлительнаяОперацияВыполняется = Ложь;
	ОсвободитьТекущийСеанс(Ложь);
	ЗакрытьОкноОжидания();
	
КонецПроцедуры

// #КонецОбласти

// #КонецОбласти

// #Область ОбработчикиСобытийЭлементовТаблицыФормы

// #Область ОткрытиеЗначенияКонстанты

&НаКлиенте
Процедура КонстантыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не КонстантаРедактируемаНаСервере(Элемент.ТекущиеДанные.МетаданныеИмя) Тогда
		ПредупредитьПользователя(НСтр("ru='Хранилище значения не поддерживает редактирование в этом окне.'"));
		
		Возврат;
	КонецЕсли;
	
	ПараметрыОкна = Новый Структура("ИмяКонстанты", Элемент.ТекущиеДанные.МетаданныеИмя);
	
	Если ПоддерживаетсяРелизПлатформы(3) Тогда
		КлиентскийАдаптер(3).ОткрытьСБлокировкойВладельца(
			"ВнешняяОбработка.ДанныеИнформационнойБазыИСистемы.Форма.ЗначениеКонстантыУФ",
			ПараметрыОкна, ЭтаФорма, ПараметрыОкна.ИмяКонстанты);
	Иначе
		// В старой платформе используем штатное модальное открытие.
		ОткрытьФормуМодально("ВнешняяОбработка.ДанныеИнформационнойБазыИСистемы.Форма.ЗначениеКонстантыУФ",
			ПараметрыОкна, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область ВыборСтрокТаблиц

&НаКлиенте
Процедура СтрокаТаблицыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	СтрокаДанных = Элемент.ТекущиеДанные;
	
	Если СтрокаДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Описание = ОписаниеРазделаПоРеквизиту(Элемент.Имя);
	
	Если Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Описание.ВыборСтроки = "Ссылка" Тогда
		Если ЗначениеЗаполнено(СтрокаДанных.Ссылка) Тогда
			ПутьФормы = Описание.КоллекцияОбъектовМетаданных + "." + Описание.ОбъектМетаданных
				+ ".ФормаОбъекта";
			ОткрытьФорму(ПутьФормы, Новый Структура("Ключ", СтрокаДанных.Ссылка));
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ВыбранныеМетаданные = МетаданныеСтрокиТаблицы(Описание, СтрокаДанных);
	ОткрытьСтандартныйСписок(ВыбранныеМетаданные);
	
КонецПроцедуры

// #КонецОбласти

// #КонецОбласти

// #Область ОбработчикиКомандФормы

// #Область СнимкиИСравнение

&НаКлиенте
Процедура СканироватьОсновные(Команда)
	
	НачатьСеансТаблиц(Истина, Ложь, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура СканироватьДополнительные(Команда)
	
	НачатьСеансТаблиц(Ложь, Истина, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьСкан(Команда)
	
	ПоказатьТабличныйДокумент(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СканироватьВсе(Команда)
	
	НачатьСеансТаблиц(Истина, Истина, Истина);
	
КонецПроцедуры

// #КонецОбласти

// #Область ВспомогательныеМетоды

&НаКлиенте
Процедура ОткрытьОсновнуюФормуСписка(Команда)
	
	ВыбранныеМетаданные = ТекущиеМетаданные();
	
	Если ВыбранныеМетаданные = Неопределено Тогда
		ПредупредитьПользователя(НСтр("ru='Не выбрана строка'"));
		
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеМетаданные.КоллекцияОбъектовМетаданных = "Константы" Тогда
		ПредупредитьПользователя(НСтр("ru='Для константы используйте открытие её значения.'"));
		
		Возврат;
	КонецЕсли;
	
	ОткрытьСтандартныйСписок(ВыбранныеМетаданные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьУниверсальнуюФормуСписка(Команда)
	
	ВыбранныеМетаданные = ТекущиеМетаданные();
	
	Если ВыбранныеМетаданные = Неопределено Тогда
		ПредупредитьПользователя(НСтр("ru='Не выбрана строка'"));
		
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеМетаданные.КоллекцияОбъектовМетаданных = "Константы" Тогда
		ПредупредитьПользователя(НСтр("ru='Для константы используйте открытие её значения.'"));
		
		Возврат;
	КонецЕсли;
	
	ВыбранныеМетаданные = ПараметрыСпискаСОтборами(ВыбранныеМетаданные);
	ОткрытьФорму("ВнешняяОбработка.ДанныеИнформационнойБазыИСистемы.Форма.УниверсальнаяФормаСпискаУФ",
		Новый Структура("ПараметрыОткрытия", ВыбранныеМетаданные), ЭтаФорма, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницуАвтора(Команда)
	
	ПерейтиПоНавигационнойСсылке("https://infostart.ru/profile/510125");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСправку(Команда)
	
	ОткрытьСправку("ВнешняяОбработка.ДанныеИнформационнойБазыИСистемы");
	
КонецПроцедуры

// #КонецОбласти

// #Область КомандыСканов

&НаКлиенте
Процедура ЗапомнитьСкан(Команда)
	
	Попытка
		Если Не ЗапомнитьСканНаСервере() Тогда
			ПредупредитьПользователя(НСтр("ru='Сначала обновите основные таблицы.'"));
		КонецЕсли;
	Исключение
		ПредупредитьОбОшибкеСкана(НСтр("ru='Не удалось сохранить скан в памяти.'"), ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСкан(Команда)
	
	Адрес = Неопределено;
	
	Попытка
#Если ВебКлиент Тогда
		АдаптерСкачивания = Неопределено;
		
		Если ПоддерживаетсяРелизПлатформы(15) Тогда
			// Загрузка адаптера обращается к серверу и должна предшествовать созданию непривязанной копии.
			АдаптерСкачивания = КлиентскийАдаптер(15);
		КонецЕсли;
		
		Адрес = АдресСохраняемогоСкана(Истина);
#Иначе
		Адрес = АдресСохраняемогоСкана();
#КонецЕсли
		Если Адрес = Неопределено Тогда
			ПредупредитьПользователя(НСтр("ru='Сначала обновите основные таблицы.'"));
			
			Возврат;
		КонецЕсли;
		
		ИмяФайла = "Скан_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss") + ".mxl";
#Если ВебКлиент Тогда
		// Без callback срок хранения ограничен следующим серверным вызовом, а не жизнью формы.
		Если АдаптерСкачивания <> Неопределено Тогда
			АдаптерСкачивания.СохранитьСкан(Адрес, ИмяФайла);
		Иначе
			ПолучитьФайл(Адрес, ИмяФайла, Истина);
		КонецЕсли;
		
#Иначе
		Если ПоддерживаетсяРелизПлатформы(6) Тогда
			КлиентскийАдаптер(6).СохранитьСкан(Адрес, ИмяФайла, ЭтаФорма);
		Иначе
			ПолучитьФайл(Адрес, ИмяФайла, Истина);
			ОсвободитьСохраняемыйСкан(Адрес);
		КонецЕсли;
		
#КонецЕсли
	Исключение
		Описание = ОписаниеОшибки();
		ОсвободитьСохраняемыйСкан(Адрес);
		ПредупредитьОбОшибкеСкана(НСтр("ru='Не удалось сохранить файл скана.'"), Описание);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСканДляСравнения(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru='Скан для сравнения'");
	Диалог.Фильтр = "Скан информационной базы (*.mxl)|*.mxl";
	Диалог.МножественныйВыбор = Ложь;
	
	Если ПоддерживаетсяРелизПлатформы(13) Тогда
		КлиентскийАдаптер(13).ЗагрузитьСкан(Диалог, ЭтаФорма);
	ИначеЕсли Диалог.Выбрать() Тогда
		ЗагрузитьВыбранныйСкан(Диалог.ПолноеИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область СистемныеСведения

&НаКлиенте
Процедура СистемныеСведения(Команда)
	
	Если Не МожноНачатьДлительнуюОперацию() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		НачатьДлительнуюОперацию(Ложь);
		ОбновитьКомпьютерыНаКлиенте(Истина);
	Исключение
		ЗавершитьДлительнуюОперацию(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	
	ЗавершитьДлительнуюОперацию(Ложь);
	
КонецПроцедуры

// #КонецОбласти

// #Область ПодробныйПросмотрОбъекта

&НаКлиенте
Процедура ОткрытьПодробныйПросмотр(Команда)
	
	ПолноеИмя = ПолноеИмяПросмотраНаСервере(ТекущиеМетаданные(Истина));
	
	Если ПустаяСтрока(ПолноеИмя) Тогда
		ПредупредитьПользователя(НСтр("ru='Выберите строку существующего объекта метаданных на вкладке "
			+ "основных или дополнительных таблиц.'"));
		
		Возврат;
	КонецЕсли;
	
	ПараметрыОкна = Новый Структура("ПолноеИмяМетаданных", ПолноеИмя);
	ПутьФормыПросмотра = "ВнешняяОбработка.ДанныеИнформационнойБазыИСистемы.Форма.ПросмотрОбъектаМетаданныхУФ";
	
	Если ПоддерживаетсяРелизПлатформы(3) Тогда
		КлиентскийАдаптер(3).ОткрытьСБлокировкойВладельца(ПутьФормыПросмотра, ПараметрыОкна, ЭтаФорма, ПолноеИмя);
	Иначе
		ФормаПросмотра = ПолучитьФорму(ПутьФормыПросмотра, ПараметрыОкна, ЭтаФорма, ПолноеИмя);
		ФормаПросмотра.ОткрытьМодально();
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область ВспомогательныеМетоды

&НаКлиенте
Процедура ПоказатьТабличныйДокумент(ВыводитьТакжеДопТаблицы)
	
	ДанныеДокумента = СформированныйТабличныйДокумент(ВыводитьТакжеДопТаблицы);
	ДанныеДокумента.Документ.Показать(ДанныеДокумента.Заголовок);
	
КонецПроцедуры

&НаСервере
Функция СформированныйТабличныйДокумент(Знач ВыводитьТакжеДопТаблицы)
	
	ОбработкаОбъект = ОбъектОбработкиНаСервере();
	ЗаголовокДокумента = "";
	ПечатныйДокумент = ОбработкаОбъект.Печать(ЭтаФорма, ВыводитьТакжеДопТаблицы, ЗаголовокДокумента);
	
	Возврат Новый Структура("Документ,Заголовок", ПечатныйДокумент, ЗаголовокДокумента);
	
КонецФункции

&НаКлиенте
Процедура ОповеститьПользователяОбОжидании()
	
	Если ФормаОжидания <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("Заголовок",
		НСтр("ru='чтение данных. Это может занять несколько минут'"));
	ФормаОжидания =
		ПолучитьФорму("ВнешняяОбработка.ДанныеИнформационнойБазыИСистемы.Форма.ОжиданиеСканированияУФ",
			ПараметрыОткрытия, ЭтаФорма);
	ФормаОжидания.Открыть();
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеНавигацииРазделов()
	
	Если НавигацияРазделов = Неопределено Тогда
		НавигацияРазделов = ОписанияНавигацииНаСервере();
	КонецЕсли;
	
	Возврат НавигацияРазделов;
	
КонецФункции

&НаКлиенте
Функция ОписаниеРазделаПоИмени(ИмяРаздела)
	
	Для Каждого Описание Из ДанныеНавигацииРазделов() Цикл
		Если Описание.ИмяТаблицы = ИмяРаздела Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ОписаниеРазделаПоРеквизиту(ИмяРеквизита)
	
	Для Каждого Описание Из ДанныеНавигацииРазделов() Цикл
		Если Описание.ИмяРеквизита = ИмяРеквизита Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ОписанияНавигацииНаСервере()
	
	Возврат ОбъектОбработкиНаСервере().ОписанияРазделовФормы();
	
КонецФункции

&НаКлиенте
Функция ТекущиеМетаданные(ТребуетсяВыбраннаяСтрока = Ложь)
	
	Если Элементы.СтраницыВерхнийУровень.ТекущаяСтраница = Элементы.Информация Тогда
		ТекущаяСтраница = Элементы.СтраницыИнформации.ТекущаяСтраница;
	ИначеЕсли Элементы.СтраницыВерхнийУровень.ТекущаяСтраница = Элементы.ДополнительнаяИнформация Тогда
		ТекущаяСтраница = Элементы.СтраницыДополнительнойИнформации.ТекущаяСтраница;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Описание = ОписаниеРазделаПоИмени(Сред(ТекущаяСтраница.Имя, 4));
	
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Описание.ОтдельныеСведения Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаМетаданных = Элементы.Найти(Описание.ИмяРеквизита);
	
	Если ТаблицаМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекущиеДанные = ТаблицаМетаданных.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено
		И (ТребуетсяВыбраннаяСтрока Или ПустаяСтрока(Описание.ОбъектМетаданных)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МетаданныеСтрокиТаблицы(Описание, ТекущиеДанные);
	
КонецФункции

&НаКлиенте
Функция МетаданныеСтрокиТаблицы(Описание, СтрокаДанных)
	
	ОбъектМетаданных = Описание.ОбъектМетаданных;
	КоллекцияОбъектовМетаданных = Описание.КоллекцияОбъектовМетаданных;
	
	Если ПустаяСтрока(ОбъектМетаданных) Тогда
		ОбъектМетаданных = СтрокаДанных.МетаданныеИмя;
	КонецЕсли;
	
	Если ПустаяСтрока(КоллекцияОбъектовМетаданных) Тогда
		КоллекцияОбъектовМетаданных = СтрокаДанных.КоллекцияОбъектовМетаданныхИмя;
	КонецЕсли;
	
	Возврат Новый Структура("КоллекцияОбъектовМетаданных, ОбъектМетаданных",
		КоллекцияОбъектовМетаданных, ОбъектМетаданных);
	
КонецФункции

&НаКлиенте
Функция ТипКлиентскогоПриложения()
	
#Если ТолстыйКлиентОбычноеПриложение Тогда
	Клиент = "Толстый клиент (обычное приложение)";
#ИначеЕсли ТолстыйКлиентУправляемоеПриложение Тогда
	Клиент = "Толстый клиент (управляемое приложение)";
#ИначеЕсли Сервер Тогда
	Клиент = "Сервер";
#ИначеЕсли ВнешнееСоединение Тогда
	Клиент = "Внешнее соединение";
#ИначеЕсли ТонкийКлиент Тогда
	Клиент = "Тонкий клиент";
#ИначеЕсли ВебКлиент Тогда
	Клиент = "Веб-клиент";
#Иначе
	Клиент = "Ошибка определения среды выполнения";
#КонецЕсли
	
	Возврат Клиент;
	
КонецФункции

&НаКлиенте
Функция ЗаголовокКлиентскогоПриложения()
	
	Если ПоддерживаетсяРелизПлатформы(10) Тогда
		Возврат КлиентскийАдаптер(10).ЗаголовокПриложения();
	КонецЕсли;
	
#Если ТолстыйКлиентУправляемоеПриложение Тогда
	
	Возврат ПолучитьЗаголовокСистемы();
#Иначе
	
	Возврат "недоступен на этой версии платформы";
#КонецЕсли
	
КонецФункции

&НаКлиенте
Процедура НачатьЗамерВремени()
	
	НачалоЗамераВремени = ТекущаяДата();
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончитьЗамерВремени()
	
	Продолжительность = ВычислитьПродолжительность(ТекущаяДата() - НачалоЗамераВремени);
	Элементы.НадписьПоследняяПродолжительность.Заголовок =
		СтрШаблонАдапт(НСтр("ru='(Продолжительность сканирования: %1)'"), Продолжительность);
	
КонецПроцедуры

&НаКлиенте
Функция ВычислитьПродолжительность(Остаток)
	
	Часы = Цел(Остаток / 3600);
	Остаток = Остаток - Часы * 3600;
	
	Минуты = Цел(Остаток / 60);
	Остаток = Остаток - Минуты * 60;
	
	Секунды = Остаток;
	
	Продолжительность = СтрШаблонАдапт(НСтр("ru='%1:%2:%3'"),
		Формат(Часы, "ЧЦ=2; ЧН=; ЧВН="),
		Формат(Минуты, "ЧЦ=2; ЧН=; ЧВН="),
		Формат(Секунды, "ЧЦ=2; ЧН=; ЧВН="));
	
	Возврат Продолжительность;
	
КонецФункции

&НаСервере
Функция ОтборПоПериоду()
	
	Возврат ЭтаФорма["ОтборПоПериоду"];
	
КонецФункции

&НаСервере
Функция ОтборПоОрганизации()
	
	РеквизитыФормы = ПолучитьРеквизиты();
	
	РеквизитНайден = Ложь;
	
	Для Каждого ТекРеквизит Из РеквизитыФормы Цикл
		Если ТекРеквизит.Имя = "ОтборПоОрганизации" Тогда
			РеквизитНайден = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не РеквизитНайден Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначениеОтбора = ЭтаФорма["ОтборПоОрганизации"];
	
	Возврат ?(ЗначениеЗаполнено(ЗначениеОтбора), ЗначениеОтбора, Неопределено);
	
КонецФункции

&НаКлиенте
Функция ПараметрыСпискаСОтборами(ВыбранныеМетаданные)
	
	ПараметрыСписка = Новый Структура;
	Для Каждого Поле Из ВыбранныеМетаданные Цикл
		ПараметрыСписка.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	ТекущиеОтборы = ТекущиеОтборыФормы();
	ПараметрыСписка.Вставить("Период", ТекущиеОтборы.Период);
	ПараметрыСписка.Вставить("Организация", ТекущиеОтборы.Организация);
	
	Возврат ПараметрыСписка;
	
КонецФункции

&НаКлиенте
Функция ТекущиеОтборыФормы()
	
	Организация = Неопределено;
	ЭлементОрганизации = Элементы.Найти("ОтборПоОрганизации");
	
	Если ЭлементОрганизации <> Неопределено Тогда
		Если ЭлементОрганизации.Видимость Тогда
			ЗначениеОтбора = ЭтаФорма["ОтборПоОрганизации"];
			Организация = ?(ЗначениеЗаполнено(ЗначениеОтбора), ЗначениеОтбора, Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("Период,Организация", ЭтаФорма["ОтборПоПериоду"], Организация);
	
КонецФункции

&НаСервере
Процедура ОбновитьНадписьОтборовНаСервере()
	
	Обработка = ОбъектОбработкиДляОтборовНаСервере();
	Обработка.ОбновитьОтборыФормы(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСтандартныйСписок(ВыбранныеМетаданные)
	
	ПараметрыСписка = ПараметрыСпискаСОтборами(ВыбранныеМетаданные);
	НастройкиСписка = ПараметрыСтандартногоСпискаБезКонтекста(ПараметрыСписка,
		ИмяОркестратораФормы, ИдентификаторСборкиФормы);
	ПутьФормы = ВыбранныеМетаданные.КоллекцияОбъектовМетаданных + "."
		+ ВыбранныеМетаданные.ОбъектМетаданных + ".ФормаСписка";
	
	Если Не ПоддерживаетсяРелизПлатформы(3) Тогда
		ФормаСписка = СтандартнаяФормаСписка(ПутьФормы, НастройкиСписка.ПараметрыФормы);
		УстановитьПользовательскиеОтборыСтандартногоСписка(ФормаСписка, НастройкиСписка.ОтборСписка);
		УстановитьПериодСтандартногоСписка(ФормаСписка, ПараметрыСписка);
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НастройкиСписка.ОтборСписка.Организация)
		И Не ЗначениеЗаполнено(ПараметрыСписка.Период) Тогда
		ФормаСписка = СтандартнаяФормаСписка(ПутьФормы, Новый Структура);
		
		Возврат;
	КонецЕсли;
	
	КлючФормы = Новый УникальныйИдентификатор;
	Состояние = НовоеСостояниеСтандартногоСписка(КлючФормы);
	
	Попытка
		ФормаСписка = КлиентскийАдаптер(3).СтандартныйСписокСОповещением(ПутьФормы, ЭтаФорма, КлючФормы);
		Состояние.Форма = ФормаСписка;
		Состояние.СохранениеДанныхФормы = ФормаСписка.АвтоматическоеСохранениеДанныхВНастройках;
		ФормаСписка.АвтоматическоеСохранениеДанныхВНастройках =
			АвтоматическоеСохранениеДанныхФормыВНастройках.НеИспользовать;
		ЕстьДокументныйПериод = ПараметрыСписка.КоллекцияОбъектовМетаданных = "Документ"
			И ЗначениеЗаполнено(ПараметрыСписка.Период);
		УстановитьПользовательскиеОтборыСтандартногоСписка(ФормаСписка,
			НастройкиСписка.ОтборСписка, Состояние.Списки, ЕстьДокументныйПериод);
		УстановитьПериодСтандартногоСписка(ФормаСписка, ПараметрыСписка, Состояние.Периоды);
	Исключение
		ВосстановитьНастройкиСтандартногоСписка(Состояние);
		ВременныеНастройкиСтандартныхСписков.Удалить(КлючФормы);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция СтандартнаяФормаСписка(ПутьФормы, ПараметрыФормы)
	
	Попытка
		ФормаСписка = ПолучитьФорму(ПутьФормы, ПараметрыФормы, ЭтаФорма, Истина);
	Исключение
		// Не каждая форма конфигурации принимает параметры отбора.
		ФормаСписка = ПолучитьФорму(ПутьФормы, , ЭтаФорма, Истина);
	КонецПопытки;
	
	ФормаСписка.Открыть();
	
	Возврат ФормаСписка;
	
КонецФункции

&НаКлиенте
Функция НовоеСостояниеСтандартногоСписка(КлючФормы)
	
	Если ВременныеНастройкиСтандартныхСписков = Неопределено Тогда
		ВременныеНастройкиСтандартныхСписков = Новый Соответствие;
	КонецЕсли;
	
	Состояние = Новый Структура;
	Состояние.Вставить("Форма", Неопределено);
	Состояние.Вставить("СохранениеДанныхФормы", Неопределено);
	Состояние.Вставить("Списки", Новый Массив);
	Состояние.Вставить("Периоды", Новый Массив);
	ВременныеНастройкиСтандартныхСписков.Вставить(КлючФормы, Состояние);
	
	Возврат Состояние;
	
КонецФункции

// Восстанавливает настройки отдельного штатного списка после его закрытия.
//
// Параметры:
//  РезультатЗакрытия - Произвольный - результат закрытия штатной формы; восстановлению настроек не требуется.
//  КлючФормы - УникальныйИдентификатор - ключ отдельного списка и его временных пользовательских настроек.
&НаКлиенте
Процедура СтандартныйСписокЗакрыт(РезультатЗакрытия, КлючФормы) Экспорт
	
	Если ВременныеНастройкиСтандартныхСписков = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Состояние = ВременныеНастройкиСтандартныхСписков[КлючФормы];
	ВременныеНастройкиСтандартныхСписков.Удалить(КлючФормы);
	
	Если Состояние <> Неопределено Тогда
		ВосстановитьНастройкиСтандартногоСписка(Состояние);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройкиОткрытыхСписков()
	
	Если ВременныеНастройкиСтандартныхСписков = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Состояние Из ВременныеНастройкиСтандартныхСписков Цикл
		ВосстановитьНастройкиСтандартногоСписка(Состояние.Значение);
	КонецЦикла;
	ВременныеНастройкиСтандартныхСписков.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройкиСтандартногоСписка(Состояние)
	
	Для Каждого Настройки Из Состояние.Списки Цикл
		Попытка
			Настройки.Список.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(Настройки.Настройки);
			КлиентскийАдаптер(3).ВосстановитьСохранениеНастроекСписка(
				Настройки.Список, Настройки.РежимСохранения);
		Исключение
			// Закрытая форма может уже освободить список; автосохранение было отключено до применения отбора.
		КонецПопытки;
	КонецЦикла;
	
	Для Каждого ИсходныйПериод Из Состояние.Периоды Цикл
		Попытка
			ИсходныйПериод.Таблица.Период = ИсходныйПериод.Период;
			Если Состояние.Форма.Открыта() Тогда
				ИсходныйПериод.Таблица.Обновить();
			КонецЕсли;
		Исключение
			// После закрытия элемента может уже не быть в форме.
		КонецПопытки;
	КонецЦикла;
	
	Если Состояние.СохранениеДанныхФормы <> Неопределено Тогда
		Попытка
			Состояние.Форма.АвтоматическоеСохранениеДанныхВНастройках = Состояние.СохранениеДанныхФормы;
		Исключение
			// Постоянные настройки защищены отключенным сохранением до закрытия формы.
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодСтандартногоСписка(ФормаСписка, ПараметрыСписка, ИсходныеПериоды = Неопределено)
	
	Если ПараметрыСписка.КоллекцияОбъектовМетаданных <> "Документ"
		Или Не ЗначениеЗаполнено(ПараметрыСписка.Период) Тогда
		Возврат;
	КонецЕсли;
	
	ПериодСписка = Новый СтандартныйПериод;
	ПериодСписка.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	
	ПериодСписка.ДатаНачала = ПараметрыСписка.Период.ДатаНачала;
	ПериодСписка.ДатаОкончания = ПараметрыСписка.Период.ДатаОкончания;
	
	Для Каждого Элемент Из ФормаСписка.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ТаблицаФормы") Тогда
			Попытка
				// После открытия: обработчик формы уже восстановил свои настройки периода.
				Если ИсходныеПериоды <> Неопределено Тогда
					ИсходныеПериоды.Добавить(Новый Структура("Таблица,Период", Элемент, Элемент.Период));
				КонецЕсли;
				Элемент.Период = ПериодСписка;
				Элемент.Обновить();
			Исключение
				// У произвольной таблицы формы может не быть штатного периода списка документов.
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользовательскиеОтборыСтандартногоСписка(ФормаСписка, ОтборСписка,
	ИсходныеНастройки = Неопределено, ЕстьДокументныйПериод = Ложь)
	
	Если ПустаяСтрока(ОтборСписка.ПолеОрганизации)
		И ОтборСписка.ПолеПериода <> "Период"
		И ОтборСписка.ПолеПериода <> "ПериодРегистрации" И Не ЕстьДокументныйПериод Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ФормаСписка.Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("ТаблицаФормы") Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			СписокФормы = ДанныеТаблицыСтандартногоСписка(ФормаСписка, Элемент);
			
			Если СписокФормы = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УстановитьПользовательскиеОтборыСписка(СписокФормы, ОтборСписка, ИсходныеНастройки);
			Элемент.Обновить();
		Исключение
			// Произвольная форма может использовать источник, отличный от динамического списка.
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеТаблицыСтандартногоСписка(ФормаСписка, ЭлементТаблицы)
	
	Попытка
		// ПутьКДанным доступен только на сервере; используем совпадающее имя реквизита штатной таблицы.
		
		Возврат ФормаСписка[ЭлементТаблицы.Имя];
	Исключение
		
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура УстановитьПользовательскиеОтборыСписка(СписокФормы, ОтборСписка,
	ИсходныеНастройки = Неопределено)
	
	Если Не ПоддерживаетсяРелизПлатформы(3) Тогда
		УстановитьПериодРегистраСписка(СписокФормы, ОтборСписка);
		
		Возврат;
	КонецЕсли;
	
	Компоновщик = СписокФормы.КомпоновщикНастроек;
	ИдентификаторОтбора = Компоновщик.Настройки.Отбор.ИдентификаторПользовательскойНастройки;
	Результат = ПользовательскиеНастройкиСОтборомБезКонтекста(Компоновщик.ПользовательскиеНастройки,
		ИдентификаторОтбора, ОтборСписка, ИмяОркестратораФормы, ИдентификаторСборкиФормы);
	
	Если ИсходныеНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РежимСохранения = КлиентскийАдаптер(3).ОтключитьСохранениеНастроекСписка(СписокФормы);
	ИсходныеНастройки.Добавить(Новый Структура("Список,Настройки,РежимСохранения",
		СписокФормы, Результат.ИсходныеНастройки, РежимСохранения));
	Если Результат.ОтборУстановлен Тогда
		Компоновщик.ЗагрузитьПользовательскиеНастройки(Результат.Настройки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодРегистраСписка(СписокФормы, ОтборСписка)
	
	Если (ОтборСписка.ПолеПериода <> "Период" И ОтборСписка.ПолеПериода <> "ПериодРегистрации")
		Или ОтборСписка.Период = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеПериода = Новый ПолеКомпоновкиДанных(ОтборСписка.ПолеПериода);
	УдалитьОтборПоляСписка(СписокФормы.Отбор, ПолеПериода);
	ЭлементОтбора = СписокФормы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ПолеПериода;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение = ОтборСписка.Период.ДатаНачала;
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора = СписокФормы.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = ПолеПериода;
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ЭлементОтбора.ПравоеЗначение = ОтборСписка.Период.ДатаОкончания;
	ЭлементОтбора.Использование = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОтборПоляСписка(Отбор, ПолеОтбора)
	
	Индекс = Отбор.Элементы.Количество() - 1;
	
	Пока Индекс >= 0 Цикл
		ЭлементОтбора = Отбор.Элементы[Индекс];
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			УдалитьОтборПоляСписка(ЭлементОтбора, ПолеОтбора);
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение = ПолеОтбора Тогда
			Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПользовательскиеНастройкиСОтборомБезКонтекста(Знач Настройки, Знач ИдентификаторОтбора,
	Знач ОтборСписка, Знач ИмяОркестратора, Знач Сборка)
	
	Обработка = ОркестраторСеанса(ИмяОркестратора, Сборка);
	
	Возврат Обработка.ПользовательскиеНастройкиСОтборомСписка(Настройки, ИдентификаторОтбора, ОтборСписка);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПараметрыСтандартногоСпискаБезКонтекста(Знач ПараметрыСписка, Знач ИмяОркестратора, Знач Сборка)
	
	Обработка = ОркестраторСеанса(ИмяОркестратора, Сборка);
	ДанныеСписка = Обработка.ДанныеУниверсальногоСписка(ПараметрыСписка);
	
	Возврат Новый Структура("ПараметрыФормы,ОтборСписка",
		Обработка.ПараметрыСтандартногоСписка(ДанныеСписка.ОтборСписка), ДанныеСписка.ОтборСписка);
	
КонецФункции

&НаКлиенте
Процедура ПредупредитьОбОшибкеСкана(Сообщение, ТекстОшибки)
	
	Описание = КраткоеПредставлениеОшибкиСкана(ТекстОшибки);
	
	Если Не ПустаяСтрока(Описание) Тогда
		Сообщение = Сообщение + Символы.ПС + Описание;
	КонецЕсли;
	
	ПредупредитьПользователя(Сообщение);
	
КонецПроцедуры

&НаКлиенте
Функция КраткоеПредставлениеОшибкиСкана(ТекстОшибки)
	
	ТекстОшибки = СтрЗаменить(ТекстОшибки, Символы.ВК, "");
	Результат = "";
	
	Пока Не ПустаяСтрока(ТекстОшибки) Цикл
		ПозицияПеревода = Найти(ТекстОшибки, Символы.ПС);
		
		Если ПозицияПеревода = 0 Тогда
			СтрокаОшибки = СокрЛП(ТекстОшибки);
			ТекстОшибки = "";
		Иначе
			СтрокаОшибки = СокрЛП(Лев(ТекстОшибки, ПозицияПеревода - 1));
			ТекстОшибки = Сред(ТекстОшибки, ПозицияПеревода + 1);
		КонецЕсли;
		
		Если Лев(СтрокаОшибки, 1) = "{" Тогда
			ПозицияКонтекста = Найти(СтрокаОшибки, "}:");
			СтрокаОшибки = ?(ПозицияКонтекста = 0, "", СокрЛП(Сред(СтрокаОшибки, ПозицияКонтекста + 2)));
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтрокаОшибки) И Лев(СтрокаОшибки, 1) <> "[" Тогда
			Результат = Результат + ?(ПустаяСтрока(Результат), "", Символы.ПС) + СтрокаОшибки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Лев(Результат, 1500);
	
КонецФункции

&НаКлиенте
Процедура ПредупредитьПользователя(ТекстПредупреждения)
	
	Если ПоддерживаетсяРелизПлатформы(3) Тогда
		КлиентскийАдаптер(3).Предупредить(ТекстПредупреждения);
	Иначе
		Предупреждение(ТекстПредупреждения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОкноОжидания()
	
	Если ФормаОжидания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ФормаОжидания.Открыта() Тогда
		ФормаОжидания.Закрыть();
	КонецЕсли;
	
	ФормаОжидания = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДополнительныеСведения(Обработка, Данные)
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Раздел Из Обработка.ОписанияРазделовФормы() Цикл
		Если Не Раздел.ОтдельныеСведения Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица = Неопределено;
		
		Если Данные.Свойство(Раздел.ИмяТаблицы, Таблица) И Таблица <> Неопределено Тогда
			ЗначениеВРеквизитФормы(Таблица, Раздел.ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьДлительнуюОперацию(ИзмерятьСканирование = Истина)
	
	ДлительнаяОперацияВыполняется = Истина;
	Если ИзмерятьСканирование Тогда
		НачатьЗамерВремени();
	КонецЕсли;
	ОповеститьПользователяОбОжидании();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьДлительнуюОперацию(ИзмерятьСканирование = Истина)
	
	ОтключитьОбработчикОжидания("ПродолжитьСканирование");
	ДлительнаяОперацияВыполняется = Ложь;
	ОсвободитьТекущийСеанс();
	ЗакрытьОкноОжидания();
	Если ИзмерятьСканирование Тогда
		ОкончитьЗамерВремени();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция МожноНачатьДлительнуюОперацию()
	
	Если ДлительнаяОперацияВыполняется = Истина Тогда
		ПредупредитьПользователя(НСтр("ru='Дождитесь окончания сканирования.'"));
		
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ТекстПредупрежденийРазделов(Предупреждения)
	
	Текст = "";
	
	Для Каждого ПредупреждениеРаздела Из Предупреждения Цикл
		Текст = Текст + ?(ПустаяСтрока(Текст), "", Символы.ПС) + ПредупреждениеРаздела;
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ОбновитьСведенияКлиентскогоПриложенияНаСервере(Знач Заголовок, Знач Клиент)
	
	ОбработкаОбъект = ОбъектОбработкиНаСервере();
	ОбработкаОбъект.УстановитьСведенияКлиентскогоПриложения(ЭтаФорма, Заголовок, Клиент);
	СохранитьОбъектОбработкиНаСервере(ОбработкаОбъект);
	
	Возврат ОбработкаОбъект.ОписанияРазделовФормы();
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьСборкуОркестратора(Обработка, Сборка)
	
	Попытка
		Совпадает = Обработка.ИдентификаторСборки() = Сборка;
	Исключение
		Совпадает = Ложь;
	КонецПопытки;
	
	Если Не Совпадает Тогда
		ВызватьИсключение НСтр("ru='В сеансе подключена другая сборка обработки. Закройте обработку "
			+ "и откройте нужный файл заново.'");
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область СовместимостьПлатформы8_3_5

&НаКлиенте
Функция СтрШаблонАдапт(Строка, П1 = "", П2 = "", П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "", П9 = "",
	П10 = "")
	
	ЗначенияПодстановки = Новый Массив;
	ЗначенияПодстановки.Добавить(П1);
	ЗначенияПодстановки.Добавить(П2);
	ЗначенияПодстановки.Добавить(П3);
	ЗначенияПодстановки.Добавить(П4);
	ЗначенияПодстановки.Добавить(П5);
	ЗначенияПодстановки.Добавить(П6);
	ЗначенияПодстановки.Добавить(П7);
	ЗначенияПодстановки.Добавить(П8);
	ЗначенияПодстановки.Добавить(П9);
	ЗначенияПодстановки.Добавить(П10);
	
	Результат = "";
	Позиция = 1;
	
	Пока Позиция <= СтрДлина(Строка) Цикл
		Символ = Сред(Строка, Позиция, 1);
		Номер = 0;
		ДлинаФрагмента = 1;
		
		Если Символ = "%" Тогда
			Если Сред(Строка, Позиция + 1, 2) = "10" Тогда
				Номер = 10;
				ДлинаФрагмента = 3;
			Иначе
				Цифра = Сред(Строка, Позиция + 1, 1);
				
				Если Цифра <> "" Тогда
					Номер = Найти("123456789", Цифра);
					
					Если Номер > 0 Тогда
						ДлинаФрагмента = 2;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Номер > 0 Тогда
			ЗначениеПараметра = ЗначенияПодстановки[Номер - 1];
			Результат = Результат + Строка(ЗначениеПараметра);
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
		
		Позиция = Позиция + ДлинаФрагмента;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область КомандыСканов

&НаСервере
Функция ЗапомнитьСканНаСервере()
	
	ОбработкаОбъект = ОбъектОбработкиНаСервере();
	
	Если Не ОбработкаОбъект.ЕстьТекущийСкан() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбработкаОбъект.ЗапомнитьТекущийСкан(ЭтаФорма);
	СохранитьОбъектОбработкиНаСервере(ОбработкаОбъект);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция АдресСохраняемогоСкана(Знач ДляВебКлиента = Ложь)
	
	ОбработкаОбъект = ОбъектОбработкиНаСервере();
	ДокументСкана = ОбработкаОбъект.ДокументТекущегоСкана(ЭтаФорма);
	
	Если ДокументСкана = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("mxl");
	
	Попытка
		ДокументСкана.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.MXL);
		// Передача начинается штатным API до следующей пользовательской команды.
		// Без привязки к форме платформа удалит копию при следующем серверном вызове.
		
		Если ДляВебКлиента Тогда
			Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла));
		Иначе
			Адрес = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), УникальныйИдентификатор);
		КонецЕсли;
	Исключение
		УдалитьФайлы(ИмяФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьФайлы(ИмяФайла);
	
	Возврат Адрес;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьВременныйСкан(Знач Адрес)
	
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыбранныйСкан(ИмяФайла)
	
	Попытка
		Адрес = "";
		
		Если ПоместитьФайл(Адрес, ИмяФайла, ИмяФайла, Ложь, УникальныйИдентификатор) Тогда
			УстановитьЗагруженныйСкан(Адрес);
		КонецЕсли;
	Исключение
		ПредупредитьОбОшибкеСкана(НСтр("ru='Не удалось загрузить скан для сравнения.'"), ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗагруженныйСкан(Знач Адрес)
	
	ИмяФайла = ПолучитьИмяВременногоФайла("mxl");
	
	Попытка
		ПолучитьИзВременногоХранилища(Адрес).Записать(ИмяФайла);
		ДокументСкана = Новый ТабличныйДокумент;
		ДокументСкана.Прочитать(ИмяФайла);
		ОбработкаОбъект = ОбъектОбработкиНаСервере();
		ОбработкаОбъект.УстановитьСканИзДокумента(ЭтаФорма, ДокументСкана);
		СохранитьОбъектОбработкиНаСервере(ОбработкаОбъект);
	Исключение
		УдалитьФайлы(ИмяФайла);
		УдалитьИзВременногоХранилища(Адрес);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьФайлы(ИмяФайла);
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

&НаКлиенте
Функция ПоддерживаетсяРелизПлатформы(МинимальныйРелиз)
	
	Система = Новый СистемнаяИнформация;
	Разряды = РазрядыВерсии(Система.ВерсияПриложения);
	
	Если Разряды[0] <> 8 Тогда
		Возврат Разряды[0] > 8;
	КонецЕсли;
	
	Если Разряды[1] <> 3 Тогда
		Возврат Разряды[1] > 3;
	КонецЕсли;
	
	Возврат Разряды[2] >= МинимальныйРелиз;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьКомпьютерыНаКлиенте(Подробно = Ложь)
	
	СлужебнаяФорма = ПолучитьФорму(ИмяФормыСистемныхСведенийНаСервере(), , ЭтаФорма);
	Повтор = ПовторитьСистемныйСбор;
	ПовторитьСистемныйСбор = Ложь;
	Сведения = СлужебнаяФорма.СведенияКомпьютеров(Подробно, Повтор);
	ОтобразитьКомпьютерыНаСервере(Сведения);
	ПовторитьСистемныйСбор = Новый Структура("Клиент,Сервер",
		Сведения.Клиент.Свойство("СборПропущен"), Сведения.Сервер.Свойство("СборПропущен"));
	
КонецПроцедуры

&НаСервере
Процедура ОтобразитьКомпьютерыНаСервере(Знач Сведения)
	
	ОбработкаОбъект = ОбъектОбработкиНаСервере();
	ОбработкаОбъект.ОбновитьСведенияКомпьютеров(ЭтаФорма, Сведения);
	СохранитьОбъектОбработкиНаСервере(ОбработкаОбъект);
	
КонецПроцедуры

// #КонецОбласти

// #Область КлиентскийПрограммныйИнтерфейс

// Обрабатывает завершение загрузки файла в хранилище и освобождает использованный адрес.
//
// Параметры:
//  Результат - Булево - успешность помещения файла во временное хранилище.
//  Адрес - Строка - адрес во временном хранилище; файловые адаптеры освобождают его по своему контракту.
//  ВыбранноеИмяФайла - Строка - имя из оповещения платформы; для чтения используется Адрес.
//  ДополнительныеПараметры - Произвольный - параметры штатного оповещения; текущему обработчику не требуются.
&НаКлиенте
Процедура ПослеПомещенияСкана(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		Попытка
			УстановитьЗагруженныйСкан(Адрес);
		Исключение
			ПредупредитьОбОшибкеСкана(НСтр("ru='Не удалось загрузить скан для сравнения.'"), ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Освобождает серверную копию MXL после завершения или отмены штатного файлового диалога.
//
// Параметры:
//  ПолученныеФайлы - Массив, Неопределено - результат штатного файлового диалога; адрес освобождается и при отмене.
//  Адрес - Строка - адрес во временном хранилище; файловые адаптеры освобождают его по своему контракту.
&НаКлиенте
Процедура СохранениеСканаЗавершено(ПолученныеФайлы, Адрес) Экспорт
	
	// Вызывается после сохранения либо отмены диалога пользователем.
	ОсвободитьСохраняемыйСкан(Адрес);
	
КонецПроцедуры

// #КонецОбласти

// #Область СостояниеСкановФормы

&НаСервере
Функция ОбъектОбработкиДляОтборовНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ПроверитьСборкуОркестратора(Обработка, ИдентификаторСборкиФормы);
	
	Если Не ПустаяСтрока(АдресТекущегоСкана) Тогда
		Обработка.ТекущийСкан = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресТекущегоСкана));
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресДополнительногоСкана) Тогда
		Обработка.УстановитьДополнительныйСкан(ПолучитьИзВременногоХранилища(АдресДополнительногоСкана));
	КонецЕсли;
	
	Возврат Обработка;
	
КонецФункции

&НаСервере
Функция ОбъектОбработкиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Если Не ПустаяСтрока(ИдентификаторСборкиФормы) Тогда
		ПроверитьСборкуОркестратора(ОбработкаОбъект, ИдентификаторСборкиФормы);
	КонецЕсли;
	
	// Экспортные переменные объекта не переносятся в данные управляемой формы.
	
	// Адреса привязаны к форме: сканы сохраняются между вызовами и удаляются при закрытии.
	
	Если Не ПустаяСтрока(АдресТекущегоСкана) Тогда
		ОбработкаОбъект.ТекущийСкан = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресТекущегоСкана));
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресСканаДляСравнения) Тогда
		ОбработкаОбъект.СканДляСравнения =
			Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресСканаДляСравнения));
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресКэшаДиагностики) Тогда
		ОбработкаОбъект.УстановитьКэшДиагностики(ПолучитьИзВременногоХранилища(АдресКэшаДиагностики));
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресДополнительногоСкана) Тогда
		ОбработкаОбъект.УстановитьДополнительныйСкан(ПолучитьИзВременногоХранилища(АдресДополнительногоСкана));
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресСистемногоСкана) Тогда
		ОбработкаОбъект.УстановитьСистемныйСкан(ПолучитьИзВременногоХранилища(АдресСистемногоСкана));
	КонецЕсли;
	
	Возврат ОбработкаОбъект;
	
КонецФункции

&НаСервере
Процедура СохранитьОбъектОбработкиНаСервере(ОбработкаОбъект, Изменения = Неопределено)
	
	Данные = Неопределено;
	
	Если Изменения = Неопределено Тогда
		Изменения = ОбработкаОбъект.ИзмененноеСостояние();
	КонецЕсли;
	
	Если Изменения.Свойство("ТекущийСкан", Данные) Тогда
		СохранитьДанныеСкана(Данные, АдресТекущегоСкана);
	КонецЕсли;
	
	Если Изменения.Свойство("СканДляСравнения", Данные) Тогда
		СохранитьДанныеСкана(Данные, АдресСканаДляСравнения);
	КонецЕсли;
	
	Если Изменения.Свойство("КэшДиагностики", Данные) Тогда
		СохранитьДанныеСкана(Данные, АдресКэшаДиагностики);
	КонецЕсли;
	
	Если Изменения.Свойство("ДополнительныеСведения", Данные) Тогда
		СохранитьДанныеСкана(Данные, АдресДополнительногоСкана);
	КонецЕсли;
	
	Если Изменения.Свойство("СистемныеСведения", Данные) Тогда
		СохранитьДанныеСкана(Данные, АдресСистемногоСкана);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбработкаОбъект, "Объект");
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеСкана(Скан, Адрес)
	
	Если Скан = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = ПоместитьВоВременноеХранилище(Скан, УникальныйИдентификатор);
	Иначе
		ПоместитьВоВременноеХранилище(Скан, Адрес);
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

// #Область РедакторКонстант

&НаСервере
Процедура ОбновитьКонстантуНаСервере(Знач ИмяКонстанты)
	
	Обработка = ОбъектОбработкиНаСервере();
	Обработка.ОбновитьСтрокуКонстанты(ЭтаФорма, ИмяКонстанты);
	СохранитьОбъектОбработкиНаСервере(Обработка);
	
КонецПроцедуры

&НаСервере
Функция КонстантаРедактируемаНаСервере(Знач ИмяКонстанты)
	
	Обработка = ОбъектОбработкиНаСервере();
	
	Возврат Обработка.КонстантаРедактируемаВУниверсальномОкне(ИмяКонстанты);
	
КонецФункции

// #КонецОбласти

// #Область ПодробныйПросмотрОбъекта

&НаСервере
Функция ПолноеИмяПросмотраНаСервере(Знач ВыбранныеМетаданные)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Возврат Обработка.ПолноеИмяПодробногоПросмотра(ВыбранныеМетаданные);
	
КонецФункции

// #КонецОбласти

// #Область СовместимостьПлатформы

&НаКлиенте
Функция РазрядыВерсии(Знач Версия)
	
	Разряды = Новый Массив;
	
	Пока Разряды.Количество() < 3 Цикл
		Разделитель = Найти(Версия, ".");
		Разряд = ?(Разделитель = 0, Версия, Лев(Версия, Разделитель - 1));
		Разряды.Добавить(Число(Разряд));
		Версия = ?(Разделитель = 0, "", Сред(Версия, Разделитель + 1));
	КонецЦикла;
	
	Возврат Разряды;
	
КонецФункции

// #КонецОбласти

// #Область УправлениеПорциями

&НаКлиенте
Процедура НачатьСеансТаблиц(Основные, Дополнительные, Системные = Ложь)
	
	Если Не МожноНачатьДлительнуюОперацию() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЭтоКорректныйПериодСканирования(ОтборПоПериоду.ДатаНачала, ОтборПоПериоду.ДатаОкончания) Тогда
		ПредупредитьПользователя(
			НСтр("ru='Некорректный отбор по периоду. Дата начала не может быть больше даты окончания'"));
		
		Возврат;
	КонецЕсли;
	
	Попытка
		НачатьДлительнуюОперацию();
		
		Если Системные Тогда
			ОбновитьКомпьютерыНаКлиенте(Истина);
		КонецЕсли;
		
		Подготовка = НачатьСеансНаСервере(Основные, Дополнительные);
		АдресСеансаСканирования = Подготовка.Сеанс;
		ИмяОркестратораСканирования = Подготовка.Исполнитель;
		ФормаОжидания.ПоказатьПрогресс("Подготовка сканирования…");
		ЗапланироватьПродолжениеСканирования();
	Исключение
		ЗавершитьДлительнуюОперацию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоКорректныйПериодСканирования(ДатаНачала, ДатаОкончания)
	
	Возврат Не (ЗначениеЗаполнено(ДатаНачала) И ЗначениеЗаполнено(ДатаОкончания)
		И ДатаНачала > ДатаОкончания);
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьСканирование()
	
	Если Не ДлительнаяОперацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ФормаОжидания = Неопределено Тогда
			ЗавершитьДлительнуюОперацию();
			
			Возврат;
		КонецЕсли;
		
		Если Не ФормаОжидания.Открыта() Тогда
			ЗавершитьДлительнуюОперацию();
			
			Возврат;
		КонецЕсли;
		
		Состояние = СледующаяПорцияБезКонтекста(АдресСеансаСканирования, ИмяОркестратораСканирования,
			ИдентификаторСборкиФормы);
		
		Если Состояние.Статус = "ПубликацияОсновных" Или Состояние.Статус = "ПубликацияДополнительных" Тогда
			Состояние = ОпубликоватьСеансНаСервере(АдресСеансаСканирования);
			
			Если Состояние.Статус <> "Ошибка" Тогда
				Состояние = ПодтвердитьСеансБезКонтекста(АдресСеансаСканирования, ИмяОркестратораСканирования,
					Состояние.ИдентификаторПубликации, ИдентификаторСборкиФормы);
			КонецЕсли;
		КонецЕсли;
		
		ФормаОжидания.ПоказатьПрогресс(ТекстПрогрессаСканирования(Состояние),
		ПроцентПрогрессаСканирования(Состояние));
		
		Если Состояние.Статус = "Завершен" Тогда
			ЗавершитьДлительнуюОперацию();
			
			Если Состояние.Предупреждения.Количество() > 0 Тогда
				ПредупредитьПользователя(ТекстПредупрежденийРазделов(Состояние.Предупреждения));
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
		
		Если Состояние.Статус = "Ошибка" Тогда
			ОшибкаПродолженияСканирования(Состояние.Сообщение);
			
			Возврат;
		КонецЕсли;
		
		ЗапланироватьПродолжениеСканирования();
	Исключение
		ОшибкаПродолженияСканирования(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция ТекстПрогрессаСканирования(Состояние)
	
	Если Состояние.Статус = "Ошибка" Тогда
		Возврат Состояние.Сообщение;
	КонецЕсли;
	
	Возврат "Сканирование: " + Состояние.Раздел;
	
КонецФункции

&НаКлиенте
Функция ПроцентПрогрессаСканирования(Состояние)
	
	Если Состояние.Всего = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат Мин(100, Макс(0, Окр(100 * Состояние.Выполнено / Состояние.Всего, 0)));
	
КонецФункции

// #КонецОбласти

// #Область ПередачаСеанса

&НаСервере
Функция НачатьСеансНаСервере(Знач Основные, Знач Дополнительные)
	
	Обработка = ОбъектОбработкиНаСервере();
	Сеанс = Обработка.НовыйСеансСканирования(ОтборПоПериоду(), ОтборПоОрганизации(),
		Основные, Дополнительные, УникальныйИдентификатор);
	Адрес = ПоместитьВоВременноеХранилище(Сеанс, УникальныйИдентификатор);
	
	Возврат Новый Структура("Сеанс,Исполнитель", Адрес, Обработка.Метаданные().Имя);
	
КонецФункции

&НаСервереБезКонтекста
Функция СледующаяПорцияБезКонтекста(Знач Адрес, Знач ИмяОркестратора, Знач Сборка)
	
	Возврат ОркестраторСеанса(ИмяОркестратора, Сборка).ПродолжениеСеансаИзХранилища(Адрес);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИзменитьСеансНаСервере(Знач Адрес, Знач ИмяОркестратора, Знач ДействиеСеанса, Знач Сборка)
	
	ОркестраторСеанса(ИмяОркестратора, Сборка).ИзменитьСеансИзХранилища(Адрес, ДействиеСеанса);
	
КонецПроцедуры

&НаСервере
Функция ОпубликоватьСеансНаСервере(Знач Адрес)
	
	Сеанс = ПолучитьИзВременногоХранилища(Адрес);
	Обработка = ОбъектОбработкиНаСервере();
	
	Попытка
		Изменения = Обработка.ПубликацияСеанса(ЭтаФорма, Сеанс);
		ЗагрузитьДополнительныеСведения(Обработка, Обработка.ДанныеДополнительногоСкана());
		СохранитьОбъектОбработкиНаСервере(Обработка, Изменения);
	Исключение
		Сеанс.Статус = "Ошибка";
		Сеанс.Сообщение = "Отображение результатов: " + ОписаниеОшибки();
	КонецПопытки;
	
	ПоместитьВоВременноеХранилище(Сеанс, Адрес);
	
	Возврат Обработка.СостояниеСеансаСканирования(Сеанс);
	
КонецФункции

&НаСервереБезКонтекста
Функция ОркестраторСеанса(Знач ИмяОбработки, Знач Сборка)
	
	Обработка = ВнешниеОбработки.Создать(ИмяОбработки, Истина);
	ПроверитьСборкуОркестратора(Обработка, Сборка);
	
	Возврат Обработка;
	
КонецФункции

// #КонецОбласти

// #Область СеансСканирования

&НаСервереБезКонтекста
Функция ПодтвердитьСеансБезКонтекста(Знач Адрес, Знач ИмяОркестратора, Знач Идентификатор, Знач Сборка)
	
	Возврат ОркестраторСеанса(ИмяОркестратора, Сборка).ПодтверждениеСеансаИзХранилища(Адрес, Идентификатор);
	
КонецФункции

&НаКлиенте
Процедура ЗапланироватьПродолжениеСканирования()
	
	Попытка
		ПодключитьОбработчикОжидания("ПродолжитьСканирование", 0.1, Истина);
	Исключение
		ПодключитьОбработчикОжидания("ПродолжитьСканирование", 1, Истина);
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОшибкаПродолженияСканирования(ТекстОшибки)
	
	ЗавершитьДлительнуюОперацию();
	ПредупредитьОбОшибкеСкана("Сканирование остановлено. Последний завершённый скан сохранён. "
		+ "Для новой попытки запустите сканирование ещё раз.", ТекстОшибки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсвободитьТекущийСеанс(СообщатьОшибку = Истина)
	
	// Локальное завершение не зависит от доступности сервера. Очистку не повторяем по таймеру.
	Адрес = АдресСеансаСканирования;
	ИмяОркестратора = ИмяОркестратораСканирования;
	АдресСеансаСканирования = "";
	ИмяОркестратораСканирования = "";
	
	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ИзменитьСеансНаСервере(Адрес, ИмяОркестратора, "Освободить", ИдентификаторСборкиФормы);
	Исключение
		Если СообщатьОшибку Тогда
			Сообщить(НСтр("ru='Не удалось освободить временные данные сканирования: '") + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область СистемныеСведения

&НаСервере
Функция ИмяФормыСистемныхСведенийНаСервере()
	
	Возврат ОбъектОбработкиНаСервере().ИмяФормыСистемнойДиагностики();
	
КонецФункции

// #КонецОбласти

// #Область СнимкиИСравнение

&НаКлиенте
Процедура ОсвободитьСохраняемыйСкан(Адрес)
	
	Если Адрес = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		УдалитьВременныйСкан(Адрес);
	Исключение
		Сообщить(НСтр("ru='Не удалось освободить временный файл скана: '") + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область АдаптерыКлиентскихДиалогов

&НаКлиенте
Функция КлиентскийАдаптер(Релиз)
	
	Если КлиентскиеАдаптеры = Неопределено Тогда
		КлиентскиеАдаптеры = Новый Соответствие;
	КонецЕсли;
	
	Адаптер = КлиентскиеАдаптеры.Получить(Релиз);
	
	Если Адаптер = Неопределено Тогда
		ПутьФормыАдаптера = ИмяФормыКлиентскогоАдаптераНаСервере(Релиз);
		Адаптер = ПолучитьФорму(ПутьФормыАдаптера, , ЭтаФорма);
		КлиентскиеАдаптеры.Вставить(Релиз, Адаптер);
	КонецЕсли;
	
	Возврат Адаптер;
	
КонецФункции

&НаСервере
Функция ИмяФормыКлиентскогоАдаптераНаСервере(Знач Релиз)
	
	Обработка = ОбъектОбработкиНаСервере();
	
	Возврат Обработка.ИмяФормыКлиентскогоАдаптера(Релиз);
	
КонецФункции

// #КонецОбласти

// #КонецОбласти
