// #Область ОбработчикиСобытийФормы

// #Область ВспомогательныеМетоды

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ДанныеКартинкиОжидания = Обработка.ДанныеКартинкиОжиданияФормы();
	АдресКартинкиОжидания = ПоместитьВоВременноеХранилище(
		ДанныеКартинкиОжидания, УникальныйИдентификатор);
	
	Если Параметры.Свойство("Заголовок") Тогда
		СостояниеСканирования = СтрЗаменить(НСтр("ru='Выполняется %1'"), "%1", Строка(Параметры.Заголовок));
		Элементы.Выполняется.Заголовок = СостояниеСканирования;
	КонецЕсли;
	
КонецПроцедуры

// #КонецОбласти

