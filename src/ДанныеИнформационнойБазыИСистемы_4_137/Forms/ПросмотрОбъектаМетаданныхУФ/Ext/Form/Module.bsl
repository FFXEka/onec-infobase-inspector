// #Область ОбработчикиСобытийФормы

// #Область СобытияФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПолноеИмяМетаданных = Параметры.ПолноеИмяМетаданных;
	ЭтаФорма.Заголовок = НСтр("ru='Объект подробно: '") + ПолноеИмяМетаданных;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПодключитьОбработчикОжидания("СчитатьДанныеОбъекта", 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Попытка
		ОтключитьОбработчикОжидания("СчитатьДанныеОбъекта");
	Исключение
		// Однократный обработчик может быть уже отключен платформой.
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область СобытияФормы

&НаКлиенте
Процедура СчитатьДанныеОбъекта()
	
	ЗагрузитьДанныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеНаСервере()
	
	Попытка
		Обработка = РеквизитФормыВЗначение("Объект");
		Данные = Обработка.ДанныеПодробногоПросмотра(ПолноеИмяМетаданных);
		Обработка.ПостроитьПодробныйПросмотр(ЭтаФорма, Данные, Истина);
	Исключение
		Элементы.СостояниеЗагрузки.Заголовок = НСтр("ru='Не удалось прочитать данные: '") + ОписаниеОшибки();
	КонецПопытки;
	
КонецПроцедуры

