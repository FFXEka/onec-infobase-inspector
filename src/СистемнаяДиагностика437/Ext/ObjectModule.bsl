// #Область СлужебныйПрограммныйИнтерфейс

// #Область КонтрактыСведений

// Создает описание недоступности отдельного сервера для обычного приложения.
//
// Возвращаемое значение:
//  Структура - пустые сведения компьютера с Диагностикой недоступности; состав описан в СведенияКомпьютераПоОС.
Функция НедоступныеСведенияСервера() Экспорт
	
	Сведения = НовыеСведенияКомпьютера();
	Сведения.Диагностика = НСтр("ru='Сведения о серверном ПК недоступны в обычном приложении внешней обработки.'");
	
	Возврат Сведения;
	
КонецФункции

// #КонецОбласти

// #Область ДиагностикаLinux

// Выбирает сборщик ОС; подробный Windows-сбор защищается маркером предыдущего запуска.
//
// Параметры:
//  Подробно - Булево - запрашивать подробные сведения ОС; может требовать штатного разрешения.
//  Область - Строка - идентификатор области предохранителя; не является областью модуля.
//  Сторона - Строка - Клиент или Сервер для раздельного контроля повторного сбора.
//  Повторить - Булево - разрешение повторить сбор указанной стороны после срабатывания предохранителя.
//
// Возвращаемое значение:
//  Структура - ОС, память, процессоры, диски и диагностика недоступных компонентов.
//   * Имя - Строка - имя компьютера.
//   * Идентификатор - Строка - идентификатор из доступного источника ОС.
//   * Виртуализация - Строка - распознанный тип виртуальной машины; пустая строка означает отсутствие подтверждения.
//   * Дата - Дата - время сбора сведений.
//   * ОС - Строка - представление операционной системы.
//   * Платформа - Строка - версия платформы процесса сбора.
//   * ВсегоПамятиМБ - Число - объем оперативной памяти.
//   * СвободноПамятиМБ - Число, Неопределено - доступная память, когда источник её предоставил.
//   * Процессор - Строка - краткое представление процессора.
//   * ДатаЗапускаОС - Дата, Неопределено - время запуска ОС, когда оно известно.
//   * ЧасовРаботыОС - Число, Неопределено - длительность работы ОС.
//   * Процессоры - Массив - доступные подробности процессоров.
//   * ЛогическиеДиски - Массив - логические диски и объемы; у дисков Linux также поле Устройство.
//   * ФизическиеДиски - Массив - доступные физические диски.
//   * ФайлыПодкачки - Массив - доступные файлы подкачки.
//   * МатеринскиеПлаты - Массив - доступные сведения плат.
//   * Диагностика - Строка - причины недоступности компонентов сбора.
Функция СведенияКомпьютераПоОС(Подробно, Область = "", Сторона = "Клиент", Повторить = Ложь) Экспорт
	
	Система = Новый СистемнаяИнформация;
	
	Если Найти(ВРег(Строка(Система.ТипПлатформы)), "LINUX") > 0 Тогда
		Возврат СведенияКомпьютераLinux(Система);
	КонецЕсли;
	
	Возврат СведенияКомпьютераWindows(Подробно, Область, Сторона, Повторить);
	
КонецФункции

// #КонецОбласти

// #Область СведенияПриложения

// Собирает сведения платформы, конфигурации и режима работы базы.
//
// Возвращаемое значение:
//  Структура - сведения приложения и соединения без запуска подробного системного сбора.
//   * Заголовок - Строка - исходно не определен; дополняется клиентским заголовком.
//   * Клиент - Строка - исходно не определен; дополняется видом клиентского приложения.
//   * Конфигурация - Строка - подробная информация конфигурации.
//   * ВерсияКонфигурации - Строка - версия конфигурации.
//   * Платформа - Строка - версия приложения платформы.
//   * ТипПлатформы - ТипПлатформы - вид ОС и разрядность текущего процесса.
//   * Расположение - Строка - строка соединения информационной базы.
Функция СведенияПриложения() Экспорт
	
	Система = Новый СистемнаяИнформация;
	Сведения = Новый Структура;
	Сведения.Вставить("Заголовок", "не определен");
	Сведения.Вставить("Клиент", "не определен");
	Сведения.Вставить("Конфигурация", Метаданные.ПодробнаяИнформация);
	Сведения.Вставить("ВерсияКонфигурации", Метаданные.Версия);
	Сведения.Вставить("Платформа", Система.ВерсияПриложения);
	Сведения.Вставить("ТипПлатформы", Система.ТипПлатформы);
	Сведения.Вставить("Расположение", СтрокаСоединенияИнформационнойБазы());
	
	Возврат Сведения;
	
КонецФункции

// #КонецОбласти

// #Область ИдентификацияСборки

// Идентификатор совместимости основной обработки и исполнителей.
//
// Возвращаемое значение:
//  Строка - версия и отпечаток исходников для проверки совместимости исполнителей.
Функция ИдентификаторСборки() Экспорт
	
	Возврат "4.137_e9277ced5053957b345f";
	
КонецФункции

// #КонецОбласти

// #КонецОбласти

// #Область СлужебныеПроцедурыИФункции

// #Область СборСистемныхДанных

Функция СведенияКомпьютераWindows(Подробно, Область = "", Сторона = "Клиент", Повторить = Ложь)
	
	Сведения = НовыеСведенияКомпьютера();
	Система = Новый СистемнаяИнформация;
	Сведения.ОС = Система.ВерсияОС;
	Сведения.Платформа = Система.ВерсияПриложения;
	Сведения.ВсегоПамятиМБ = Система.ОперативнаяПамять;
	Сведения.Процессор = Система.Процессор;
#Если ВебКлиент Тогда
	Сведения.Диагностика = НСтр("ru='Браузер не предоставляет имя ПК, оборудование и свободную физическую память.'");
#Иначе
	Сведения.Имя = ИмяКомпьютера();
	ПопыткаСбора = НачатаяПопыткаСистемногоСбора(Область, Сторона, Повторить);
	
	Если ПопыткаСбора.Разрешено Тогда
		Попытка
			ДополнитьСведенияЧерезWMI(Сведения, Подробно);
		Исключение
			Сведения.Диагностика = ОписаниеОшибки();
		КонецПопытки;
		
		ЗавершитьПопыткуСистемногоСбора(ПопыткаСбора);
	Иначе
		Сведения.Диагностика = ПопыткаСбора.Причина;
		Сведения.Вставить("СборПропущен", Истина);
	КонецЕсли;
	
#КонецЕсли
	
	Возврат Сведения;
	
КонецФункции

Функция НовыеСведенияКомпьютера()
	
	Сведения = Новый Структура;
	Сведения.Вставить("Имя", "");
	Сведения.Вставить("Идентификатор", "");
	Сведения.Вставить("Виртуализация", "");
	Сведения.Вставить("Дата", ТекущаяДата());
	Сведения.Вставить("ОС", "");
	Сведения.Вставить("Платформа", "");
	Сведения.Вставить("ВсегоПамятиМБ", 0);
	Сведения.Вставить("СвободноПамятиМБ", Неопределено);
	Сведения.Вставить("Процессор", "");
	Сведения.Вставить("ДатаЗапускаОС", Неопределено);
	Сведения.Вставить("ЧасовРаботыОС", Неопределено);
	Сведения.Вставить("Процессоры", Новый Массив);
	Сведения.Вставить("ЛогическиеДиски", Новый Массив);
	Сведения.Вставить("ФизическиеДиски", Новый Массив);
	Сведения.Вставить("ФайлыПодкачки", Новый Массив);
	Сведения.Вставить("МатеринскиеПлаты", Новый Массив);
	Сведения.Вставить("Диагностика", "");
	
	Возврат Сведения;
	
КонецФункции

Процедура ДополнитьСведенияЧерезWMI(Сведения, Подробно)
	
#Если Не ВебКлиент Тогда
	Попытка
		WMI = GetCOMObject("winmgmts://./root/cimv2");
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика,
			НСтр("ru='Подключение WMI недоступно: '") + ОписаниеОшибки());
		
		Возврат;
	КонецПопытки;
	
	ДополнитьСведенияОСЧерезWMI(Сведения, WMI);
	ДополнитьВиртуализациюWindows(Сведения, WMI);
	ДополнитьБыстрыйОсмотр(Сведения, WMI, Подробно);
	
	Попытка
		Для Каждого Компьютер Из WMI.ExecQuery("SELECT UUID FROM Win32_ComputerSystemProduct") Цикл
			Сведения.Идентификатор = Строка(Компьютер.UUID);
		КонецЦикла;
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика,
			НСтр("ru='Идентификатор компьютера через WMI недоступен: '") + ОписаниеОшибки());
	КонецПопытки;
	
	Если Подробно Тогда
		ДополнитьОборудованиеЧерезWMI(Сведения, WMI);
	КонецЕсли;
	
#КонецЕсли
	
КонецПроцедуры

Процедура ДополнитьВиртуализациюWindows(Сведения, WMI)
	
#Если Не ВебКлиент Тогда
	Попытка
		Для Каждого Компьютер Из WMI.ExecQuery("SELECT Manufacturer, Model FROM Win32_ComputerSystem") Цикл
			Если Компьютер.Manufacturer <> Null И Компьютер.Model <> Null Тогда
				Сведения.Виртуализация = ВиртуализацияПоМоделиКомпьютера(
					Строка(Компьютер.Manufacturer), Строка(Компьютер.Model));
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Отсутствие сведений модели не доказывает физический компьютер; отметка остается пустой.
	КонецПопытки;
#КонецЕсли
	
КонецПроцедуры

Функция ВиртуализацияПоМоделиКомпьютера(Знач Производитель, Знач Модель)
	
	Производитель = ВРег(СокрЛП(Производитель));
	Модель = ВРег(СокрЛП(Модель));
	
	Если Производитель = "VMWARE, INC."
		И (Модель = "VMWARE VIRTUAL PLATFORM" Или Модель = "VMWARE7,1" Или Модель = "VMWARE20,1") Тогда
		Возврат "VMware";
	ИначеЕсли Производитель = "PARALLELS SOFTWARE INTERNATIONAL INC"
		И Модель = "PARALLELS VIRTUAL PLATFORM" Тогда
		Возврат "Parallels";
	ИначеЕсли Производитель = "MICROSOFT CORPORATION" И Модель = "VIRTUAL MACHINE" Тогда
		Возврат "Hyper-V";
	ИначеЕсли (Производитель = "INNOTEK GMBH" Или Производитель = "ORACLE CORPORATION")
		И Модель = "VIRTUALBOX" Тогда
		Возврат "VirtualBox";
	ИначеЕсли (Производитель = "QEMU" Или Производитель = "RED HAT")
		И (Лев(Модель, 12) = "STANDARD PC " Или Модель = "KVM") Тогда
		Возврат "KVM/QEMU";
	ИначеЕсли Производитель = "XEN" И Модель = "HVM DOMU" Тогда
		Возврат "Xen";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ДополнитьСведенияОСЧерезWMI(Сведения, WMI)
	
#Если Не ВебКлиент Тогда
	Попытка
		Для Каждого ОС Из WMI.ExecQuery("SELECT Caption, OSArchitecture, FreePhysicalMemory, "
				+ "LastBootUpTime, LocalDateTime FROM Win32_OperatingSystem") Цикл
			Сведения.ОС = Строка(ОС.Caption) + " " + Строка(ОС.OSArchitecture);
			Сведения.СвободноПамятиМБ = Число(ОС.FreePhysicalMemory) / 1024;
			
			Если ОС.LastBootUpTime <> Null И ОС.LocalDateTime <> Null Тогда
				Часов = (ДатаWMI(ОС.LocalDateTime) - ДатаWMI(ОС.LastBootUpTime)) / 3600;
				Сведения.ДатаЗапускаОС = ДатаWMI(ОС.LastBootUpTime);
				Сведения.ЧасовРаботыОС = Часов;
			КонецЕсли;
			
		КонецЦикла;
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика,
			НСтр("ru='Сведения ОС и свободная память через WMI недоступны: '") + ОписаниеОшибки());
	КонецПопытки;
	
#КонецЕсли
	
КонецПроцедуры

Процедура ДополнитьОборудованиеЧерезWMI(Сведения, WMI)
	
#Если Не ВебКлиент Тогда
	Для Каждого Плата Из СтрокиWMI(Сведения, WMI,
			"SELECT Manufacturer, Product FROM Win32_BaseBoard", "Материнская плата") Цикл
		ДополнитьСведенияПлатыЧерезWMI(Сведения, Плата);
	КонецЦикла;
	
	Для Каждого Диск Из СтрокиWMI(Сведения, WMI,
			"SELECT Model, Size FROM Win32_DiskDrive", "Физические диски") Цикл
		ДополнитьСведенияДискаЧерезWMI(Сведения, Диск);
	КонецЦикла;
	
#КонецЕсли
	
КонецПроцедуры

Процедура ДополнитьСведенияПлатыЧерезWMI(Сведения, Плата)
	
	ОписаниеПлаты = Новый Структура("Производитель,Модель", "", "");
	Попытка
		ОписаниеПлаты.Производитель = Строка(Плата.Manufacturer);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Производитель материнской платы: недоступно");
	КонецПопытки;
	
	Попытка
		ОписаниеПлаты.Модель = Строка(Плата.Product);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Модель материнской платы: недоступно");
	КонецПопытки;
	
	Сведения.МатеринскиеПлаты.Добавить(ОписаниеПлаты);
	
КонецПроцедуры

Процедура ДополнитьСведенияДискаЧерезWMI(Сведения, Диск)
	
	ОписаниеДиска = Новый Структура("Модель,РазмерБайт", "", Неопределено);
	Попытка
		ОписаниеДиска.Модель = Строка(Диск.Model);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Модель физического диска: недоступно");
	КонецПопытки;
	
	Попытка
		ОписаниеДиска.РазмерБайт = ЧислоWMI(Диск.Size);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Размер физического диска: недоступно");
	КонецПопытки;
	
	Сведения.ФизическиеДиски.Добавить(ОписаниеДиска);
	
КонецПроцедуры

Процедура ДобавитьОписаниеКомпонента(Описание, Компонент)
	
	Если Не ПустаяСтрока(Описание) Тогда
		Описание = Описание + "; ";
	КонецЕсли;
	
	Описание = Описание + Компонент;
	
КонецПроцедуры

Функция СтрокиWMI(Сведения, WMI, ТекстЗапроса, Название)
	
	Строки = Новый Массив;
#Если Не ВебКлиент Тогда
	Попытка
		// Полусинхронный WMI может сообщить об ошибке только при переборе.
		Для Каждого СтрокаWMI Из WMI.ExecQuery(ТекстЗапроса, "WQL", 48) Цикл
			Строки.Добавить(СтрокаWMI);
		КонецЦикла;
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, Название + ": недоступно");
	КонецПопытки;
	
#КонецЕсли
	
	Возврат Строки;
	
КонецФункции

Процедура ДополнитьБыстрыйОсмотр(Сведения, WMI, Подробно)
	
	Попытка
		ДополнитьЗагрузкуПроцессора(Сведения, WMI, Подробно);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Загрузка CPU: недоступно");
	КонецПопытки;
	
	Попытка
		ДополнитьФайлыПодкачки(Сведения, WMI);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Файл подкачки: недоступно");
	КонецПопытки;
	
	Попытка
		ДополнитьЛогическиеДиски(Сведения, WMI);
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Свободное место: недоступно");
	КонецПопытки;
	
КонецПроцедуры

Процедура ДополнитьЗагрузкуПроцессора(Сведения, WMI, Подробно)
	
	Для Каждого ЦП Из СтрокиWMI(Сведения, WMI,
			"SELECT DeviceID, LoadPercentage, Name, NumberOfCores, NumberOfLogicalProcessors "
			+ "FROM Win32_Processor", "Загрузка CPU") Цикл
		Процессор = Новый Структура;
		Процессор.Вставить("Имя", Строка(ЦП.DeviceID));
		Процессор.Вставить("Загрузка", ЧислоWMI(ЦП.LoadPercentage));
		Процессор.Вставить("Модель", ?(Подробно, СокрЛП(Строка(ЦП.Name)), ""));
		Процессор.Вставить("Ядер", ЧислоWMI(ЦП.NumberOfCores));
		Процессор.Вставить("Потоков", ЧислоWMI(ЦП.NumberOfLogicalProcessors));
		Сведения.Процессоры.Добавить(Процессор);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьФайлыПодкачки(Сведения, WMI)
	
	Для Каждого Подкачка Из СтрокиWMI(Сведения, WMI,
			"SELECT Name, AllocatedBaseSize, CurrentUsage FROM Win32_PageFileUsage", "Файл подкачки") Цикл
		Сведения.ФайлыПодкачки.Добавить(Новый Структура("Имя,ВсегоМБ,ЗанятоМБ",
			Строка(Подкачка.Name), ЧислоWMI(Подкачка.AllocatedBaseSize), ЧислоWMI(Подкачка.CurrentUsage)));
	КонецЦикла;
	
КонецПроцедуры

Функция ДатаWMI(Знач Текст)
	
	Текст = Строка(Текст);
	
	Возврат Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 5, 2)), Число(Сред(Текст, 7, 2)),
		Число(Сред(Текст, 9, 2)), Число(Сред(Текст, 11, 2)), Число(Сред(Текст, 13, 2)));
	
КонецФункции

Процедура ДополнитьЛогическиеДиски(Сведения, WMI)
	
	// Сетевые ресурсы не опрашиваем.
	Для Каждого Диск Из СтрокиWMI(Сведения, WMI,
			"SELECT DeviceID, Size, FreeSpace FROM Win32_LogicalDisk WHERE DriveType = 3", "Свободное место") Цикл
		Сведения.ЛогическиеДиски.Добавить(Новый Структура("Имя,РазмерБайт,СвободноБайт",
			Строка(Диск.DeviceID), ЧислоWMI(Диск.Size), ЧислоWMI(Диск.FreeSpace)));
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область ПредохранительСистемногоСбора

Функция КлючОбластиСистемногоСбора(Знач Основа)
	
	ЧислоКлюча = 17;
	
	Для Индекс = 1 По СтрДлина(Основа) Цикл
		ЧислоКлюча = (ЧислоКлюча * 31 + КодСимвола(Основа, Индекс)) % 2147483647;
	КонецЦикла;
	
	Возврат Формат(ЧислоКлюча, "ЧГ=;ЧДЦ=0");
	
КонецФункции

Функция НачатаяПопыткаСистемногоСбора(Область, Сторона, Повторить)
	
	ПопыткаСбора = Новый Структура;
	ПопыткаСбора.Вставить("Разрешено", Ложь);
	ПопыткаСбора.Вставить("Путь", КаталогВременныхФайлов() + "infostart-wmi-" + КлючОбластиСистемногоСбора(Область
		+ ИмяКомпьютера() + Сторона) + ".lock");
	ПопыткаСбора.Вставить("Идентификатор", Строка(Новый УникальныйИдентификатор));
	ПопыткаСбора.Вставить("Причина", "");
	
	Попытка
		Файлы = Новый COMОбъект("Scripting.FileSystemObject");
		
		Если Файлы.FileExists(ПопыткаСбора.Путь) Тогда
			ФайлПопытки = Файлы.GetFile(ПопыткаСбора.Путь);
			Возраст = ТекущаяДата() - Дата(ФайлПопытки.DateLastModified);
			
			Если Не Повторить И Возраст >= 0 И Возраст < 900 Тогда
				ПопыткаСбора.Причина = НСтр("ru='Предыдущая попытка системного сбора не завершилась или еще "
					+ "выполняется. Подробный сбор пропущен. Повторная команда сбора "
					+ "системной информации повторит попытку. Предохранитель действует 15 "
					+ "минут.'");
				
				Возврат ПопыткаСбора;
			КонецЕсли;
			
			Файлы.DeleteFile(ПопыткаСбора.Путь);
		КонецЕсли;
		
		Поток = Файлы.CreateTextFile(ПопыткаСбора.Путь, Ложь, Истина);
		Поток.Write(ПопыткаСбора.Идентификатор);
		Поток.Close();
		ПопыткаСбора.Разрешено = Истина;
	Исключение
		ПопыткаСбора.Причина = НСтр("ru='Предохранитель системного сбора недоступен: '") + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат ПопыткаСбора;
	
КонецФункции

Процедура ЗавершитьПопыткуСистемногоСбора(ПопыткаСбора)
	
	Если Не ПопыткаСбора.Разрешено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Файлы = Новый COMОбъект("Scripting.FileSystemObject");
		
		Если Не Файлы.FileExists(ПопыткаСбора.Путь) Тогда
			Возврат;
		КонецЕсли;
		
		Поток = Файлы.OpenTextFile(ПопыткаСбора.Путь, 1, Ложь, -1);
		Владелец = Поток.ReadAll();
		Поток.Close();
		
		Если Владелец = ПопыткаСбора.Идентификатор Тогда
			Файлы.DeleteFile(ПопыткаСбора.Путь);
		КонецЕсли;
	Исключение
		// Остаточный маркер ограничен сроком действия; данные системы уже собраны.
	КонецПопытки;
	
КонецПроцедуры

// #КонецОбласти

// #Область КонтрактыСведений

Функция ЧислоWMI(Значение)
	
	Возврат ?(Значение = Null, Неопределено, Число(Значение));
	
КонецФункции

// #КонецОбласти

// #Область ДиагностикаLinux

Функция СведенияКомпьютераLinux(Система)
	
	Сведения = НовыеСведенияКомпьютера();
	Сведения.Имя = ИмяКомпьютера();
	Сведения.ОС = Система.ВерсияОС;
	Сведения.Платформа = Система.ВерсияПриложения;
	Сведения.ВсегоПамятиМБ = Система.ОперативнаяПамять;
	Сведения.Процессор = Система.Процессор;
	// Linux-команды завершаются TERM/KILL по времени; предохранитель Windows/WMI здесь не используется.
	
	Попытка
		Снимок = СнимокСистемныхСведенийLinux();
		ЗаполнитьСведенияLinux(Сведения, Снимок);
	Исключение
		Сведения.Диагностика = НСтр("ru='Системные сведения Linux получены не полностью: '") + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Сведения;
	
КонецФункции

Функция СнимокСистемныхСведенийLinux()
	
	ПрограммаОграниченияВремени = Новый Файл("/usr/bin/timeout");
	
	Если Не ПрограммаОграниченияВремени.Существует() Тогда
		ВызватьИсключение НСтр("ru='Не найдена штатная команда /usr/bin/timeout.'");
	КонецЕсли;
	
	ИмяСценария = ПолучитьИмяВременногоФайла("sh");
	ИмяРезультата = ПолучитьИмяВременногоФайла("txt");
	
	Попытка
		ПолучитьМакет("СнимокLinux").Записать(ИмяСценария);
		КодВозврата = 0;
		Команда = "/usr/bin/timeout -k 1s 5s /bin/sh " + ПутьКомандыLinux(ИмяСценария) + " "
		+ ПутьКомандыLinux(ИмяРезультата);
		ЗапуститьПриложение(Команда, , Истина, КодВозврата);
		Документ = Новый ТекстовыйДокумент;
		Документ.Прочитать(ИмяРезультата, КодировкаТекста.UTF8);
		Разделы = РазделыСнимкаLinux(Документ);
		Разделы.Вставить("КодВозврата", КодВозврата);
	Исключение
		УдалитьФайлыСнимкаLinux(ИмяСценария, ИмяРезультата);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьФайлыСнимкаLinux(ИмяСценария, ИмяРезультата);
	
	Возврат Разделы;
	
КонецФункции

Функция ПутьКомандыLinux(Путь)
	
	Возврат "'" + СтрЗаменить(Путь, "'", "'""'""'") + "'";
	
КонецФункции

Процедура УдалитьФайлыСнимкаLinux(Сценарий, Результат)
	
	Для Каждого Путь Из ПоляСтрокиLinux(Сценарий + Символы.ПС + Результат, Символы.ПС) Цикл
		Попытка
			УдалитьФайлы(Путь);
		Исключение
			Продолжить; // Ошибка очистки не скрывает причину ошибки сбора.
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

Функция РазделыСнимкаLinux(Документ)
	
	Разделы = Новый Соответствие;
	Статусы = Новый Соответствие;
	Разделы.Вставить("Статусы", Статусы);
	Строки = Неопределено;
	Раздел = "";
	
	Для Индекс = 1 По Документ.КоличествоСтрок() Цикл
		Текст = СокрЛП(Документ.ПолучитьСтроку(Индекс));
		
		Если Лев(Текст, 1) = "[" И Прав(Текст, 1) = "]" Тогда
			Раздел = Сред(Текст, 2, СтрДлина(Текст) - 2);
			Строки = Новый Массив;
			Разделы.Вставить(Раздел, Строки);
		ИначеЕсли Лев(Текст, 8) = "@status=" Тогда
			Статусы.Вставить(Раздел, Сред(Текст, 9));
		ИначеЕсли Строки <> Неопределено И Не ПустаяСтрока(Текст) Тогда
			Строки.Добавить(Текст);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Разделы;
	
КонецФункции

Функция СтрокиРазделаLinux(Снимок, Имя)
	
	Строки = Снимок.Получить(Имя);
	
	Возврат ?(Строки = Неопределено, Новый Массив, Строки);
	
КонецФункции

Функция ПарыРазделаLinux(Строки, Разделитель)
	
	Пары = Новый Соответствие;
	
	Для Каждого Текст Из Строки Цикл
		Позиция = Найти(Текст, Разделитель);
		
		Если Позиция > 0 Тогда
			Пары.Вставить(СокрЛП(Лев(Текст, Позиция - 1)), СокрЛП(Сред(Текст, Позиция + 1)));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Пары;
	
КонецФункции

Функция ПоляСтрокиLinux(Знач Текст, Разделитель = " ")
	
	Поля = Новый Массив;
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");
	
	Если Разделитель = " " Тогда
		Пока Найти(Текст, "  ") > 0 Цикл
			Текст = СтрЗаменить(Текст, "  ", " ");
		КонецЦикла;
	КонецЕсли;
	
	Пока Истина Цикл
		Позиция = Найти(Текст, Разделитель);
		
		Если Позиция = 0 Тогда
			Поля.Добавить(Текст);
			Прервать;
		КонецЕсли;
		
		Поля.Добавить(Лев(Текст, Позиция - 1));
		Текст = Сред(Текст, Позиция + СтрДлина(Разделитель));
	КонецЦикла;
	
	Возврат Поля;
	
КонецФункции

Процедура ЗаполнитьСведенияLinux(Сведения, Снимок)
	
	Для Каждого Компонент Из ПоляСтрокиLinux("ОС|Память|Процессор|Диски|Подкачка|Оборудование", "|") Цикл
		ЗаполнитьКомпонентLinux(Компонент, Сведения, Снимок);
	КонецЦикла;
	
	ЗаполнитьВиртуализациюLinux(Сведения, Снимок);
	ДополнитьДиагностикуСнимкаLinux(Сведения, Снимок);
	
КонецПроцедуры

Процедура ЗаполнитьВиртуализациюLinux(Сведения, Снимок)
	
	Строки = СтрокиРазделаLinux(Снимок, "virtualization");
	
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Вид = НРег(СокрЛП(Строки[0]));
	
	Если Вид = "vmware" Тогда
		Сведения.Виртуализация = "VMware";
	ИначеЕсли Вид = "microsoft" Тогда
		Сведения.Виртуализация = "Hyper-V";
	ИначеЕсли Вид = "oracle" Тогда
		Сведения.Виртуализация = "VirtualBox";
	ИначеЕсли Вид = "kvm" Или Вид = "qemu" Тогда
		Сведения.Виртуализация = "KVM/QEMU";
	ИначеЕсли Вид = "xen" Тогда
		Сведения.Виртуализация = "Xen";
	ИначеЕсли Вид = "parallels" Тогда
		Сведения.Виртуализация = "Parallels";
	ИначеЕсли Вид = "amazon" Тогда
		Сведения.Виртуализация = "Amazon EC2";
	ИначеЕсли Вид = "google" Тогда
		Сведения.Виртуализация = "Google Compute Engine";
	ИначеЕсли Не ПустаяСтрока(Вид) И Вид <> "none"
		И Не ЭтоИдентификаторКонтейнераLinux(Вид) Тогда
		// Сценарий передает только успешный результат systemd-detect-virt --vm.
		Сведения.Виртуализация = Вид;
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоИдентификаторКонтейнераLinux(Вид)
	
	Контейнеры = "|openvz|lxc|lxc-libvirt|systemd-nspawn|docker|podman|rkt|wsl|proot|pouch|";
	
	Возврат Найти(Контейнеры, "|" + Вид + "|") > 0;
	
КонецФункции

Процедура ЗаполнитьОСLinux(Сведения, Снимок)
	
	Пары = ПарыРазделаLinux(СтрокиРазделаLinux(Снимок, "os"), "=");
	Представление = Пары.Получить("PRETTY_NAME");
	
	Если Представление <> Неопределено Тогда
		Представление = СокрЛП(СтрЗаменить(Представление, """", ""));
		
		Если Не ПустаяСтрока(Представление) Тогда
			Сведения.ОС = Представление;
		КонецЕсли;
	КонецЕсли;
	
	Строки = СтрокиРазделаLinux(Снимок, "uptime");
	
	Если Строки.Количество() > 0 Тогда
		Секунды = Число(ПоляСтрокиLinux(ПоляСтрокиLinux(Строки[0])[0], ".")[0]);
		Сведения.ДатаЗапускаОС = ТекущаяДата() - Секунды;
		Сведения.ЧасовРаботыОС = Секунды / 3600;
	КонецЕсли;
	
	Строки = СтрокиРазделаLinux(Снимок, "identity");
	
	Если Строки.Количество() > 0 Тогда
		Сведения.Идентификатор = Строки[0];
	КонецЕсли;
	
КонецПроцедуры

Функция КилобайтыПамятиLinux(Пары, Имя)
	
	Текст = Пары.Получить(Имя);
	
	Возврат ?(Текст = Неопределено, 0, Число(ПоляСтрокиLinux(Текст)[0]));
	
КонецФункции

Процедура ЗаполнитьПамятьLinux(Сведения, Снимок)
	
	Пары = ПарыРазделаLinux(СтрокиРазделаLinux(Снимок, "memory"), ":");
	Всего = КилобайтыПамятиLinux(Пары, "MemTotal");
	
	Если Всего <= 0 Тогда
		ВызватьИсключение НСтр("ru='Не получен общий объём памяти /proc/meminfo.'");
	КонецЕсли;
	
	Если Пары.Получить("MemAvailable") <> Неопределено Тогда
		Свободно = КилобайтыПамятиLinux(Пары, "MemAvailable");
	Иначе
		Если Пары.Получить("MemFree") = Неопределено Тогда
			ВызватьИсключение НСтр("ru='Доступная память /proc/meminfo не определена.'");
		КонецЕсли;
		
		ДобавитьОписаниеКомпонента(Сведения.Диагностика,
			"Доступная ОП: приближённая оценка, MemAvailable отсутствует.");
		Свободно = КилобайтыПамятиLinux(Пары, "MemFree") + КилобайтыПамятиLinux(Пары, "Buffers")
		+ КилобайтыПамятиLinux(Пары, "Cached") + КилобайтыПамятиLinux(Пары, "SReclaimable")
		- КилобайтыПамятиLinux(Пары, "Shmem");
	КонецЕсли;
	
	Сведения.ВсегоПамятиМБ = Всего / 1024;
	Сведения.СвободноПамятиМБ = Макс(0, Мин(Всего, Свободно)) / 1024;
	
КонецПроцедуры

Функция СчетчикиПроцессораLinux(Строки)
	
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Поля = ПоляСтрокиLinux(СокрЛП(Строки[0]));
	
	Если Поля.Количество() < 6 Или Поля[0] <> "cpu" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("Всего,Простой", 0, 0);
	
	Попытка
		// guest и guest_nice уже входят в user/nice: учитываем только первые восемь счётчиков.
		Для Индекс = 1 По Мин(8, Поля.Количество() - 1) Цикл
			Счетчик = Число(Поля[Индекс]);
			
			Если Счетчик < 0 Или Счетчик <> Цел(Счетчик) Тогда
				Возврат Неопределено;
			КонецЕсли;
			
			Результат.Всего = Результат.Всего + Счетчик;
			
			Если Индекс = 4 Или Индекс = 5 Тогда
				Результат.Простой = Результат.Простой + Счетчик;
			КонецЕсли;
		КонецЦикла;
	Исключение
		
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат ?(Результат.Всего > 0, Результат, Неопределено);
	
КонецФункции

Функция ЗагрузкаПроцессораLinux(До, После)
	
	Если До = Неопределено Или После = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Период = После.Всего - До.Всего;
	Простой = После.Простой - До.Простой;
	
	Если Период <= 0 Или Простой < 0 Или Простой > Период Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Окр((1 - Простой / Период) * 100, 0);
	
КонецФункции

Процедура ЗаполнитьПроцессорLinux(Сведения, Снимок)
	
	Если СтрокиРазделаLinux(Снимок, "cpuinfo").Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru='Сведения процессора /proc/cpuinfo недоступны.'");
	КонецЕсли;
	
	Логических = 0;
	Ядра = Новый Соответствие;
	Сокеты = Новый Соответствие;
	Сокет = "0";
	Модель = "";
	
	Для Каждого Текст Из СтрокиРазделаLinux(Снимок, "cpuinfo") Цикл
		Позиция = Найти(Текст, ":");
		
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Ключ = СокрЛП(Лев(Текст, Позиция - 1));
		Значение = СокрЛП(Сред(Текст, Позиция + 1));
		
		Если Ключ = "processor" Тогда
			Логических = Логических + 1;
		ИначеЕсли Ключ = "model name" Тогда
			Модель = Значение;
		ИначеЕсли Ключ = "physical id" Тогда
			Сокет = Значение;
			Сокеты.Вставить(Сокет, Истина);
		ИначеЕсли Ключ = "core id" Тогда
			Ядра.Вставить(Сокет + ":" + Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Процессор = Новый Структура;
	Процессор.Вставить("Имя", "CPU");
	Процессор.Вставить("Модель", ?(Сокеты.Количество() > 1,
		Формат(Сокеты.Количество(), "ЧГ=; ЧН=0") + " × ", "") + Модель);
	Процессор.Вставить("Ядер", ?(Ядра.Количество() = 0, Логических, Ядра.Количество()));
	Процессор.Вставить("Потоков", Логических);
	Процессор.Вставить("Загрузка", Неопределено);
	Сведения.Процессоры.Добавить(Процессор);
	До = СчетчикиПроцессораLinux(СтрокиРазделаLinux(Снимок, "cpu_before"));
	После = СчетчикиПроцессораLinux(СтрокиРазделаLinux(Снимок, "cpu_after"));
	Процессор.Загрузка = ЗагрузкаПроцессораLinux(До, После);
	
	Если Процессор.Загрузка = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Загрузка процессора /proc/stat недоступна.'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДискиLinux(Сведения, Снимок)
	
	ЗаполнитьТочкиМонтированияLinux(Сведения, Снимок);
	Устройства = УстройстваДисковLinux(Снимок);
	Для Каждого Текст Из СтрокиРазделаLinux(Снимок, "disks") Цикл
		Поля = ПоляСтрокиLinux(Текст, "|");
		Если Поля.Количество() = 3 Тогда
			Имя = ПутьМонтированияLinux(Поля[2]);
			Диск = Новый Структура;
			Диск.Вставить("Имя", Имя);
			Диск.Вставить("РазмерБайт", Число(Поля[0]));
			Диск.Вставить("СвободноБайт", Число(Поля[1]));
			Диск.Вставить("Устройство", Устройства[Имя]);
			Сведения.ЛогическиеДиски.Добавить(Диск);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция УстройстваДисковLinux(Снимок)
	
	Устройства = Новый Соответствие;
	Для Каждого Текст Из СтрокиРазделаLinux(Снимок, "mounts") Цикл
		Поля = ПоляСтрокиLinux(Текст);
		Разделитель = Найти(Текст, " - ");
		Если Поля.Количество() < 6 Или Разделитель = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПоляФайловойСистемы = ПоляСтрокиLinux(Сред(Текст, Разделитель + 3));
		Если ПоляФайловойСистемы.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Устройства.Вставить(ПутьМонтированияLinux(Поля[4]), ПутьМонтированияLinux(ПоляФайловойСистемы[1]));
	КонецЦикла;
	
	Возврат Устройства;
	
КонецФункции

Процедура ЗаполнитьПодкачкуLinux(Сведения, Снимок)
	
	Строки = СтрокиРазделаLinux(Снимок, "swap");
	
	Для Индекс = 1 По Строки.Количество() - 1 Цикл
		Поля = ПоляСтрокиLinux(Строки[Индекс]);
		Сведения.ФайлыПодкачки.Добавить(Новый Структура("Имя,ВсегоМБ,ЗанятоМБ", Поля[0], Число(Поля[2]) / 1024,
			Число(Поля[3]) / 1024));
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОборудованиеLinux(Сведения, Снимок)
	
	Плата = ПарыРазделаLinux(СтрокиРазделаLinux(Снимок, "board"), "=");
	
	Если Плата.Получить("board_name") <> Неопределено Тогда
		Сведения.МатеринскиеПлаты.Добавить(Новый Структура("Производитель,Модель",
			?(Плата.Получить("board_vendor") = Неопределено, "", Плата.Получить("board_vendor")),
			Плата.Получить("board_name")));
	КонецЕсли;
	
	Для Каждого Текст Из СтрокиРазделаLinux(Снимок, "physical") Цикл
		Поля = ПоляСтрокиLinux(Текст, "|");
		
		Если Поля.Количество() = 3 Тогда
			Модель = СокрЛП(Поля[1]);
			Сведения.ФизическиеДиски.Добавить(Новый Структура("Модель,РазмерБайт",
				Поля[0] + ": " + ?(ПустаяСтрока(Модель), "n/a", Модель),
				Число(Поля[2]) * 512));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКомпонентLinux(Компонент, Сведения, Снимок)
	
	Попытка
		Если Компонент = "ОС" Тогда
			ЗаполнитьОСLinux(Сведения, Снимок);
		ИначеЕсли Компонент = "Память" Тогда
			ЗаполнитьПамятьLinux(Сведения, Снимок);
		ИначеЕсли Компонент = "Процессор" Тогда
			ЗаполнитьПроцессорLinux(Сведения, Снимок);
		ИначеЕсли Компонент = "Диски" Тогда
			ЗаполнитьДискиLinux(Сведения, Снимок);
		ИначеЕсли Компонент = "Подкачка" Тогда
			ЗаполнитьПодкачкуLinux(Сведения, Снимок);
		ИначеЕсли Компонент = "Оборудование" Тогда
			ЗаполнитьОборудованиеLinux(Сведения, Снимок);
		КонецЕсли;
	Исключение
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, Компонент + ": " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

Процедура ДополнитьДиагностикуСнимкаLinux(Сведения, Снимок)
	
	Статусы = Снимок.Получить("Статусы");
	
	Если Статусы <> Неопределено Тогда
		Для Каждого Статус Из Статусы Цикл
			Если Статус.Значение = "0" Или Статус.Ключ = "virtualization" Тогда
				Продолжить;
			КонецЕсли;
			
			Если Статус.Ключ = "disks" И Сведения.ЛогическиеДиски.Количество() > 0 Тогда
				Описание = "Часть точек монтирования Linux недоступна; показаны доступные диски (код "
				+ Статус.Значение + ")";
			ИначеЕсли Статус.Ключ = "board" Или Статус.Ключ = "identity" Или Статус.Ключ = "os" Тогда
				Описание = "Необязательные сведения Linux: " + Статус.Ключ + " не предоставлены (код "
				+ Статус.Значение + ")";
			Иначе
				Описание = "Раздел Linux " + Статус.Ключ + ": недоступен или прочитан не полностью (код "
				+ Статус.Значение + ")";
			КонецЕсли;
			
			ДобавитьОписаниеКомпонента(Сведения.Диагностика, Описание);
		КонецЦикла;
	КонецЕсли;
	
	Код = Снимок.Получить("КодВозврата");
	
	Если Код = 124 Или Код = 137 Тогда
		ДобавитьОписаниеКомпонента(Сведения.Диагностика,
			"Осмотр Linux прерван по ограничению времени (5 с и до 1 с на завершение).");
	ИначеЕсли Код <> 0 Или Снимок.Получить("complete") = Неопределено Тогда
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Осмотр Linux не завершён; код запуска " + Строка(Код) + ".");
	КонецЕсли;
	
	Если Сведения.ЛогическиеДиски.Количество() = 0 Тогда
		ДобавитьОписаниеКомпонента(Сведения.Диагностика, "Свободное место дисков Linux недоступно.");
	КонецЕсли;
	
КонецПроцедуры

Функция ПутьМонтированияLinux(Текст)
	
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст,
		"\040", " "), "\011", Символы.Таб), "\012", Символы.ПС), "\134", "\");
	
КонецФункции

Процедура ЗаполнитьТочкиМонтированияLinux(Сведения, Снимок, КаталогБазы = Неопределено)
	
	Если КаталогБазы = Неопределено Тогда
		КаталогБазы = КаталогФайловойБазы(СтрокаСоединенияИнформационнойБазы());
	КонецЕсли;
	
	ВыбраннаяТочка = "";
	
	Если Лев(КаталогБазы, 1) = "/" Тогда
		Для Каждого Текст Из СтрокиРазделаLinux(Снимок, "mounts") Цикл
			Поля = ПоляСтрокиLinux(Текст);
			
			Если Поля.Количество() < 6 Тогда
				Продолжить;
			КонецЕсли;
			
			Точка = ПутьМонтированияLinux(Поля[4]);
			
			Если ЭтоКаталогНаТочкеМонтирования(КаталогБазы, Точка) И СтрДлина(Точка) > СтрДлина(ВыбраннаяТочка) Тогда
				ВыбраннаяТочка = Точка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Сведения.Вставить("ТочкаМонтированияБазы", ВыбраннаяТочка);
	
КонецПроцедуры

// #КонецОбласти

// #Область ВспомогательныеМетоды

Функция КаталогФайловойБазы(СтрокаСоединения)
	
	Если Не ИнформационнаяБазаФайловая(СтрокаСоединения) Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = СокрЛП(Сред(СтрокаСоединения, 6));
	
	Если Лев(Остаток, 1) = """" Тогда
		Результат = "";
		Индекс = 2;
		
		Пока Индекс <= СтрДлина(Остаток) Цикл
			Символ = Сред(Остаток, Индекс, 1);
			
			Если Символ = """" Тогда
				Если Сред(Остаток, Индекс + 1, 1) <> """" Тогда
					Возврат Результат;
				КонецЕсли;
				
				Индекс = Индекс + 1;
			КонецЕсли;
			
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
		КонецЦикла;
		
		Возврат "";
	КонецЕсли;
	
	Разделитель = Найти(Остаток, ";");
	
	Возврат ?(Разделитель = 0, Остаток, Лев(Остаток, Разделитель - 1));
	
КонецФункции

Функция ЭтоКаталогНаТочкеМонтирования(Каталог, Точка)
	
	Если Точка = "/" Тогда
		Возврат Лев(Каталог, 1) = "/";
	КонецЕсли;
	
	Возврат Каталог = Точка Или Лев(Каталог, СтрДлина(Точка) + 1) = Точка + "/";
	
КонецФункции

// #КонецОбласти

// #Область СовместимостьПлатформы

Функция ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "")
	
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		
		СтрокаСоединенияИнформационнойБазы = СтрокаСоединенияИнформационнойБазы();
		
		Возврат Найти(ВРег(СтрокаСоединенияИнформационнойБазы), "FILE=") = 1;
		
	КонецЕсли;
	
	Возврат Найти(ВРег(СтрокаСоединенияИнформационнойБазы), "FILE=") = 1;
	
КонецФункции

