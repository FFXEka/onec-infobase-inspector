// #Область ОписаниеПеременных

Перем ОписанияТаблиц; // Массив, Неопределено - схема разделов текущего контекста.

// #КонецОбласти

// #Область СлужебныйПрограммныйИнтерфейс

// #Область УниверсальныеСписки

// Подготавливает описание штатного списка выбранных метаданных.
//
// Параметры:
//  ПараметрыОткрытия - Структура - метаданные списка; необязательные текущие Период и Организация.
//   * КоличествоСтрокТабличныхЧастей - Булево - включать счетчики; при отсутствии поля включены.
//
// Возвращаемое значение:
//  Структура - таблица, поля, текст и параметры запроса, отборы и синонимы метаданных.
//   * ИменаПолейТабличныхЧастей - Соответствие - имена табличных частей и уникальные поля их счетчиков.
//   * ОсновнаяТаблица - Строка - полное имя основной таблицы метаданных.
//   * Поля - Массив из Строка - поля записи, субконто и включенные счетчики табличных частей.
//   * СинонимКоллекции - Строка - представление вида метаданных.
//   * СинонимОбъекта - Строка - синоним либо имя выбранного объекта.
//   * ТекстЗапроса - Строка - запрос списка с примененными отборами.
//   * ПараметрыЗапроса - Соответствие - значения параметров запроса.
//   * ОтборСписка - Структура - имена полей и значения периода и организации.
//   * НастройкиОтборов - Структура - доступность и видимость отборов формы.
//   * ДинамическоеСчитываниеДанных - Булево - режим чтения списка по потребности отображения.
Функция ДанныеУниверсальногоСписка(ПараметрыОткрытия) Экспорт
	
	СоответствияПадежей = СоответствияПадежейИменКоллекцийМетаданных();
	ИмяКоллекции = СоответствияПадежей.Получить(ПараметрыОткрытия.КоллекцияОбъектовМетаданных);
	ОбъектМетаданных = Метаданные[ИмяКоллекции][ПараметрыОткрытия.ОбъектМетаданных];
	Поля = ПоляОбъектаМетаданных(ПараметрыОткрытия, ОбъектМетаданных);
	ИменаПолейТабличныхЧастей = ИменаПолейТабличныхЧастейСписка(Поля);
	ИсключитьОтключенныеСчетчикиСписка(Поля, ПараметрыОткрытия);
	Отбор = ОтборСписка(ПараметрыОткрытия, ОбъектМетаданных);
	ПараметрыЗапроса = Новый Соответствие;
	ТекстОтбора = ТекстОтбораСписка(Отбор, ПараметрыЗапроса, "Данные.");
	
	ДанныеСписка = Новый Структура;
	ДанныеСписка.Вставить("ОсновнаяТаблица", ПараметрыОткрытия.КоллекцияОбъектовМетаданных
		+ "." + ПараметрыОткрытия.ОбъектМетаданных);
	ДанныеСписка.Вставить("Поля", Поля);
	ДанныеСписка.Вставить("ИменаПолейТабличныхЧастей", ИменаПолейТабличныхЧастей);
	ДанныеСписка.Вставить("ДинамическоеСчитываниеДанных", Истина);
	ДанныеСписка.Вставить("СинонимКоллекции",
		ПредставлениеКоллекцииСписка(ПараметрыОткрытия.КоллекцияОбъектовМетаданных));
	ДанныеСписка.Вставить("СинонимОбъекта",
		?(ПустаяСтрока(ОбъектМетаданных.Синоним), ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним));
	ДанныеСписка.Вставить("ТекстЗапроса",
		ТекстЗапросаСписка(ПараметрыОткрытия, Поля, ИменаПолейТабличныхЧастей, Отбор) + ТекстОтбора);
	ДанныеСписка.Вставить("ПараметрыЗапроса", ПараметрыЗапроса);
	ДанныеСписка.Вставить("ОтборСписка", Отбор);
	ДанныеСписка.Вставить("НастройкиОтборов", НастройкиОтборовСписка(ОбъектМетаданных, Отбор));
	
	Возврат ДанныеСписка;
	
КонецФункции

// Описывает физические поля выбранного бухгалтерского регистра и движений документа.
//
// Параметры:
//  ПолноеИмя - Строка - полное имя выбранного объекта метаданных.
//
// Возвращаемое значение:
//  Соответствие - полное имя регистра и массив описаний его физических полей; каждый элемент массива содержит
//   следующие поля.
//   * Имя - Строка - имя поля записи с учетом корреспонденции и балансовости.
//   * Синоним - Строка - заголовок поля с обозначением стороны проводки.
//   * Тип - ОписаниеТипов - тип физического поля записи.
//   * Метаданные - ОбъектМетаданных - исходный реквизит или регистр для созданного поля счета.
//   * Группа - Строка - раздел реквизитов подробного просмотра.
//   * ДоступноВСписке - Булево - поле пригодно для универсального списка.
Функция ОписанияПолейБухгалтерскихРегистров(ПолноеИмя) Экспорт
	
	Описания = Новый Соответствие;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	
	Если Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных) Тогда
		Описания.Вставить(ПолноеИмя, ОписаниеПолейРегистраБухгалтерии(ОбъектМетаданных));
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Для Каждого Регистр Из ОбъектМетаданных.Движения Цикл
			Если Метаданные.РегистрыБухгалтерии.Содержит(Регистр) Тогда
				Описания.Вставить(Регистр.ПолноеИмя(), ОписаниеПолейРегистраБухгалтерии(Регистр));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Описания;
	
КонецФункции

// Определяет поле периода, пригодное для отбора строк объекта метаданных.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - документ, справочник или регистр.
//
// Возвращаемое значение:
//  Строка - имя поля или пустая строка, если период не предусмотрен.
Функция ИмяПоляПериода(ОбъектМетаданных) Экспорт
	
	Если Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат "Дата";
	ИначеЕсли Метаданные.РегистрыСведений.Содержит(ОбъектМетаданных) Тогда
		Если ОбъектМетаданных.ПериодичностьРегистраСведений
			<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Возврат "Период";
		КонецЕсли;
	ИначеЕсли Метаданные.РегистрыНакопления.Содержит(ОбъектМетаданных)
		Или Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных) Тогда
		Возврат "Период";
	ИначеЕсли Метаданные.РегистрыРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПериодРегистрации";
	ИначеЕсли Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Поле = ОбъектМетаданных.Реквизиты.Найти("Дата");
		
		Если Поле <> Неопределено Тогда
			Если Поле.Тип.СодержитТип(Тип("Дата")) Тогда
				Возврат "Дата";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Находит реквизит или измерение организации, совместимое с переданным типом ссылки.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - документ, справочник или регистр, для которого описывается отбор.
//  ТипОрганизации - Тип, Неопределено - тип ссылки; без значения выбирается подходящий реквизит справочника.
//
// Возвращаемое значение:
//  Строка - Организация, Фирма или пустая строка при отсутствии совместимого поля.
Функция ИмяПоляОрганизации(ОбъектМетаданных, ТипОрганизации = Неопределено) Экспорт
	
	Для Каждого ИмяПоля Из Новый Структура("Организация,Фирма") Цикл
		Поле = РеквизитОрганизацииСписка(ОбъектМетаданных, ИмяПоля.Ключ);
		
		Если Поле <> Неопределено Тогда
			Если ТипОрганизации = Неопределено Тогда
				Если СправочныеТипыОрганизации(Поле.Тип).Количество() > 0 Тогда
					Возврат ИмяПоля.Ключ;
				КонецЕсли;
			ИначеЕсли Поле.Тип.СодержитТип(ТипОрганизации) Тогда
				Возврат ИмяПоля.Ключ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

// Описывает реальные поля записи для отбора организации, включая стороны проводки.
//
// Параметры:
//  ОбъектМетаданных - ОбъектМетаданных - документ, справочник или регистр.
//  ТипОрганизации - Тип, Неопределено - тип ссылки; без значения выбирается подходящий реквизит справочника.
//
// Возвращаемое значение:
//  Структура - Имя — базовое имя реквизита; Поля — массив реальных имён полей записи.
Функция ОписаниеПолейОрганизации(ОбъектМетаданных, ТипОрганизации = Неопределено) Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", ИмяПоляОрганизации(ОбъектМетаданных, ТипОрганизации));
	Описание.Вставить("Поля", Новый Массив);
	
	Если ПустаяСтрока(Описание.Имя) Тогда
		Возврат Описание;
	КонецЕсли;
	
	Если ОрганизацияРазделенаПоСторонамПроводки(ОбъектМетаданных, Описание.Имя) Тогда
		Описание.Поля.Добавить(Описание.Имя + "Дт");
		Описание.Поля.Добавить(Описание.Имя + "Кт");
	Иначе
		Описание.Поля.Добавить(Описание.Имя);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

// Формирует условие равенства организации по любому из реальных полей записи.
//
// Параметры:
//  ПоляОрганизации - Массив - имена полей из ОписаниеПолейОрганизации.
//
// Возвращаемое значение:
//  Строка - условие с параметром Организация либо пустая строка для пустого массива.
Функция УсловиеОтбораПоОрганизации(ПоляОрганизации) Экспорт
	
	Условие = "";
	
	Для Каждого ИмяПоля Из ПоляОрганизации Цикл
		Условие = Условие + ?(ПустаяСтрока(Условие), "", " ИЛИ ") + ИмяПоля + " = &Организация";
	КонецЦикла;
	
	Возврат ?(ПоляОрганизации.Количество() > 1, "(" + Условие + ")", Условие);
	
КонецФункции

// #КонецОбласти

// #Область КонстантыИТабличныеЧасти

// Проверяет, допускает ли тип константы редактирование в универсальном окне.
//
// Параметры:
//  ИмяКонстанты - Строка - имя существующей константы в метаданных конфигурации.
//
// Возвращаемое значение:
//  Булево - Ложь для ХранилищаЗначения, Истина для поддерживаемых типов.
Функция КонстантаРедактируемаВУниверсальномОкне(ИмяКонстанты) Экспорт
	
	МетаданныеКонстанты = Метаданные.Константы.Найти(ИмяКонстанты);
	
	Возврат Не МетаданныеКонстанты.Тип.СодержитТип(Тип("ХранилищеЗначения"));
	
КонецФункции

// Подсчитывает строки табличных частей только для переданных ссылок списка.
//
// Параметры:
//  ПараметрыОткрытия - Структура - КоллекцияОбъектовМетаданных и ОбъектМетаданных выбранного списка.
//  Ссылки - Массив - ссылки только тех объектов, для которых нужны количества строк табличных частей.
//  ПоляСписка - Массив, Неопределено - имена колонок; при отсутствии определяются по метаданным списка.
//
// Возвращаемое значение:
//  Соответствие - ссылка объекта и количества строк его табличных частей.
Функция ЧислоСтрокТабличныхЧастейСписка(ПараметрыОткрытия, Ссылки, ПоляСписка = Неопределено) Экспорт
	
	Результат = Новый Соответствие;
	
	Если Ссылки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ПоляСписка = Неопределено Тогда
		ПоляСписка = ДанныеУниверсальногоСписка(ПараметрыОткрытия).Поля;
	КонецЕсли;
	
	ИменаПолейТабличныхЧастей = ИменаПолейТабличныхЧастейСписка(ПоляСписка);
	Поля = Новый Массив;
	Поля.Добавить("Ссылка");
	
	Для Каждого Поле Из ПоляСписка Цикл
		Если Лев(Поле, 5) = "$ТЧ$_" Тогда
			Поля.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	
	Если Поля.Количество() = 1 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаСписка(ПараметрыОткрытия, Поля, ИменаПолейТабличныхЧастей, Неопределено, Истина)
		+ Символы.ПС + "ГДЕ Данные.Ссылка В (&Ссылки)");
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗначенияСтроки = Новый Структура;
		
		Для Каждого Поле Из Поля Цикл
			Если Лев(Поле, 5) = "$ТЧ$_" Тогда
				ИмяПоля = ИменаПолейТабличныхЧастей.Получить(Сред(Поле, 6));
				Количество = Выборка[ИмяПоля];
				ЗначенияСтроки.Вставить(Сред(Поле, 6), Количество);
			КонецЕсли;
		КонецЦикла;
		
		Результат.Вставить(Выборка.Ссылка, ЗначенияСтроки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область СведенияОБазе

// Определяет файловый режим и доступный размер файла информационной базы.
//
// Возвращаемое значение:
//  Структура - режим работы, каталог, размер файла и диагностика чтения.
//   * Файловая - Булево - файловый режим информационной базы.
//   * Каталог - Строка - каталог файловой базы либо пустая строка.
//   * РазмерБайт - Число, Неопределено - размер 1Cv8.1CD, если он доступен.
//   * Ошибка - Строка - необязательное описание ошибки чтения файла.
Функция СведенияФайловойБазы() Экспорт
	
	Сведения = Новый Структура("Файловая,Каталог,РазмерБайт", ИнформационнаяБазаФайловая(), "", Неопределено);
	
	Если Не Сведения.Файловая Тогда
		Возврат Сведения;
	КонецЕсли;
	
	Сведения.Каталог = КаталогФайловойБазы(СтрокаСоединенияИнформационнойБазы());
	
	Попытка
		Если Не ПустаяСтрока(Сведения.Каталог) Тогда
			ФайлБазы = Новый Файл(Сведения.Каталог + "/1Cv8.1CD");
			
			Если ФайлБазы.Существует() Тогда
				Сведения.РазмерБайт = ФайлБазы.Размер();
			КонецЕсли;
		КонецЕсли;
	Исключение
		Сведения.Вставить("Ошибка", ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Сведения;
	
КонецФункции

// Читает физические имена таблиц для объектов основного скана.
//
// Параметры:
//  Скан - Структура, Неопределено - основной снимок со строками и зафиксированными отборами.
//  Кэш - Структура - кэш физических имен; чтение может дополнить его.
//
// Возвращаемое значение:
//  Соответствие - полное имя метаданных и имя физической таблицы.
Функция ИменаОсновныхТаблицСУБД(Скан, Кэш) Экспорт
	
	СтрокиСкана = Неопределено;
	
	Если Скан <> Неопределено Тогда
		СтрокиСкана = Скан.Строки;
	КонецЕсли;
	
	Возврат ИменаТаблицПоСтрокамСкана(СтрокиСкана, Кэш);
	
КонецФункции

// Возвращает физические имена объектов строк скана и всех видов документов для хронологии.
//
// Параметры:
//  СтрокиСкана - ТаблицаЗначений, Неопределено - строки основного снимка; при отсутствии читаются имена таблиц
//   документов для хронологии.
//  Кэш - Структура - кэш диагностики; см. ДанныеИнформационнойБазыИСистемы.ДанныеКэшаДиагностики.
//
// Возвращаемое значение:
//  Соответствие - полное имя метаданных и физическое имя таблицы; переданный кэш может дополняться.
Функция ИменаТаблицПоСтрокамСкана(СтрокиСкана, Кэш) Экспорт
	
	Возврат ИменаТаблицСУБД(ОбъектыДляИменТаблицСУБД(СтрокиСкана, Кэш), Кэш);
	
КонецФункции

// #КонецОбласти

// #Область МетаданныеИПоказатели

// Читает значение константы и сведения для универсального редактора.
//
// Параметры:
//  ИмяКонстанты - Строка - имя существующей константы в метаданных конфигурации.
//
// Возвращаемое значение:
//  Структура - значение, описание типа и возможность редактирования.
//   * Доступно - Булево - значение не имеет тип ХранилищеЗначения.
//   * Тип - ОписаниеТипов - допустимые типы выбранной константы.
//   * Заголовок - Строка - синоним и имя константы.
//   * Значение - Произвольный - текущее значение либо Неопределено для недоступного типа.
Функция ДанныеКонстанты(ИмяКонстанты) Экспорт
	
	Описание = Метаданные.Константы.Найти(ИмяКонстанты);
	
	Если Описание = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Константа не найдена: '") + ИмяКонстанты;
	КонецЕсли;
	
	Данные = Новый Структура;
	Данные.Вставить("Доступно", Не Описание.Тип.СодержитТип(Тип("ХранилищеЗначения")));
	Данные.Вставить("Тип", Описание.Тип);
	Данные.Вставить("Заголовок", Описание.Синоним + " (" + ИмяКонстанты + ")");
	Данные.Вставить("Значение", Неопределено);
	
	Если Данные.Доступно Тогда
		Данные.Значение = Константы[ИмяКонстанты].Получить();
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

// Проверяет выбранные метаданные и определяет объект подробного просмотра.
//
// Параметры:
//  ВыбранныеМетаданные - Структура - класс и имя объекта из выбранной строки.
//
// Возвращаемое значение:
//  Строка - полное имя метаданных, например Документ.ЗаказПоставщику.
Функция ПолноеИмяПодробногоПросмотра(ВыбранныеМетаданные) Экспорт
	
	Если ВыбранныеМетаданные = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Класс = ВыбранныеМетаданные.КоллекцияОбъектовМетаданных;
	
	Если Класс = "Константы" Тогда
		Класс = "Константа";
	КонецЕсли;
	
	ПолноеИмя = Класс + "." + ВыбранныеМетаданные.ОбъектМетаданных;
	
	Если Метаданные.НайтиПоПолномуИмени(ПолноеИмя) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ПолноеИмя;
	
КонецФункции

// Читает идентификатор, предоставляемый конфигурацией; недоступность не заменяется вымышленным UUID.
//
// Возвращаемое значение:
//  Строка - идентификатор базы либо пояснение его недоступности.
Функция ПредставлениеИдентификатораБазы() Экспорт
	
	Для Каждого Имя Из Новый Структура("ИдентификаторИнформационнойБазы,УникальныйИдентификаторИнформационнойБазы") Цикл
		Если Метаданные.Константы.Найти(Имя.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Значение = Константы[Имя.Ключ].Получить();
			
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Строка(Значение);
			КонецЕсли;
		Исключение
			
			Возврат "недоступен с текущими правами";
		КонецПопытки;
	КонецЦикла;
	
	Возврат "не задан или не поддерживается конфигурацией";
	
КонецФункции

// Записывает значение выбранной константы; исключения платформы передаются вызывающему коду.
//
// Параметры:
//  ИмяКонстанты - Строка - имя существующей константы в метаданных конфигурации.
//  Значение - Произвольный - новое значение константы, совместимое с ее типом.
Процедура ЗаписатьЗначениеКонстанты(ИмяКонстанты, Знач Значение) Экспорт
	
	Данные = ДанныеКонстанты(ИмяКонстанты);
	
	Если Не Данные.Доступно Тогда
		ВызватьИсключение НСтр("ru='Хранилище значения не поддерживает редактирование в этом окне.'");
	КонецЕсли;
	
	Если Не Данные.Тип.СодержитТип(ТипЗнч(Значение)) Тогда
		ВызватьИсключение НСтр("ru='Тип значения не соответствует типу константы.'");
	КонецЕсли;
	
	// Платформа проверяет права записи; привилегированный режим не используется.
	
	Константы[ИмяКонстанты].Установить(Значение);
	
КонецПроцедуры

