// #Область СлужебныеПроцедурыИФункции

// #Область УниверсальныеСписки

Функция НастройкиОтборовСписка(ОбъектМетаданных, Отбор)
	
	Настройки = Новый Структура;
	Настройки.Вставить("ПолеПериода", ИмяПоляПериода(ОбъектМетаданных));
	Настройки.Вставить("ПолеОрганизации", "");
	Настройки.Вставить("ТипОрганизации", Новый ОписаниеТипов);
	
	Для Каждого ИмяПоля Из Новый Структура("Организация,Фирма") Цикл
		Если Не ПустаяСтрока(Отбор.ПолеОрганизации) И ИмяПоля.Ключ <> Отбор.ПолеОрганизации Тогда
			Продолжить;
		КонецЕсли;
		
		Поле = РеквизитОрганизацииСписка(ОбъектМетаданных, ИмяПоля.Ключ);
		
		Если Поле = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипыОрганизации = СправочныеТипыОрганизации(Поле.Тип);
		
		Если ТипыОрганизации.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Настройки.ПолеОрганизации = ИмяПоля.Ключ;
		Настройки.ТипОрганизации = Новый ОписаниеТипов(ТипыОрганизации);
		Прервать;
	КонецЦикла;
	
	Возврат Настройки;
	
КонецФункции

Функция РеквизитОрганизацииСписка(ОбъектМетаданных, ИмяПоля)
	
	Поле = ОбъектМетаданных.Реквизиты.Найти(ИмяПоля);
	
	Если Поле = Неопределено И Лев(ОбъектМетаданных.ПолноеИмя(), 7) = "Регистр" Тогда
		Поле = ОбъектМетаданных.Измерения.Найти(ИмяПоля);
	КонецЕсли;
	
	Возврат Поле;
	
КонецФункции

Функция СправочныеТипыОрганизации(ОписаниеТипа)
	
	ТипыОрганизации = Новый Массив;
	
	Для Каждого ТипОрганизации Из ОписаниеТипа.Типы() Цикл
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипОрганизации);
		
		Если МетаданныеТипа <> Неопределено Тогда
			Если Метаданные.Справочники.Содержит(МетаданныеТипа) Тогда
				ТипыОрганизации.Добавить(ТипОрганизации);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТипыОрганизации;
	
КонецФункции

Функция ОтборСписка(ПараметрыОткрытия, ОбъектМетаданных)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ПолеПериода", "");
	Отбор.Вставить("ПолеОрганизации", "");
	Отбор.Вставить("ПоляОрганизации", Новый Массив);
	Отбор.Вставить("ОрганизацияПоСторонамПроводки", Ложь);
	Отбор.Вставить("Период", Неопределено);
	Отбор.Вставить("Организация", Неопределено);
	ПараметрыОткрытия.Свойство("Период", Отбор.Период);
	ПараметрыОткрытия.Свойство("Организация", Отбор.Организация);
	Отбор.Период = НормализованныйПериодОтбора(Отбор.Период, Истина);
	
	Если ЗначениеЗаполнено(Отбор.Период) Тогда
		Отбор.ПолеПериода = ИмяПоляПериода(ОбъектМетаданных);
	КонецЕсли;
	
	ТипОрганизации = ?(ЗначениеЗаполнено(Отбор.Организация), ТипЗнч(Отбор.Организация), Неопределено);
	ОписаниеОрганизации = ОписаниеПолейОрганизации(ОбъектМетаданных, ТипОрганизации);
	Отбор.ПолеОрганизации = ОписаниеОрганизации.Имя;
	Отбор.ПоляОрганизации = ОписаниеОрганизации.Поля;
	Отбор.ОрганизацияПоСторонамПроводки = Отбор.ПоляОрганизации.Количество() > 1;
	
	Возврат Отбор;
	
КонецФункции

Функция ОрганизацияРазделенаПоСторонамПроводки(ОбъектМетаданных, ИмяПоля)
	
	Если Не Метаданные.РегистрыБухгалтерии.Содержит(ОбъектМетаданных)
		Или ПустаяСтрока(ИмяПоля) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ОбъектМетаданных.Корреспонденция Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Измерение = ОбъектМетаданных.Измерения.Найти(ИмяПоля);
	
	Возврат Измерение <> Неопределено И Не Измерение.Балансовый;
	
КонецФункции

Функция ТекстОтбораСписка(Отбор, ПараметрыЗапроса, ПрефиксПоля = "")
	
	Условия = "";
	
	Если Не ПустаяСтрока(Отбор.ПолеПериода) Тогда
		Условия = ПрефиксПоля + Отбор.ПолеПериода + " МЕЖДУ &ДатаНачала И &ДатаОкончания";
		ПараметрыЗапроса.Вставить("ДатаНачала", Отбор.Период.ДатаНачала);
		ПараметрыЗапроса.Вставить("ДатаОкончания", Отбор.Период.ДатаОкончания);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.Организация) И Отбор.ПоляОрганизации.Количество() > 0 Тогда
		ПоляОрганизации = Новый Массив;
		
		Для Каждого ИмяПоля Из Отбор.ПоляОрганизации Цикл
			ПоляОрганизации.Добавить(ПрефиксПоля + ИмяПоля);
		КонецЦикла;
		
		Условия = Условия + ?(ПустаяСтрока(Условия), "", Символы.ПС + "И ")
			+ УсловиеОтбораПоОрганизации(ПоляОрганизации);
		ПараметрыЗапроса.Вставить("Организация", Отбор.Организация);
	КонецЕсли;
	
	Возврат ?(ПустаяСтрока(Условия), "", Символы.ПС + "ГДЕ " + Условия);
	
КонецФункции

Процедура ИсключитьОтключенныеСчетчикиСписка(Поля, ПараметрыОткрытия)
	
	СчитатьСтроки = Истина;
	Если Не ПараметрыОткрытия.Свойство("КоличествоСтрокТабличныхЧастей", СчитатьСтроки)
		Или СчитатьСтроки Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПолей = Поля.Количество();
	Для Шаг = 1 По КоличествоПолей Цикл
		Индекс = КоличествоПолей - Шаг;
		Если Лев(Поля[Индекс], 5) = "$ТЧ$_" Тогда
			Поля.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Определяет имена вычисляемых счетчиков, не занятые реквизитами и другими табличными частями.
//
// Параметры:
//  ПоляСписка - Массив из Строка - реальные поля и маркеры табличных частей.
//
// Возвращаемое значение:
//  Соответствие - имя табличной части и уникальное имя ее вычисляемого поля.
Функция ИменаПолейТабличныхЧастейСписка(ПоляСписка)
	
	Имена = Новый Соответствие;
	ЗанятыеИмена = Новый Соответствие;
	ИменаСчетчиков = Новый Соответствие;
	
	Для Каждого Поле Из ПоляСписка Цикл
		Если Лев(Поле, 5) = "$ТЧ$_" Тогда
			ИменаСчетчиков.Вставить(ВРег(СтрЗаменить(Поле, "$", "")), Истина);
		Иначе
			ЗанятыеИмена.Вставить(ВРег(Поле), Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Поле Из ПоляСписка Цикл
		Если Лев(Поле, 5) <> "$ТЧ$_" Тогда
			Продолжить;
		КонецЕсли;
		
		ОсноваИмени = СтрЗаменить(Поле, "$", "");
		ИмяПоля = СвободноеИмяСчетчикаСписка(ОсноваИмени, ЗанятыеИмена, ИменаСчетчиков);
		Имена.Вставить(Сред(Поле, 6), ИмяПоля);
		ЗанятыеИмена.Вставить(ВРег(ИмяПоля), Истина);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

// Выбирает свободный псевдоним, сохраняя незанятые имена остальных счетчиков.
//
// Параметры:
//  ОсноваИмени - Строка - обычное имя счетчика.
//  ЗанятыеИмена - Соответствие - уже использованные имена в верхнем регистре.
//  ИменаСчетчиков - Соответствие - обычные имена всех счетчиков в верхнем регистре.
//
// Возвращаемое значение:
//  Строка - свободное имя поля запроса и колонки списка.
Функция СвободноеИмяСчетчикаСписка(ОсноваИмени, ЗанятыеИмена, ИменаСчетчиков)
	
	Если ЗанятыеИмена.Получить(ВРег(ОсноваИмени)) <> Истина Тогда
		Возврат ОсноваИмени;
	КонецЕсли;
	
	Номер = 1;
	ИмяПоля = ОсноваИмени + "_" + Формат(Номер, "ЧГ=;ЧН=0");
	
	Пока ЗанятыеИмена.Получить(ВРег(ИмяПоля)) = Истина
		Или ИменаСчетчиков.Получить(ВРег(ИмяПоля)) = Истина Цикл
		Номер = Номер + 1;
		ИмяПоля = ОсноваИмени + "_" + Формат(Номер, "ЧГ=;ЧН=0");
	КонецЦикла;
	
	Возврат ИмяПоля;
	
КонецФункции

Функция ТекстЗапросаСписка(ПараметрыОткрытия, МассивПолей, ИменаПолейТабличныхЧастей,
	Отбор = Неопределено, ОграничиватьСсылки = Ложь)
	
	Если ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "РегистрБухгалтерии" Тогда
		ОбъектМетаданных = Метаданные.РегистрыБухгалтерии[ПараметрыОткрытия.ОбъектМетаданных];
		
		Возврат ТекстЗапросаРегистраБухгалтерии(ОбъектМетаданных, МассивПолей);
	КонецЕсли;
	
	ИмяТаблицы = ПараметрыОткрытия.КоллекцияОбъектовМетаданных + "." + ПараметрыОткрытия.ОбъектМетаданных;
	ТекстЗапроса = "ВЫБРАТЬ";
	Соединения = "";
	
	Для Индекс = 0 По МассивПолей.Количество() - 1 Цикл
		Поле = МассивПолей[Индекс];
		
		Если Лев(Поле, 5) = "$ТЧ$_" Тогда
			ИмяТабличнойЧасти = Сред(Поле, 6);
			ИмяСчетчика = "СчетчикТабличнойЧасти" + Формат(Индекс, "ЧГ=;ЧН=0");
			ВыражениеПоля = "ЕСТЬNULL(" + ИмяСчетчика + ".Количество, 0)";
			СинонимПоля = ИменаПолейТабличныхЧастей.Получить(ИмяТабличнойЧасти);
			Соединения = Соединения + ТекстСоединенияСчетчикаСписка(ИмяТаблицы, ИмяТабличнойЧасти,
				ИмяСчетчика, Отбор, ОграничиватьСсылки);
		Иначе
			ВыражениеПоля = "Данные." + Поле;
			СинонимПоля = Поле;
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + Символы.Таб + ВыражениеПоля + " КАК " + СинонимПоля;
		Если Индекс <> МассивПолей.Количество() - 1 Тогда
			ТекстЗапроса = ТекстЗапроса + ",";
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстЗапроса + Символы.ПС + "ИЗ " + ИмяТаблицы + " КАК Данные" + Соединения;
	
КонецФункции

// Формирует соединение с числовым счетчиком строк табличной части.
//
// Параметры:
//  ИмяТаблицы - Строка - полное имя основной таблицы метаданных.
//  ИмяТабличнойЧасти - Строка - имя табличной части основной таблицы.
//  ИмяСчетчика - Строка - псевдоним соединяемого источника счетчика.
//  Отбор - Структура, Неопределено - отборы периода и организации основного списка.
//  ОграничиватьСсылки - Булево - считать только ссылки из параметра запроса Ссылки.
//
// Возвращаемое значение:
//  Строка - соединение с одним счетчиком на каждую ссылку основного списка.
Функция ТекстСоединенияСчетчикаСписка(ИмяТаблицы, ИмяТабличнойЧасти, ИмяСчетчика,
	Отбор, ОграничиватьСсылки)
	
	ТекстУсловия = "";
	Если ОграничиватьСсылки Тогда
		ТекстУсловия = "ГДЕ СтрокиТабличнойЧасти.Ссылка В (&Ссылки)";
	ИначеЕсли Отбор <> Неопределено Тогда
		ПараметрыОтбора = Новый Соответствие;
		ТекстУсловия = ТекстОтбораСписка(Отбор, ПараметрыОтбора, "СтрокиТабличнойЧасти.Ссылка.");
	КонецЕсли;
	
	Возврат "
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|    (ВЫБРАТЬ
		|        СтрокиТабличнойЧасти.Ссылка КАК Ссылка,
		|        КОЛИЧЕСТВО(*) КАК Количество
		|    ИЗ " + ИмяТаблицы + "." + ИмяТабличнойЧасти + " КАК СтрокиТабличнойЧасти
		|    " + ТекстУсловия + "
		|    СГРУППИРОВАТЬ ПО СтрокиТабличнойЧасти.Ссылка) КАК " + ИмяСчетчика + "
		|ПО Данные.Ссылка = " + ИмяСчетчика + ".Ссылка";
	
КонецФункции

Функция ТекстЗапросаРегистраБухгалтерии(ОбъектМетаданных, Поля)
	
	Текст = "ВЫБРАТЬ";
	
	Для Каждого ИмяПоля Из Поля Цикл
		Префикс = ?(ЭтоПолеСубконтоРегистра(ИмяПоля, ОбъектМетаданных), "Субконто.", "Данные.");
		Разделитель = ?(Текст = "ВЫБРАТЬ", "", ",");
		Текст = Текст + Разделитель + Символы.ПС + Символы.Таб
			+ Префикс + ИмяПоля + " КАК " + ИмяПоля;
	КонецЦикла;
	
	ИмяТаблицы = ОбъектМетаданных.ПолноеИмя();
	Текст = Текст + Символы.ПС + "ИЗ " + ИмяТаблицы + " КАК Данные";
	
	Если ОбъектМетаданных.ПланСчетов.МаксКоличествоСубконто > 0 Тогда
		// Физическая таблица задает ключ записи динамического списка.
		// Ключ записи соединяет одну проводку с одной строкой ее аналитики.
		Текст = Текст + Символы.ПС
			+ "ЛЕВОЕ СОЕДИНЕНИЕ " + ИмяТаблицы + ".ДвиженияССубконто КАК Субконто" + Символы.ПС
			+ "ПО Данные.Период = Субконто.Период" + Символы.ПС
			+ "И Данные.Регистратор = Субконто.Регистратор" + Символы.ПС
			+ "И Данные.НомерСтроки = Субконто.НомерСтроки";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ЭтоПолеСубконтоРегистра(ИмяПоля, ОбъектМетаданных)
	
	Для Номер = 1 По ОбъектМетаданных.ПланСчетов.МаксКоличествоСубконто Цикл
		Суффикс = Формат(Номер, "ЧГ=;ЧН=0");
		
		Если ОбъектМетаданных.Корреспонденция Тогда
			Если ИмяПоля = "СубконтоДт" + Суффикс Или ИмяПоля = "СубконтоКт" + Суффикс Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли ИмяПоля = "Субконто" + Суффикс Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПоляОбъектаМетаданных(ПараметрыОткрытия, ОбъектМетаданных)
	
	Если ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "РегистрБухгалтерии" Тогда
		Возврат ПоляРегистраБухгалтерии(ОбъектМетаданных);
	КонецЕсли;
	
	ПоляОбъектаМетаданных = Новый Массив;
	
	ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "СтандартныеРеквизиты");
	
	Если ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "РегистрНакопления"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "РегистрСведений"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "РегистрРасчета" Тогда
		
		ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "Измерения");
		ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "Ресурсы");
		ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "Реквизиты");
		
	КонецЕсли;
	
	Если ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "Задача" Тогда
		ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "РеквизитыАдресации");
	КонецЕсли;
	
	Если ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "Задача"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "БизнесПроцесс"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "ПланВидовХарактеристик"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "Документ"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "Справочник"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "ПланСчетов"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "ПланВидовРасчета"
		Или ПараметрыОткрытия.КоллекцияОбъектовМетаданных = "ПланОбмена" Тогда
		
		ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "Реквизиты");
		ДобавитьВПоля(ПоляОбъектаМетаданных, ОбъектМетаданных, "ТабличныеЧасти");
		
	КонецЕсли;
	
	Возврат ПоляОбъектаМетаданных;
	
КонецФункции

Функция ПоляРегистраБухгалтерии(ОбъектМетаданных)
	
	Поля = Новый Массив;
	
	Для Каждого Описание Из ОписаниеПолейРегистраБухгалтерии(ОбъектМетаданных) Цикл
		Если Описание.ДоступноВСписке Тогда
			Поля.Добавить(Описание.Имя);
			
			Если Описание.Имя = "СчетДт" Или Описание.Имя = "СчетКт" Или Описание.Имя = "Счет" Тогда
				ДобавитьПоляСубконто(Поля, ОбъектМетаданных, Описание.Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Поля;
	
КонецФункции

Процедура ДобавитьОписанияПолейБухгалтерии(Описания, Поля, ИмяГруппы, Корреспонденция)
	
	Для Каждого Поле Из Поля Цикл
		Если Корреспонденция И Не Поле.Балансовый Тогда
			ДобавитьОписаниеПоляБухгалтерии(Описания, Поле.Имя + "Дт", Поле, ИмяГруппы, " (дебет)");
			ДобавитьОписаниеПоляБухгалтерии(Описания, Поле.Имя + "Кт", Поле, ИмяГруппы, " (кредит)");
		Иначе
			ДобавитьОписаниеПоляБухгалтерии(Описания, Поле.Имя, Поле, ИмяГруппы);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеПолейРегистраБухгалтерии(ОбъектМетаданных)
	
	Описания = Новый Массив;
	
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		Имя = Реквизит.Имя;
		
		Если Лев(Имя, 8) = "Субконто" Или Лев(Имя, 11) = "ВидСубконто"
			Или Имя = "Счет" Или Имя = "СчетДт" Или Имя = "СчетКт" Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьОписаниеПоляБухгалтерии(Описания, Имя, Реквизит, "Стандартные реквизиты");
	КонецЦикла;
	
	ТипСчета = Новый ОписаниеТипов("ПланСчетовСсылка." + ОбъектМетаданных.ПланСчетов.Имя);
	
	Если ОбъектМетаданных.Корреспонденция Тогда
		ДобавитьОписаниеПоляБухгалтерии(Описания, "СчетДт", ОбъектМетаданных,
			"Стандартные реквизиты", "", ТипСчета, "Счет (дебет)");
		ДобавитьОписаниеПоляБухгалтерии(Описания, "СчетКт", ОбъектМетаданных,
			"Стандартные реквизиты", "", ТипСчета, "Счет (кредит)");
	Иначе
		ДобавитьОписаниеПоляБухгалтерии(Описания, "Счет", ОбъектМетаданных,
			"Стандартные реквизиты", "", ТипСчета, "Счет");
	КонецЕсли;
	
	ДобавитьОписанияПолейБухгалтерии(Описания, ОбъектМетаданных.Измерения,
		"Измерения", ОбъектМетаданных.Корреспонденция);
	ДобавитьОписанияПолейБухгалтерии(Описания, ОбъектМетаданных.Ресурсы,
		"Ресурсы", ОбъектМетаданных.Корреспонденция);
	
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		ДобавитьОписаниеПоляБухгалтерии(Описания, Реквизит.Имя, Реквизит, "Реквизиты объекта");
	КонецЦикла;
	
	Возврат Описания;
	
КонецФункции

Процедура ДобавитьОписаниеПоляБухгалтерии(Описания, Имя, Поле, Группа, Суффикс = "",
	ТипПоля = Неопределено, Синоним = Неопределено)
	
	Для Каждого Описание Из Описания Цикл
		Если Описание.Имя = Имя Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Если ТипПоля = Неопределено Тогда
		ТипПоля = Поле.Тип;
	КонецЕсли;
	
	Если Синоним = Неопределено Тогда
		Синоним = ?(ПустаяСтрока(Поле.Синоним), Поле.Имя, Поле.Синоним) + Суффикс;
	КонецЕсли;
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("Тип", ТипПоля);
	Описание.Вставить("Метаданные", Поле);
	Описание.Вставить("Группа", Группа);
	Если Имя = "Счет" Или Имя = "СчетДт" Или Имя = "СчетКт" Тогда
		Описание.Вставить("ДоступноВСписке", Истина);
	Иначе
		Описание.Вставить("ДоступноВСписке", ПолеДоступноВУниверсальномСписке(Поле));
	КонецЕсли;
	Описания.Добавить(Описание);
	
КонецПроцедуры

Процедура ДобавитьПоляСубконто(Поля, ОбъектМетаданных, ИмяСчета)
	
	ИмяПоля = СтрЗаменить(ИмяСчета, "Счет", "Субконто");
	
	Для Номер = 1 По ОбъектМетаданных.ПланСчетов.МаксКоличествоСубконто Цикл
		Поля.Добавить(ИмяПоля + Формат(Номер, "ЧГ=;ЧН=0"));
	КонецЦикла;
	
КонецПроцедуры

Функция ПредставлениеКоллекцииСписка(КоллекцияОбъектовМетаданных)
	
	Если ОписанияТаблиц <> Неопределено Тогда
		Для Каждого Раздел Из ОписанияТаблиц Цикл
			Если Раздел.ИмяТаблицы = КоллекцияОбъектовМетаданных Тогда
				Возврат Раздел.СинонимТаблицы;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат КоллекцияОбъектовМетаданных;
	
КонецФункции

Функция СоответствияПадежейИменКоллекцийМетаданных()
	
	Соответствия = Новый Соответствие;
	
	Соответствия.Вставить("ПланОбмена", "ПланыОбмена");
	Соответствия.Вставить("Справочник", "Справочники");
	Соответствия.Вставить("Документ", "Документы");
	Соответствия.Вставить("ПланВидовХарактеристик", "ПланыВидовХарактеристик");
	Соответствия.Вставить("БизнесПроцесс", "БизнесПроцессы");
	Соответствия.Вставить("Задача", "Задачи");
	Соответствия.Вставить("РегистрСведений", "РегистрыСведений");
	Соответствия.Вставить("РегистрНакопления", "РегистрыНакопления");
	Соответствия.Вставить("РегистрБухгалтерии", "РегистрыБухгалтерии");
	Соответствия.Вставить("РегистрРасчета", "РегистрыРасчета");
	
	Соответствия.Вставить("ПланСчетов", "ПланыСчетов");
	Соответствия.Вставить("ПланВидовРасчета", "ПланыВидовРасчета");
	
	Возврат Соответствия;
	
КонецФункции

Функция ПолеДоступноВУниверсальномСписке(Поле)
	
	Если Поле.Тип.СодержитТип(Тип("ХранилищеЗначения")) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Поле.Тип.СодержитТип(Тип("Строка")) Тогда
		Попытка
			
			Возврат Не Поле.РежимПароля;
		Исключение
			// Свойство предусмотрено не для всех классов реквизитов метаданных.
		КонецПопытки;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ДобавитьВПоля(МассивПолей, ОбъектМетаданных, Свойство)
	
	Для Каждого Значение Из ОбъектМетаданных[Свойство] Цикл
		Если Свойство = "ТабличныеЧасти" Тогда
			МассивПолей.Добавить("$ТЧ$_" + Значение.Имя);
		ИначеЕсли ПолеДоступноВУниверсальномСписке(Значение) Тогда
			МассивПолей.Добавить(Значение.Имя);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// #КонецОбласти

// #Область СовместимостьИСхемы

Функция ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "")
	
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		СтрокаСоединенияИнформационнойБазы = СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	
	Возврат Лев(ВРег(СтрокаСоединенияИнформационнойБазы), 5) = "FILE=";
	
КонецФункции

Функция КлючСтрокиСкана(СтрокаСкана)
	
	Возврат СтрокаСкана.КоллекцияОбъектовМетаданныхИмя + "." + СтрокаСкана.МетаданныеИмя;
	
КонецФункции

// #КонецОбласти

// #Область СведенияОБазе

Функция КаталогФайловойБазы(СтрокаСоединения)
	
	Если Не ИнформационнаяБазаФайловая(СтрокаСоединения) Тогда
		Возврат "";
	КонецЕсли;
	
	Остаток = СокрЛП(Сред(СтрокаСоединения, 6));
	
	Если Лев(Остаток, 1) = """" Тогда
		Результат = "";
		Индекс = 2;
		
		Пока Индекс <= СтрДлина(Остаток) Цикл
			Символ = Сред(Остаток, Индекс, 1);
			
			Если Символ = """" Тогда
				Если Сред(Остаток, Индекс + 1, 1) <> """" Тогда
					Возврат Результат;
				КонецЕсли;
				
				Индекс = Индекс + 1;
			КонецЕсли;
			
			Результат = Результат + Символ;
			Индекс = Индекс + 1;
		КонецЦикла;
		
		Возврат "";
	КонецЕсли;
	
	Разделитель = Найти(Остаток, ";");
	
	Возврат ?(Разделитель = 0, Остаток, Лев(Остаток, Разделитель - 1));
	
КонецФункции

// #КонецОбласти

// #Область МетаданныеИПоказатели

Функция ОбъектыДляИменТаблицСУБД(СтрокиСкана, Кэш)
	
	Имена = Новый Соответствие;
	// Проверенные имена действуют до сброса кэша при изменении конфигурации.
	
	Если СтрокиСкана <> Неопределено Тогда
		Для Каждого СтрокаДанных Из СтрокиСкана Цикл
			ПолноеИмя = КлючСтрокиСкана(СтрокаДанных);
			
			Если Кэш.ПроверенныеТаблицы.Получить(ПолноеИмя) = Истина
				Или Метаданные.НайтиПоПолномуИмени(ПолноеИмя) <> Неопределено Тогда
				Имена.Вставить(ПолноеИмя, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Физические имена нужны для всех видов документов, в том числе вне основного скана.
	
	Для Каждого Документ Из Метаданные.Документы Цикл
		Имена.Вставить("Документ." + Документ.Имя, Истина);
	КонецЦикла;
	
	Результат = Новый Массив;
	
	Для Каждого Имя Из Имена Цикл
		Результат.Добавить(Имя.Ключ);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область СтруктураХраненияИСхемы

Функция ИменаТаблицСУБД(ОбъектыМетаданных, Кэш)
	
	Если Кэш.ИменаТаблиц = Неопределено Тогда
		Кэш.ИменаТаблиц = Новый Соответствие;
	КонецЕсли;
	
	Имена = Кэш.ИменаТаблиц;
	
	Если ИнформационнаяБазаФайловая() Тогда
		Возврат Имена;
	КонецЕсли;
	
	Объекты = Новый Массив;
	
	Для Каждого Имя Из ОбъектыМетаданных Цикл
		Если Кэш.ПроверенныеТаблицы.Получить(Имя) <> Истина Тогда
			Объекты.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	
	Если Объекты.Количество() = 0 Тогда
		Возврат Имена;
	КонецЕсли;
	
	ТаблицыХранения = ПолучитьСтруктуруХраненияБазыДанных(Объекты, Истина);
	
	Для Каждого Объект Из Объекты Цикл
		Имена.Удалить(Объект);
	КонецЦикла;
	
	Для Каждого ТаблицаХранения Из ТаблицыХранения Цикл
		Если ТаблицаХранения.Назначение = "Основная" И Не ПустаяСтрока(ТаблицаХранения.ИмяТаблицы) Тогда
			Имена.Вставить(ТаблицаХранения.ИмяТаблицы, ТаблицаХранения.ИмяТаблицыХранения);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Объект Из Объекты Цикл
		Кэш.ПроверенныеТаблицы.Вставить(Объект, Истина);
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

Процедура ПроверитьСтруктуруСхемы(СхемаТаблиц)
	
	Если ТипЗнч(СхемаТаблиц) <> Тип("Массив") Тогда
		ВызватьИсключение "Схема таблиц должна быть массивом разделов.";
	КонецЕсли;
	
	Если СхемаТаблиц.Количество() = 0 Тогда
		ВызватьИсключение "В схеме таблиц нет разделов.";
	КонецЕсли;
	
	ИменаРазделов = Новый Соответствие;
	ИменаРеквизитов = Новый Соответствие;
	ПорядкиПечати = Новый Соответствие;
	
	Для Каждого Раздел Из СхемаТаблиц Цикл
		Место = "Раздел схемы " + Строка(ИменаРазделов.Количество() + 1);
		ПроверитьПоляРазделаСхемы(Раздел, Место);
		Место = "Раздел " + Раздел.ИмяТаблицы;
		ПроверитьУникальностьСхемы(ИменаРазделов, ВРег(Раздел.ИмяТаблицы), Место);
		ПроверитьУникальностьСхемы(ИменаРеквизитов, ВРег(Раздел.ИмяРеквизита), Место + ": имя реквизита");
		ПроверитьУникальностьСхемы(ПорядкиПечати, Раздел.ПорядокПечати, Место + ": порядок печати");
		ПроверитьКолонкиСхемы(Раздел, Место);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьПоляРазделаСхемы(Раздел, Место)
	
	ПроверитьПоляСхемы(Раздел, "ИмяТаблицы,ИмяТаблицыМн,СинонимТаблицы,ЗаголовокСтраницы,ИмяРеквизита",
		"Строка", Место);
	ПроверитьПоляСхемы(Раздел, "УсловиеДоступности,МетаданныеДоступности,ВыборСтроки,Сортировка,ЗаголовокПечати",
		"Строка", Место);
	ПроверитьПоляСхемы(Раздел, "ЭтоДополнительнаяТаблица,ОтдельныеСведения,Подвал,ПоказыватьНоль", "Булево", Место);
	ПроверитьПоляСхемы(Раздел, "РесурсПроведен,РесурсПометкаУдаления,РесурсПредопределенный", "Булево", Место);
	ПроверитьПоляСхемы(Раздел, "Порядок,ПорядокПечати", "Число", Место);
	ПроверитьВидСтрокиПечатиСхемы(Раздел, Место);
	
	ПроверитьПоляСхемы(Раздел, "Колонки", "Массив", Место);
	ПроверитьПоляСхемы(Раздел, "ДополнительныеРесурсы", "ТаблицаЗначений", Место);
	ПроверитьИмяСхемы(Раздел.ИмяТаблицы, Место);
	ПроверитьИмяСхемы(Раздел.ИмяРеквизита, Место + ": имя реквизита");
	
	Если ПустаяСтрока(Раздел.ЗаголовокСтраницы) Или ПустаяСтрока(Раздел.ЗаголовокПечати) Тогда
		ВызватьИсключение Место + ": не заполнен заголовок страницы или печати.";
	КонецЕсли;
	
	Если Раздел.ПорядокПечати < 0 Или Цел(Раздел.ПорядокПечати) <> Раздел.ПорядокПечати Тогда
		ВызватьИсключение Место + ": порядок печати должен быть целым неотрицательным числом.";
	КонецЕсли;
	
	ПроверитьЗначениеСхемы(Раздел.УсловиеДоступности, "Всегда,Справочник,Коллекция", Место + ": условие доступности");
	ПроверитьЗначениеСхемы(Раздел.ВыборСтроки, ",Метаданные,Константа,Ссылка", Место + ": выбор строки");
	
	Если Раздел.УсловиеДоступности <> "Всегда" Тогда
		ПроверитьИмяСхемы(Раздел.МетаданныеДоступности, Место + ": метаданные доступности");
	КонецЕсли;
	
	Если Раздел.УсловиеДоступности = "Коллекция" Тогда
		ПроверитьКоллекциюСхемы(Раздел.МетаданныеДоступности, Место);
	КонецЕсли;
	
	Если Не ПустаяСтрока(Раздел.ИмяТаблицыМн) И Раздел.ИмяТаблицыМн <> "Сводная" Тогда
		ПроверитьКоллекциюСхемы(Раздел.ИмяТаблицыМн, Место);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВидСтрокиПечатиСхемы(Раздел, Место)
	
	ПроверитьПоляСхемы(Раздел, "ВидСтрокиПечати", "Строка", Место);
	ПроверитьЗначениеСхемы(Раздел.ВидСтрокиПечати,
		",Организация,Библиотека,Расширение,Хронология,Константа,Оборудование", Место + ": вид строки печати");
	ОтдельныеСведения = Раздел.ВидСтрокиПечати = "Организация" Или Раздел.ВидСтрокиПечати = "Библиотека"
		Или Раздел.ВидСтрокиПечати = "Расширение";
	
	Если Раздел.ОтдельныеСведения <> ОтдельныеСведения Тогда
		ВызватьИсключение Место + ": вид строки печати не соответствует отдельным сведениям.";
	КонецЕсли;
	
	Если Не ПустаяСтрока(Раздел.ВидСтрокиПечати) И Не Раздел.ЭтоДополнительнаяТаблица Тогда
		ВызватьИсключение Место + ": специальный вид строки печати допустим только для дополнительной таблицы.";
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКоллекциюСхемы(ИмяКоллекции, Место)
	
	Коллекции = СоответствияПадежейИменКоллекцийМетаданных();
	Коллекции.Вставить("Константа", "Константы");
	
	Для Каждого Коллекция Из Коллекции Цикл
		Если Коллекция.Значение = ИмяКоллекции Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение Место + ": неизвестная коллекция метаданных " + ИмяКоллекции;
	
КонецПроцедуры

Процедура ПроверитьКолонкиСхемы(Раздел, Место)
	
	Если Раздел.Колонки.Количество() = 0 Тогда
		ВызватьИсключение Место + ": не заданы колонки.";
	КонецЕсли;
	
	ИменаКолонок = Новый Соответствие;
	
	Для Каждого Колонка Из Раздел.Колонки Цикл
		ПроверитьПоляСхемы(Колонка, "Имя,Заголовок,ВидТипа,УсловиеДоступности,Формат,Цвет,Ресурс", "Строка", Место);
		ПроверитьПоляСхемы(Колонка, "Видимость,Полужирная,Итог", "Булево", Место);
		ПроверитьПоляСхемы(Колонка, "Порядок", "Число", Место);
		МестоКолонки = Место + ", колонка " + Колонка.Имя;
		
		Если Колонка.Свойство("Ширина") Тогда
			ПроверитьПоляСхемы(Колонка, "Ширина", "Число", МестоКолонки);
			
			Если Колонка.Ширина < 0 Тогда
				ВызватьИсключение МестоКолонки + ": ширина должна быть неотрицательным числом.";
			КонецЕсли;
		КонецЕсли;
		
		ПроверитьИмяСхемы(Колонка.Имя, МестоКолонки);
		ПроверитьУникальностьСхемы(ИменаКолонок, ВРег(Колонка.Имя), МестоКолонки);
		ПроверитьЗначениеСхемы(Колонка.Ресурс, ",Проведен,ПометкаУдаления,Предопределенный", МестоКолонки + ": ресурс");
	КонецЦикла;
	
	ПроверитьСортировкуСхемы(Раздел.Сортировка, ИменаКолонок, Место);
	
	Для Каждого ИмяКолонки Из Новый Структура("Метаданные,ИмяРесурса,ЗначениеРесурса") Цикл
		Если Раздел.ДополнительныеРесурсы.Колонки.Найти(ИмяКолонки.Ключ) = Неопределено Тогда
			ВызватьИсключение Место + ": нет колонки ресурсов " + ИмяКолонки.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Ресурс Из Раздел.ДополнительныеРесурсы Цикл
		Если ТипЗнч(Ресурс.ИмяРесурса) <> Тип("Строка") Тогда
			ВызватьИсключение Место + ": имя ресурса должно быть строкой.";
		КонецЕсли;
		
		Если ИменаКолонок.Получить(ВРег(Ресурс.ИмяРесурса)) <> Истина Тогда
			ВызватьИсключение Место + ": ресурс ссылается на неизвестную колонку " + Ресурс.ИмяРесурса;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьСортировкуСхемы(Сортировка, ИменаКолонок, Место)
	
	Если ПустаяСтрока(Сортировка) Тогда
		Возврат;
	КонецЕсли;
	
	Если Найти(Сортировка, Символы.ПС) > 0 Или Найти(Сортировка, Символы.ВК) > 0 Тогда
		ВызватьИсключение Место + ": сортировка должна быть указана в одной строке.";
	КонецЕсли;
	
	Если Лев(СокрЛП(Сортировка), 1) = "," Или Прав(СокрЛП(Сортировка), 1) = "," Тогда
		ВызватьИсключение Место + ": не задана колонка в начале или конце сортировки.";
	КонецЕсли;
	
	ПоляСортировки = СтрЗаменить(Сортировка, ",", Символы.ПС);
	
	Для НомерПоля = 1 По СтрЧислоСтрок(ПоляСортировки) Цикл
		ПолеСортировки = СокрЛП(СтрЗаменить(СтрПолучитьСтроку(ПоляСортировки, НомерПоля), Символы.Таб, " "));
		ИмяКолонки = ПолеСортировки;
		Направление = "";
		Разделитель = Найти(ПолеСортировки, " ");
		
		Если Разделитель > 0 Тогда
			ИмяКолонки = Лев(ПолеСортировки, Разделитель - 1);
			Направление = СокрЛП(Сред(ПолеСортировки, Разделитель + 1));
		КонецЕсли;
		
		Если ИменаКолонок.Получить(ВРег(ИмяКолонки)) <> Истина Тогда
			ВызватьИсключение Место + ": сортировка ссылается на неизвестную колонку " + ИмяКолонки;
		КонецЕсли;
		
		ПроверитьЗначениеСхемы(ВРег(Направление), ",ВОЗР,УБЫВ,ASC,DESC",
			Место + ": направление сортировки колонки " + ИмяКолонки);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьПоляСхемы(Описание, ИменаПолей, ИмяТипа, Место)
	
	Если ТипЗнч(Описание) <> Тип("Структура") Тогда
		ВызватьИсключение Место + ": описание должно быть структурой.";
	КонецЕсли;
	
	Для Каждого Поле Из Новый Структура(ИменаПолей) Цикл
		ЗначениеПоля = Неопределено;
		
		Если Не Описание.Свойство(Поле.Ключ, ЗначениеПоля) Тогда
			ВызватьИсключение Место + ": отсутствует поле " + Поле.Ключ;
		КонецЕсли;
		
		Если ТипЗнч(ЗначениеПоля) <> Тип(ИмяТипа) Тогда
			ВызватьИсключение Место + ": поле " + Поле.Ключ + " должно иметь тип " + ИмяТипа;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИмяСхемы(Имя, Место)
	
	Попытка
		ПроверкаИмени = Новый Структура;
		ПроверкаИмени.Вставить(Имя, Неопределено);
	Исключение
		ВызватьИсключение Место + ": недопустимое имя " + Имя;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроверитьУникальностьСхемы(Значения, Ключ, Место)
	
	Если Значения.Получить(Ключ) = Истина Тогда
		ВызватьИсключение Место + ": повторное значение " + Строка(Ключ);
	КонецЕсли;
	
	Значения.Вставить(Ключ, Истина);
	
КонецПроцедуры

Процедура ПроверитьЗначениеСхемы(Значение, ДопустимыеЗначения, Место)
	
	Если Найти(Значение, ",") > 0 Или Найти("," + ДопустимыеЗначения + ",", "," + Значение + ",") = 0 Тогда
		ВызватьИсключение Место + ": недопустимое значение " + Значение;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодготовитьКолонкуСхемы(Колонка, ФайловаяБаза, МестоКолонки)
	
	Попытка
		ТипЗначения = ТипКолонкиСхемы(Колонка.ВидТипа);
		Доступна = ДоступнаКолонкаСхемы(Колонка, ФайловаяБаза);
	Исключение
		ВызватьИсключение МестоКолонки + ": " + ОписаниеОшибки();
	КонецПопытки;
	
	Колонка.Вставить("ТипЗначения", ТипЗначения);
	Колонка.Вставить("Доступна", Доступна);
	
КонецПроцедуры

Функция КоллекцияМетаданныхРазделаСхемы(Раздел)
	
	Если Раздел.УсловиеДоступности = "Справочник" Тогда
		Возврат "Справочник";
	КонецЕсли;
	
	Если Раздел.УсловиеДоступности <> "Коллекция" Тогда
		Возврат "";
	КонецЕсли;
	
	Если Раздел.МетаданныеДоступности = "Константы" Тогда
		Возврат "Константы";
	КонецЕсли;
	
	Для Каждого Коллекция Из СоответствияПадежейИменКоллекцийМетаданных() Цикл
		Если Коллекция.Значение = Раздел.МетаданныеДоступности Тогда
			Возврат Коллекция.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение "Раздел " + Раздел.ИмяТаблицы + ": неизвестная коллекция " + Раздел.МетаданныеДоступности;
	
КонецФункции

Функция ТипКолонкиСхемы(ВидТипа)
	
	Если ВидТипа = "Строка" Тогда
		Возврат Новый ОписаниеТипов("Строка");
	ИначеЕсли ВидТипа = "Строка255" Тогда
		Возврат Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(255));
	ИначеЕсли ВидТипа = "Число150" Тогда
		Возврат Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 0));
	ИначеЕсли ВидТипа = "Число154" Тогда
		Возврат Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15, 4));
	ИначеЕсли ВидТипа = "Дата" Тогда
		Возврат Новый ОписаниеТипов("Дата", , , , , Новый КвалификаторыДаты(ЧастиДаты.Дата));
	ИначеЕсли ВидТипа = "Булево" Тогда
		Возврат Новый ОписаниеТипов("Булево");
	ИначеЕсли ВидТипа = "СсылкаОрганизации" Тогда
		Возврат ТипСсылкиОрганизации();
	ИначеЕсли ВидТипа = "СсылкаОборудования" Тогда
		Возврат ТипСсылкиОборудования();
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный тип колонки схемы: " + ВидТипа;
	
КонецФункции

Функция ДоступнаКолонкаСхемы(Колонка, ФайловаяБаза)
	
	Если Колонка.УсловиеДоступности = "Всегда" Тогда
		Возврат Истина;
	ИначеЕсли Колонка.УсловиеДоступности = "СервернаяБаза" Тогда
		Возврат Не ФайловаяБаза;
	КонецЕсли;
	
	ВызватьИсключение "Неизвестное условие доступности колонки: " + Колонка.УсловиеДоступности;
	
КонецФункции

Функция ТипСсылкиОрганизации()
	
	Если Метаданные.Справочники.Найти("Организации") <> Неопределено Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.Организации");
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов("Строка");
	
КонецФункции

// #КонецОбласти

// #Область ВозможностиИнтерфейса

Функция ЕстьМетаданныеСтраницы(ДанныеТаблицы)
	
	Если ДанныеТаблицы.УсловиеДоступности = "Всегда" Тогда
		Возврат Истина;
	ИначеЕсли ДанныеТаблицы.УсловиеДоступности = "Справочник" Тогда
		Возврат Метаданные.Справочники.Найти(ДанныеТаблицы.МетаданныеДоступности) <> Неопределено;
	ИначеЕсли ДанныеТаблицы.УсловиеДоступности = "Коллекция" Тогда
		Возврат Метаданные[ДанныеТаблицы.МетаданныеДоступности].Количество() > 0;
	КонецЕсли;
	
	ВызватьИсключение "Неизвестное условие доступности раздела: " + ДанныеТаблицы.УсловиеДоступности;
	
КонецФункции

// #КонецОбласти

// #Область ВспомогательныеМетоды

Функция ТипСсылкиОборудования()
	
	Если Метаданные.Справочники.Найти("ПодключаемоеОборудование") <> Неопределено Тогда
		Возврат Новый ОписаниеТипов("СправочникСсылка.ПодключаемоеОборудование");
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов("Строка");
	
КонецФункции

// #КонецОбласти

// Нормализует границы отбора, не изменяя переданный период.
//
// Параметры:
//  ИсходныйПериод - СтандартныйПериод, Структура, Неопределено - границы ДатаНачала и ДатаОкончания.
//  ПроверятьГраницы - Булево - отклонить начало позже окончания.
//
// Возвращаемое значение:
//  - СтандартныйПериод - начало как задано, окончание в конце дня; пустой конец заменен верхней границей дат.
//  - Неопределено - обе даты не заданы.
Функция НормализованныйПериодОтбора(ИсходныйПериод, ПроверятьГраницы = Ложь)
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод.ДатаНачала)
		И Не ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Период = Новый СтандартныйПериод;
	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = ИсходныйПериод.ДатаНачала;
	
	Если ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Период.ДатаОкончания = КонецДня(ИсходныйПериод.ДатаОкончания);
	Иначе
		Период.ДатаОкончания = Дата('39991231235959');
	КонецЕсли;
	
	Если ПроверятьГраницы И Период.ДатаОкончания < Период.ДатаНачала Тогда
		ВызватьИсключение(
			НСтр("ru='Некорректный отбор по периоду. Дата начала не может быть больше даты окончания'"));
	КонецЕсли;
	
	Возврат Период;
	
КонецФункции

// #КонецОбласти
