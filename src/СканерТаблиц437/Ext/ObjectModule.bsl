// #Область ОписаниеПеременных

Перем ОписанияТаблиц; // Массив, Неопределено - схема разделов текущего контекста.
Перем ДоступКДанным; // ВнешняяОбработкаОбъект, Неопределено - внедренный исполнитель данных.
Перем ДополнительныеРесурсы; // ТаблицаЗначений, Неопределено - ресурсы контекста сеанса.
Перем КэшДиагностики; // Структура, Неопределено - до закрытия обработки или сброса конфигурации.
Перем СтрокиОсновногоСкана; // ТаблицаЗначений, Неопределено - опубликованные основные строки.
Перем РазмерПорции; // Число, Неопределено - ограничение количества ссылок одной порции.

// #КонецОбласти

// #Область СлужебныйПрограммныйИнтерфейс

// #Область СовместимостьПлатформы

// Версия структуры сеанса, которую поддерживает сканер.
//
// Возвращаемое значение:
//  Число - номер контракта изменяемого сеанса сканера.
Функция ВерсияКонтракта() Экспорт
	
	Возврат 1;
	
КонецФункции

// #КонецОбласти

// #Область ВспомогательныеМетоды

// Внедряет исполнителя данных той же сборки; подготовка контекста выполняется при запуске работы.
//
// Параметры:
//  СлужбаДанных - ВнешняяОбработкаОбъект - исполнитель ДоступКДанным той же сборки.
Процедура Инициализировать(СлужбаДанных) Экспорт
	
	ДоступКДанным = СлужбаДанных;
	
КонецПроцедуры

// #КонецОбласти

// #Область СеансыСканирования

// Фиксирует план и отборы; временные данные принадлежат указанному владельцу.
//
// Параметры:
//  Описания - ТаблицаЗначений - таблица плана сканирования из основной обработки.
//  Параметры - Структура - зафиксированные отборы задания: Период и Организация.
//  Контекст - Структура - СхемаТаблиц, ДополнительныеРесурсы, КэшДиагностики, СтрокиОсновногоСкана, РазмерПорции;
//   необязательные ПредыдущиеСведения сохраняют прежние дополнительные результаты.
//  Основные - Булево - включить основной этап в план сеанса.
//  Дополнительные - Булево - включить дополнительные разделы в план сеанса.
//  Владелец - УникальныйИдентификатор - владелец адресов контекста, плана и порций.
//
// Возвращаемое значение:
//  Структура - параметры, план, позиция, статус, адрес контекста, адреса порций и подтверждения публикаций.
//   * Идентификатор - УникальныйИдентификатор - уникальный ключ сеанса.
//   * Владелец - УникальныйИдентификатор - владелец временных данных.
//   * Параметры - Структура - зафиксированные Период и Организация.
//     * Период - Структура, Неопределено - примененные границы ДатаНачала и ДатаОкончания.
//     * Организация - СправочникСсылка, Неопределено - организация или фирма отбора.
//   * План - Массив из Структура - этапы с адресами порций и представлениями для прогресса.
//     * Этап - Строка - основной, дополнительный этап или граница публикации.
//     * Таблица - Строка - ключ раздела.
//     * Адрес - Строка - адрес основной порции либо пустая строка.
//     * Представление - Строка - подпись текущего этапа прогресса.
//   * АдресКонтекста - Строка - адрес неизменного контекста во временном хранилище.
//   * ПорцииОсновных - Массив из Строка - адреса собранных основных порций.
//   * ПорцииДополнительных - Соответствие - раздел и адрес его результата.
//   * Позиция - Число - номер следующей порции, начиная с нуля.
//   * Всего - Число - количество порций и границ публикации.
//   * Статус - Строка - состояние выполнения, публикации, ошибки, отмены или завершения.
//   * Сообщение - Строка - пояснение текущего состояния.
//   * Замеры - Массив из Структура - результаты измерений порций.
//     * Раздел - Строка - ключ обработанной порции.
//     * ДлительностьМс - Число - длительность выполнения порции.
//     * Успех - Булево - порция выполнена без ошибки.
//   * Освобожден - Булево - признак освобождения временных данных.
//   * ИдентификаторПубликации - Строка - ключ ожидающей подтверждения публикации.
//   * ПодтвержденныеПубликации - Соответствие - уже обработанные ключи публикаций.
//   * ОшибкиРазделов - Соответствие - раздел и описание ошибки.
//   * ПредупрежденияРазделов - Соответствие - неполные служебные сведения при успешном чтении данных.
//   * ИмитацияОшибкиРаздела - Строка - пустой штатный маркер адресной проверки ошибок.
Функция НовыйСеанс(Описания, Параметры, Контекст, Основные, Дополнительные, Владелец) Экспорт
	
	Параметры.Период = НормализованныйПериодОтбора(Параметры.Период, Истина);
	ПодготовитьКонтекстСеанса(Контекст);
	
	Если Дополнительные Тогда
		ПроверитьИсточникиДополнительныхРазделов();
	КонецЕсли;
	
	План = Новый Массив;
	
	Если Основные Тогда
		Для Каждого Порция Из ПланОсновныхТаблиц(Описания, Параметры) Цикл
			Порция.Вставить("Этап", "Основные");
			План.Добавить(Порция);
		КонецЦикла;
		
		План.Добавить(Новый Структура("Этап,Таблица", "ПубликацияОсновных", "Основные таблицы"));
	КонецЕсли;
	
	Если Дополнительные Тогда
		Для Каждого Раздел Из ДополнительныеРазделыСканирования() Цикл
			План.Добавить(Новый Структура("Этап,Таблица", "Дополнительные", Раздел.Ключ));
		КонецЦикла;
		
		План.Добавить(Новый Структура("Этап,Таблица", "ПубликацияДополнительных", "Дополнительные таблицы"));
	КонецЕсли;
	
	Сеанс = Новый Структура;
	Сеанс.Вставить("Идентификатор", Новый УникальныйИдентификатор);
	Сеанс.Вставить("Владелец", Владелец);
	Сеанс.Вставить("Параметры", Параметры);
	Сеанс.Вставить("План", КраткийПланСеанса(План, Владелец));
	Сеанс.Вставить("АдресКонтекста", ПоместитьВоВременноеХранилище(Контекст, Владелец));
	Сеанс.Вставить("ПорцииОсновных", Новый Массив);
	Сеанс.Вставить("ПорцииДополнительных", Новый Соответствие);
	Сеанс.Вставить("Позиция", 0);
	Сеанс.Вставить("Всего", План.Количество());
	Сеанс.Вставить("Статус", "Выполняется");
	Сеанс.Вставить("Сообщение", "");
	Сеанс.Вставить("Замеры", Новый Массив);
	Сеанс.Вставить("Освобожден", Ложь);
	Сеанс.Вставить("ИдентификаторПубликации", "");
	Сеанс.Вставить("ПодтвержденныеПубликации", Новый Соответствие);
	Сеанс.Вставить("ОшибкиРазделов", Новый Соответствие);
	Сеанс.Вставить("ПредупрежденияРазделов", Новый Соответствие);
	Сеанс.Вставить("ИмитацияОшибкиРаздела", "");
	
	Возврат Сеанс;
	
КонецФункции

// Объединяет собранные основные порции; вызывается оркестратором только на границе публикации.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//
// Возвращаемое значение:
//  ТаблицаЗначений - завершенные строки основного этапа.
Функция ОсновнойРезультатСеанса(Сеанс) Экспорт
	
	Данные = НоваяТаблицаРезультатов();
	
	Для Каждого Адрес Из Сеанс.ПорцииОсновных Цикл
		Порция = ПолучитьИзВременногоХранилища(Адрес);
		
		Для Каждого СтрокаДанных Из Порция Цикл
			ЗаполнитьЗначенияСвойств(Данные.Добавить(), СтрокаДанных);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

// Собирает результаты дополнительных разделов, сохраняя прежние данные неудачных разделов.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//
// Возвращаемое значение:
//  Структура - табличные разделы под именами общей схемы, Сведения, ОшибкиРазделов и КэшДиагностики; непрочитанные
//   таблицы могут быть Неопределено.
//   * Сведения - Структура - результаты дополнительных разделов и отборы хронологии.
//     * РазделыСДанными - Соответствие - разделы с результатом; успешные ноль строк учитываются.
//     * СохраненыПредыдущиеДанные - Соответствие - разделы, сохранившие прежние данные после ошибки.
//     * ПериодХронологии - Структура, Неопределено - отбор опубликованной хронологии.
//     * ОрганизацияХронологии - СправочникСсылка, Неопределено - организация опубликованной хронологии.
//   * ОшибкиРазделов - Соответствие - раздел и его ошибка; успешные разделы остаются доступными.
//   * КэшДиагностики - Структура - кэш после сеанса; состав описан в основной обработке.
Функция ДополнительныйРезультатСеанса(Сеанс) Экспорт
	
	Контекст = ПолучитьИзВременногоХранилища(Сеанс.АдресКонтекста);
	ДоступКДанным.Инициализировать(Контекст.СхемаТаблиц);
	Данные = НовыеДанныеДополнительногоРезультата(Контекст);
	Сведения = СведенияДополнительногоРезультата(Контекст);
	
	Для Каждого Порция Из Сеанс.ПорцииДополнительных Цикл
		РезультатРаздела = ПолучитьИзВременногоХранилища(Порция.Значение);
		
		Если Сведения.Свойство(Порция.Ключ) Тогда
			Сведения[Порция.Ключ] = РезультатРаздела;
		Иначе
			Данные.Вставить(Порция.Ключ, РезультатРаздела);
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьСостояниеДополнительныхРазделов(Сведения, Контекст, Сеанс);
	Сведения.Вставить("ОшибкиРазделов", Сеанс.ОшибкиРазделов);
	Сведения.Вставить("ПредупрежденияРазделов", Сеанс.ПредупрежденияРазделов);
	
	Если Сеанс.ОшибкиРазделов.Получить("ХронологияДокументов") = Неопределено Тогда
		Сведения.Вставить("ПериодХронологии", Сеанс.Параметры.Период);
		Сведения.Вставить("ОрганизацияХронологии", Сеанс.Параметры.Организация);
	КонецЕсли;
	
	Данные.Вставить("Сведения", Сведения);
	Данные.Вставить("ОшибкиРазделов", Сеанс.ОшибкиРазделов);
	Данные.Вставить("КэшДиагностики", Контекст.КэшДиагностики);
	
	Возврат Данные;
	
КонецФункции

// Продвигает план после подтвержденной публикации; повторный идентификатор не продвигает его дважды.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//  ОсновныеСтроки - ТаблицаЗначений, Неопределено - опубликованные основные строки для следующего состояния кэша.
//  ИдентификаторПубликации - Строка - ключ подтверждения; повторный ключ обрабатывается без повторного продвижения.
Процедура ПодтвердитьПубликациюСеанса(Сеанс, ОсновныеСтроки = Неопределено, ИдентификаторПубликации = "") Экспорт
	
	Если ПустаяСтрока(ИдентификаторПубликации) Тогда
		ИдентификаторПубликации = Сеанс.ИдентификаторПубликации;
	КонецЕсли;
	
	Если Сеанс.ПодтвержденныеПубликации.Получить(ИдентификаторПубликации) = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИдентификаторПубликации)
		Или ИдентификаторПубликации <> Сеанс.ИдентификаторПубликации
		Или (Сеанс.Статус <> "ПубликацияОсновных" И Сеанс.Статус <> "ПубликацияДополнительных") Тогда
		ВызватьИсключение НСтр("ru='Подтверждение не соответствует ожидаемой публикации.'");
	КонецЕсли;
	
	Если ОсновныеСтроки <> Неопределено Тогда
		Контекст = ПолучитьИзВременногоХранилища(Сеанс.АдресКонтекста);
		Контекст.СтрокиОсновногоСкана = ОсновныеСтроки;
		ПоместитьВоВременноеХранилище(Контекст, Сеанс.АдресКонтекста);
	КонецЕсли;
	
	Сеанс.ПодтвержденныеПубликации.Вставить(ИдентификаторПубликации, Истина);
	Сеанс.Позиция = Сеанс.Позиция + 1;
	Сеанс.Статус = ?(Сеанс.Позиция >= Сеанс.Всего, "Завершен", "Выполняется");
	
КонецПроцедуры

// Меняет статус сеанса на отмененный между порциями; текущий запрос не прерывает.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
Процедура ОтменитьСеанс(Сеанс) Экспорт
	
	Если Сеанс.Статус <> "Завершен" Тогда
		Сеанс.Статус = "Отменен";
		Сеанс.Сообщение = "Сканирование остановлено. Последний завершённый скан сохранён.";
	КонецЕсли;
	
КонецПроцедуры

// Снимает ошибку текущей порции для повторного выполнения.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
Процедура ПовторитьСеанс(Сеанс) Экспорт
	
	Если Сеанс.Статус = "Ошибка" Или Сеанс.Статус = "Отменен" Тогда
		Сеанс.Статус = "Выполняется";
		Сеанс.Сообщение = "";
	КонецЕсли;
	
КонецПроцедуры

// Удаляет принадлежащие сеансу адреса временного хранилища и отмечает освобождение.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
Процедура ОсвободитьСеанс(Сеанс) Экспорт
	
	Если Сеанс.Освобожден Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Порция Из Сеанс.План Цикл
		Если Не ПустаяСтрока(Порция.Адрес) Тогда
			УдалитьИзВременногоХранилища(Порция.Адрес);
		КонецЕсли;
	КонецЦикла;
	
	УдалитьИзВременногоХранилища(Сеанс.АдресКонтекста);
	
	Для Каждого Адрес Из Сеанс.ПорцииОсновных Цикл
		УдалитьИзВременногоХранилища(Адрес);
	КонецЦикла;
	
	Для Каждого Порция Из Сеанс.ПорцииДополнительных Цикл
		УдалитьИзВременногоХранилища(Порция.Значение);
	КонецЦикла;
	
	Сеанс.Освобожден = Истина;
	
КонецПроцедуры

// Создает состояние для интерфейса, не передавая массивы данных и адреса порций.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//
// Возвращаемое значение:
//  Структура - Статус, Сообщение, Выполнено, Всего, Раздел, ИдентификаторПубликации и Предупреждения.
//   * Статус - Строка - текущее состояние сеанса.
//   * Сообщение - Строка - пояснение состояния или ошибки.
//   * Выполнено - Число - позиция следующей порции.
//   * Всего - Число - количество порций вместе с границами публикации.
//   * Раздел - Строка - представление следующей порции либо пустая строка.
//   * ИдентификаторПубликации - Строка - ключ ожидающей подтверждения публикации.
//   * Предупреждения - Массив из Строка - ошибки отдельных дополнительных разделов.
Функция СостояниеСеанса(Сеанс) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Статус", Сеанс.Статус);
	Результат.Вставить("Сообщение", Сеанс.Сообщение);
	Результат.Вставить("Выполнено", Сеанс.Позиция);
	Результат.Вставить("Всего", Сеанс.Всего);
	Результат.Вставить("Раздел", "");
	Результат.Вставить("ИдентификаторПубликации", Сеанс.ИдентификаторПубликации);
	
	Если Сеанс.Позиция < Сеанс.Всего Тогда
		План = Сеанс.План;
		Результат.Раздел = План[Сеанс.Позиция].Представление;
	КонецЕсли;
	
	Результат.Вставить("Предупреждения", ПредупрежденияРазделов(Сеанс));
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область СеансСканирования

// Выполняет ограниченную пачку порций; бюджет проверяется между запросами, а не прерывает запрос.
//
// Параметры:
//  Сеанс - Структура - изменяемый сеанс; см. МодульСканированиеТаблиц.НовыйСеанс.
//  Максимум - Число - максимум порций в одном вызове.
//  БюджетМс - Число - бюджет вызова в миллисекундах; проверяется между порциями.
//
// Возвращаемое значение:
//  Структура - состояние после пачки порций; см. СостояниеСеанса.
Функция ВыполнитьСледующиеПорции(Сеанс, Максимум = 32, БюджетМс = 750) Экспорт
	
	Начало = ВремяПорции();
	Выполнено = 0;
	Состояние = СостояниеСеанса(Сеанс);
	
	Пока Выполнено < Максимум И Сеанс.Статус = "Выполняется" Цикл
		Состояние = ВыполнитьСледующуюПорцию(Сеанс);
		Выполнено = Выполнено + 1;
		
		Если ВремяПорции() - Начало >= БюджетМс Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Состояние;
	
КонецФункции

