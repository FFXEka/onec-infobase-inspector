Процедура ПодготовитьКонтекстСеанса(Контекст)
	
	ДополнительныеРесурсы = Контекст.ДополнительныеРесурсы;
	КопияКэша = Новый ХранилищеЗначения(Контекст.КэшДиагностики);
	КэшДиагностики = КопияКэша.Получить();
	СтрокиОсновногоСкана = Контекст.СтрокиОсновногоСкана;
	РазмерПорции = Контекст.РазмерПорции;
	ОписанияТаблиц = Контекст.СхемаТаблиц;
	ДоступКДанным.Инициализировать(ОписанияТаблиц);
	
КонецПроцедуры

Процедура ПроверитьИсточникиДополнительныхРазделов()
	
	Для Каждого Раздел Из ДополнительныеРазделыСканирования() Цикл
		Если Раздел.Ключ <> "Константы"
			И Раздел.Ключ <> "ХронологияДокументов"
			И Раздел.Ключ <> "ПодключаемоеОборудование"
			И Раздел.Ключ <> "Библиотеки"
			И Раздел.Ключ <> "Расширения"
			И Раздел.Ключ <> "Организации" Тогда
			ВызватьИсключение НСтр("ru='Неизвестный раздел дополнительного скана: '") + Раздел.Ключ;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПланОсновныхТаблиц(Описания, Параметры)
	
	План = Новый Массив;
	
	Для Каждого Описание Из Описания Цикл
		Если Описание.Дополнительная Или Описание.Имя = "Сводная" Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого Текст Из ПакетТекстовЗапроса(Описание, Параметры.Период, Параметры.Организация) Цикл
			Если Не ПустаяСтрока(Текст) Тогда
				План.Добавить(Новый Структура("Таблица,ТекстЗапроса", Описание.Имя, Текст));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат План;
	
КонецФункции

Функция НоваяТаблицаРезультатов()
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("МетаданныеИмя", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("МетаданныеСиноним", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("КоллекцияОбъектовМетаданныхИмя", Новый ОписаниеТипов("Строка"));
	Данные.Колонки.Добавить("КоллекцияМетаданныхСиноним", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Имя Из Новый Структура("ОсновнойРесурс,Ресурс1,Ресурс2") Цикл
		Данные.Колонки.Добавить(Имя.Ключ, Новый ОписаниеТипов("Число"));
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ХронологияДокументов(Период = Неопределено, Организация = Неопределено)
	
	Текст = ТекстЗапросаХронологииДокументов(Период, Организация);
	
	Если ПустаяСтрока(Текст) Тогда
		Таблица = Новый ТаблицаЗначений;
		Таблица.Колонки.Добавить("МетаданныеИмя", ОписаниеТиповСтрока255());
		Таблица.Колонки.Добавить("МетаданныеСиноним", ОписаниеТиповСтрока255());
		Таблица.Колонки.Добавить("ОсновнойРесурс", Новый ОписаниеТипов("Дата"));
		Таблица.Колонки.Добавить("ДатаПоследнегоДокумента", Новый ОписаниеТипов("Дата"));
		Таблица.Колонки.Добавить("Ресурс1", Новый ОписаниеТипов("Число"));
	Иначе
		Запрос = Новый Запрос(Текст);
		УстановитьОтборПоПериодуПриНеобходимости(Запрос, Период);
		УстановитьОтборПоОрганизацииПриНеобходимости(Запрос, Организация);
		Таблица = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	
	ДополнитьХронологиюИменамиСУБД(Таблица);
	
	Возврат Таблица;
	
КонецФункции

Функция ДанныеПодключаемогоОборудования()
	
	Если Метаданные.Справочники.Найти("ПодключаемоеОборудование") = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаПодключаемоеОборудование());
	Данные = Запрос.Выполнить().Выгрузить();
	Данные.Колонки.Добавить("ОсновнойРесурс");
	Данные.Колонки.Добавить("МетаданныеИмя");
	Данные.Колонки.Добавить("МетаданныеСиноним");
	
	Для Каждого СтрокаДанных Из Данные Цикл
		СтрокаДанных.ОсновнойРесурс = СтрокаДанных.Используется;
		СтрокаДанных.МетаданныеИмя = СтрокаДанных.ТипОборудования;
		СтрокаДанных.МетаданныеСиноним = СтрокаДанных.Наименование;
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ПредупрежденияРазделов(Сеанс)
	
	Результат = Новый Массив;
	
	Для Каждого Раздел Из Сеанс.ОшибкиРазделов Цикл
		Результат.Добавить(Раздел.Ключ + ": данные не обновлены. " + Раздел.Значение);
	КонецЦикла;
	
	Для Каждого Раздел Из Сеанс.ПредупрежденияРазделов Цикл
		Результат.Добавить(Раздел.Ключ + ": " + Раздел.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область СеансСканирования

Функция СканироватьПорцию(Порция, Параметры)
	
	Данные = НоваяТаблицаРезультатов();
	Запрос = Новый Запрос(Порция.ТекстЗапроса);
	УстановитьОтборПоПериодуПриНеобходимости(Запрос, Параметры.Период);
	УстановитьОтборПоОрганизацииПриНеобходимости(Запрос, Параметры.Организация);
	
	Для Каждого Результат Из Запрос.ВыполнитьПакет() Цикл
		ДобавитьРезультатПорции(Данные, Результат);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Процедура ДобавитьРезультатПорции(Данные, Результат)
	
	Выборка = Результат.Выбрать();
	Ресурсы = НовыеРесурсы();
	Поля = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		Поля = Новый Структура;
		Поля.Вставить("МетаданныеИмя", Выборка.МетаданныеИмя);
		Поля.Вставить("МетаданныеСиноним", Выборка.МетаданныеСиноним);
		Поля.Вставить("КоллекцияОбъектовМетаданныхИмя", Выборка.КоллекцияМетаданныхИмя);
		Поля.Вставить("КоллекцияМетаданныхСиноним", Выборка.КоллекцияМетаданныхСиноним);
		РассчитатьРесурсы(Ресурсы, Выборка);
	КонецЦикла;
	
	Если Поля = Неопределено Или Ресурсы.Основной = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаДанных = Данные.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДанных, Поля);
	СтрокаДанных.ОсновнойРесурс = Ресурсы.Основной;
	СтрокаДанных.Ресурс1 = Ресурсы.Доп1;
	СтрокаДанных.Ресурс2 = Ресурсы.Доп2;
	
КонецПроцедуры

Функция КраткийПланСеанса(План, Владелец)
	
	Результат = Новый Массив;
	
	Для Каждого Порция Из План Цикл
		Адрес = "";
		
		Если Порция.Этап = "Основные" Тогда
			Адрес = ПоместитьВоВременноеХранилище(Порция, Владелец);
		КонецЕсли;
		
		Описание = Новый Структура("Этап,Таблица,Адрес", Порция.Этап, Порция.Таблица, Адрес);
		Описание.Вставить("Представление", ПредставлениеРазделаСканирования(Порция.Таблица));
		Результат.Добавить(Описание);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПредставлениеРазделаСканирования(ИмяРаздела)
	
	Для Каждого Описание Из ОписанияТаблиц Цикл
		Если Описание.ИмяТаблицы = ИмяРаздела Тогда
			
			Возврат ?(ПустаяСтрока(Описание.СинонимТаблицы),
				Описание.ЗаголовокСтраницы, Описание.СинонимТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИмяРаздела;
	
КонецФункции

Функция ПорцияСеанса(Сеанс)
	
	Описание = Сеанс.План[Сеанс.Позиция];
	
	Если Не ПустаяСтрока(Описание.Адрес) Тогда
		Возврат ПолучитьИзВременногоХранилища(Описание.Адрес);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ДополнительныеРазделыСканирования()
	
	Разделы = Новый Структура;
	
	Для Каждого Описание Из ОписанияТаблиц Цикл
		Если Описание.ЭтоДополнительнаяТаблица Тогда
			Разделы.Вставить(Описание.ИмяТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Разделы;
	
КонецФункции

// #КонецОбласти

// #Область СборДанных

Функция ПакетТекстовЗапроса(СтруктураМетаданных, ОтборПоПериоду, ОтборПоОрганизации)
	
	ПакетТекстовЗапроса = Новый Массив;
	
	ДополнительныйРесурс1 = "Неопределено";
	ДополнительныйРесурс2 = "Неопределено";
	ОпределитьДополнительныеРесурсы(СтруктураМетаданных, ДополнительныйРесурс1, ДополнительныйРесурс2);
	
	Выражение1 = ДополнительныйРесурс1;
	Выражение2 = ДополнительныйРесурс2;
	
	Если РесурсыСуммируютсяВЗапросе() Тогда
		Выражение1 = ВыражениеСуммыРесурса(ДополнительныйРесурс1);
		Выражение2 = ВыражениеСуммыРесурса(ДополнительныйРесурс2);
	КонецЕсли;
	
	Индекс = 0;
	ТекстЗапроса = "";
	
	Для Каждого ОбъектМетаданных Из Метаданные[СтруктураМетаданных.КоллекцияОбъектовМетаданных] Цикл
		
		РеквизитПериод = Неопределено;
		ПоляОрганизации = Новый Массив;
		
		Если ЗначениеЗаполнено(ОтборПоПериоду) Тогда
			УстановитьРеквизитПериодОбъектаМетаданных(РеквизитПериод, ОбъектМетаданных);
			
			Если РеквизитПериод = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтборПоОрганизации) Тогда
			ОписаниеОрганизации = ДоступКДанным.ОписаниеПолейОрганизации(
				ОбъектМетаданных, ТипЗнч(ОтборПоОрганизации));
			ПоляОрганизации = ОписаниеОрганизации.Поля;
			Если ПоляОрганизации.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
		ПоместитьТекстВПакетПриНеобходимости(ПакетТекстовЗапроса, ТекстЗапроса, Индекс);
		ДобавитьРазделительПриНеобходимости(ТекстЗапроса);
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + "ВЫБРАТЬ
			|	КОЛИЧЕСТВО(*) КАК ОсновнойРесурс,
			|	" + Выражение1 + " КАК ДополнительныйРесурс1,
			|	" + Выражение2 + " КАК ДополнительныйРесурс2,
			|	""" + СтруктураМетаданных.Имя + """ КАК КоллекцияМетаданныхИмя,
			|	""" + СтрЗаменить(СтруктураМетаданных.Синоним, """", """""") + """ КАК КоллекцияМетаданныхСиноним,
			|	""" + ОбъектМетаданных.Имя + """ КАК МетаданныеИмя,
			|	""" + СтрЗаменить(ОбъектМетаданных.Синоним, """", """""") + """ КАК МетаданныеСиноним
			|ИЗ
			|	" + СтруктураМетаданных.Имя + "." + ОбъектМетаданных.Имя;
		
		ДобавитьОбластьГДЕ(ТекстЗапроса, РеквизитПериод, ПоляОрганизации);
		
		Если Не РесурсыСуммируютсяВЗапросе() Тогда
			ДобавитьОбластьСГРУППИРОВАТЬПО(ТекстЗапроса, ДополнительныйРесурс1, ДополнительныйРесурс2);
		КонецЕсли;
		
	КонецЦикла;
	
	ПакетТекстовЗапроса.Добавить(ТекстЗапроса);
	
	Возврат ПакетТекстовЗапроса;
	
КонецФункции

Процедура ДобавитьОбластьГДЕ(ТекстЗапроса, РеквизитПериод, ПоляОрганизации)
	
	Отборы = Новый Массив;
	
	Если РеквизитПериод <> Неопределено Тогда
		ТекстСтроки = "	" + РеквизитПериод + " МЕЖДУ &ДатаНачала И &ДатаОкончания";
		Отборы.Добавить(ТекстСтроки);
	КонецЕсли;
	
	Если ПоляОрганизации.Количество() > 0 Тогда
		Отборы.Добавить(ДоступКДанным.УсловиеОтбораПоОрганизации(ПоляОрганизации));
	КонецЕсли;
	
	Если Отборы.Количество() > 0 Тогда
		
		ОбластьГДЕ = "ГДЕ";
		
		Первый = Истина;
		Приставка = "";
		
		Для Каждого ТекОтбор Из Отборы Цикл
			
			Если Первый Тогда
				Первый = Ложь;
			Иначе
				Приставка = "И ";
			КонецЕсли;
			
			ОбластьГДЕ = ОбластьГДЕ + Символы.ПС + Приставка + ТекОтбор;
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + ОбластьГДЕ;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОбластьСГРУППИРОВАТЬПО(ТекстЗапроса, ДополнительныйРесурс1, ДополнительныйРесурс2)
	
	Если ДополнительныйРесурс1 <> "Неопределено" Или ДополнительныйРесурс2 <> "Неопределено" Тогда
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + Символы.ПС + "СГРУППИРОВАТЬ ПО";
		
		Если ДополнительныйРесурс1 <> "Неопределено" Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	" + ДополнительныйРесурс1;
		КонецЕсли;
		
		Если ДополнительныйРесурс2 <> "Неопределено" Тогда
			Если ДополнительныйРесурс1 <> "Неопределено" Тогда
				ТекстЗапроса = ТекстЗапроса + ",";
			КонецЕсли;
			
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "	" + ДополнительныйРесурс2;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьРесурсы(Ресурсы, ВыборкаПоОбъектуМетаданных)
	
	Ресурсы.Основной = Ресурсы.Основной + ВыборкаПоОбъектуМетаданных.ОсновнойРесурс;
	
	Если РесурсыСуммируютсяВЗапросе() Тогда
		Ресурсы.Доп1 = Ресурсы.Доп1 + ВыборкаПоОбъектуМетаданных.ДополнительныйРесурс1;
		Ресурсы.Доп2 = Ресурсы.Доп2 + ВыборкаПоОбъектуМетаданных.ДополнительныйРесурс2;
		
		Возврат;
	КонецЕсли;
	
	Если ВыборкаПоОбъектуМетаданных.ДополнительныйРесурс1 = Истина Тогда
		Ресурсы.Доп1 = Ресурсы.Доп1 + ВыборкаПоОбъектуМетаданных.ОсновнойРесурс;
	КонецЕсли;
	
	Если ВыборкаПоОбъектуМетаданных.ДополнительныйРесурс2 = Истина Тогда
		Ресурсы.Доп2 = Ресурсы.Доп2 + ВыборкаПоОбъектуМетаданных.ОсновнойРесурс;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьОтборПоПериодуПриНеобходимости(Запрос, ОтборПоПериоду)
	
	ОтборПоПериоду = НормализованныйПериодОтбора(ОтборПоПериоду, Истина);
	Если ЗначениеЗаполнено(ОтборПоПериоду) Тогда
		Запрос.УстановитьПараметр("ДатаНачала", ОтборПоПериоду.ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ОтборПоПериоду.ДатаОкончания);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьОтборПоОрганизацииПриНеобходимости(Запрос, ОтборПоОрганизации)
	
	Если ЗначениеЗаполнено(ОтборПоОрганизации) Тогда
		Запрос.УстановитьПараметр("Организация", ОтборПоОрганизации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьДополнительныеРесурсы(СтруктураМетаданных, ДополнительныйРесурс1, ДополнительныйРесурс2)
	
	ПараметрыПоиска = Новый Структура("Метаданные", СтруктураМетаданных.КоллекцияОбъектовМетаданных);
	
	ПоискОпределенияРесурсов = ДополнительныеРесурсы.НайтиСтроки(ПараметрыПоиска);
	
	Для Каждого РезультатПоиска Из ПоискОпределенияРесурсов Цикл
		
		Если РезультатПоиска.ИмяРесурса = "Ресурс1" Тогда
			ДополнительныйРесурс1 = РезультатПоиска.ЗначениеРесурса;
		КонецЕсли;
		
		Если РезультатПоиска.ИмяРесурса = "Ресурс2" Тогда
			ДополнительныйРесурс2 = РезультатПоиска.ЗначениеРесурса;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьРеквизитПериодОбъектаМетаданных(РеквизитПериод, ОбъектМетаданных)
	
	ИмяПоля = ДоступКДанным.ИмяПоляПериода(ОбъектМетаданных);
	РеквизитПериод = ?(ПустаяСтрока(ИмяПоля), Неопределено, ИмяПоля);
	
КонецПроцедуры

Процедура УстановитьРеквизитОрганизацияОбъектаМетаданных(РеквизитОрганизация, ОбъектМетаданных, ТипОрганизации)
	
	ИмяПоля = ДоступКДанным.ИмяПоляОрганизации(ОбъектМетаданных, ТипОрганизации);
	РеквизитОрганизация = ?(ПустаяСтрока(ИмяПоля), Неопределено, ИмяПоля);
	
КонецПроцедуры

Функция ТекстЗапросаПодключаемоеОборудование()
	
	ОбъектМетаданных = Метаданные.Справочники.ПодключаемоеОборудование;
	Используется = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "УстройствоИспользуется,Используется",
		"ПодключаемоеОборудование");
	ТипОборудования = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "ТипОборудования",
		"ПодключаемоеОборудование");
	Драйвер = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "ДрайверОборудования,Драйвер",
		"ПодключаемоеОборудование");
	РабочееМесто = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "РабочееМесто",
		"ПодключаемоеОборудование");
	Организация = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "Организация,Фирма",
		"ПодключаемоеОборудование");
	СерийныйНомер = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "СерийныйНомер",
		"ПодключаемоеОборудование");
	
	Возврат "ВЫБРАТЬ
	| " + Используется + " КАК Используется,
	| " + ТипОборудования + " КАК ТипОборудования,
	| " + Драйвер + " КАК Драйвер,
	| " + РабочееМесто + " КАК РабочееМесто,
	| ПодключаемоеОборудование.Наименование КАК Наименование,
	| " + Организация + " КАК Организация,
	| " + СерийныйНомер + " КАК СерийныйНомер,
	| ПодключаемоеОборудование.Ссылка КАК Ссылка
	|ИЗ
	| Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование";
	
КонецФункции

Функция ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, ИменаРеквизитов, ПсевдонимТаблицы)
	
	Для Каждого ИмяРеквизита Из Новый Структура(ИменаРеквизитов) Цикл
		Если ОбъектМетаданных.Реквизиты.Найти(ИмяРеквизита.Ключ) <> Неопределено Тогда
			Возврат "ПРЕДСТАВЛЕНИЕ(" + ПсевдонимТаблицы + "." + ИмяРеквизита.Ключ + ")";
		КонецЕсли;
	КонецЦикла;
	
	Возврат """""";
	
КонецФункции

Функция ТекстЗапросаХронологииДокументов(Период = Неопределено, Организация = Неопределено)
	
	ТелоЗапроса = Новый Массив;
	
	Для Каждого ОбъектМетаданных Из Метаданные.Документы Цикл
		ПоляОрганизации = Новый Массив;
		
		Если ЗначениеЗаполнено(Организация) Тогда
			ОписаниеОрганизации = ДоступКДанным.ОписаниеПолейОрганизации(
				ОбъектМетаданных, ТипЗнч(Организация));
			ПоляОрганизации = ОписаниеОрганизации.Поля;
			
			Если ПоляОрганизации.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Синоним = СтрЗаменить(ОбъектМетаданных.Синоним, """", """""");
		СтрокаЗапроса = "ВЫБРАТЬ
			|   """ + ОбъектМетаданных.Имя + """ КАК МетаданныеИмя,
			|   """ + Синоним + """ КАК МетаданныеСиноним,
			|   МИНИМУМ(Дата) КАК ОсновнойРесурс,
			|   МАКСИМУМ(Дата) КАК ДатаПоследнегоДокумента,
			|   КОЛИЧЕСТВО(*) КАК Ресурс1";
		Если ТелоЗапроса.Количество() = 0 Тогда
			СтрокаЗапроса = СтрокаЗапроса + Символы.ПС + "ПОМЕСТИТЬ ХронологияДокументов";
		КонецЕсли;
		
		СтрокаЗапроса = СтрокаЗапроса + Символы.ПС + "ИЗ Документ." + ОбъектМетаданных.Имя;
		ДобавитьОбластьГДЕ(СтрокаЗапроса, ?(ЗначениеЗаполнено(Период), "Дата", Неопределено),
			ПоляОрганизации);
		ТелоЗапроса.Добавить(СтрокаЗапроса);
	КонецЦикла;
	
	Если ТелоЗапроса.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстЗапроса = СтрСоединитьАдапт(ТелоЗапроса, РазделительОбъединить());
	ДобавитьРазделительПриНеобходимости(ТекстЗапроса);
	
	Возврат ТекстЗапроса + Символы.ПС + "ВЫБРАТЬ
		|   МетаданныеИмя,
		|   МетаданныеСиноним,
		|   ОсновнойРесурс,
		|   ДатаПоследнегоДокумента,
		|   Ресурс1
		|ИЗ ХронологияДокументов
		|ГДЕ Ресурс1 > 0";
	
КонецФункции

Процедура ПоместитьТекстВПакетПриНеобходимости(ПакетТекстовЗапроса, ТекстЗапроса, Индекс)
	
	// Размер порции выбран по замерам; это не предел числа таблиц в одном запросе.
	РазмерПорцииЗапросов = РазмерПорции;
	
	Если Индекс > РазмерПорцииЗапросов Тогда
		Индекс = 1;
		ПакетТекстовЗапроса.Добавить(ТекстЗапроса);
		ТекстЗапроса = "";
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРазделительПриНеобходимости(ТекстЗапроса)
	
	Разделитель = Символы.ПС + ";
		|
		|////////////////////////////////////////////////////////////////////////////////";
	
	Если ТекстЗапроса <> "" Тогда
		ТекстЗапроса = ТекстЗапроса + Разделитель;
	КонецЕсли;
	
КонецПроцедуры

Функция ДанныеБиблиотекДиагностики()
	
	Таблица = ДоступКДанным.НоваяТаблицаБиблиотек();
	
	Если Метаданные.ОбщиеМодули.Найти("СтандартныеПодсистемыПовтИсп") = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	
	СтандартныеПодсистемыПовтИспАдапт = Неопределено;
	
	Попытка
		Выполнить("СтандартныеПодсистемыПовтИспАдапт = СтандартныеПодсистемыПовтИсп");
		Библиотеки = СтандартныеПодсистемыПовтИспАдапт.ОписанияПодсистем().ПоИменам;
	Исключение
		ВызватьИсключение НСтр("ru='Сведения о библиотеках недоступны в этой версии БСП.'");
	КонецПопытки;
	
	Для Каждого Библиотека Из Библиотеки Цикл
		Строка = Таблица.Добавить();
		Строка.Имя = Библиотека.Значение.Имя;
		Строка.Версия = Библиотека.Значение.Версия;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ДанныеУстановленныхРасширений()
	
	Таблица = ДоступКДанным.НоваяТаблицаРасширений();
	
	Если Не ДоступКДанным.ПоддерживаютсяРасширенияКонфигурации() Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Расширения = Неопределено;
	
	Попытка
		Выполнить("Расширения = РасширенияКонфигурации.Получить();");
	Исключение
		ВызватьИсключение НСтр("ru='Сведения об установленных расширениях недоступны на этой платформе "
			+ "или с текущими правами.'");
	КонецПопытки;
	
	Кэш = ДанныеКэшаДиагностики();
	Актуальные = Новый Соответствие;
	
	Для Каждого Расширение Из Расширения Цикл
		Данные = КэшированныеДанныеРасширения(Расширение, Кэш.Расширения, Актуальные);
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Данные);
	КонецЦикла;
	
	Кэш.Расширения = Актуальные;
	
	Возврат Таблица;
	
КонецФункции

Функция ДанныеРасширения(Расширение, ПолноеОписание = Ложь)
	
	Данные = Новый Структура;
	Данные.Вставить("Имя", Расширение.Имя);
	Данные.Вставить("Синоним", ?(ПустаяСтрока(Расширение.Синоним), Расширение.Имя, Расширение.Синоним));
	Данные.Вставить("Версия", Расширение.Версия);
	Данные.Вставить("Описание", "");
	Данные.Вставить("АвторскиеПрава", "");
	Данные.Вставить("АдресИнформации", "");
	Данные.Вставить("АдресПоставщика", "");
	ДобавитьНастройкиРасширения(Данные, Расширение);
	Информация = Неопределено;
	
	Попытка
		Выполнить("Информация = Новый ОбъектМетаданныхКонфигурация(Расширение.ПолучитьДанные());");
	Исключение
		// На ранних платформах остаются доступные имя, наименование и версия.
	КонецПопытки;
	
	ПолноеОписание = Информация <> Неопределено;
	
	Если ПолноеОписание Тогда
		Данные.Описание = Информация.КраткаяИнформация;
		
		Если СтрДлина(Информация.ПодробнаяИнформация) > СтрДлина(Данные.Описание) Тогда
			Данные.Описание = Информация.ПодробнаяИнформация;
		КонецЕсли;
		
		Данные.АвторскиеПрава = Информация.АвторскиеПрава;
		Данные.АдресИнформации = Информация.АдресИнформацииОКонфигурации;
		Данные.АдресПоставщика = Информация.АдресИнформацииОПоставщике;
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Функция НовыеРесурсы()
	
	Возврат Новый Структура("Основной, Доп1, Доп2", 0, 0, 0);
	
КонецФункции

Функция ИнформационнаяБазаФайловая(Знач СтрокаСоединенияИнформационнойБазы = "")
	
	Если ПустаяСтрока(СтрокаСоединенияИнформационнойБазы) Тогда
		СтрокаСоединенияИнформационнойБазы = СтрокаСоединенияИнформационнойБазы();
	КонецЕсли;
	
	Возврат Лев(ВРег(СтрокаСоединенияИнформационнойБазы), 5) = "FILE=";
	
КонецФункции

Функция СтрСоединитьАдапт(Строки, Разделитель = "")
	
	Результат = "";
	ЭтоПервыйЭлемент = Истина;
	
	Для Каждого СтрокаТаблицы Из Строки Цикл
		
		Если Не ЭтоПервыйЭлемент Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;
		
		Результат = Результат + СтрокаТаблицы;
		ЭтоПервыйЭлемент = Ложь;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РазделительОбъединить()
	
	Возврат Символы.ПС + "
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|";
	
КонецФункции

Функция ОписаниеТиповСтрока255()
	
	Возврат Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(255));
	
КонецФункции

Функция ИменаОсновныхТаблицСУБД()
	
	Возврат ДоступКДанным.ИменаТаблицПоСтрокамСкана(СтрокиОсновногоСкана, ДанныеКэшаДиагностики());
	
КонецФункции

Процедура ДополнитьХронологиюИменамиСУБД(Хронология)
	
	ДанныеКэшаДиагностики().Удалить("ОшибкаИменТаблиц");
	Если ИнформационнаяБазаФайловая() Тогда
		Возврат;
	КонецЕсли;
	
	Хронология.Колонки.Добавить("ТаблицаСУБД", ОписаниеТиповСтрока255(), "Таблица СУБД");
	
	Попытка
		Имена = ИменаОсновныхТаблицСУБД();
	Исключение
		ДанныеКэшаДиагностики().Вставить("ОшибкаИменТаблиц", ОписаниеОшибки());
		
		Возврат;
	КонецПопытки;
	
	Для Каждого СтрокаХронологии Из Хронология Цикл
		Имя = Имена.Получить("Документ." + СтрокаХронологии.МетаданныеИмя);
		СтрокаХронологии.ТаблицаСУБД = ?(Имя = Неопределено, "", Имя);
	КонецЦикла;
	
КонецПроцедуры

Функция ДанныеКэшаДиагностики()
	
	Если КэшДиагностики = Неопределено Тогда
		КэшДиагностики = Новый Структура;
		КэшДиагностики.Вставить("ИменаТаблиц", Неопределено);
		КэшДиагностики.Вставить("Расширения", Новый Соответствие);
		КэшДиагностики.Вставить("ПроверенныеТаблицы", Новый Соответствие);
		КэшДиагностики.Вставить("ОписаниеБиблиотек", Неопределено);
	КонецЕсли;
	
	Возврат КэшДиагностики;
	
КонецФункции

Функция КлючКэшаРасширения(Расширение)
	
	Если ПустаяСтрока(Расширение.ХешСумма) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Строка(Расширение.УникальныйИдентификатор) + ":" + Расширение.ХешСумма
	+ ":" + Расширение.Версия + ":" + Расширение.Имя + ":" + Расширение.Синоним;
	
КонецФункции

Функция КэшированныеДанныеРасширения(Расширение, Прежние, Актуальные)
	
	Ключ = КлючКэшаРасширения(Расширение);
	
	Если Ключ = Неопределено Тогда
		Возврат ДанныеРасширения(Расширение);
	КонецЕсли;
	
	Данные = Прежние.Получить(Ключ);
	
	Если Данные = Неопределено Тогда
		ПолноеОписание = Ложь;
		Данные = ДанныеРасширения(Расширение, ПолноеОписание);
		
		Если Не ПолноеОписание Тогда
			Возврат Данные;
		КонецЕсли;
	КонецЕсли;
	
	Данные = СкопированныеДанныеРасширения(Данные);
	ДобавитьНастройкиРасширения(Данные, Расширение);
	Актуальные.Вставить(Ключ, Данные);
	
	Возврат Данные;
	
КонецФункции

Функция СкопированныеДанныеРасширения(Данные)
	
	Копия = Новый Структура;
	
	Для Каждого Поле Из Данные Цикл
		Копия.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	
	Возврат Копия;
	
КонецФункции

Функция ДанныеКонстантПорциями()
	
	Данные = Новый ТаблицаЗначений;
	Данные.Колонки.Добавить("МетаданныеИмя");
	Данные.Колонки.Добавить("МетаданныеСиноним");
	Данные.Колонки.Добавить("КоллекцияОбъектовМетаданныхИмя");
	Данные.Колонки.Добавить("ОсновнойРесурс");
	РазмерПорцииКонстант = 64;
	Имена = Новый Массив;
	
	Для Каждого Константа Из Метаданные.Константы Цикл
		Имена.Добавить(Константа.Имя);
		
		Если Имена.Количество() = РазмерПорцииКонстант Тогда
			ПрочитатьПорциюКонстант(Данные, Имена);
			Имена.Очистить();
		КонецЕсли;
	КонецЦикла;
	
	ПрочитатьПорциюКонстант(Данные, Имена);
	
	Возврат Данные;
	
КонецФункции

Процедура ПрочитатьПорциюКонстант(Данные, Имена)
	
	Если Имена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапросаПорцииКонстант(Имена));
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		// Старые СУБД могут ограничивать число неявных соединений для представлений.
		Если Имена.Количество() = 1 Тогда
			ВызватьИсключение;
		КонецЕсли;
		
		ПрочитатьРазделеннуюПорциюКонстант(Данные, Имена);
		
		Возврат;
	КонецПопытки;
	
	Если Не Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	Для Индекс = 0 По Имена.Количество() - 1 Цикл
		СтрокаДанных = Данные.Добавить();
		СтрокаДанных.МетаданныеИмя = Имена[Индекс];
		СтрокаДанных.МетаданныеСиноним = Метаданные.Константы[Имена[Индекс]].Синоним;
		СтрокаДанных.КоллекцияОбъектовМетаданныхИмя = "Константы";
		СтрокаДанных.ОсновнойРесурс = Выборка[Индекс];
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаПорцииКонстант(Имена)
	
	Поля = Новый Массив;
	
	Для Индекс = 0 По Имена.Количество() - 1 Цикл
		Поля.Добавить("ПРЕДСТАВЛЕНИЕ(" + Имена[Индекс] + ") КАК Значение" + Формат(Индекс, "ЧГ=;ЧН=0"));
	КонецЦикла;
	
	Возврат "ВЫБРАТЬ " + СтрСоединитьАдапт(Поля, ", ") + " ИЗ Константы";
	
КонецФункции

Функция РесурсыСуммируютсяВЗапросе()
	
	// Файловая СУБД быстрее выполняет прежнюю группировку, серверная - условные суммы.
	
	Возврат Не ИнформационнаяБазаФайловая();
	
КонецФункции

Функция ВыражениеСуммыРесурса(Поле)
	
	Если Поле = "Неопределено" Тогда
		Возврат "0";
	КонецЕсли;
	
	Возврат "ЕСТЬNULL(СУММА(ВЫБОР КОГДА " + Поле + " ТОГДА 1 ИНАЧЕ 0 КОНЕЦ), 0)";
	
КонецФункции

Процедура ПрочитатьРазделеннуюПорциюКонстант(Данные, Имена)
	
	Первая = Новый Массив;
	Вторая = Новый Массив;
	
	Для Индекс = 0 По Имена.Количество() - 1 Цикл
		Если Индекс < Цел(Имена.Количество() / 2) Тогда
			Первая.Добавить(Имена[Индекс]);
		Иначе
			Вторая.Добавить(Имена[Индекс]);
		КонецЕсли;
	КонецЦикла;
	
	ПрочитатьПорциюКонстант(Данные, Первая);
	ПрочитатьПорциюКонстант(Данные, Вторая);
	
КонецПроцедуры

Функция ДанныеОрганизацийСКоличествомДокументов()
	
	Таблица = НоваяТаблицаОрганизаций();
	ОбъектМетаданных = Метаданные.Справочники.Найти("Организации");
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Количество = КоличествоДокументовПоОрганизациям();
	Запрос = Новый Запрос(ТекстЗапросаОрганизаций(ОбъектМетаданных));
	
	Для Каждого Организация Из Запрос.Выполнить().Выгрузить() Цикл
		СтрокаДанных = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДанных, Организация);
		
		Если ПустаяСтрока(СтрокаДанных.СокращенноеНаименование) Тогда
			СтрокаДанных.СокращенноеНаименование = СтрокаДанных.Наименование;
		КонецЕсли;
		
		ЧислоДокументов = Количество.Получить(Организация.Ссылка);
		СтрокаДанных.КоличествоДокументов = ?(ЧислоДокументов = Неопределено, 0, ЧислоДокументов);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ТекстЗапросаОрганизаций(ОбъектМетаданных)
	
	Префикс = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "Префикс,ПрефиксНумерации", "Организации");
	ВидОрганизации = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных,
		"ЮридическоеФизическоеЛицо,ВидОрганизации,ЮрФизЛицо", "Организации");
	ИНН = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "ИНН", "Организации");
	КПП = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных, "КПП", "Организации");
	СокращенноеНаименование = ВыражениеНеобязательногоРеквизита(ОбъектМетаданных,
		"НаименованиеСокращенное,СокращенноеНаименование", "Организации");
	
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| Организации.Ссылка КАК Ссылка,
	| " + Префикс + " КАК Префикс,
	| Организации.Представление КАК Наименование,
	| " + СокращенноеНаименование + " КАК СокращенноеНаименование,
	| " + ВидОрганизации + " КАК ВидОрганизации,
	| " + ИНН + " КАК ИНН,
	| " + КПП + " КАК КПП
	|ИЗ Справочник.Организации КАК Организации";
	
КонецФункции

Функция КоличествоДокументовПоОрганизациям()
	
	Результат = Новый Соответствие;
	ТипОрганизации = ТипЗнч(Справочники.Организации.ПустаяСсылка());
	Пакет = "";
	КоличествоТаблиц = 0;
	
	Для Каждого Документ Из Метаданные.Документы Цикл
		ИмяРеквизита = Неопределено;
		УстановитьРеквизитОрганизацияОбъектаМетаданных(ИмяРеквизита, Документ, ТипОрганизации);
		
		Если ИмяРеквизита = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Пакет = Пакет + ?(ПустаяСтрока(Пакет), "", Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
		+ ТекстЗапросаКоличестваДокументовОрганизации(Документ.ПолноеИмя(), ИмяРеквизита, ПустаяСтрока(Пакет));
		КоличествоТаблиц = КоличествоТаблиц + 1;
		
		Если КоличествоТаблиц = 100 Тогда
			ДобавитьСчетчикиДокументовОрганизаций(Результат, Пакет);
			Пакет = "";
			КоличествоТаблиц = 0;
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьСчетчикиДокументовОрганизаций(Результат, Пакет);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаКоличестваДокументовОрганизации(ПолноеИмя, Реквизит, ЭтоПервыйЗапрос)
	
	Начало = ?(ЭтоПервыйЗапрос, "ВЫБРАТЬ РАЗРЕШЕННЫЕ ", "ВЫБРАТЬ ");
	
	Возврат Начало + "Документы." + Реквизит + " КАК Организация, КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ " + ПолноеИмя + " КАК Документы
	|СГРУППИРОВАТЬ ПО Документы." + Реквизит;
	
КонецФункции

Процедура ДобавитьСчетчикиДокументовОрганизаций(Счетчики, Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(Текст);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Прежнее = Счетчики.Получить(Выборка.Организация);
		Счетчики.Вставить(Выборка.Организация, ?(Прежнее = Неопределено, 0, Прежнее) + Выборка.Количество);
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяТаблицаОрганизаций()
	
	Возврат ДоступКДанным.НоваяТаблицаОрганизаций();
	
КонецФункции

// #КонецОбласти

// #Область СеансыСканирования

Функция ВыполнитьСледующуюПорцию(Сеанс)
	
	Если Сеанс.Статус <> "Выполняется" Тогда
		Возврат СостояниеСеанса(Сеанс);
	КонецЕсли;
	
	План = Сеанс.План;
	
	Если Сеанс.Позиция >= План.Количество() Тогда
		Сеанс.Статус = "Завершен";
		
		Возврат СостояниеСеанса(Сеанс);
	КонецЕсли;
	
	Порция = ПорцияСеанса(Сеанс);
	
	Если Лев(Порция.Этап, 10) = "Публикация" Тогда
		Сеанс.Статус = Порция.Этап;
		Сеанс.ИдентификаторПубликации = Строка(Сеанс.Идентификатор) + ":" + Формат(Сеанс.Позиция, "ЧГ=;ЧН=0");
		
		Возврат СостояниеСеанса(Сеанс);
	КонецЕсли;
	
	Контекст = Неопределено;
	
	Если Порция.Этап = "Дополнительные" Тогда
		Контекст = ПолучитьИзВременногоХранилища(Сеанс.АдресКонтекста);
		ПодготовитьКонтекстСеанса(Контекст);
	КонецЕсли;
	
	Начало = ВремяПорции();
	
	Попытка
		ВыполнитьПорциюСеанса(Сеанс, Порция);
		Сеанс.Позиция = Сеанс.Позиция + 1;
		Сеанс.Сообщение = "";
	Исключение
		
		Если Порция.Этап = "Дополнительные" Тогда
			Сеанс.ОшибкиРазделов.Вставить(Порция.Таблица, ОписаниеОшибки());
			Сеанс.Позиция = Сеанс.Позиция + 1;
		Иначе
			Сеанс.Статус = "Ошибка";
			Сеанс.Сообщение = Порция.Таблица + ": " + ОписаниеОшибки();
		КонецЕсли;
	КонецПопытки;
	
	Замер = Новый Структура("Раздел,ДлительностьМс,Успех", Порция.Таблица,
		ВремяПорции() - Начало,
		Сеанс.Статус <> "Ошибка" И Сеанс.ОшибкиРазделов.Получить(Порция.Таблица) = Неопределено);
	Сеанс.Замеры.Добавить(Замер);
	
	Если Порция.Этап = "Дополнительные" И Сеанс.Статус <> "Ошибка" Тогда
		Контекст.КэшДиагностики = ДанныеКэшаДиагностики();
		ПоместитьВоВременноеХранилище(Контекст, Сеанс.АдресКонтекста);
	КонецЕсли;
	
	Возврат СостояниеСеанса(Сеанс);
	
КонецФункции

Процедура ВыполнитьПорциюСеанса(Сеанс, Порция)
	
	Если Сеанс.ИмитацияОшибкиРаздела = Порция.Таблица Тогда
		ВызватьИсключение НСтр("ru='Имитация отказа раздела'");
	КонецЕсли;
	
	Если Порция.Этап = "Основные" Тогда
		Данные = СканироватьПорцию(Порция, Сеанс.Параметры);
		Адрес = ПоместитьВоВременноеХранилище(Данные, Сеанс.Владелец);
		Сеанс.ПорцииОсновных.Добавить(Адрес);
	Иначе
		Данные = ДанныеДополнительнойПорции(Порция.Таблица, Сеанс.Параметры);
		Если Порция.Таблица = "ХронологияДокументов" Тогда
			ДобавитьПредупреждениеИменТаблиц(Сеанс);
		КонецЕсли;
		Адрес = ПоместитьВоВременноеХранилище(Данные, Сеанс.Владелец);
		Сеанс.ПорцииДополнительных.Вставить(Порция.Таблица, Адрес);
	КонецЕсли;
	
КонецПроцедуры

Функция НовыеДанныеДополнительногоРезультата(Контекст)
	
	Данные = Новый Структура;
	
	Для Каждого Описание Из Контекст.СхемаТаблиц Цикл
		Если Описание.ЭтоДополнительнаяТаблица И Не Описание.ОтдельныеСведения Тогда
			Данные.Вставить(Описание.ИмяТаблицы, Неопределено);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция СведенияДополнительногоРезультата(Контекст)
	
	Сведения = Новый Структура;
	
	Для Каждого Описание Из Контекст.СхемаТаблиц Цикл
		Если Описание.ОтдельныеСведения Тогда
			Сведения.Вставить(Описание.ИмяТаблицы, ДоступКДанным.НоваяТаблицаПоСхеме(Описание.ИмяТаблицы));
		КонецЕсли;
	КонецЦикла;
	
	Сведения.Вставить("ПериодХронологии", Неопределено);
	Сведения.Вставить("ОрганизацияХронологии", Неопределено);
	ПрежниеСведения = Неопределено;
	
	Если Контекст.Свойство("ПредыдущиеСведения", ПрежниеСведения) И ПрежниеСведения <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Сведения, ПрежниеСведения);
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции

Процедура ДобавитьСостояниеДополнительныхРазделов(Сведения, Контекст, Сеанс)
	
	РазделыСДанными = Новый Соответствие;
	СохраненыПредыдущиеДанные = Новый Соответствие;
	ПрежниеСведения = Неопределено;
	Контекст.Свойство("ПредыдущиеСведения", ПрежниеСведения);
	
	Для Каждого Описание Из Контекст.СхемаТаблиц Цикл
		Если Не Описание.ЭтоДополнительнаяТаблица Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяРаздела = Описание.ИмяТаблицы;
		ЕстьПрежниеДанные = ЕстьПрежнийРезультатРаздела(ПрежниеСведения, ИмяРаздела);
		ЕстьНовыеДанные = Сеанс.ПорцииДополнительных.Получить(ИмяРаздела) <> Неопределено;
		РазделыСДанными.Вставить(ИмяРаздела, ЕстьНовыеДанные Или ЕстьПрежниеДанные);
		
		Если Сеанс.ОшибкиРазделов.Получить(ИмяРаздела) <> Неопределено Тогда
			СохраненыПредыдущиеДанные.Вставить(ИмяРаздела, ЕстьПрежниеДанные);
		КонецЕсли;
	КонецЦикла;
	
	Сведения.Вставить("РазделыСДанными", РазделыСДанными);
	Сведения.Вставить("СохраненыПредыдущиеДанные", СохраненыПредыдущиеДанные);
	
КонецПроцедуры

Функция ЕстьПрежнийРезультатРаздела(Сведения, ИмяРаздела)
	
	Если Сведения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РазделыСДанными = Неопределено;
	
	Если Сведения.Свойство("РазделыСДанными", РазделыСДанными) Тогда
		Возврат РазделыСДанными.Получить(ИмяРаздела) = Истина;
	КонецЕсли;
	
	ТаблицаРаздела = Неопределено;
	
	Если Не Сведения.Свойство(ИмяРаздела, ТаблицаРаздела) Или ТаблицаРаздела = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОшибкиРазделов = Неопределено;
	
	Если Сведения.Свойство("ОшибкиРазделов", ОшибкиРазделов) Тогда
		Возврат ОшибкиРазделов.Получить(ИмяРаздела) = Неопределено;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДанныеДополнительнойПорции(Раздел, Параметры)
	
	Если Раздел = "Константы" Тогда
		Данные = ДанныеКонстантПорциями();
	ИначеЕсли Раздел = "ХронологияДокументов" Тогда
		Данные = ХронологияДокументов(Параметры.Период, Параметры.Организация);
	ИначеЕсли Раздел = "ПодключаемоеОборудование" Тогда
		Данные = ДанныеПодключаемогоОборудования();
	ИначеЕсли Раздел = "Библиотеки" Тогда
		Кэш = ДанныеКэшаДиагностики();
		
		Если Кэш.ОписаниеБиблиотек = Неопределено Тогда
			Кэш.ОписаниеБиблиотек = ДанныеБиблиотекДиагностики();
		КонецЕсли;
		
		Данные = Кэш.ОписаниеБиблиотек;
	ИначеЕсли Раздел = "Расширения" Тогда
		Данные = ДанныеУстановленныхРасширений();
	ИначеЕсли Раздел = "Организации" Тогда
		Данные = ДанныеОрганизацийСКоличествомДокументов();
	Иначе
		ВызватьИсключение НСтр("ru='Неизвестный раздел дополнительного скана: '") + Раздел;
	КонецЕсли;
	
	ОтсортироватьДополнительныйРаздел(Раздел, Данные);
	
	Возврат Данные;
	
КонецФункции

Процедура ОтсортироватьДополнительныйРаздел(Раздел, Данные)
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Описание Из ОписанияТаблиц Цикл
		Если Описание.ИмяТаблицы <> Раздел Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Описание.Сортировка) Тогда
			Данные.Сортировать(Описание.Сортировка);
		КонецЕсли;
		
		Возврат;
	КонецЦикла;
	
КонецПроцедуры

Функция ВремяПорции()
	
	Результат = Неопределено;
	
	Попытка
		Выполнить("Результат = ТекущаяУниверсальнаяДатаВМиллисекундах();");
	Исключение
		Результат = (ТекущаяДата() - Дата(2000, 1, 1)) * 1000;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// #КонецОбласти

// #Область НастройкиРасширений

Процедура ДобавитьНастройкиРасширения(Данные, Расширение)
	
	Данные.Вставить("Активно", ПредставлениеФлагаРасширения(СвойствоРасширения(Расширение, "Активно")));
	БезопасныйРежим = СвойствоРасширения(Расширение, "БезопасныйРежим");
	ЕстьПрофиль = ТипЗнч(БезопасныйРежим) = Тип("Строка");
	Данные.Вставить("БезопасныйРежим", ?(ЕстьПрофиль, "Профиль безопасности",
		ПредставлениеФлагаРасширения(БезопасныйРежим)));
	Данные.Вставить("ИмяПрофиля", ?(ЕстьПрофиль, БезопасныйРежим, ""));
	Данные.Вставить("ИспользуетсяВРИБ", ПредставлениеФлагаРасширения(СвойствоРасширения(Расширение,
		"ИспользуетсяВРаспределеннойИнформационнойБазе")));
	Данные.Вставить("ИспользоватьОсновныеРоли", ПредставлениеФлагаРасширения(СвойствоРасширения(Расширение,
		"ИспользоватьОсновныеРолиДляВсехПользователей")));
	Данные.Вставить("ЗащитаОтОпасныхДействий", ПредставлениеЗащитыРасширения(СвойствоРасширения(Расширение,
		"ЗащитаОтОпасныхДействий")));
	
КонецПроцедуры

Функция СвойствоРасширения(Расширение, ИмяСвойства)
	
	Попытка
		
		Возврат Расширение[ИмяСвойства];
	Исключение
		// На старой платформе отдельных настроек может не быть.
		
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Функция ПредставлениеФлагаРасширения(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Булево") Тогда
		Возврат "Недоступно на этой платформе";
	КонецЕсли;
	
	Возврат ?(Значение, "Да", "Нет");
	
КонецФункции

Функция ПредставлениеЗащитыРасширения(Защита)
	
	Если Защита = Неопределено Или ТипЗнч(Защита) = Тип("Булево") Тогда
		Возврат ПредставлениеФлагаРасширения(Защита);
	КонецЕсли;
	
	Попытка
		
		Возврат ПредставлениеФлагаРасширения(Защита.ПредупреждатьОбОпасныхДействиях);
	Исключение
		
		Возврат "Недоступно на этой платформе";
	КонецПопытки;
	
КонецФункции

// #КонецОбласти

// Нормализует границы отбора, не изменяя переданный период.
//
// Параметры:
//  ИсходныйПериод - СтандартныйПериод, Структура, Неопределено - границы ДатаНачала и ДатаОкончания.
//  ПроверятьГраницы - Булево - отклонить начало позже окончания.
//
// Возвращаемое значение:
//  - СтандартныйПериод - начало как задано, окончание в конце дня; пустой конец заменен верхней границей дат.
//  - Неопределено - обе даты не заданы.
Функция НормализованныйПериодОтбора(ИсходныйПериод, ПроверятьГраницы = Ложь)
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИсходныйПериод.ДатаНачала)
		И Не ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Период = Новый СтандартныйПериод;
	Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Период.ДатаНачала = ИсходныйПериод.ДатаНачала;
	
	Если ЗначениеЗаполнено(ИсходныйПериод.ДатаОкончания) Тогда
		Период.ДатаОкончания = КонецДня(ИсходныйПериод.ДатаОкончания);
	Иначе
		Период.ДатаОкончания = Дата('39991231235959');
	КонецЕсли;
	
	Если ПроверятьГраницы И Период.ДатаОкончания < Период.ДатаНачала Тогда
		ВызватьИсключение(
			НСтр("ru='Некорректный отбор по периоду. Дата начала не может быть больше даты окончания'"));
	КонецЕсли;
	
	Возврат Период;
	
КонецФункции

Процедура ДобавитьПредупреждениеИменТаблиц(Сеанс)
	
	Ошибка = "";
	Если ДанныеКэшаДиагностики().Свойство("ОшибкаИменТаблиц", Ошибка) Тогда
		Сеанс.ПредупрежденияРазделов.Вставить("ХронологияДокументов",
			"Даты и количество документов обновлены; имена таблиц СУБД недоступны. " + Ошибка);
	КонецЕсли;
	
КонецПроцедуры

